# seed-config.diff — 设备与预装包选择（追加到 .config 后 make defconfig）
# 决策：主路由形态 + 双 release（stock/oc）共用同一 seed；oc 档差异只在 prepare-oc.sh。
# 注意：依赖自定义 feed 的包需 feed 已供给（config/feeds.custom.conf）；未供给的先注释，构建通过后逐个解锁。
# 每项带来源：O=官方包 / C=自定义feed / T=TODO待供给

# ── 目标：gemtek_xr1710g-ubi（#22397 板级补丁提供）──
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_gemtek_xr1710g-ubi=y
# 备选：同源 W1700K（官方已合入）CONFIG_TARGET_airoha_an7581_gemtek_w1700k-ubi=y

# ── 基础系统（O）──
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_wpad-openssl=y            # 全功能（mesh/SAE 预留在位，为 802.11s/EHT320 回程）
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_nano=y

# ── 设备驱动/kmod（O；决策默认档）──
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y   # NPU 固件（上游 #22289 已合）
CONFIG_PACKAGE_rtl826x-firmware=y                    # 10G PHY 固件 blob（#23427 已合）
CONFIG_PACKAGE_kmod-phy-realtek=y                    # 10G PHY 驱动（6.18 切 kmod-phy-realtek，ecabaa534e）
CONFIG_PACKAGE_kmod-hwmon-nct7802=y                  # 风扇温控传感器（动态探测，见 files/etc/init.d/fan）
CONFIG_PACKAGE_kmod-i2c-an7581=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996e=y

# ── LuCI 与工具（O / C）──
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_irqbalance=y
# 应用包（C：patches/vendor/fanboy/19-w1700k-apps-pack 随树内置；拆包评审后可选 src-git feed，见 FIXES F13）：
CONFIG_PACKAGE_luci-app-mlo=y
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=y
CONFIG_PACKAGE_luci-app-airoha-npu=y          # NPU 诊断（决策已选）
CONFIG_PACKAGE_luci-app-airoha-flowsense=y    # 流量卸载诊断
CONFIG_PACKAGE_luci-app-filemanager=y         # fanboy 档位应用

# ── 待供给（T，见 ROADMAP P1）──
# CONFIG_PACKAGE_luci-app-airoha-recovery=y     # 恢复页入口（无独立仓库，抽取后解锁）

# ── 暂缓（决策）：科学上网 / Docker ──
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_docker=y