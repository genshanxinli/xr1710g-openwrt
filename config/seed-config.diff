# seed-config.diff — 设备与预装包选择（追加到 .config 后 make defconfig）
# 决策：主路由形态 + 双 release（stock/oc）共用同一 seed；oc 档差异只在 prepare-oc.sh。
# 注意：依赖自定义 feed 的包需 feed 已供给（config/feeds.custom.conf）；未供给的先注释，构建通过后逐个解锁。
# 每项带来源：O=官方包 / C=自定义feed / T=TODO待供给

# ── 目标：gemtek_xr1710g-ubi（#22397 板级补丁提供）──
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# 设备符号 = CONFIG_TARGET_<board>_<subtarget>_DEVICE_<device>（metadata.pm confstr 清洗 target 名，profile id 保留 DEVICE_ 前缀与连字符）
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y
# 备选：同源 W1700K（官方已合入）CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_w1700k-ubi=y

# ── 基础系统（O）──
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_wpad-openssl=y            # 全功能（mesh/SAE 预留在位，为 802.11s/EHT320 回程）
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_nano=y

# ── 设备驱动/kmod（O；决策默认档）──
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y   # NPU 固件（上游 #22289 已合）
CONFIG_PACKAGE_rtl826x-firmware=y                    # 10G PHY 固件 blob（#23427 已合）
CONFIG_PACKAGE_kmod-phy-realtek=y                    # 10G PHY 驱动（6.18 切 kmod-phy-realtek，ecabaa534e）
CONFIG_PACKAGE_kmod-hwmon-nct7802=y                  # 风扇温控传感器（动态探测，见 files/etc/init.d/fan）
# an7581 的 I2C 控制器 = mediatek,mt7621-i2c（CONFIG_I2C_MT7621=y 内核内置）——无需/不存在 kmod-i2c-an7581（F17 移除）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996e=y

# ── LuCI 与工具（O / C）──
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_irqbalance=y
# 诊断工具（issue #2/F42）：NPU RPC 依赖 devmem/ethtool/bridge；tcpdump/iperf3 供深度排障
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
# devmem 根因修复（issue #2）：busybox devmem applet 只是用户态工具，内核必须提供 /dev/mem 驱动；
# OpenWrt 通用内核配置默认 `CONFIG_DEVMEM is not set`，设备上 mknod /dev/mem 后 open 仍 ENXIO。
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y
# 应用包（C：packages-xr1710g src-link / patches/vendor/fanboy/19 随树内置；拆包评审后可选 src-git feed，见 FIXES F13）：
CONFIG_PACKAGE_luci-app-mlo=y
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=y
CONFIG_PACKAGE_luci-app-airoha-npu=y          # NPU 诊断（决策已选，19-pack 内置）
CONFIG_PACKAGE_luci-app-airoha-flowsense=y    # 流量卸载诊断（19-pack 内置）
CONFIG_PACKAGE_luci-app-filemanager=y         # 官方 luci feed（O）
CONFIG_PACKAGE_luci-app-airoha-recovery=y     # 恢复页入口（C：packages-xr1710g src-link，锁 dd9ecfeef）
# ── 代理与组网（ADR-0003/0004；docs/plans/proxy-dns-stack/）──
# 预装但**默认不启用**：xr1710g-proxy 的 uci-defaults 只写 enabled=0，不 enable 任何服务（I4）。
# ── 方案二 kmod 预装（D6 封闭清单；ADR-0006）──
# 为什么必须**预装**而不是运行期装：官方 kmods 目录是
#   downloads.openwrt.org/snapshots/targets/airoha/an7581/kmods/<ver>-<hash>/
# 本机构建 hash 与官方发布 hash **不同**（两者 vermagic 都不含 hash，所以 apk 不会自己发现——
# 属静默 ABI 风险）。且设备 distfeeds 只挂了 .../packages/packages.adb，**没有 kmods 这一项**，
# 所以 `apk add kmod-wireguard` 只会得到 "no such package"。这是 F5 闸门的完整版本。
# 因此：方案二的内核态 WG 只能走"随固件预装"这条路。
CONFIG_PACKAGE_kmod-wireguard=y                # G3 硬要求：netbird 必须报 Interface type: Kernel
CONFIG_PACKAGE_kmod-ipt-ipset=y                # netbird 依赖（注意：**不存在** kmod-ipset 这个包名）
CONFIG_PACKAGE_kmod-tun=y                      # sing-box TUN 入站（F6 已在，显式固化）
CONFIG_PACKAGE_kmod-nft-tproxy=y               # 本轮不用，为将来 TProxy 留路（成本极低）
# netbird 本体（自持提版 0.78.1，见 patches/packages/netbird-0001-* 与 ADR-0006）
CONFIG_PACKAGE_netbird=y                       # 方案二核心；预装但默认不启用（官方包不带 rc.d/uci-defaults）
CONFIG_PACKAGE_xr1710g-proxy=y                 # 数据面：sing-box + 内核层分流 nft + CN 放行集合（C：packages-xr1710g）
CONFIG_PACKAGE_luci-app-xr1710g-proxy=y        # 极简前端：开关/名单/CN 更新/只读状态（C：packages-xr1710g）
CONFIG_PACKAGE_sing-box=y                      # 官方 feed 1.14.0（O）
CONFIG_PACKAGE_jsonfilter=y                    # 状态查询（O）

# bridge-flow-offload 由 vendor/05 + root/9024 提供（issue #1 E1/E3；ci-74 实验档验证通过，毕业 default 后 stock 档也应安装）。
CONFIG_PACKAGE_bridge-flow-offload=y

# ── 暂缓（决策）：科学上网 / Docker ──
