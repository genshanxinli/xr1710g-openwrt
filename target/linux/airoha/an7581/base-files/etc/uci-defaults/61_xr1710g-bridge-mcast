#!/bin/sh
# Enable IGMP/MLD snooping and multicast querier on br-lan for XR1710G.

# shellcheck disable=SC1090,SC1091
. "${IPKG_INSTROOT:-}/lib/functions.sh"

case "$(board_name)" in
gemtek,xr1710g-ubi) ;;
*) exit 0 ;;
esac

SYS_NET="${BR_MCAST_SYS_NET:-/sys/class/net}"
snooping_file="$SYS_NET/br-lan/bridge/multicast_snooping"
querier_file="$SYS_NET/br-lan/bridge/multicast_querier"

find_br_lan_section() {
	uci -q show network | sed -n "s/^network\.\([^.=']*\)\.name='br-lan'$/\1/p" | head -n 1
}

changed=0
apply_snooping=0
apply_querier=0

br_lan_section=$(find_br_lan_section)

if [ -n "$br_lan_section" ]; then
	cur=$(uci -q get "network.$br_lan_section.igmp_snooping")
	cur_querier=$(uci -q get "network.$br_lan_section.multicast_querier")

	case "$cur" in
	"")
		uci -q set "network.$br_lan_section.igmp_snooping=1"
		cur=1
		changed=1
		apply_snooping=1
		;;
	1)
		apply_snooping=1
		;;
	*)
		logger -t bridge-mcast "br-lan igmp_snooping is '$cur', leaving it alone"
		;;
	esac

	if [ "$cur" = "1" ]; then
		case "$cur_querier" in
		"")
			uci -q set "network.$br_lan_section.multicast_querier=1"
			changed=1
			apply_querier=1
			;;
		1)
			apply_querier=1
			;;
		*)
			logger -t bridge-mcast "br-lan multicast_querier is '$cur_querier', leaving it alone"
			;;
		esac
	fi
else
	logger -t bridge-mcast "br-lan has no device section, adding one"
	uci -q batch <<-EOF
		add network device
		set network.@device[-1].name='br-lan'
		set network.@device[-1].type='bridge'
		set network.@device[-1].igmp_snooping='1'
		set network.@device[-1].multicast_querier='1'
	EOF
	changed=1
	apply_snooping=1
	apply_querier=1
fi

[ "$changed" = 1 ] && uci commit network

apply_sysfs() {
	if [ -e "$1" ]; then
		[ "$(cat "$1" 2>/dev/null)" = 1 ] || \
			echo 1 > "$1" 2>/dev/null || \
			logger -t bridge-mcast "failed to set $1"
	else
		logger -t bridge-mcast "br-lan is not up yet, netifd will apply $2"
	fi
}

[ "$apply_snooping" = 1 ] && apply_sysfs "$snooping_file" igmp_snooping
[ "$apply_querier" = 1 ] && apply_sysfs "$querier_file" multicast_querier

exit 0
