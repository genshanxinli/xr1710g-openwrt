#!/bin/sh
#
# The Gemtek boxes ship with hardware flow offloading and Full Cone NAT on.
#
# These are device characteristics, not tree-wide policy. They used to be
# baked into /etc/config/firewall by the firewall4 fullcone patch, which
# meant every board on every target in the tree inherited them from a core
# package. The PPE is what makes 2.5G/10G routing possible on these boxes,
# and Full Cone NAT is the behaviour their owners expect from the stock
# firmware -- but a reference design or a PON stick has no reason to get it.
#
# Runs once from /etc/init.d/boot (START=10), before firewall starts
# (START=19), and only on boards that are actually deployed.
#
# Bridged traffic is already offloaded: 50-nf-bridge-call sets
# br-lan's nf_call_iptables=1, which feeds bridged packets through
# NF_INET_FORWARD where the inet flowtable picks them up as HNAPT entries.
# There is no bridge-family flowtable and none is needed; one only added
# UNB churn.

. /lib/functions.sh

case "$(board_name)" in
gemtek,xr1710g-ubi|gemtek,w1700k-ubi)
	uci set firewall.@defaults[0].flow_offloading='1'
	uci set firewall.@defaults[0].flow_offloading_hw='1'
	uci set firewall.@defaults[0].fullcone='1'
	uci set firewall.@defaults[0].fullcone6='0'
	uci commit firewall
	;;
esac

exit 0
