#!/bin/sh
# Tune usteer SNR thresholds and enable single-AP local_mode default on XR1710G.

# shellcheck disable=SC1090,SC1091
. "${IPKG_INSTROOT:-}/lib/functions.sh"

[ -e "${IPKG_INSTROOT:-}/etc/config/usteer" ] || exit 0

changed=0

uci_set_default() {
	_usd_opt="$1"
	_usd_stock="$2"
	_usd_val="$3"

	_usd_cur=$(uci -q get "usteer.@usteer[0].$_usd_opt")
	[ -z "$_usd_cur" ] || [ "$_usd_cur" = "$_usd_stock" ] || return 0

	uci -q set "usteer.@usteer[0].$_usd_opt=$_usd_val"
	changed=1
}

case "$(board_name)" in
gemtek,xr1710g-ubi)
	uci_set_default band_steering_min_snr -60 -70
	uci_set_default roam_scan_snr 0 -75
	if [ -z "$(uci -q get usteer.@usteer[0]._xr1710g_local_mode_init)" ]; then
		_lm_cur=$(uci -q get usteer.@usteer[0].local_mode)
		if [ -z "$_lm_cur" ] || [ "$_lm_cur" = "0" ]; then
			uci -q set usteer.@usteer[0].local_mode='1'
		fi
		uci -q set usteer.@usteer[0]._xr1710g_local_mode_init='1'
		changed=1
	fi
	;;
esac

[ "$changed" = 1 ] && uci commit usteer

exit 0
