#!/bin/sh
#
# Radio defaults for the Gemtek XR1710G (MT7996, 2.4/5/6 GHz).
#
# The stock wireless config puts 2.4 GHz on channel 1, 5 GHz on channel 36
# and 6 GHz on an automatic channel at EHT80. A survey of this site found
# channel 1 carrying 39 neighbour BSSes at 66% airtime, while channel 149
# is quiet *and* has a 5 dB higher regulatory ceiling than channel 36
# (28 vs 23 dBm on this board), and channel 37 is a 6 GHz PSC that supports
# EHT320 at 30 dBm. See issue #191 comment 6897351558.
#
# Every option below is a plain UCI setting, so it is trivially reversible
# with `uci revert`; nothing here touches the EEPROM, the regdb, the SKU
# table or the calibration data.
#
# A value is only rewritten while it is still unset or still at the stock
# default, so a deliberate operator choice (or a config restored from a
# backup) always wins. Runs from /etc/init.d/boot (START=10), after
# `wifi config` has created the radio sections and before wifi starts.

. /lib/functions.sh

[ -e /etc/config/wireless ] || exit 0

# uci_set_from <section> <option> <stock> <value>
uci_set_from() {
	local section="$1"
	local option="$2"
	local stock="$3"
	local value="$4"
	local cur

	cur=$(uci -q get "wireless.$section.$option")

	[ -z "$cur" ] || [ "$cur" = "$stock" ] || return 0
	[ "$cur" = "$value" ] && return 0

	uci -q set "wireless.$section.$option=$value"
	changed=1
}

# phy_has <iw phy line>: 0 supported, 1 iw ran and the channel is absent, 2
# iw is not usable here. "(disabled)" still counts as supported: the phy's
# band capability is what matters, the regdomain is applied by hostapd later.
phy_has() {
	command -v iw >/dev/null 2>&1 || return 2
	iw phy 2>/dev/null | grep -qF "$1"
}

# radio_usable <section> <band> <iw phy line>: a fixed channel/width is only
# promoted when the radio section exists, its own `band` does not contradict
# the promotion, and (when iw is available) the phy advertises the channel.
# Without iw the UCI band is the only evidence there is.
radio_usable() {
	local section="$1"
	local band="$2"
	local phy="$3"
	local cur

	uci -q get "wireless.$section" >/dev/null 2>&1 || return 1

	cur=$(uci -q get "wireless.$section.band")
	[ -n "$cur" ] && [ "$cur" != "$band" ] && return 1

	phy_has "$phy"
	[ $? -eq 1 ] && return 1
	return 0
}

case "$(board_name)" in
gemtek,xr1710g-ubi)
	# 2.4 GHz: leave the crowded channel 1. Keep 20 MHz -- at 66%
	# airtime a second 20 MHz just feeds half the bandwidth to the
	# neighbours.
	uci_set_from radio0 channel 1 6

	# eBF never fires on this band (measured 0 times) and the antenna
	# report gains only 1.33 dB, so do not pay for the sounding.
	uci_set_from radio0 he_mu_beamformer "" 0

	# 5 GHz: channel 149 is quiet and its ceiling is 28 dBm, not 23.
	# EHT80 rather than EHT160 -- many clients reject HE160 at 149, and
	# 58_xr1710g-wifi-htmode is the script that narrows the width once
	# the channel is final.
	#
	# wireless.radio1.xr1710g_5g160=1 opts in to the 36-64 profile the
	# survey left unused: the channel is pinned to that block and EHT160
	# is restored on it. A channel outside 36-64 is left alone, so those
	# keep whatever the operator (and 58) decide. The marker is only read,
	# never written: unset and 0 both keep the 149/EHT80 default above.
	if [ "$(uci -q get wireless.radio1.xr1710g_5g160)" = "1" ]; then
		channel=$(uci -q get wireless.radio1.channel)

		# The marker asks for the 36-64 profile, so an unset channel and
		# `auto` cannot be left to ACS: ACS scores 149 as the quietest
		# channel here, and 160 MHz cannot come up on UNII-3, so the
		# opt-in would silently degrade into a width hostapd refuses.
		# Write the 36 anchor of the 160 MHz block and decide the width
		# from it.
		case "$channel" in
		''|auto)
			uci -q set wireless.radio1.channel=36
			changed=1
			channel=36
			;;
		esac

		case "$channel" in
		36|40|44|48|52|56|60|64)
			# Restore EHT160 even if an earlier boot narrowed it to
			# EHT80 while the band sat on 149: the marker asks for the
			# 160 MHz profile, so it wins on UNII-1/UNII-2A.
			#
			# HE160 and VHT160 already ask for 160 MHz and were picked
			# by the operator (or restored from an older config), so
			# they are not narrowing leftovers: rewriting them to EHT160
			# would silently discard that choice.
			htmode=$(uci -q get wireless.radio1.htmode)
			case "$htmode" in
			EHT160|HE160|VHT160) ;;
			*)
				uci -q set wireless.radio1.htmode=EHT160
				changed=1
				;;
			esac

			# The 36-64 block is one 160 MHz segment and it covers the DFS
			# channels 52-64, so hostapd has to run a 60 s CAC before the
			# BSS can start and has to keep radar detection on. `noscan`
			# does not skip that: it only skips the scan *before* CAC, and
			# setting it here would hide a DFS channel from the survey
			# tooling. Radar detection is `ieee80211h=1`, which
			# hostapd.sh:186 emits only while doth is on (default 1), so a
			# config that turned it off has to be told what it gave up.
			case "$channel" in
			52|56|60|64)
				logger -t wireless-tuning \
					"5g160: primary channel $channel is DFS, expect a 60 s CAC and radar-triggered restarts"
				;;
			esac
			if [ "$(uci -q get wireless.radio1.doth)" = "0" ]; then
				logger -t wireless-tuning \
					"5g160: doth=0 turns radar detection off, 160 MHz on 36-64 is not usable without it"
			fi
			;;
		esac
	elif radio_usable radio1 5g "5745 MHz [149]"; then
		uci_set_from radio1 channel 36 149
	else
		logger -t wireless-tuning \
			"radio1 has no usable 5 GHz channel 149, leaving the channel alone"
	fi

	# 6 GHz: channel 37 is a PSC (clients that only scan PSC can find
	# it) and EHT320 is usable here -- 0.4% airtime, zero neighbour
	# BSSes.
	# Promote only when the radio really is a 6 GHz one: a board without
	# the band, or a config that reassigned radio2, still carries the
	# section, and 37/EHT320 there makes hostapd refuse the BSS instead of
	# tuning anything. The band option and `iw phy` are the two pieces of
	# evidence available; with iw missing the band option has to decide.
	if radio_usable radio2 6g "6135 MHz [37]"; then
		uci_set_from radio2 channel auto 37
		# Literal on purpose: scripts/wireless/6g-restore-eht320.sh
		# parses this exact line.
		uci_set_from radio2 htmode EHT80 EHT320
	else
		logger -t wireless-tuning \
			"radio2 has no usable 6 GHz channel 37, leaving channel and htmode alone"
	fi

	# A fixed BSS colour per band. The schema default of 128 means "pick
	# a random colour on every reload", and a colour that changes on
	# every reload makes the neighbours' SRG bitmaps flap.
	#
	# 128 is accepted as "still stock" as well as unset: uci_set_from()
	# already treats an empty option as unset, but once something writes
	# the schema default into /etc/config/wireless the empty check no
	# longer matches and these three would silently stop applying.
	uci_set_from radio0 he_bss_color 128 37
	uci_set_from radio1 he_bss_color 128 38
	uci_set_from radio2 he_bss_color 128 39

	# Do not drop a client just because its ACKs get sparse, and do not
	# time out an idle one after the 5 minute default: an edge-of-cell
	# client that reconnects every few minutes never gets a stable rate.
	#
	# 802.11k and 802.11v are turned on here because DEVICE_PACKAGES now
	# pulls in wpad-mbedtls, which actually implements them; usteer needs
	# both (neighbour reports to know where a client could go, BSS
	# transition requests to ask it to move) and is useless without them.
	for radio in radio0 radio1 radio2; do
		iface="default_$radio"

		# A missing section is normal before `wifi config` has run on a
		# board whose radios are still disabled, but it also means the
		# five settings below are silently skipped, so say which one.
		uci -q get "wireless.$iface" >/dev/null || {
			logger -t wireless-tuning "no $iface, skipping 11k/v defaults"
			continue
		}
		uci_set_from "$iface" disassoc_low_ack "" 0

		# U-APSD is advertised by default -- hostapd.sh:594 sets uapsd 1
		# and nothing here turned it off, so all three generated hostapd
		# confs carry uapsd_advertisement_enabled=1 (measured 2026-11-20
		# on /var/run/hostapd-phy0.{0,1,2}.conf). The reference board this
		# tree is ported from turns it off on its AP ifaces, which is what
		# issue #5 ports; it is a UCI default so it also survives a config
		# restore, which a changed hostapd default in the package would
		# not. No before/after throughput measurement was made for it.
		uci_set_from "$iface" uapsd "" 0
		uci_set_from "$iface" max_inactivity "" 86400
		uci_set_from "$iface" ieee80211k "" 1
		uci_set_from "$iface" bss_transition "" 1
	done
	;;
esac

[ -n "$changed" ] && uci commit wireless

exit 0
