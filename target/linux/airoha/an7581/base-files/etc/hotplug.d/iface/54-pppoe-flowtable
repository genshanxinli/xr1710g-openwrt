#!/bin/sh
# Keep the PPPoE l3_device registered in fw4's inet flowtable after 20-firewall reloads.

[ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ] || exit 0
[ "$INTERFACE" = "${PF_IFACE:-wan}" ] || exit 0

[ -r /etc/hotplug.d/firewall/54-pppoe-flowtable ] && sh /etc/hotplug.d/firewall/54-pppoe-flowtable

exit 0
