#!/bin/sh
# Reload fw4 once br-lan membership settles at boot, plus one conditional DFS recheck.

[ "$ACTION" = ifup ] || exit 0
[ "$INTERFACE" = lan ] || exit 0

BRIDGE="${BR_HW_BRIDGE:-br-lan}"
SYS_NET="${BR_HW_SYS_NET:-/sys/class/net}"
SETTLE_TIMEOUT="${BR_HW_SETTLE_TIMEOUT:-120}"
SETTLE_INTERVAL="${BR_HW_SETTLE_INTERVAL:-5}"
SETTLE_STABLE="${BR_HW_SETTLE_STABLE:-3}"
RECHECK_DELAY="${RECHECK_DELAY:-40}"
LOCK_FILE="${BRIDGE_HW_OFFLOAD_LOCK:-/var/run/xr1710g-locks/bridge-hw-offload.lock}"
DIRTY_FILE="${LOCK_FILE}.dirty"
SETTLE_LOCK="${LOCK_FILE}.settle"

[ -d "${SYS_NET}/${BRIDGE}/bridge" ] || exit 0
LOCK_DIR="${LOCK_FILE%/*}"
if [ "$LOCK_DIR" != "$LOCK_FILE" ] && [ -n "$LOCK_DIR" ]; then
	while [ "$LOCK_DIR" != "/" ]; do
		case "$LOCK_DIR" in
		*/) LOCK_DIR="${LOCK_DIR%/}" ;;
		*) break ;;
		esac
	done
	[ -L "$LOCK_DIR" ] && exit 1
	mkdir -p -m 0700 "$LOCK_DIR" 2>/dev/null || exit 1
	[ -L "$LOCK_DIR" ] && exit 1
	[ -d "$LOCK_DIR" ] || exit 1
	chmod 0700 "$LOCK_DIR" 2>/dev/null || exit 1
fi
if [ -L "$LOCK_FILE" ] || [ -L "$DIRTY_FILE" ] || [ -L "$SETTLE_LOCK" ]; then
	exit 1
fi

list_brif() {
	_out=""
	for _p in "${SYS_NET}/${BRIDGE}/brif"/*; do
		[ -e "$_p" ] || [ -L "$_p" ] || continue
		_out="${_out}${_out:+ }${_p##*/}"
	done
	printf '%s' "$_out"
}

run_reload() {
	_waits=0
	exec 9>"$LOCK_FILE"
	while ! flock -n 9; do
		[ "$_waits" -lt 10 ] || {
			: > "$DIRTY_FILE"
			exec 9>&-
			logger -t bridge-hw-offload "reload already in progress, giving up"
			return 0
		}
		_waits=$((_waits + 1))
		sleep 1
	done
	: > "$DIRTY_FILE"
	while :; do
		while [ -e "$DIRTY_FILE" ]; do
			rm -f "$DIRTY_FILE"
			/etc/init.d/firewall reload 8>&- 9>&- >/dev/null 2>&1
		done
		flock -u 9
		[ -e "$DIRTY_FILE" ] || break
		flock -n 9 || break
	done
	exec 9>&-
}

(
	exec 8>"$SETTLE_LOCK"
	flock -n 8 || exit 0

	seen=""; prev=""; stable=0; waited=0
	while [ "$waited" -lt "$SETTLE_TIMEOUT" ]; do
		cur=$(list_brif)
		[ -n "$cur" ] && seen=1
		if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
			stable=$((stable + 1))
			[ "$stable" -ge "$SETTLE_STABLE" ] && break
		else
			stable=0
		fi
		prev="$cur"
		sleep "$SETTLE_INTERVAL"
		waited=$((waited + SETTLE_INTERVAL))
	done
	if [ -z "$seen" ]; then
		logger -t bridge-hw-offload "no bridge ports seen, skipping reload"
		exit 0
	fi
	run_reload

	sleep "$RECHECK_DELAY"
	now=$(list_brif)
	[ "$now" = "$prev" ] && exit 0
	logger -t bridge-hw-offload "bridge members changed, reloading again"
	run_reload
) </dev/null >/dev/null 2>&1 &

exit 0
