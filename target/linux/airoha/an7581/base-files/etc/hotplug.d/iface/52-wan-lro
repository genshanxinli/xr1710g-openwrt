#!/bin/sh

# Hardware LRO is compiled in but it is not part of the default feature set
# (netdev->hw_features carries NETIF_F_LRO, netdev->features does not), so
# out of the box every device runs with plain GRO. On this SoC LRO is worth
# the trouble: the driver pads the RX rings used by LRO to order-2 pages and
# aggregates TCP streams in the CDM block, and the vendor measured ~2.7 Gbps
# with GRO against ~8.2 Gbps with LRO on a 10G link.
#
# Enable it on the WAN device when it comes up, and turn it off again when it
# goes down so the aggregation state does not outlive the interface.
#
# Do not add any LAN port to this script.  Two independent reasons, and the
# first one alone is enough:
#
#   1. A LAN port is a bridge member, and no bridge member may carry LRO.
#      NETIF_F_UPPER_DISABLES is NETIF_F_LRO (include/linux/netdev_features.h)
#      and netdev_sync_upper_features() clears it off the lower device when the
#      upper has it off.  br-lan builds its feature set from COMMON_FEATURES
#      (net/bridge/br_device.c), which has no NETIF_F_LRO, so br-lan can never
#      pass LRO down.  ethtool -K lan2 rx-lro on fails while lan2 is enslaved
#      and the feature appears again the moment it is released.  Verified on
#      hardware: 2026-10-21, docs/community-onhardware-2026-10-21b.md section 2.4.
#
#   2. If a port is taken out of the bridge to get around point 1, it then
#      really does share QDMA0 with the DSA conduit (airoha_dev_set_qdma()
#      picks "QDMA0 for lan ports, QDMA1 for WAN ports"), and the LRO block
#      aggregates per QDMA rather than per port.  Once two ingress ports feed
#      one aggregation, the metadata the aggregate carries - source GDM, L2
#      length, DSA tag - belongs to whichever packet arrived first, and the
#      driver cannot recover the real ingress.  That is the failure the
#      community hit when patch 994 removed the "-EBUSY while a QDMA is
#      shared" guard, and patches 195/198 here remove that same guard, so
#      nothing in the driver stops this any more.
#
# So point 1 is why LAN LRO simply does not work today; point 2 is why "just
# pull the port out of the bridge" is not the fix either.  WAN (GDM2) is not a
# bridge member and sits on its own QDMA, which is the only combination that
# works - hence this script touches WAN and nothing else.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifdown ] || exit 0
[ "$INTERFACE" = wan ] || exit 0

# ethtool-full is only pulled in by some devices; without it the -k query
# below matches nothing and the -K call fails silently, which looks exactly
# like "LRO is fixed off". Say so instead of failing quietly.
command -v ethtool >/dev/null || {
	logger -t wan-lro "ethtool not installed, leaving LRO alone on $INTERFACE"
	exit 0
}

# LRO lives on the physical netdev, not on the stacked one.  When the WAN is
# PPPoE, netifd reports $DEVICE=pppoe-wan and l3_device is pppoe-wan too; a
# virtual device has no LRO knob ("large-receive-offload: off [fixed]"), so
# ethtool fails and nothing is applied.  Ask netifd for the underlying device
# instead of trusting $DEVICE: status reports @.device as main_dev (the
# physical port) and only @.l3_device as the PPP interface.
#
# The fallback is not DHCP-only.  netifd sets DEVICE only for ifup and
# ifupdate (interface-event.c: device = current->l3_dev.dev->ifname under
# `current_ev == IFEV_UP || current_ev == IFEV_UPDATE`), so on ifdown it is
# unset for every proto - and by then interface.c has already released
# main_dev, so @.device is gone from the status reply too.  Without the
# fallback the LRO state would outlive the interface.
DEV="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)"
[ -n "$DEV" ] || DEV="${DEVICE:-wan}"

# A stacked device would silently accept the ioctl and change nothing, so
# refuse anything whose LRO is fixed rather than pretending it worked.
case "$(ethtool -k "$DEV" 2>/dev/null)" in
	*"large-receive-offload: off [fixed]"*)
		logger -t wan-lro "refusing to touch $DEV: LRO is fixed off"
		exit 0
		;;
esac

case "$ACTION" in
	ifup)
		ethtool -K "$DEV" rx-lro on >/dev/null 2>&1 &&
			logger -t wan-lro "LRO enabled on $DEV"
		;;
	ifdown)
		ethtool -K "$DEV" rx-lro off >/dev/null 2>&1
		;;
esac

exit 0
