#!/bin/sh

# Hardware LRO is compiled in but it is not part of the default feature set
# (netdev->hw_features carries NETIF_F_LRO, netdev->features does not), so
# out of the box every device runs with plain GRO. On this SoC LRO is worth
# the trouble: the driver pads the RX rings used by LRO to order-2 pages and
# aggregates TCP streams in the CDM block, and the vendor measured ~2.7 Gbps
# with GRO against ~8.2 Gbps with LRO on a 10G link.
#
# Enable it on the WAN device when it comes up, and turn it off again when it
# goes down so the aggregation state does not outlive the interface.
#
# Do not add lan2 to this script.  The LRO block aggregates per QDMA, not per
# port: qdma is chosen by "QDMA0 for lan ports, QDMA1 for WAN ports"
# (airoha_dev_set_qdma()), so lan2 and the DSA conduit share one LRO engine.
# Once two ingress ports feed one aggregation, the metadata the aggregate
# carries - source GDM, L2 length, DSA tag - belongs to whichever packet
# arrived first, and the driver cannot recover the real ingress.  The
# community saw exactly that and withdrew the "enable LRO by default" patch
# (994) that removed the "-EBUSY while a QDMA is shared" guard; patches 195
# and 198 here deliberately removed that same guard, so the guard no longer
# protects us.  What protects us today is this script: WAN (GDM2) really does
# sit on its own QDMA.  Test with lan2 first (ethtool -K lan2 rx-lro on plus
# two simultaneous flows) before widening this.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifdown ] || exit 0
[ "$INTERFACE" = wan ] || exit 0

# LRO lives on the physical netdev, not on the stacked one.  When the WAN is
# PPPoE, netifd reports $DEVICE=pppoe-wan and l3_device is pppoe-wan too; a
# virtual device has no LRO knob ("large-receive-offload: off [fixed]"), so
# ethtool fails and nothing is applied.  Ask netifd for the underlying device
# instead of trusting $DEVICE: status reports @.device as main_dev (the
# physical port) and only @.l3_device as the PPP interface.
#
# The fallback is not DHCP-only.  netifd sets DEVICE only for ifup and
# ifupdate (interface-event.c: device = current->l3_dev.dev->ifname under
# `current_ev == IFEV_UP || current_ev == IFEV_UPDATE`), so on ifdown it is
# unset for every proto - and by then interface.c has already released
# main_dev, so @.device is gone from the status reply too.  Without the
# fallback the LRO state would outlive the interface.
DEV="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)"
[ -n "$DEV" ] || DEV="${DEVICE:-wan}"

# A stacked device would silently accept the ioctl and change nothing, so
# refuse anything whose LRO is fixed rather than pretending it worked.
case "$(ethtool -k "$DEV" 2>/dev/null)" in
	*"large-receive-offload: off [fixed]"*)
		logger -t wan-lro "refusing to touch $DEV: LRO is fixed off"
		exit 0
		;;
esac

case "$ACTION" in
	ifup)
		ethtool -K "$DEV" rx-lro on >/dev/null 2>&1 &&
			logger -t wan-lro "LRO enabled on $DEV"
		;;
	ifdown)
		ethtool -K "$DEV" rx-lro off >/dev/null 2>&1
		;;
esac

exit 0
