#!/bin/sh
# Apply one-time XR1710G MT7996 wireless defaults after 10-wifi-detect populates UCI.

[ "$ACTION" = "add" ] || exit 0
WIRELESS_CFG="${WIRELESS_CONFIG:-${IPKG_INSTROOT:-}/etc/config/wireless}"
[ -f "$WIRELESS_CFG" ] && chmod 600 "$WIRELESS_CFG"
# shellcheck disable=SC1090,SC1091
. "${IPKG_INSTROOT:-}/lib/functions.sh"
[ "$(board_name)" = "gemtek,xr1710g-ubi" ] || exit 0
[ -s "$WIRELESS_CFG" ] || exit 0
[ "$(uci -q get wireless.radio0._xr1710g_tuned)" = "1" ] && exit 0

LOCK_FILE="${XR1710G_WIFI_LOCK:-/var/run/xr1710g-locks/xr1710g-wifi-defaults.lock}"
LOCK_DIR="${LOCK_FILE%/*}"
if [ "$LOCK_DIR" != "$LOCK_FILE" ] && [ -n "$LOCK_DIR" ]; then
	while [ "$LOCK_DIR" != "/" ]; do
		case "$LOCK_DIR" in
		*/) LOCK_DIR="${LOCK_DIR%/}" ;;
		*) break ;;
		esac
	done
	[ -L "$LOCK_DIR" ] && exit 1
	mkdir -p -m 0700 "$LOCK_DIR" 2>/dev/null || exit 1
	[ -L "$LOCK_DIR" ] && exit 1
	[ -d "$LOCK_DIR" ] || exit 1
	chmod 0700 "$LOCK_DIR" 2>/dev/null || exit 1
fi
[ -L "$LOCK_FILE" ] && exit 1

set_from() {
	_sf_sec="$1"; _sf_opt="$2"; _sf_val="$3"; _sf_match=0
	shift 3
	_sf_cur="$(uci -q get "wireless.$_sf_sec.$_sf_opt")"
	[ "$_sf_cur" = "$_sf_val" ] && return 0
	[ -z "$_sf_cur" ] && _sf_match=1
	for _sf_s in "$@"; do
		[ "$_sf_cur" = "$_sf_s" ] && _sf_match=1
	done
	[ "$_sf_match" -eq 1 ] || return 0
	uci -q set "wireless.$_sf_sec.$_sf_opt=$_sf_val"
	changed=1
}

(
	exec 9>"$LOCK_FILE"
	waits=0
	while ! flock -n 9; do
		[ "$waits" -lt 15 ] || exit 0
		waits=$((waits + 1))
		sleep 1
	done

	[ "$(uci -q get wireless.radio0._xr1710g_tuned)" = "1" ] && exit 0
	[ "$(uci -q get wireless.radio0.band)" = "2g" ] || exit 0
	[ "$(uci -q get wireless.radio1.band)" = "5g" ] || exit 0
	[ "$(uci -q get wireless.radio2.band)" = "6g" ] || exit 0

	changed=0
	set_from radio0 channel 6 1 auto
	set_from radio0 he_mu_beamformer 0
	set_from radio0 he_bss_color 37 128

	if [ "$(uci -q get wireless.radio1.xr1710g_5g160)" = "1" ]; then
		set_from radio1 channel 36 auto
		case "$(uci -q get wireless.radio1.channel)" in
		36|40|44|48|52|56|60|64)
			case "$(uci -q get wireless.radio1.htmode)" in
			EHT160|HE160|VHT160) ;;
			*) uci -q set wireless.radio1.htmode=EHT160; changed=1 ;;
			esac
			;;
		esac
	else
		set_from radio1 channel 149 36 auto
		case "$(uci -q get wireless.radio1.channel)" in
		149|153|157|161|165) set_from radio1 htmode EHT80 EHT160 ;;
		esac
	fi
	set_from radio1 he_bss_color 38 128

	set_from radio2 channel 37 auto 1
	set_from radio2 htmode EHT320 EHT80
	set_from radio2 he_bss_color 39 128

	for r in radio0 radio1 radio2; do
		uci -q get "wireless.default_$r" >/dev/null || continue
		set_from "default_$r" disassoc_low_ack 0
		set_from "default_$r" uapsd 0
		set_from "default_$r" max_inactivity 86400
		set_from "default_$r" ieee80211k 1
		set_from "default_$r" bss_transition 1
	done

	# shellcheck disable=SC2018,SC2019
	c1="$(uci -q get wireless.radio1.country | tr 'a-z' 'A-Z')"
	# shellcheck disable=SC2018,SC2019
	c2="$(uci -q get wireless.radio2.country | tr 'a-z' 'A-Z')"
	case "$c1:$c2" in
	[A-Z][A-Z]:[A-Z][A-Z])
		[ "$c1" = "$c2" ] || logger -t xr1710g-wifi "radio1/radio2 country mismatch ($c1 vs $c2); MT7996 shares one regdomain"
		;;
	esac

	uci -q set wireless.radio0._xr1710g_tuned='1'
	uci -q commit wireless
	[ -f "$WIRELESS_CFG" ] && chmod 600 "$WIRELESS_CFG"
	exec 9>&-
	if [ "$changed" -eq 1 ] && command -v ubus >/dev/null 2>&1; then
		ubus -t 5 call network reload >/dev/null 2>&1 || true
		ubus -t 5 call network.wireless retry >/dev/null 2>&1 || true
	fi
)

exit 0
