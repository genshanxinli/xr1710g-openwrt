#!/bin/sh
#
# Reload the firewall once br-lan's member set has settled.
#
# This is the *member* half of the bridge offload setup, so it lives where
# member changes are reported: /etc/hotplug.d/net fires an "add"/"remove"
# for every netdevice that appears or disappears, including a wlan vif
# joining the bridge long after lan came up.
#
# /etc/hotplug.json has no "eq SUBSYSTEM net" rule, but its last rule is an
# "if" whose fourth element -- the else branch, libubox json_script.c
# handle_if() -- tests isdir(/etc/hotplug.d/net) and execs
# /sbin/hotplug-call on a match.  Verified on hardware with a probe script,
# and by deleting the else branch and watching the probes stop.

BRIDGE="${BR_HW_BRIDGE:-br-lan}"
SYS_NET="${BR_HW_SYS_NET:-/sys/class/net}"
# The lock is shared with hotplug.d/iface/51-bridge-hw-offload, so the live
# default has to stay on /var/lock.  BRIDGE_HW_OFFLOAD_LOCK is a test hook that
# lets scripts/tests/test_bridge_hw_offload_lock.py run on hosts whose
# /var/lock is read-only; nothing in the image sets it.
LOCK_FILE="${BRIDGE_HW_OFFLOAD_LOCK:-/var/lock/bridge-hw-offload.lock}"

case "$ACTION" in
	add|remove) ;;
	*) exit 0 ;;
esac
[ -n "$DEVICENAME" ] || exit 0
case "$DEVICENAME" in
	lo|"$BRIDGE") exit 0 ;;
esac

if [ -L "${SYS_NET}/${DEVICENAME}/master" ] || [ -e "${SYS_NET}/${DEVICENAME}/master" ]; then
	master=$(readlink "${SYS_NET}/${DEVICENAME}/master" 2>/dev/null)
	[ "${master##*/}" = "$BRIDGE" ] || exit 0
fi

[ "${LOCK_FILE%/*}" != "$LOCK_FILE" ] && [ -n "${LOCK_FILE%/*}" ] && mkdir -p "${LOCK_FILE%/*}" 2>/dev/null

(
	exec 9>"$LOCK_FILE"
	# The lock serialises reloads, it does not mean "drop the second caller".
	# A member arriving while the boot-time settle loop in
	# hotplug.d/iface/51 still runs must queue up, not be silently ignored.
	#
	# The wait must therefore outlive that loop, which holds the lock for the
	# whole settle window: BR_HW_SETTLE_TIMEOUT (120 s) plus RECHECK_DELAY
	# (40 s) is 160 s, so 200 s.  With the original 10 s every member change
	# that overlapped the settle loop was dropped instead of queued --
	# measured on r38047 as 54 consecutive "giving up" lines in logread and
	# 0 successful reloads, which is how the live flowtables kept a device
	# list from before the wlan vifs were re-created.  scripts/tests/
	# test_bridge_hw_offload_lock.py keeps the two numbers consistent.
	#
	# The bound is a retry loop on "flock -n", not a timed wait.  busybox's flock
	# is the only flock a stock image has (/usr/bin/flock -> ../../bin/busybox)
	# and it takes [-sxun] FD and nothing else, so the old "-w 200 9" was an
	# unknown option: it exited 1, and every member change took the give-up
	# branch while still looking bounded in the source.  Two hundred one-second
	# attempts keep the same 200 s ceiling and work on busybox and util-linux.
	waits=0
	while ! flock -n 9; do
		[ "$waits" -lt 200 ] || {
			logger -t bridge-hw-offload "reload still running after 200 s, giving up"
			exit 0
		}
		waits=$((waits + 1))
		sleep 1
	done
	sleep 3
	BR_HW_RELOAD="${BR_HW_RELOAD:-/etc/init.d/firewall reload}"
	# Unquoted on purpose: the default is two words, and the test harness
	# substitutes its own command through this variable.
	$BR_HW_RELOAD >/dev/null 2>&1
) &

exit 0
