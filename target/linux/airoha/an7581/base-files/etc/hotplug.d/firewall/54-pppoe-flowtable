#!/bin/sh
# Keep the active PPPoE l3_device registered in fw4's inet flowtable after any firewall reload.

case "${ACTION:-}" in
""|includes|reload|start|restart|ifup|ifupdate) ;;
*) exit 0 ;;
esac

valid_netdev() {
	case "$1" in
	""|.|..|-*|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-]*)
		return 1
		;;
	esac
	[ "${#1}" -le 15 ] || return 1
	return 0
}

IFACE="${PF_IFACE:-wan}"
valid_netdev "$IFACE" || {
	logger -t pppoe-flowtable "invalid interface name, leaving the flowtable alone"
	exit 0
}

command -v nft >/dev/null || {
	logger -t pppoe-flowtable "nft not installed, cannot touch the flowtable"
	exit 0
}
command -v jsonfilter >/dev/null || {
	logger -t pppoe-flowtable "jsonfilter not installed, cannot read the netifd status"
	exit 0
}

SYS_NET="${PF_SYS_NET:-/sys/class/net}"

STATUS="$(ubus -t 5 call "network.interface.$IFACE" status 2>/dev/null)"
PROTO="$(printf '%s\n' "$STATUS" | jsonfilter -e '@.proto' 2>/dev/null)"
[ "$PROTO" = pppoe ] || exit 0
UP="$(printf '%s\n' "$STATUS" | jsonfilter -e '@.up' 2>/dev/null)"
[ "$UP" = false ] && exit 0

DEV="$(printf '%s\n' "$STATUS" | jsonfilter -e '@.l3_device' 2>/dev/null)"
if [ -z "$DEV" ]; then
	if [ -d "$SYS_NET/pppoe-$IFACE" ]; then
		DEV="pppoe-$IFACE"
	else
		for d in "$SYS_NET"/pppoe-* "$SYS_NET"/ppp[0-9]*; do
			[ -d "$d" ] || continue
			DEV="${d##*/}"
			break
		done
	fi
fi
[ -n "$DEV" ] || {
	logger -t pppoe-flowtable "no PPP netdev found, leaving the flowtable alone"
	exit 0
}
valid_netdev "$DEV" || {
	logger -t pppoe-flowtable "invalid netdev name, leaving the flowtable alone"
	exit 0
}
[ -d "$SYS_NET/$DEV" ] || {
	logger -t pppoe-flowtable "$DEV does not exist, leaving the flowtable alone"
	exit 0
}

LOCK_DIR="${PF_LOCK_DIR:-/var/run/xr1710g-locks}"
while [ "$LOCK_DIR" != "/" ]; do
	case "$LOCK_DIR" in
	*/) LOCK_DIR="${LOCK_DIR%/}" ;;
	*) break ;;
	esac
done
[ -L "$LOCK_DIR" ] && exit 1
mkdir -p -m 0700 "$LOCK_DIR" 2>/dev/null || exit 1
[ -L "$LOCK_DIR" ] && exit 1
[ -d "$LOCK_DIR" ] || exit 1
chmod 0700 "$LOCK_DIR" 2>/dev/null || exit 1
LOCK_FILE="$LOCK_DIR/pppoe-flowtable.lock"
[ -L "$LOCK_FILE" ] && exit 1

(
	exec 9>"$LOCK_FILE"
	waits=0
	while ! flock -n 9; do
		[ "$waits" -lt 10 ] || {
			logger -t pppoe-flowtable "another flowtable change is in progress, giving up"
			exit 0
		}
		waits=$((waits + 1))
		sleep 1
	done

	LIST="$(nft list flowtable inet fw4 ft 2>/dev/null)" || {
		logger -t pppoe-flowtable "fw4 has no inet flowtable ft, nothing to add"
		exit 0
	}

	if printf '%s\n' "$LIST" | awk -v dev="$DEV" '
		/devices[ \t]*=[ \t]*\{/ {
			in_devs = 1
			sub(/.*devices[ \t]*=[ \t]*\{/, "")
		}
		in_devs {
			line = $0
			if (index(line, "}")) {
				sub(/\}.*/, "", line)
				in_devs = 0
			}
			n = split(line, parts, /[ ,\t]+/)
			for (i = 1; i <= n; i++) {
				t = parts[i]
				gsub(/^"|"$/, "", t)
				if (t == dev) found = 1
			}
		}
		END { exit(found ? 0 : 1) }
	'; then
		exit 0
	fi

	FLAGS=""
	case "$LIST" in
	*"flags offload"*) FLAGS="flags offload;" ;;
	esac

	if nft add flowtable inet fw4 ft \
		"{ hook ingress priority 0; devices = { \"$DEV\" }; $FLAGS }" >/dev/null 2>&1; then
		logger -t pppoe-flowtable "added $DEV to flowtable ft"
	else
		logger -t pppoe-flowtable "could not add $DEV to flowtable ft"
	fi
)

exit 0
