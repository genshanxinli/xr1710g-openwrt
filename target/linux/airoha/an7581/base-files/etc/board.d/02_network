. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

an7581_setup_interfaces()
{
	local board="$1"

	case "$board" in
	airoha,an7581-evb)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "eth1"
		;;
	gemtek,w1700k-ubi)
		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"
		;;
	gemtek,xr1710g-ubi)
		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"

		# This is a US-market device (sold by Brightspeed) and 6 GHz is not
		# usable without a real country code: /lib/wifi/mac80211.uc seeds
		# an unprovisioned radio with the placeholder '00', which hostapd
		# rejects outright. Board defaults are the intended mechanism for
		# this (board.json wlan.defaults.country), and they are also what
		# the 6 GHz radio needs in order to come up out of the box.
		ucidef_set_country "US"
		;;
	nokia,valyrian)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 10g" "wan"
		;;
	nokia,xg-040g-md |\
	nokia,xg-040g-md-ubi)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	quantum,q1000k-ubi)
		# Both copper ports are LAN; the upstream connection is PON.
		ucidef_set_interface_lan "lan1 lan2"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
an7581_setup_interfaces $board
board_config_flush

exit 0
