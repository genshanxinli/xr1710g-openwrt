#!/bin/sh /etc/rc.common

# Pin QDMA bank0 IRQs to dedicated CPUs and spread remaining QDMA/Wi-Fi/NPU IRQs.
START=39

QDMA_IRQ_NAME="${QDMA_IRQ_NAME:-airoha_eth}"
OTHER_IRQ_NAMES="${OTHER_IRQ_NAMES:-mt76-npu mt7996e-hif mt7996e}"
LOG_TAG="qdma-irq-affinity"

log() {
	logger -t "$LOG_TAG" "$@" 2>/dev/null
}

online_cpu_list() {
	tr ',' ' ' < /sys/devices/system/cpu/online 2>/dev/null | \
	tr ' ' '\n' | \
	while read -r range; do
		case "$range" in
		*-*)
			start=${range%-*}
			end=${range#*-}
			while [ "$start" -le "$end" ]; do
				echo "$start"
				start=$((start + 1))
			done
			;;
		'') ;;
		*) echo "$range" ;;
		esac
	done
}

qdma_bank0() {
	local idx="$1"

	case "$idx" in
	''|*[!0-9]*) return 1 ;;
	esac

	[ $((idx % 4)) -eq 0 ] || return 1
	echo $((idx / 4))
}

msi_function() {
	local dir

	for dir in /sys/bus/pci/devices/*/msi_irqs; do
		[ -e "$dir/$1" ] && { echo "${dir%/msi_irqs}"; return 0; }
	done
	return 1
}

unmovable_msi_functions() {
	local dir irq cur

	for dir in /sys/bus/pci/devices/*/msi_irqs; do
		[ -d "$dir" ] || continue
		for irq in "$dir"/*; do
			break
		done
		irq=${irq##*/}
		[ -e "/proc/irq/$irq" ] || continue
		cur=$(cat "/proc/irq/$irq/smp_affinity" 2>/dev/null)
		echo "$cur" > "/proc/irq/$irq/smp_affinity" 2>/dev/null || \
			echo "${dir%/msi_irqs}"
	done
}

norm_mask() {
	local m

	m=$(printf '%s' "$1" | tr -d ' \t\r\n,' | tr 'A-F' 'a-f')
	while [ "${#m}" -gt 1 ]; do
		case "$m" in
		0*) m=${m#0} ;;
		*) break ;;
		esac
	done
	printf '%s' "$m"
}

pin_irq() {
	local irq="$1" cpu="$2" mask want cur dev err

	mask=$(printf '%08x' "$((1 << cpu))")
	want=$(printf '%x' "$((1 << cpu))")
	cur=$(cat "/proc/irq/$irq/smp_affinity" 2>/dev/null)
	[ "$(norm_mask "$cur")" = "$want" ] && return 0

	dev=$(msi_function "$irq") || dev=""
	if [ -n "$dev" ]; then
		case " $NO_AFFINITY_MSI " in
		*" $dev "*)
			log "irq $irq: skipped, MSI domain of ${dev##*/} has no affinity support"
			return 0
			;;
		esac
	fi

	if err=$(echo "$mask" 2>&1 > "/proc/irq/$irq/smp_affinity"); then
		log "irq $irq pinned to cpu$cpu"
		return 0
	fi

	log "irq $irq: smp_affinity write to $mask rejected${err:+ ($err)}; leaving default"
	return 0
}

matching_irqs() {
	awk -v qdma="$QDMA_IRQ_NAME" -v others="$OTHER_IRQ_NAMES" '
		BEGIN {
			n = split(others, o, " ")
			cand[1] = qdma
			for (i = 1; i <= n; i++)
				cand[i + 1] = o[i]
			ncand = n + 1
		}
		/^[ \t]*[0-9]+:/ {
			line = tolower($0)
			name = ""
			p = 0
			for (i = 1; i <= ncand; i++) {
				pos = index(line, tolower(cand[i]))
				if (!pos)
					continue
				if (length(cand[i]) > length(name)) {
					name = cand[i]
					p = pos
				}
			}
			if (name == "")
				next

			p += length(name)
			suffix = ""
			while (p <= length(line)) {
				c = substr(line, p, 1)
				if (c !~ /[0-9.]/)
					break
				suffix = suffix c
				p++
			}

			irq = $0
			sub(/:.*/, "", irq)
			gsub(/[ \t]/, "", irq)
			print irq, name, suffix
		}
	' /proc/interrupts 2>/dev/null
}

cpu_at() {
	echo "$CPU_LIST" | cut -d' ' -f$(($1 + 1))
}

main() {
	local ncpu irq name suffix qdma cpu extra=0 first_shared=2 spare slot irqs

	CPU_LIST=$(online_cpu_list | tr '\n' ' ')
	ncpu=$(echo "$CPU_LIST" | wc -w)
	[ "$ncpu" -gt 0 ] || return 0
	[ "$ncpu" -lt "$first_shared" ] && first_shared=$ncpu

	NO_AFFINITY_MSI="$(unmovable_msi_functions | tr '\n' ' ')"
	irqs="$(matching_irqs 2>/dev/null)" || return 0
	[ -n "$irqs" ] || return 0

	echo "$irqs" | while read -r irq name suffix; do
		[ "$name" = "$QDMA_IRQ_NAME" ] || continue
		qdma=$(qdma_bank0 "${suffix#.}")
		[ -n "$qdma" ] || continue
		[ "$qdma" -lt "$first_shared" ] || continue
		pin_irq "$irq" "$(cpu_at "$qdma")"
	done

	spare=$((ncpu - first_shared))
	[ "$spare" -gt 0 ] || spare=$ncpu
	echo "$irqs" | while read -r irq name suffix; do
		if [ "$name" = "$QDMA_IRQ_NAME" ]; then
			qdma=$(qdma_bank0 "${suffix#.}")
			[ -n "$qdma" ] && [ "$qdma" -lt "$first_shared" ] && continue
		fi
		slot=$extra
		[ "$((ncpu - first_shared))" -gt 0 ] && slot=$((first_shared + extra % spare))
		cpu=$(cpu_at $((slot % ncpu)))
		pin_irq "$irq" "$cpu"
		extra=$((extra + 1))
	done
}

start() {
	main
}
