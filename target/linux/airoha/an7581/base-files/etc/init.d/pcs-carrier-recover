#!/bin/sh /etc/rc.common

# Bounce lan2 on XR1710G if AN7581 PCS RX calibration fails and leaves carrier down.
START=95
STOP=10

PCS_DEV="${PCS_DEV:-lan2}"
PCS_LOG_PATTERN="${PCS_LOG_PATTERN:-FreqDet module after 50 calibration try}"
PCS_DELAY="${PCS_DELAY:-180}"
PCS_DOWN_SECS="${PCS_DOWN_SECS:-3}"
PCS_UP_SECS="${PCS_UP_SECS:-12}"
PCS_MAX_ATTEMPTS="${PCS_MAX_ATTEMPTS:-2}"
PCS_SYS_NET="${PCS_SYS_NET:-/sys/class/net}"
PCS_PROC_DIR="${PCS_PROC_DIR:-/proc}"
LOG_TAG="pcs-carrier-recover"
PIDFILE="${PCS_PIDFILE:-/var/run/${LOG_TAG}.pid}"
LOCKFILE="${PCS_LOCKFILE:-/var/run/xr1710g-locks/${LOG_TAG}.lock}"
SLEEP_PID=""
PORT_DOWN=0

log() {
	logger -t "$LOG_TAG" "$@"
}

sleep_interruptible() {
	[ "${1:-0}" -gt 0 ] || return 0
	sleep "$1" &
	SLEEP_PID=$!
	wait "$SLEEP_PID" 2>/dev/null
	SLEEP_PID=""
}

saw_calib_failure() {
	dmesg 2>/dev/null | grep -q "$PCS_LOG_PATTERN"
}

has_carrier() {
	[ -r "$PCS_SYS_NET/$PCS_DEV/carrier" ] || return 0
	[ "$(cat "$PCS_SYS_NET/$PCS_DEV/carrier" 2>/dev/null)" = "1" ]
}

recover() {
	log "$PCS_DEV: carrier down with PCS calibration failure, bouncing it"
	PORT_DOWN=1
	ip link set dev "$PCS_DEV" down 2>/dev/null
	sleep_interruptible "$PCS_DOWN_SECS"
	ip link set dev "$PCS_DEV" up 2>/dev/null
	PORT_DOWN=0
	sleep_interruptible "$PCS_UP_SECS"
}

main() {
	local attempt=0

	[ -d "$PCS_SYS_NET/$PCS_DEV" ] || return 0

	while [ "$attempt" -lt "$PCS_MAX_ATTEMPTS" ]; do
		saw_calib_failure || return 0
		has_carrier && return 0

		recover
		attempt=$((attempt + 1))

		has_carrier && {
			log "$PCS_DEV: carrier restored after $attempt attempt(s)"
			return 0
		}
	done

	log "$PCS_DEV: carrier still down after $attempt attempt(s)"
	return 0
}

pid_is_recover() {
	local pid="$1" cmd

	case "$pid" in
	''|*[!0-9]*|0*|1) return 1 ;;
	esac
	[ "$pid" = "$$" ] && return 1
	kill -0 "$pid" 2>/dev/null || return 1
	[ -r "$PCS_PROC_DIR/self/cmdline" ] || return 1
	[ -r "$PCS_PROC_DIR/$pid/cmdline" ] || return 1
	cmd=$(tr '\000' ' ' < "$PCS_PROC_DIR/$pid/cmdline" 2>/dev/null)
	case "$cmd" in
	*" stop"*) return 1 ;;
	*rc.common*"$LOG_TAG"*) return 0 ;;
	*) return 1 ;;
	esac
}

acquire_lock() {
	local waits=0 lock_dir

	case "$LOCKFILE" in
	*/*)
		lock_dir="${LOCKFILE%/*}"
		if [ -n "$lock_dir" ]; then
			while [ "$lock_dir" != "/" ]; do
				case "$lock_dir" in
				*/) lock_dir="${lock_dir%/}" ;;
				*) break ;;
				esac
			done
			[ -L "$lock_dir" ] && return 2
			mkdir -p -m 0700 "$lock_dir" 2>/dev/null || return 2
			[ -L "$lock_dir" ] && return 2
			[ -d "$lock_dir" ] || return 2
			chmod 0700 "$lock_dir" 2>/dev/null || return 2
		fi
		;;
	esac
	[ -L "$LOCKFILE" ] && return 2
	exec 9>"$LOCKFILE"
	while ! flock -n 9; do
		[ "$waits" -lt 10 ] || return 1
		waits=$((waits + 1))
		sleep 1
	done
	return 0
}

start() {
	case "$(board_name)" in
	gemtek,xr1710g-ubi) ;;
	*) return 0 ;;
	esac

	(
		acquire_lock
		lock_rc=$?
		[ "$lock_rc" -eq 0 ] || { [ "$lock_rc" -eq 2 ] && exit 1; exit 0; }
		pid="$(cat "$PIDFILE" 2>/dev/null)"
		if pid_is_recover "$pid"; then
			exit 0
		fi

		case "$PIDFILE" in
		*/*) mkdir -p "${PIDFILE%/*}" 2>/dev/null ;;
		esac
		(
			WORKER_PID=$(exec sh -c 'echo "$PPID"')
			cleaned=0
			cleanup_worker() {
				[ "$cleaned" -eq 0 ] || return 0
				cleaned=1
				[ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null
				if [ "${PORT_DOWN:-0}" -eq 1 ]; then
					ip link set dev "$PCS_DEV" up 2>/dev/null || true
				fi
				if [ -f "$PIDFILE" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" = "$WORKER_PID" ]; then
					rm -f "$PIDFILE"
				fi
			}
			trap 'cleanup_worker' EXIT
			trap 'cleanup_worker; exit 0' INT TERM HUP

			echo "$WORKER_PID" > "$PIDFILE"
			# Release start/stop lock now that PIDFILE identifies this worker.
			exec 9>&-

			sleep_interruptible "$PCS_DELAY"
			main
		) </dev/null >/dev/null 2>&1 &
	)
}

stop() {
	(
		acquire_lock
		lock_rc=$?
		[ "$lock_rc" -eq 0 ] || { [ "$lock_rc" -eq 2 ] && exit 1; exit 0; }
		pid="$(cat "$PIDFILE" 2>/dev/null)"
		tries=0
		if [ -n "$pid" ] && pid_is_recover "$pid"; then
			kill "$pid" 2>/dev/null
			while [ "$tries" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
				tries=$((tries + 1))
				sleep 1
			done
		fi
		if [ -f "$PIDFILE" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" = "$pid" ]; then
			rm -f "$PIDFILE"
		fi
	)
}
