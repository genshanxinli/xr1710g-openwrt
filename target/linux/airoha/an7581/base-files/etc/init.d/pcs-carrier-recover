#!/bin/sh /etc/rc.common

# Bounce lan2 on XR1710G if AN7581 PCS RX calibration fails and leaves carrier down.
START=95
STOP=10

PCS_DEV="${PCS_DEV:-lan2}"
PCS_LOG_PATTERN="${PCS_LOG_PATTERN:-FreqDet module after 50 calibration try}"
PCS_DELAY="${PCS_DELAY:-180}"
PCS_DOWN_SECS="${PCS_DOWN_SECS:-3}"
PCS_UP_SECS="${PCS_UP_SECS:-12}"
PCS_MAX_ATTEMPTS="${PCS_MAX_ATTEMPTS:-2}"
LOG_TAG="pcs-carrier-recover"
PIDFILE="${PCS_PIDFILE:-/var/run/${LOG_TAG}.pid}"
LOCKFILE="${PCS_LOCKFILE:-/var/lock/${LOG_TAG}.lock}"

log() {
	logger -t "$LOG_TAG" "$@"
}

saw_calib_failure() {
	dmesg 2>/dev/null | grep -q "$PCS_LOG_PATTERN"
}

has_carrier() {
	[ -r "/sys/class/net/$PCS_DEV/carrier" ] || return 0
	[ "$(cat "/sys/class/net/$PCS_DEV/carrier" 2>/dev/null)" = "1" ]
}

recover() {
	log "$PCS_DEV: carrier down with PCS calibration failure, bouncing it"
	ip link set dev "$PCS_DEV" down 2>/dev/null
	sleep "$PCS_DOWN_SECS"
	ip link set dev "$PCS_DEV" up 2>/dev/null
	sleep "$PCS_UP_SECS"
}

main() {
	local attempt=0

	[ -d "/sys/class/net/$PCS_DEV" ] || return 0

	while [ "$attempt" -lt "$PCS_MAX_ATTEMPTS" ]; do
		saw_calib_failure || return 0
		has_carrier && return 0

		recover
		attempt=$((attempt + 1))

		has_carrier && {
			log "$PCS_DEV: carrier restored after $attempt attempt(s)"
			return 0
		}
	done

	log "$PCS_DEV: carrier still down after $attempt attempt(s)"
	return 0
}

pid_is_running() {
	local pid="$1" cmd

	case "$pid" in
	''|*[!0-9]*|0*) return 1 ;;
	esac
	kill -0 "$pid" 2>/dev/null || return 1
	[ -r /proc/self/cmdline ] || return 0
	[ -r "/proc/$pid/cmdline" ] || return 1
	cmd=$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
	case "$cmd" in
	*pcs-carrier-recover*) return 0 ;;
	*) return 1 ;;
	esac
}

start() {
	case "$(board_name)" in
	gemtek,xr1710g-ubi) ;;
	*) return 0 ;;
	esac

	local pid lock_dir pid_dir

	lock_dir="${LOCKFILE%/*}"
	pid_dir="${PIDFILE%/*}"
	[ -n "$lock_dir" ] && [ "$lock_dir" != "$LOCKFILE" ] && mkdir -p "$lock_dir" 2>/dev/null
	[ -n "$pid_dir" ] && [ "$pid_dir" != "$PIDFILE" ] && mkdir -p "$pid_dir" 2>/dev/null

	exec 9>"$LOCKFILE"
	if ! flock -n 9; then
		exec 9>&-
		return 0
	fi

	if [ -f "$PIDFILE" ]; then
		pid="$(cat "$PIDFILE" 2>/dev/null)"
		if pid_is_running "$pid"; then
			exec 9>&-
			return 0
		fi
	fi

	(
		child=""
		trap '[ -n "$child" ] && kill "$child" 2>/dev/null; rm -f "$PIDFILE"; exit 0' TERM INT
		sleep "$PCS_DELAY" 9>&- &
		child="$!"
		wait "$child"
		child=""
		main 9>&-
		rm -f "$PIDFILE"
	) </dev/null >/dev/null 2>&1 &
	echo "$!" > "$PIDFILE"
	exec 9>&-
}

stop() {
	local pid tries=0

	pid="$(cat "$PIDFILE" 2>/dev/null)"
	if [ -n "$pid" ] && pid_is_running "$pid"; then
		kill "$pid" 2>/dev/null
		while [ "$tries" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
			tries=$((tries + 1))
			sleep 1
		done
	fi
	rm -f "$PIDFILE"
}
