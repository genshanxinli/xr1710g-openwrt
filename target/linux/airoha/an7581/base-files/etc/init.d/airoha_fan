#!/bin/sh /etc/rc.common

START=99

# lib/functions.sh (board_name) is already sourced by rc.common.

# NCT7802 fan curve.
#
# This used to be duplicated: this script wrote the pwm1_* sysfs attributes
# directly, while luci-app-airoha-fancontrol ships /etc/init.d/fan which
# applies the UCI curve selected in LuCI. Both ran at START=99 and wrote the
# same attributes, so whichever ran last won and a preset picked in the UI
# could be silently overwritten on boot.
#
# Now /etc/init.d/fan is authoritative whenever it is installed and this
# script is a no-op. Without the LuCI app (minimal images) the stock curve is
# applied from here, so the fan is never left unmanaged. /etc/config/fan is
# owned entirely by luci-app-airoha-fancontrol; this script does not create it.

# Stock curve: 40/50/60/70/80 degC -> PWM 54/69/95/199 (idle 770 rpm,
# 1000/1400/2700 rpm at the higher points), matching "balanced" in LuCI.
STOCK_TEMP="40000 50000 60000 70000 80000"
STOCK_PWM="54 69 95 199"

find_nct7802() {
	for hwmon in /sys/class/hwmon/hwmon*; do
		if [ -f "$hwmon/name" ] && [ "$(cat "$hwmon/name" 2>/dev/null)" = "nct7802" ]; then
			echo "$hwmon"
			return
		fi
	done
}

apply_stock_curve() {
	local hwmon="$1" i=1 temp pwm

	echo 1 > "$hwmon/pwm1_enable" 2>/dev/null

	for temp in $STOCK_TEMP; do
		echo "$temp" > "$hwmon/pwm1_auto_point${i}_temp" 2>/dev/null
		i=$((i + 1))
	done

	i=1
	for pwm in $STOCK_PWM; do
		echo "$pwm" > "$hwmon/pwm1_auto_point${i}_pwm" 2>/dev/null
		i=$((i + 1))
	done

	echo 2 > "$hwmon/pwm1_enable" 2>/dev/null
}

boot() {
	case "$(board_name)" in
	gemtek,w1700k-ubi|gemtek,xr1710g-ubi) ;;
	*) return 0 ;;
	esac

	# luci-app-airoha-fancontrol owns the hardware once installed.
	[ -x /etc/init.d/fan ] && return 0

	local hwmon
	hwmon="$(find_nct7802)"
	[ -n "$hwmon" ] || return 0

	apply_stock_curve "$hwmon"
}
