#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
# NCT7802 stock curve (defers to /etc/init.d/fan) and procd-supervised stall failsafe.

START=99
STOP=10
USE_PROCD=1

MONITOR_BIN="/usr/libexec/airoha-fan-monitor"

start_service() {
	case "$(board_name)" in
	gemtek,w1700k-ubi|gemtek,xr1710g-ubi) ;;
	*) return 0 ;;
	esac

	[ -x "$MONITOR_BIN" ] || return 0
	"$MONITOR_BIN" --init

	procd_open_instance
	procd_set_param command "$MONITOR_BIN"
	procd_set_param respawn 30 5 0
	procd_close_instance
}
