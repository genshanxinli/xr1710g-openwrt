#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
# Report ramoops/pstore status, watchdog bootstatus, and surviving crash records (read-only).

START=15

PSTORE_DIR="${PSTORE_REPORT_DIR:-/sys/fs/pstore}"
IOMEM_FILE="${PSTORE_REPORT_IOMEM:-/proc/iomem}"
MOUNTS_FILE="${PSTORE_REPORT_MOUNTS:-/proc/mounts}"
RAMOOPS_DRIVER="${PSTORE_REPORT_RAMOOPS_DRIVER:-/sys/bus/platform/drivers/ramoops}"
WDT_BOOTSTATUS="${PSTORE_REPORT_WDT_BOOTSTATUS:-/sys/class/watchdog/watchdog0/bootstatus}"
LOG_SOCK="${PSTORE_REPORT_LOG_SOCK:-/dev/log}"
LOG_WAIT_MAX="${PSTORE_REPORT_LOG_WAIT:-2}"
TAIL_BYTES="${PSTORE_REPORT_TAIL_BYTES:-2048}"
TAIL_LINES="${PSTORE_REPORT_TAIL_LINES:-8}"

ramoops_is_bound() {
	local dev

	for dev in "$RAMOOPS_DRIVER"/*ramoops*; do
		[ -e "$dev" ] && return 0
	done
	[ -r "$IOMEM_FILE" ] || return 1
	awk '/^[ \t]+[0-9a-fA-F]+-[0-9a-fA-F]+[ \t]*:[ \t]*([^ \t]*\.)?(persistent_ram|ramoops)([ \t@:]|$)/ { found = 1; exit } END { exit(found ? 0 : 1) }' \
		"$IOMEM_FILE" 2>/dev/null
}

pstore_is_mounted() {
	local dir="$PSTORE_DIR"

	[ "$dir" != "/" ] && dir="${dir%/}"
	[ -r "$MOUNTS_FILE" ] || return 1
	awk -v dir="$dir" '$2 == dir && $3 == "pstore" { found = 1; exit } END { exit(found ? 0 : 1) }' \
		"$MOUNTS_FILE" 2>/dev/null
}

boot() {
	local ramoops_status wdt_status waited=0 found=0 f name size line

	if [ -n "$LOG_SOCK" ] && [ "$LOG_WAIT_MAX" -gt 0 ] 2>/dev/null; then
		while [ ! -S "$LOG_SOCK" ] && [ "$waited" -lt "$LOG_WAIT_MAX" ]; do
			sleep 1
			waited=$((waited + 1))
		done
	fi

	if ramoops_is_bound; then
		ramoops_status="bound"
	else
		ramoops_status="unbound"
	fi
	logger -t pstore "ramoops: driver=$ramoops_status"

	if [ -r "$WDT_BOOTSTATUS" ]; then
		wdt_status=$(tr -d ' \t\r\n' < "$WDT_BOOTSTATUS" 2>/dev/null)
		[ -n "$wdt_status" ] && logger -t pstore "watchdog0: bootstatus=$wdt_status"
	fi

	if [ ! -d "$PSTORE_DIR" ] || ! pstore_is_mounted; then
		logger -t pstore "warning: $PSTORE_DIR not mounted as pstore filesystem"
		return 0
	fi

	for f in "$PSTORE_DIR"/*; do
		[ -f "$f" ] || continue
		found=$((found + 1))
		name="${f##*/}"
		size=$(wc -c < "$f" 2>/dev/null | tr -d ' \t\r\n')
		case "$name" in
		*.enc.z|*.z|*.gz|*.xz|*.bz2|*.lz4|*.zst)
			logger -t pstore "record: $name (${size:-0} bytes) [compressed, tail skipped]"
			continue
			;;
		esac
		logger -t pstore "record: $name (${size:-0} bytes)"
		tail -c "$TAIL_BYTES" "$f" 2>/dev/null |
			tr -cd '\011\012\040-\176' |
			tail -n "$TAIL_LINES" |
			cut -c 1-240 |
			while IFS= read -r line || [ -n "$line" ]; do
				[ -n "$line" ] && logger -t pstore "$name: $line"
			done
	done

	if [ "$found" -eq 0 ]; then
		logger -t pstore "clean boot: no surviving records in $PSTORE_DIR"
	else
		logger -t pstore "found $found surviving record(s) in $PSTORE_DIR"
	fi
	return 0
}

start() {
	boot "$@"
}
