#!/bin/sh
#
# wan-masq - explicit masquerade switch for the WAN firewall zone (issue #79).
#
# Nothing runs this on its own.  No uci-defaults, no hotplug, no init script:
# a human types "wan-masq on" or "wan-masq off", and until they do, every
# default in /etc/config/firewall stays exactly as shipped.  Masquerading off
# the WAN is a firewall semantics change, so it needs a human hand on it.
#
# Why there is deliberately no hotplug half
# -----------------------------------------
# "Flip masq when the WAN proto becomes pppoe" was considered and dropped.
# fw4 rebuilds every zone from /etc/config/firewall on each reload
# (etc/hotplug.d/iface/51-bridge-hw-offload:16-19 and 54-pppoe-flowtable:43-47
# both document this), so a hotplug script that adds "option masq 1" to the
# live ruleset is undone by the next reload, and one that writes the config on
# every ifup silently rewrites the operator's firewall.  Note the asymmetry
# with 54-pppoe-flowtable: adding a device to an existing flowtable is
# idempotent inside the kernel (nft_flowtable_update(), net/netfilter/
# nf_tables_api.c:9122-9131 takes the update branch when the named flowtable
# already exists), a zone is not - it is rebuilt, not patched.  So the state
# lives in the config, where it survives a reload, and only a person moves it.
#
# Consequently there is no ifdown half either: nothing here is event driven,
# so there is nothing to undo.  "wan-masq off" is that undo, and it is one
# command, which is less code and fewer surprises than a hotplug that has to
# decide whether the operator meant it.
#
# What "off" means: the option is deleted, not set to 0.  fw4 parses masq as a
# bool (/usr/share/ucode/fw4.uc:2047 "masq: [ \"bool\" ]") and only emits
# masquerade when it is true (/usr/share/firewall4/templates/ruleset.uc:330
# "{% if (zone.masq ...) %}"), so an absent option and an explicit 0 behave
# identically at runtime - but absent is what the stock config looks like for
# a zone nobody masquerades, so that is what off restores.
#
# Guardrail: an explicit "masq 0" in the zone is a decision someone made.
# "on" refuses to overwrite it and asks for --force, so the only way to lose
# that setting is to say so out loud.
#
# Scope: this script touches exactly one uci key,
# firewall.@zone[N].masq where @zone[N] is the zone named "wan".  Not other
# zones, not the network config, not the flowtable.  Every write is preceded
# by a one-time backup of /etc/config/firewall to
# /etc/config/firewall.bak-wan-masq (created only if it does not exist yet, so
# it always holds the pre-first-touch config and restoring it undoes the whole
# history of this helper).
#
# The write and the optional reload run under the locked section used by
# 51-bridge-hw-offload and 52-wan-lro: two concurrent wan-masq runs queue
# instead of interleaving, and the bounded retry cannot hang a shell.  The
# bound is a retry loop on "flock -n", not a timed wait, because busybox's
# flock is the only flock a stock image has and it takes no wait option.
# The lock is this script's own, so it does not serialise against fw4 itself;
# /etc/init.d/firewall reload is procd's job and procd queues the call.
#
# "off" is deliberately not gated on the WAN proto.  Turning masquerade off is
# never the risky direction: a box moved from pppoe to dhcp with masq 1 still
# set would otherwise have no way back short of --force.
#
# Exit status: 0 success or already in the requested state, 1 the zone or the
# config is unusable, 2 usage error, 3 "on" while the WAN proto is not pppoe,
# 4 explicit masq 0 without --force, 5 the write failed, 6 the uci change is
# committed but not live (fw4 reload failed, or the reloaded ruleset does not
# show the requested state), 7 the lock could not be taken.

CONF="${WM_FW_CONF:-/etc/config/firewall}"
BAK="$CONF.bak-wan-masq"
LOCK="${WM_LOCK:-/var/lock/wan-masq.lock}"
FW_INIT="${WM_FW_INIT:-/etc/init.d/firewall}"
NFT="${WM_NFT:-nft}"
ZONE=wan
NETIF=wan

usage() {
	cat >&2 <<'EOF'
usage: wan-masq status
       wan-masq on  [--reload] [--force]
       wan-masq off [--reload] [--force]

  status   print the zone and its current masq value, plus the live WAN proto.
           Read-only.
  on       set masq 1 on the "wan" zone.  Refused unless the WAN proto is
           pppoe, and refused over an explicit masq 0 unless --force.
  off      delete the masq option from the "wan" zone.  Always allowed: only
           "on" needs the WAN proto to be pppoe.
  --reload reload the firewall afterwards (on/off only) and check that the
           reloaded ruleset really shows the requested state.  A failed reload
           or a ruleset that disagrees is reported and exits 6; the uci change
           is already committed.
EOF
	exit 2
}

# Index of the @zone[] section named wan.  Sections are anonymous, so the only
# way in is to walk them; uci get on a section returns its type, which is how
# the walk knows it has run off the end.
zone_index() {
	i=0
	while uci -q get "firewall.@zone[$i]" >/dev/null 2>&1; do
		if [ "$(uci -q get "firewall.@zone[$i].name")" = "$ZONE" ]; then
			echo "$i"
			return 0
		fi
		i=$((i + 1))
	done
	return 1
}

# Live proto from netifd, falling back to the configured one when the
# interface has no ubus status (52-wan-lro:103-104 uses the same read).
wan_proto() {
	p=$(ubus call "network.interface.$NETIF" status 2>/dev/null |
		jsonfilter -e '@.proto' 2>/dev/null)
	[ -n "$p" ] || p=$(uci -q get "network.$NETIF.proto" 2>/dev/null)
	echo "$p"
}

# Live IPv4 masquerade for this zone, read out of the running fw4 ruleset.
# fw4 renders it as one extra statement in "chain srcnat_<zone>" of table
# inet fw4 (/usr/share/firewall4/templates/ruleset.uc:341 builds that chain,
# :330-361 pick fullcone vs the zone-masq include): "masquerade" normally, or
# "fullcone" when defaults.fullcone is set, which implies snat
# (/usr/share/ucode/fw4.uc:2254-2261).  Text output is used, not `nft -j`, so
# this keeps working across nft versions; the zone chain is emitted whether or
# not the WAN device is up (verified on the XR1710G with the WAN in dhcp/down
# and masq 1: srcnat_wan carries the fullcone rule).
# Prints "on"/"off".  Returns 1 when nft itself cannot be run, i.e. when the
# answer cannot be known at all; an absent chain simply means "off".
live_masq() {
	command -v "$NFT" >/dev/null 2>&1 || return 1
	"$NFT" list chain inet fw4 "srcnat_$ZONE" 2>/dev/null |
		grep -Eq 'nfproto ipv4[[:space:]]+(masquerade|fullcone)' && echo on ||
		echo off
}

do_status() {
	z=$(zone_index) || {
		echo "no zone named '$ZONE' in $CONF" >&2
		exit 1
	}
	[ -r "$CONF" ] || {
		echo "cannot read $CONF" >&2
		exit 1
	}
	m=$(uci -q get "firewall.@zone[$z].masq")
	printf 'zone:  firewall.@zone[%s] (%s)\n' "$z" "$ZONE"
	printf 'proto: %s\n' "$(wan_proto)"
	printf 'masq:  %s\n' "${m:-unset}"
	if l=$(live_masq); then
		printf 'live:  masquerade %s\n' "$l"
	else
		printf 'live:  unknown (cannot run %s)\n' "$NFT"
	fi
	if [ -e "$BAK" ]; then
		printf 'backup: %s\n' "$BAK"
	fi
	exit 0
}

ACTION=
RELOAD=0
FORCE=0

while [ $# -gt 0 ]; do
	case "$1" in
	status | on | off)
		[ -n "$ACTION" ] && usage
		ACTION=$1
		;;
	--reload) RELOAD=1 ;;
	--force) FORCE=1 ;;
	-h | --help) usage ;;
	*) usage ;;
	esac
	shift
done

[ -n "$ACTION" ] || usage
[ "$ACTION" = status ] && do_status

# Only "on" cares what the WAN proto is.  Refusing "off" because the operator
# already switched the WAN to dhcp is how masq 1 gets stranded.
if [ "$ACTION" = on ]; then
	PROTO=$(wan_proto)
	if [ "$PROTO" != pppoe ] && [ "$FORCE" -ne 1 ]; then
		echo "refusing: network.$NETIF proto is '${PROTO:-unknown}', not pppoe" >&2
		echo "re-run with --force if you really mean to change WAN masquerade" >&2
		exit 3
	fi
fi

z=$(zone_index) || {
	echo "no zone named '$ZONE' in $CONF" >&2
	exit 1
}

(
	mkdir -p "$(dirname "$LOCK")" 2>/dev/null
	exec 9>"$LOCK" || {
		echo "cannot open $LOCK" >&2
		exit 7
	}
	# Ten one-second attempts on "flock -n", not a timed wait: busybox's flock
	# (/usr/bin/flock -> ../../bin/busybox) takes [-sxun] FD and nothing else,
	# so "-w 10 9" was an unknown option and this guard fired on every run with
	# the lock uncontended.  Same 10 s ceiling, works on busybox and util-linux.
	waits=0
	while ! flock -n 9; do
		[ "$waits" -lt 10 ] || {
			echo "another wan-masq is running, giving up" >&2
			exit 7
		}
		waits=$((waits + 1))
		sleep 1
	done

	# Re-read under the lock: the value that decided anything before the
	# lock was taken may already be stale.
	cur=$(uci -q get "firewall.@zone[$z].masq")

	if [ "$ACTION" = on ]; then
		[ "$cur" = 1 ] && {
			echo "masq already 1 on zone $ZONE, nothing to do"
			exit 0
		}
		if [ "$cur" = 0 ] && [ "$FORCE" -ne 1 ]; then
			echo "zone $ZONE has an explicit masq 0; --force to override" >&2
			exit 4
		fi
		[ -e "$BAK" ] || cp "$CONF" "$BAK" || {
			echo "cannot back up $CONF to $BAK" >&2
			exit 5
		}
		uci -q set "firewall.@zone[$z].masq=1" || exit 5
	else
		# Absent and 0 are both "off" at runtime, so deleting either changes
		# nothing; skip the write rather than dirty the config.
		if [ -z "$cur" ] || [ "$cur" = 0 ]; then
			echo "masq already off on zone $ZONE, nothing to do"
			exit 0
		fi
		[ -e "$BAK" ] || cp "$CONF" "$BAK" || {
			echo "cannot back up $CONF to $BAK" >&2
			exit 5
		}
		uci -q delete "firewall.@zone[$z].masq" || exit 5
	fi

	uci -q commit firewall || exit 5
	echo "masq ${cur:-unset} -> $([ "$ACTION" = on ] && echo 1 || echo deleted) on zone $ZONE"

	[ "$RELOAD" -eq 1 ] || exit 0
	if ! "$FW_INIT" reload >/dev/null 2>&1; then
		echo "firewall reload failed: the uci change is committed but not live" >&2
		exit 6
	fi
	# init.d/firewall returning 0 only means fw4 was asked; it says nothing
	# about what the kernel now holds.  Read it back.
	want=$([ "$ACTION" = on ] && echo on || echo off)
	got=$(live_masq) || {
		echo "cannot verify the live ruleset: $NFT cannot read table inet fw4" >&2
		exit 6
	}
	if [ "$got" != "$want" ]; then
		echo "firewall reload returned 0 but the live ruleset shows masquerade $got, not $want: the uci change is committed but not live" >&2
		exit 6
	fi
	echo "firewall reloaded"
	exit 0
)
