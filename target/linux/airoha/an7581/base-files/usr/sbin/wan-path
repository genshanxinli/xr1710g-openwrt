#!/bin/sh
#
# wan-path - read-only WAN path diagnostic (issue #29).
#
# Prints the WAN path as the segments a packet actually crosses, in order:
#
#   netdev     network.wan proto, the logical netdev and the physical netdev
#              behind it.  For proto=pppoe the session interface (pppoe-wan)
#              is the logical device and network.wan.device is the physical
#              one; the live session is cross-checked against /proc/net/pppoe.
#   phy link   ethtool speed/duplex/link, with sysfs carrier/speed/duplex as
#              the fallback when ethtool cannot answer.
#   qdam       the QDMA/GDM id.  On AN7581 sysfs only exposes the ethernet
#              controller (1fb50000.ethernet), so the id is looked up in the
#              device-tree node behind <netdev>/device/of_node (or, when that
#              symlink is absent, in the DT node whose "compatible" matches the
#              controller's OF_COMPATIBLE_0).  Accepted properties are
#              qdam-id, gdm-id, gdm and queue.  When none exists the field is
#              reported unknown: the script never guesses a port number.
#   flowtable  whether the physical netdev is a member of `nft list flowtables`.
#   ppe        /sys/kernel/debug/ppe usage counters (entries/bound/unbound) and
#              the per-interface entry count when the bind table names the
#              netdev; otherwise that count stays unknown.
#   state      the verdict line: the first segment the path stops at, in that
#              order - no-netdev, no-carrier, no-pppoe-session,
#              carrier-unknown, up.  It is derived from the segments above and
#              never guessed; on this board (proto=dhcp, carrier 0, no PPPoE
#              session) it prints `state: no-carrier (...)` instead of leaving
#              the reader to infer a verdict from the counters.
#
# Every probe is a read: uci get, ubus call, ethtool, nft list, and reads of
# sysfs, procfs and debugfs.  The script never writes uci, never reloads, never
# reboots and never writes sysfs.
#
# Exit status: 0 only when the state is `up` and every segment resolved; 1 when
# the path stops at a segment, when at least one segment is unknown, or when the
# physical netdev is absent; 2 on a usage error.  --json prints one JSON object
# with the same fields; unknown values are null.

WP_SYS_NET=${WP_SYS_NET:-/sys/class/net}
WP_PROC_NET=${WP_PROC_NET:-/proc/net}
WP_DEBUGFS=${WP_DEBUGFS:-/sys/kernel/debug}
WP_DT=${WP_DT:-/proc/device-tree}

JSON=0
PROTO=
IFACE=wan
LDEP=
PHYS=
PPP_IF=
PPP_ID=
PPP_SESS=false
PRESENT=false
CARRIER=unknown
SPEED=
DUPLEX=
QDAM=
FT_MEMBER=unknown
FT_NAME=
FT_FAM=
PPE_ENTRIES=
PPE_BOUND=
PPE_UNBOUND=
PPE_IF_ENTRIES=
UNKNOWN=
STATE=
COMPLETE=false

usage() {
	cat <<'EOF'
usage: wan-path [--json]

Read-only WAN path diagnostic: netdev/PPPoE, PHY link, QDMA id, nft
flowtable membership and PPE bind counters.

Exit status: 0 when the path is up and every segment resolved; 1 when the
path stops at a segment, when a segment is unknown, or when the physical
netdev is missing.
EOF
}

add_unknown() {
	UNKNOWN="$UNKNOWN${UNKNOWN:+ }$1"
}

jstr() {
	if [ -z "$1" ]; then
		printf 'null'
		return
	fi
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

jnum() {
	if [ -z "$1" ]; then
		printf 'null'
	else
		printf '%s' "$1"
	fi
}

jbool() {
	if [ "$1" = true ]; then printf 'true'; else printf 'false'; fi
}

jtri() {
	case $1 in
	yes) printf 'true' ;;
	no) printf 'false' ;;
	*) printf 'null' ;;
	esac
}

read_trim() {
	[ -r "$1" ] || return 1
	tr -d '\000' < "$1" 2>/dev/null
}

# --- netdev ----------------------------------------------------------------

resolve_netdev() {
	PROTO=$(uci -q get network.wan.proto 2>/dev/null)
	if [ -z "$PROTO" ]; then
		PROTO=unknown
		add_unknown proto
	fi

	dev=$(uci -q get network.wan.device 2>/dev/null)
	[ -n "$dev" ] || dev=$(uci -q get network.wan.ifname 2>/dev/null)
	if [ -z "$dev" ]; then
		st=$(ubus call network.interface.wan status 2>/dev/null)
		dev=$(printf '%s' "$st" | sed -n 's/.*"device": *"\([^"]*\)".*/\1/p' | tail -1)
	fi

	if [ "$PROTO" = pppoe ]; then
		# The session interface is what owns the IP; the UCI device is the
		# netdev the PPP session runs on.
		if [ -d "$WP_SYS_NET/pppoe-$IFACE" ]; then
			PPP_IF="pppoe-$IFACE"
		else
			for d in "$WP_SYS_NET"/pppoe-* "$WP_SYS_NET"/ppp[0-9]*; do
				[ -e "$d" ] || continue
				PPP_IF=${d##*/}
				break
			done
		fi
		if [ -n "$PPP_IF" ]; then
			LDEP=$PPP_IF
		else
			LDEP=$dev
		fi
		if [ -z "$dev" ] && [ -n "$PPP_IF" ]; then
			case $PPP_IF in
			pppoe-*) dev=${PPP_IF#pppoe-} ;;
			esac
		fi
		PHYS=$dev
	else
		PHYS=$dev
		LDEP=$dev
	fi
	[ -n "$PHYS" ] || PHYS=$IFACE
	[ -n "$LDEP" ] || LDEP=$PHYS

	if [ -d "$WP_SYS_NET/$PHYS" ]; then
		PRESENT=true
	else
		add_unknown physical_device
	fi

	# Live PPPoE session table: "Id Address Device" header plus one line per
	# session.  A proto=pppoe interface with no line here has no session.
	if [ -r "$WP_PROC_NET/pppoe" ]; then
		n=$(sed -n '2,$p' "$WP_PROC_NET/pppoe" 2>/dev/null | grep -c '[^[:space:]]')
		if [ "$n" -gt 0 ]; then
			PPP_SESS=true
			PPP_ID=$(sed -n '2,$p' "$WP_PROC_NET/pppoe" 2>/dev/null |
				awk 'NF { print $1; exit }')
		fi
	fi
}

# --- phy link --------------------------------------------------------------

link_speed() {
	v=$1
	case $v in
	'' | 'Unknown!'* | -1 | 4294967295) printf '' ;;
	*Mb/s) printf '%s' "${v%Mb/s}" ;;
	*) printf '%s' "$v" ;;
	esac
}

link_duplex() {
	case $1 in
	Full | full) printf 'full' ;;
	Half | half) printf 'half' ;;
	*) printf '' ;;
	esac
}

resolve_link() {
	[ "$PRESENT" = true ] || return 0

	et=$(ethtool "$PHYS" 2>/dev/null)
	if [ -n "$et" ]; then
		sp=$(printf '%s' "$et" | sed -n 's/^[[:space:]]*Speed: *\([^[:space:]]*\).*/\1/p' | head -1)
		dx=$(printf '%s' "$et" | sed -n 's/^[[:space:]]*Duplex: *\([^[:space:]]*\).*/\1/p' | head -1)
		SPEED=$(link_speed "$sp")
		DUPLEX=$(link_duplex "$dx")
		if printf '%s' "$et" | grep -q 'Link detected: yes'; then
			CARRIER=yes
		elif printf '%s' "$et" | grep -q 'Link detected: no'; then
			CARRIER=no
		fi
	fi

	if [ -z "$SPEED" ]; then
		SPEED=$(link_speed "$(read_trim "$WP_SYS_NET/$PHYS/speed")")
	fi
	if [ -z "$DUPLEX" ]; then
		DUPLEX=$(link_duplex "$(read_trim "$WP_SYS_NET/$PHYS/duplex")")
	fi
	if [ "$CARRIER" = unknown ]; then
		case $(read_trim "$WP_SYS_NET/$PHYS/carrier") in
		1) CARRIER=yes ;;
		0) CARRIER=no ;;
		esac
	fi
}

# --- qdam ------------------------------------------------------------------

dt_node() {
	n=$(readlink -f "$WP_SYS_NET/$1/device/of_node" 2>/dev/null)
	if [ -n "$n" ] && [ -d "$n" ]; then
		printf '%s' "$n"
		return 0
	fi

	compat=$(sed -n 's/^OF_COMPATIBLE_0=\([^ ]*\).*/\1/p' \
		"$WP_SYS_NET/$1/device/uevent" 2>/dev/null | head -1)
	[ -n "$compat" ] || return 1
	for d in "$WP_DT"/soc/ethernet@* "$WP_DT"/ethernet@*; do
		[ -d "$d" ] || continue
		c=$(read_trim "$d/compatible")
		[ "$c" = "$compat" ] && { printf '%s' "$d"; return 0; }
	done
	return 1
}

resolve_qdam() {
	[ "$PRESENT" = true ] || { add_unknown qdam_id; return; }
	n=$(dt_node "$PHYS") || { add_unknown qdam_id; return; }
	for p in qdam-id gdm-id gdm queue; do
		v=$(read_trim "$n/$p")
		if [ -n "$v" ]; then
			QDAM=$v
			return
		fi
	done
	add_unknown qdam_id
}

# --- flowtable -------------------------------------------------------------

ft_json() {
	# nft pretty-prints its JSON on a stock device ("name": "ft",
	# {"dev": [...]), so collapse the insignificant whitespace before
	# matching.  Select the inet/ft flowtable specifically rather than
	# taking head -1 across all flowtables (bridge/fb may appear first),
	# and extract the device list from that matched object only.
	flat=$(printf '%s' "$1" | tr '\n\t' '  ' |
		sed -e 's/: */:/g' -e 's/{ */{/g' -e 's/ *}/}/g' \
		    -e 's/, */,/g' -e 's/\[ */[/g' -e 's/ *\]/]/g')
	objs=$(printf '%s' "$flat" | grep -o '"flowtable":{[^}]*}')
	[ -n "$objs" ] || return 1
	obj=$(printf '%s\n' "$objs" | grep -F '"family":"inet"' | grep -F '"name":"ft"' | head -1)
	if [ -z "$obj" ]; then
		FT_MEMBER=no
		return 0
	fi
	FT_NAME=$(printf '%s' "$obj" | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')
	FT_FAM=$(printf '%s' "$obj" | sed -n 's/.*"family":"\([^"]*\)".*/\1/p')
	# nft >= 1.1 names the device list "dev", older releases name it
	# "devices", and a single-device flowtable may serialize as a plain
	# JSON string ("dev":"wan") instead of a 1-element array.  Strip the
	# key prefix before matching "$PHYS" so a device name never matches
	# the JSON key itself.
	devs=$(printf '%s' "$obj" | grep -o '"devices":\[[^]]*\]' | head -1)
	[ -n "$devs" ] || devs=$(printf '%s' "$obj" | grep -o '"dev":\[[^]]*\]' | head -1)
	[ -n "$devs" ] || devs=$(printf '%s' "$obj" | grep -o '"devices":"[^"]*"' | head -1)
	[ -n "$devs" ] || devs=$(printf '%s' "$obj" | grep -o '"dev":"[^"]*"' | head -1)
	if [ -n "$devs" ] && printf '%s' "${devs#*:}" | grep -qF "\"$PHYS\""; then
		FT_MEMBER=yes
	else
		FT_MEMBER=no
	fi
	return 0
}

ft_text() {
	[ -n "$1" ] || { FT_MEMBER=no; return 0; }
	res=$(printf '%s\n' "$1" | awk -v phys="$PHYS" '
		/^table[ \t]+/ {
			fam = $2
			in_ft = 0
			in_devs = 0
			next
		}
		fam == "inet" && /^[ \t]*flowtable[ \t]+ft([ \t]|\{|$)/ {
			in_ft = 1
			in_devs = 0
			found = 1
			next
		}
		in_ft && !in_devs && /^[ \t]*\}/ {
			in_ft = 0
			next
		}
		in_ft && /devices[ \t]*=[ \t]*\{/ {
			in_devs = 1
			line = $0
			sub(/.*devices[ \t]*=[ \t]*\{/, "", line)
			if (index(line, "}")) {
				sub(/\}.*/, "", line)
				in_devs = 0
			}
			n = split(line, parts, /[ ,\t]+/)
			for (i = 1; i <= n; i++) {
				t = parts[i]
				gsub(/^"|"$/, "", t)
				if (t == phys) member = 1
			}
			next
		}
		in_ft && in_devs {
			line = $0
			if (index(line, "}")) {
				sub(/\}.*/, "", line)
				in_devs = 0
			}
			n = split(line, parts, /[ ,\t]+/)
			for (i = 1; i <= n; i++) {
				t = parts[i]
				gsub(/^"|"$/, "", t)
				if (t == phys) member = 1
			}
			next
		}
		END {
			if (!found) print "none"
			else if (member) print "yes"
			else print "no"
		}
	')
	case "$res" in
	yes)
		FT_FAM=inet
		FT_NAME=ft
		FT_MEMBER=yes
		;;
	no)
		FT_FAM=inet
		FT_NAME=ft
		FT_MEMBER=no
		;;
	*)
		FT_MEMBER=no
		;;
	esac
}

resolve_flowtable() {
	[ "$PRESENT" = true ] || { add_unknown flowtable; return; }
	if ! command -v nft >/dev/null 2>&1; then
		add_unknown flowtable
		return
	fi
	if out=$(nft -j list flowtables 2>/dev/null) && [ -n "$out" ] &&
		ft_json "$out"; then
		return
	fi
	if out=$(nft list flowtables 2>/dev/null); then
		ft_text "$out"
		return
	fi
	add_unknown flowtable
}

# --- ppe -------------------------------------------------------------------

# First number following a label anywhere in the usage dump, so the parse
# survives either one line or several (busybox awk, no jq needed).
num_field() {
	printf '%s' "$1" | awk -v k="$2" '
		{ for (i = 1; i < NF; i++) if ($i == k && $(i + 1) ~ /^[0-9]+$/) { print $(i + 1); exit } }'
}

resolve_ppe() {
	u="$WP_DEBUGFS/ppe/usage"
	if [ ! -r "$u" ]; then
		add_unknown ppe_usage
		add_unknown ppe_interface_entries
		return
	fi
	usage=$(read_trim "$u")
	PPE_ENTRIES=$(num_field "$usage" entries)
	PPE_BOUND=$(num_field "$usage" bound)
	PPE_UNBOUND=$(num_field "$usage" unbound)

	# The 5-tuple dump has no netdev field on this SoC; only a bind table that
	# literally names the netdev as a whole token can attribute entries to
	# this interface.
	b="$WP_DEBUGFS/ppe/bind"
	if [ -r "$b" ]; then
		cnt=$(awk -v p="$PHYS" '
			{
				for (i = 1; i <= NF; i++) {
					if ($i == p) { c++; break }
				}
			}
			END { print c + 0 }
		' "$b" 2>/dev/null)
		if [ "${cnt:-0}" -gt 0 ]; then
			PPE_IF_ENTRIES=$cnt
		else
			add_unknown ppe_interface_entries
		fi
	else
		add_unknown ppe_interface_entries
	fi
}

# --- state -----------------------------------------------------------------

# The one-line verdict: which segment the path dies on, in the order a packet
# crosses them.  This box (proto=dhcp, carrier 0, no session) is exactly the
# case this exists for - without it the reader gets a list of counters and has
# to work out that "carrier=no" means nothing above the PHY can ever come up.
# It is derived only from segments already resolved above, never guessed.
resolve_state() {
	if [ "$PRESENT" != true ]; then
		STATE=no-netdev
	elif [ "$CARRIER" = no ]; then
		STATE=no-carrier
	elif [ "$PROTO" = pppoe ] && [ "$PPP_SESS" != true ]; then
		STATE=no-pppoe-session
	elif [ "$CARRIER" != yes ]; then
		STATE=carrier-unknown
	else
		STATE=up
	fi
}

state_detail() {
	case $STATE in
	no-netdev)
		printf 'physical device %s is not in %s' "$PHYS" "$WP_SYS_NET"
		;;
	no-pppoe-session)
		printf 'proto=pppoe but no session in %s/pppoe; the path stops before the PPP layer' \
			"$WP_PROC_NET"
		;;
	no-carrier)
		printf 'carrier 0 on %s: the path stops at the PHY or the cable, nothing above it can come up' \
			"$PHYS"
		# Only claim this when the session table really is empty, so the
		# detail stays true for a PPPoE box whose link dropped after dial-up.
		[ "$PPP_SESS" = true ] || printf ', no PPPoE session either'
		;;
	carrier-unknown)
		printf 'no ethtool link answer and no carrier file on %s' "$PHYS"
		;;
	up)
		printf 'link up on %s; flowtable and PPE below are the offload layer, not the cause of a no-WAN report' \
			"$PHYS"
		;;
	esac
}

# --- report ----------------------------------------------------------------

print_text() {
	printf 'wan-path: read-only WAN path diagnostic\n'
	printf 'proto: %s\n' "$PROTO"
	printf 'logical device: %s\n' "${LDEP:-unknown}"
	printf 'physical device: %s\n' "${PHYS:-unknown}"
	printf 'netdev present: %s\n' "$(jbool "$PRESENT")"
	printf 'pppoe: session=%s interface=%s id=%s\n' "$(jbool "$PPP_SESS")" \
		"${PPP_IF:-none}" "${PPP_ID:-none}"
	printf 'link: carrier=%s speed=%s duplex=%s\n' "$CARRIER" \
		"${SPEED:-unknown}" "${DUPLEX:-unknown}"
	printf 'qdam: %s\n' "${QDAM:-unknown}"
	if [ "$FT_MEMBER" = unknown ]; then
		printf 'flowtable: unknown\n'
	else
		printf 'flowtable: member=%s name=%s family=%s\n' "$FT_MEMBER" \
			"${FT_NAME:-unknown}" "${FT_FAM:-unknown}"
	fi
	printf 'ppe: entries=%s bound=%s unbound=%s interface_entries=%s\n' \
		"${PPE_ENTRIES:-unknown}" "${PPE_BOUND:-unknown}" \
		"${PPE_UNBOUND:-unknown}" "${PPE_IF_ENTRIES:-unknown}"
	if [ -n "$UNKNOWN" ]; then
		printf 'unknown: %s\n' "$UNKNOWN"
	else
		printf 'unknown: none\n'
	fi
	if [ "$COMPLETE" = true ]; then
		printf 'status: complete\n'
	else
		printf 'status: incomplete\n'
	fi
	printf 'state: %s (%s)\n' "$STATE" "$(state_detail)"
}

print_json() {
	printf '{'
	printf '"interface":%s,' "$(jstr "$IFACE")"
	printf '"proto":%s,' "$(jstr "$PROTO")"
	printf '"logical_device":%s,' "$(jstr "$LDEP")"
	printf '"physical_device":%s,' "$(jstr "$PHYS")"
	printf '"netdev_present":%s,' "$(jbool "$PRESENT")"
	printf '"pppoe":{"session":%s,"interface":%s,"id":%s},' \
		"$(jbool "$PPP_SESS")" "$(jstr "$PPP_IF")" "$(jstr "$PPP_ID")"
	printf '"link":{"carrier":%s,"speed":%s,"duplex":%s},' \
		"$(jtri "$CARRIER")" "$(jnum "$SPEED")" "$(jstr "$DUPLEX")"
	printf '"qdam_id":%s,' "$(jstr "$QDAM")"
	printf '"flowtable":{'
	printf '"member":%s,' "$(jtri "$FT_MEMBER")"
	printf '"name":%s,' "$(jstr "$FT_NAME")"
	printf '"family":%s},' "$(jstr "$FT_FAM")"
	printf '"ppe":{"entries":%s,"bound":%s,"unbound":%s,"interface_entries":%s},' \
		"$(jnum "$PPE_ENTRIES")" "$(jnum "$PPE_BOUND")" \
		"$(jnum "$PPE_UNBOUND")" "$(jnum "$PPE_IF_ENTRIES")"
	printf '"unknown":['
	first=1
	for u in $UNKNOWN; do
		[ "$first" = 1 ] || printf ','
		jstr "$u"
		first=0
	done
	printf '],'
	printf '"state":%s,' "$(jstr "$STATE")"
	printf '"state_detail":%s,' "$(jstr "$(state_detail)")"
	printf '"complete":%s' "$COMPLETE"
	printf '}\n'
}

main() {
	for arg in "$@"; do
		case $arg in
		--json) JSON=1 ;;
		--help | -h) usage; exit 0 ;;
		*)
			printf 'wan-path: unknown argument: %s\n' "$arg" >&2
			exit 2
			;;
		esac
	done

	resolve_netdev
	resolve_link
	resolve_qdam
	resolve_flowtable
	resolve_ppe

	if [ -z "$UNKNOWN" ]; then COMPLETE=true; else COMPLETE=false; fi
	resolve_state

	if [ "$JSON" = 1 ]; then
		print_json
	else
		print_text
	fi

	# Non-zero when the path is not up: either a segment is unknown, or the
	# state above says which one it stops at.  A down link must never read as a
	# clean report just because every other counter happened to be readable.
	[ "$STATE" = up ] && [ -z "$UNKNOWN" ] && exit 0
	exit 1
}

main "$@"
