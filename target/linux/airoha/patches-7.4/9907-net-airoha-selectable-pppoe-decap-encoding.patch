 drivers/net/ethernet/airoha/airoha_ppe.c | 84 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/net/ethernet/airoha/airoha_ppe_debugfs.c | 138 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 238 insertions(+), 0 deletions(-)
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -568,6 +568,14 @@ struct airoha_flow_data {
 	struct {
 		u16 sid;
 		u8 num;
+		/* The rule's ingress tuple carries a PPPoE session level, so
+		 * the entry has to strip that header.  There is no sid for
+		 * this direction: the action list has no FLOW_ACTION_PPPOE_POP
+		 * to take one from, and the tuple only records that the level
+		 * exists.  Set from flow_cls_offload::pppoe_decap, the one
+		 * channel the flowtable has for the fact.
+		 */
+		bool decap;
 	} pppoe;
 
 	/* Meter group requested by a tc police action, or
@@ -918,6 +926,14 @@ bool airoha_is_valid_gdm_dev(struct airo
 
 extern struct mutex flow_offload_mutex;
 
+/* Encoding arm for a PPPoE decapsulation entry, 0 to 3; the matrix is
+ * documented in airoha_ppe.c.  The entry builder reads it once per entry, so
+ * the value in force is the arm the entries now in the table were built
+ * with.  Declared unconditionally because the flow path reads it whether or
+ * not debugfs is compiled in; only ppe/pppoe_decap writes it.
+ */
+extern unsigned int airoha_ppe_pppoe_decap;
+
 static inline struct airoha_qdma *
 airoha_qdma_deref(struct airoha_gdm_dev *dev)
 {
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -67,6 +67,34 @@ module_param_named(pppoe_vlan_refuse, ai
 MODULE_PARM_DESC(pppoe_vlan_refuse,
 		 "Refuse PPPoE-over-VLAN flows the PPE cannot express instead of programming a wrong entry");
 
+/* How a PPPoE decapsulation entry is encoded.  Nothing in the kernel
+ * documents which IB1 bit makes the parser strip a PPPoE session header on
+ * ingress: bit22 (BIND_PPPOE) is the session-id bind the push direction
+ * uses, bit23 (BIND_TUNNEL_DECAP, the vendor's "rmt") is the remove-the-
+ * outer-header bit DS-Lite and 6rd set, and no PPPoE flow has ever set
+ * either of them on this carrier.  Guessing one and calling it a fix is what
+ * issue 81 asks not to do, so the encoding is selectable and read back:
+ *
+ *   0  leave the entry exactly as it is without this patch (default)
+ *   1  psn + etype + rmt: both bind bits set, for the case where the parser
+ *      needs one of them and this arm answers both
+ *   2  etype + rmt: rmt alone.  Compared with arm 1 this says whether psn
+ *      takes part in the decap at all, and compared with arm 3 whether rmt
+ *      is the bit that strips
+ *   3  psn + etype, rmt clear: the discriminating arm of issue 81
+ *
+ * Every arm forces the L2 match word to ETH_P_PPP_SES and leaves pppoe_id at
+ * zero, which is all this direction knows.  Only a plain etype takes the
+ * arm's etype: when the egress device already owns that word (WDMA band, DSA
+ * port mask) the arm sets the IB1 bits and leaves the etype alone, so no
+ * other flow type changes shape.  DS-Lite and 6rd entries are excluded
+ * outright -- their rmt bit removes an IPv6/IPv4 tunnel header and means
+ * something else entirely.  This is a measurement knob, not a default fix:
+ * 0 keeps every byte of the old behaviour, and the arms exist to be measured
+ * one at a time against a live PPPoE WAN (scripts/pppoe-decap-hw-bench.sh).
+ */
+unsigned int airoha_ppe_pppoe_decap;
+
 static const struct rhashtable_params airoha_flow_table_params = {
 	.head_offset = offsetof(struct airoha_flow_table_entry, node),
 	.key_offset = offsetof(struct airoha_flow_table_entry, cookie),
@@ -1013,6 +1041,7 @@ static int airoha_ppe_foe_entry_prepare(
 	int wlan_etype = -EINVAL, dsa_port = airoha_get_dsa_port(&netdev);
 	struct airoha_foe_mac_info_common *l2;
 	u8 smac_id = 0xf;
+	unsigned int pppoe_decap_arm = 0;
 
 	memset(hwe, 0, sizeof(*hwe));
 
@@ -1035,6 +1064,31 @@ static int airoha_ppe_foe_entry_prepare(
 		val |= AIROHA_FOE_IB1_BIND_TTL;
 	hwe->ib1 = val;
 
+	/* A PPPoE level in the ingress tuple, and no push action, is the
+	 * decapsulation direction.  Apply the selected arm; at arm 0 nothing
+	 * below changes a bit, which is what the entry builder did before
+	 * this knob existed.  The tunnel packet types are excluded: their rmt
+	 * bit is already spoken for and a PPPoE session inside one is a
+	 * different, unencoded problem.
+	 */
+	if (data->pppoe.decap && !data->pppoe.num &&
+	    type != PPE_PKT_TYPE_IPV4_DSLITE && type != PPE_PKT_TYPE_IPV6_6RD) {
+		pppoe_decap_arm = READ_ONCE(airoha_ppe_pppoe_decap);
+		switch (pppoe_decap_arm) {
+		case 1:
+			hwe->ib1 |= AIROHA_FOE_IB1_BIND_PPPOE |
+				    AIROHA_FOE_IB1_BIND_TUNNEL_DECAP;
+			break;
+		case 2:
+			hwe->ib1 |= AIROHA_FOE_IB1_BIND_TUNNEL_DECAP;
+			break;
+		case 3:
+			/* bit23 stays clear: nothing on this path sets it. */
+			hwe->ib1 |= AIROHA_FOE_IB1_BIND_PPPOE;
+			break;
+		}
+	}
+
 	val = FIELD_PREP(AIROHA_FOE_IB2_PORT_AG, 0x1f);
 	if (netdev) {
 		struct airoha_wdma_info info = {};
@@ -1158,6 +1212,14 @@ static int airoha_ppe_foe_entry_prepare(
 		l2->etype |= !data->vlan.num ? BIT(15) : 0;
 	} else if (data->pppoe.num) {
 		l2->etype = ETH_P_PPP_SES;
+	} else if (pppoe_decap_arm) {
+		/* A decap arm: the parser has to treat the session header as
+		 * the L2 payload of this entry.  Skipped when the egress
+		 * device owns this word (WDMA band, DSA port mask above), and
+		 * for DS-Lite/6rd (pppoe_decap_arm stayed 0 above), so the
+		 * arm never reaches into another flow type's encoding.
+		 */
+		l2->etype = ETH_P_PPP_SES;
 	}
 
 	return 0;
@@ -2075,6 +2137,14 @@ static int airoha_ppe_flow_offload_repla
 
 	flow_rule_match_meta(rule, &meta);
 
+	/* The tuple of this direction lists the headers the PPE has to strip;
+	 * a PPPoE session among them reaches the driver only as this bit,
+	 * because the action list has no FLOW_ACTION_PPPOE_POP (see
+	 * nf_flow_offload_init()).  The reverse rule carries PPPOE_PUSH
+	 * actions instead and never sets it.
+	 */
+	data.pppoe.decap = f->pppoe_decap;
+
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL)) {
 		struct flow_match_control match;
 
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -518,9 +518,147 @@ static int airoha_ppe_debugfs_meter_show
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_meter);
 
+/* The PPPoE decap arms and their readback belong together: the knob is the
+ * only way to change airoha_ppe_pppoe_decap, and ppe/pppoe lists what the
+ * entries in the table hold, so a change of arm is visible next to the bits
+ * it produced instead of being inferred from a log line.
+ */
+static int
+airoha_ppe_debugfs_pppoe_decap_show(struct seq_file *m, void *private)
+{
+	seq_printf(m, "%u\n", READ_ONCE(airoha_ppe_pppoe_decap));
+
+	return 0;
+}
+
+static ssize_t airoha_ppe_debugfs_pppoe_decap_write(struct file *file,
+						    const char __user *ubuf,
+						    size_t count, loff_t *ppos)
+{
+	unsigned int arm;
+	char buf[8];
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	/* 0..3 are the arms documented in airoha_ppe.c.  Refuse anything
+	 * else instead of clamping: a typo must not silently select an arm
+	 * the operator did not mean to measure.
+	 */
+	if (kstrtouint(buf, 0, &arm) || arm > 3)
+		return -EINVAL;
+
+	WRITE_ONCE(airoha_ppe_pppoe_decap, arm);
+
+	return count;
+}
+
+static int airoha_ppe_debugfs_pppoe_decap_open(struct inode *inode,
+					       struct file *file)
+{
+	return single_open(file, airoha_ppe_debugfs_pppoe_decap_show,
+			   inode->i_private);
+}
+
+static const struct file_operations airoha_ppe_debugfs_pppoe_decap_fops = {
+	.open		= airoha_ppe_debugfs_pppoe_decap_open,
+	.read		= seq_read,
+	.write		= airoha_ppe_debugfs_pppoe_decap_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+/* Every entry that can be a PPPoE decapsulation entry, with the four fields
+ * the question turns on: the arm in force, IB1 bit22 (psn), IB1 bit23 (rmt)
+ * and the session id the entry binds.  pppoe_id is 0 for a decap entry
+ * because this direction has no sid; a non-zero value means the entry was
+ * built for the push direction, or that the packet type does not carry the
+ * field.
+ */
+static int airoha_ppe_debugfs_pppoe_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	u32 num_entries = airoha_ppe_get_total_num_entries(ppe);
+	unsigned int arm = READ_ONCE(airoha_ppe_pppoe_decap);
+	u32 count = 0;
+	int i;
+
+	seq_printf(m, "decap %u\n", arm);
+
+	for (i = 0; i < num_entries; i++) {
+		struct airoha_foe_mac_info_common *l2;
+		struct airoha_foe_entry *hwe;
+		u32 state, type, pppoe_id = 0;
+		bool psn, rmt, tunnel_type;
+		u16 etype;
+
+		hwe = airoha_ppe_foe_get_entry(ppe, i);
+		if (!hwe)
+			continue;
+
+		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+		if (!state)
+			continue;
+
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+		switch (type) {
+		case PPE_PKT_TYPE_BRIDGE:
+			l2 = &hwe->bridge.l2.common;
+			pppoe_id = hwe->bridge.l2.pppoe_id;
+			break;
+		case PPE_PKT_TYPE_IPV4_DSLITE:
+			l2 = &hwe->dslite.l2.common;
+			pppoe_id = hwe->dslite.l2.pppoe_id;
+			break;
+		default:
+			if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+				l2 = &hwe->ipv6.l2;
+				pppoe_id = FIELD_GET(AIROHA_FOE_MAC_PPPOE_ID,
+						     hwe->ipv6.l2.src_mac_hi);
+			} else {
+				l2 = &hwe->ipv4.l2.common;
+				pppoe_id = hwe->ipv4.l2.pppoe_id;
+			}
+			break;
+		}
+
+		psn = !!(hwe->ib1 & AIROHA_FOE_IB1_BIND_PPPOE);
+		rmt = !!(hwe->ib1 & AIROHA_FOE_IB1_BIND_TUNNEL_DECAP);
+		tunnel_type = type == PPE_PKT_TYPE_IPV4_DSLITE ||
+			      type == PPE_PKT_TYPE_IPV6_6RD;
+		etype = l2->etype;
+
+		/* A DS-Lite or 6rd entry carries rmt for its tunnel, not for
+		 * a session header: it is listed only when its etype says
+		 * PPPoE or it binds a session id.
+		 */
+		if (!psn && etype != ETH_P_PPP_SES &&
+		    !(rmt && !tunnel_type))
+			continue;
+
+		seq_printf(m,
+			   "%05x %s type=%u etype=%04x pppoe_id=%u decap=%u psn=%u rmt=%u\n",
+			   i, state == AIROHA_FOE_STATE_BIND ? "BND" : "UNB",
+			   type, etype, pppoe_id, arm, psn, rmt);
+		count++;
+	}
+
+	seq_printf(m, "entries %u\n", count);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_pppoe);
+
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
+	debugfs_create_file("pppoe_decap", 0644, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_pppoe_decap_fops);
+	debugfs_create_file("pppoe", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_pppoe_fops);
 	debugfs_create_file("entries", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_foe_all_fops);
 	debugfs_create_file("bind", 0444, ppe->debugfs_dir, ppe,
