 drivers/net/ethernet/airoha/airoha_ppe.c | 57 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 files changed, 51 insertions(+), 6 deletions(-)
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -6,6 +6,7 @@
 
 #include <linux/ip.h>
 #include <linux/ipv6.h>
+#include <linux/module.h>
 #include <linux/of_platform.h>
 #include <linux/moduleparam.h>
 #include <linux/platform_device.h>
@@ -25,6 +26,22 @@
 DEFINE_MUTEX(flow_offload_mutex);
 static DEFINE_SPINLOCK(ppe_lock);
 
+/* A flow whose rule carries no L4 ports has no port pair to fill in, so the
+ * driver refuses it after it has already picked a 5-tuple packet type: those
+ * flows never reach the PPE.  The PPE has dedicated 3-tuple packet types for
+ * exactly this case: IPv4 type 1 (address NAT) and IPv6 type 4 (3-tuple
+ * route), both of which match on the address pair and the protocol instead
+ * of the ports.
+ *
+ * Emitting them is opt-in because the packet types must also be enabled in
+ * PPE_FLOW_CFG, and that register is shared with the NPU firmware.  At 0
+ * every flow keeps its old packet type and the register is left alone.
+ */
+static bool airoha_ppe_3t;
+module_param(airoha_ppe_3t, bool, 0444);
+MODULE_PARM_DESC(airoha_ppe_3t,
+		 "Offload flows without L4 ports as 3-tuple PPE entries");
+
 static const struct rhashtable_params airoha_flow_table_params = {
 	.head_offset = offsetof(struct airoha_flow_table_entry, node),
 	.key_offset = offsetof(struct airoha_flow_table_entry, cookie),
@@ -346,6 +363,17 @@ static void airoha_ppe_hw_init(struct ai
 		airoha_fe_wr(eth, REG_PPE_HASH_SEED(i), PPE_HASH_SEED);
 		airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(i),
 				PPE_FLOW_CFG_IP6_6RD_MASK);
+
+		/* The parser only recognises the packet types that are
+		 * enabled here.  IPv4 type 1 is IPv4 NAT (address-only
+		 * translation, no port rewrite) and IPv6 type 4 is the
+		 * 3-tuple route; the NPU firmware normally sets both, but
+		 * nothing in this driver relies on that.
+		 */
+		if (airoha_ppe_3t)
+			airoha_fe_set(eth, REG_PPE_PPE_FLOW_CFG(i),
+				      PPE_FLOW_CFG_IP4_NAT_MASK |
+				      PPE_FLOW_CFG_IP6_3T_ROUTE_MASK);
 	}
 
 	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
@@ -780,9 +808,16 @@ static int airoha_ppe_foe_entry_set_ipv4
 		}
 		fallthrough;
 	case PPE_PKT_TYPE_IPV4_DSLITE:
-	case PPE_PKT_TYPE_IPV4_ROUTE:
 		t = &hwe->ipv4.orig_tuple;
 		break;
+	case PPE_PKT_TYPE_IPV4_ROUTE:
+		/* A 3-tuple entry keeps the pre-NAT addresses in the first
+		 * tuple and the rewrite in the second one, the same way the
+		 * vendor SDK fills an IPv4 HNAT entry.
+		 */
+		t = egress ? &hwe->ipv4.new_tuple :
+			     &hwe->ipv4.orig_tuple;
+		break;
 	default:
 		WARN_ON_ONCE(1);
 		return -EINVAL;
@@ -1647,7 +1682,7 @@ static int airoha_ppe_flow_offload_repla
 	u8 dsfield = 0, l4proto = 0;
 	struct airoha_foe_entry hwe;
 	struct net_device *indev;
-	bool bridged;
+	bool bridged, has_ports, use_3t;
 	int err, i, offload_type;
 	u16 addr_type = 0;
 
@@ -1688,6 +1723,9 @@ static int airoha_ppe_flow_offload_repla
 		dsfield = match.key->tos;
 	}
 
+	has_ports = flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS);
+	use_3t = !has_ports && airoha_ppe_3t;
+
 	switch (addr_type) {
 	case 0:
 		offload_type = PPE_PKT_TYPE_BRIDGE;
@@ -1702,10 +1740,12 @@ static int airoha_ppe_flow_offload_repla
 		}
 		break;
 	case FLOW_DISSECTOR_KEY_IPV4_ADDRS:
-		offload_type = PPE_PKT_TYPE_IPV4_HNAPT;
+		offload_type = use_3t ? PPE_PKT_TYPE_IPV4_ROUTE :
+					PPE_PKT_TYPE_IPV4_HNAPT;
 		break;
 	case FLOW_DISSECTOR_KEY_IPV6_ADDRS:
-		offload_type = PPE_PKT_TYPE_IPV6_ROUTE_5T;
+		offload_type = use_3t ? PPE_PKT_TYPE_IPV6_ROUTE_3T :
+					PPE_PKT_TYPE_IPV6_ROUTE_5T;
 		break;
 	default:
 		return -EOPNOTSUPP;
@@ -1778,7 +1818,7 @@ static int airoha_ppe_flow_offload_repla
 	if (err)
 		return err;
 
-	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
+	if (has_ports) {
 		struct flow_match_ports ports;
 
 		if (offload_type == PPE_PKT_TYPE_BRIDGE) {
@@ -1789,7 +1829,12 @@ static int airoha_ppe_flow_offload_repla
 		flow_rule_match_ports(rule, &ports);
 		data.src_port = ports.key->src;
 		data.dst_port = ports.key->dst;
-	} else if (offload_type != PPE_PKT_TYPE_BRIDGE) {
+	} else if (offload_type == PPE_PKT_TYPE_IPV4_HNAPT ||
+		   offload_type == PPE_PKT_TYPE_IPV6_ROUTE_5T) {
+		/* No ports to match on: a 5-tuple entry would carry a zeroed
+		 * port pair and never match, so leave the flow in software
+		 * unless the 3-tuple packet types are enabled.
+		 */
 		err = -EOPNOTSUPP;
 		goto put_smac;
 	}
