-	bool bridged, has_ports, use_3t;
+	bool bridged;
 	int err, i, offload_type;
 	u16 addr_type = 0;
 
@@ -1766,6 +2071,18 @@ static int airoha_ppe_flow_offload_repla
 			data.pppoe.sid = act->pppoe.sid;
 			data.pppoe.num++;
 			break;
+		case FLOW_ACTION_POLICE:
+			if (offload_type == PPE_PKT_TYPE_BRIDGE)
+				return -EOPNOTSUPP;
+			if (police)
+				return -EOPNOTSUPP;
