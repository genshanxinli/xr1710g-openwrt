From: OpenWrt <openwrt@example.org>
Date: Sun, 15 Nov 2026 00:00:00 +0800
Subject: [PATCH] net: airoha: add an opt-in per-flow PPE meter from tc police

tc police is refused by the PPE flow offload path: it hits the default
-EOPNOTSUPP arm of airoha_ppe_flow_offload_replace(), and every FOE
entry hardcodes AIROHA_FOE_SHAPER_ID to 0x7f ("no meter").

Add a default-off module parameter, airoha_ppe_meter.  With it at 0 the
driver behaves exactly as before: police is still refused, every entry
keeps SHAPER_ID 0x7f and no meter register is written.

With it at 1, a tc police action is accepted for non-L2 flows.  The
driver:

- reads rate_bytes_ps and burst (packet-rate police is refused);
- allocates one of the 63 meter groups (0..62) with a bitmap and a
  refcount;
- programs the matching QDMA0 ingress TRTCM index at QDMA0 + 0x70 with
  the requested rate and bucket (writes to FE + 0x200c + 16 * group are
  skipped because that window collides with live AN7581 FE registers);
- writes the group number into AIROHA_FOE_SHAPER_ID instead of 0x7f;
- releases the group in airoha_ppe_foe_flow_remove_entry(), which
  covers tc delete, flow expiry through FLOW_CLS_DESTROY and the
  insert-failure path.

Peakrate is deliberately refused: the PPE group register carries one
token rate and the probe leaves the QDMA block in rate-limit mode, so
there is no second bucket to program.  The rate and bucket encodings
come from the vendor SDK (ppeMeterRegConfig()/METER_REG_BYTE_* and the
QDMA TRTCM parameter fields the mainline driver already uses); their
accuracy against a packet generator is unverified because this is a
code-landing PoC without hardware validation.

Expose a read-only /sys/kernel/debug/ppe/meter dump with the allocated
group, requested rate/peakrate/burst, refcount and the live PPE
register value.

The dump walks only the groups this driver allocated.  The window that
holds them (FE + 0x200c, 63 registers 16 bytes apart) is ordinary frame
engine register space: on AN7581 group 2 reads REG_FE_GDM4_RMBI_FRAG at
FE + 0x202c, group 48 lands in the WAN MTU block and most of the rest
reads back deadbeef.  Dumping every group printed those unrelated
registers as if they were meter state, which makes "never programmed"
indistinguishable from "programmed with a rate the driver did not
intend" -- the exact question the dump exists to answer.  A group is
printed only while its refcount is non-zero.

Signed-off-by: OpenWrt <openwrt@example.org>
---
 drivers/net/ethernet/airoha/airoha_eth.h | 59 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/net/ethernet/airoha/airoha_ppe.c | 342 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 drivers/net/ethernet/airoha/airoha_ppe_debugfs.c | 65 ++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 463 insertions(+), 4 deletions(-)
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -397,6 +397,35 @@ struct airoha_foe_mac_info {
 #define AIROHA_FOE_METER_GRP3			GENMASK(8, 5)
 #define AIROHA_FOE_METER_GRP2			GENMASK(4, 0)
 
+/* Per-flow meter groups.  An FOE entry names one through
+ * AIROHA_FOE_SHAPER_ID; 0x7f, the value the driver used to hardcode, is
+ * the vendor's "no meter" sentinel.  The vendor SDK's
+ * PPE_GRP_Meter_CNT()/METER_BASE2 register layout lives at 0x200c +
+ * 16 * group (mode bit 0, trtcm bit 1, tick bit 2, 14-bit token rate at
+ * bit 3, 2-bit bucket code at bit 17), but on AN7581 that FE window
+ * collides with live FE registers and reads 0xdeadbeef, so the driver
+ * skips FE writes and only programs the QDMA0 ingress TRTCM block
+ * (0x1fb54070, 0..62 index space), see airoha_ppe_meter_hw_config().
+ */
+#define AIROHA_PPE_METER_NUM		63
+#define AIROHA_PPE_METER_NONE		0x7f
+#define AIROHA_PPE_METER_GROUP(_n)	(0x200c + ((_n) << 4))
+
+#define AIROHA_PPE_METER_MODE		BIT(0)
+#define AIROHA_PPE_METER_TRTCM		BIT(1)
+#define AIROHA_PPE_METER_TICK		BIT(2)
+#define AIROHA_PPE_METER_RATE		GENMASK(16, 3)
+#define AIROHA_PPE_METER_BUCKET		GENMASK(18, 17)
+#define AIROHA_PPE_METER_TOKEN_RATE_MAX	0x3fff
+
+/* Bucket-size encoding in AIROHA_PPE_METER_BUCKET. */
+enum airoha_ppe_meter_bucket {
+	AIROHA_PPE_METER_BUCKET_64K,
+	AIROHA_PPE_METER_BUCKET_32K,
+	AIROHA_PPE_METER_BUCKET_16K,
+	AIROHA_PPE_METER_BUCKET_4K,
+};
+
 struct airoha_foe_bridge {
 	u32 dest_mac_hi;
 
@@ -539,6 +569,12 @@ struct airoha_flow_data {
 		u16 sid;
 		u8 num;
 	} pppoe;
+
+	/* Meter group requested by a tc police action, or
+	 * AIROHA_PPE_METER_NONE.  Carried from the action parser to
+	 * airoha_ppe_foe_entry_prepare().
+	 */
+	u8 meter;
 };
 
 enum airoha_flow_entry_type {
@@ -561,6 +597,12 @@ struct airoha_flow_table_entry {
 
 	struct airoha_foe_stats64 stats;
 	enum airoha_flow_entry_type type;
+
+	/* Meter group owned by this flow, AIROHA_PPE_METER_NONE if it
+	 * was offloaded without a police action.
+	 */
+	u8 meter;
+
 	u32 ingress_dev_idx;
 	unsigned long ingress_stamp;
 	unsigned long no_hw_since;
@@ -685,6 +727,13 @@ enum airoha_ppe_entry_alias {
 	AIROHA_PPE_ENTRY_ALIAS_FAILED,
 };
 
+struct airoha_ppe_meter {
+	u32 refcount;
+	u32 rate_bps;
+	u32 peakrate_bps;
+	u32 burst;
+};
+
 struct airoha_ppe {
 	struct airoha_ppe_dev dev;
 	struct airoha_eth *eth;
@@ -720,6 +769,14 @@ struct airoha_ppe {
 	u32 bind_rate_l3;
 	u32 bind_rate_l2b;
 
+	/* tc police flow state.  Only touched while airoha_ppe_meter is
+	 * enabled; allocation, the register writes, release and the debugfs
+	 * dump are serialized by flow_offload_mutex in airoha_ppe.c.
+	 */
+	DECLARE_BITMAP(meter_bitmap, AIROHA_PPE_METER_NUM);
+	struct airoha_ppe_meter meter[AIROHA_PPE_METER_NUM];
+	bool meter_enabled;
+
 	struct dentry *debugfs_dir;
 };
 
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -61,6 +61,295 @@ static const struct rhashtable_params ai
 	.automatic_shrinking = true,
 };
 
+/* Opt-in PoC: move tc police flows from the software path to the PPE
+ * and QDMA meter groups.  Off by default so that, with the parameter at
+ * 0, the driver keeps the exact behaviour it had before this feature:
+ * FLOW_ACTION_POLICE is still refused, every entry keeps SHAPER_ID =
+ * AIROHA_PPE_METER_NONE and no meter register is ever written.
+ */
+static bool airoha_ppe_meter;
+module_param(airoha_ppe_meter, bool, 0644);
+MODULE_PARM_DESC(airoha_ppe_meter,
+		 "Offload tc police flows onto the PPE/QDMA meter groups");
+
+/* A per-flow meter pairs an FOE entry's SHAPER_ID group number with the
+ * QDMA0 ingress TRTCM index of the same number.  The QDMA side uses the
+ * parameter register and byte-mode unit scheme already driven by the
+ * mainline HTB and RX-ring paths in airoha_eth.c; writes to the vendor
+ * SDK's FE + 0x200c + 16 * group window are skipped on AN7581 because
+ * that range reads 0xdeadbeef and collides with live FE registers
+ * (REG_FE_GDM4_RMBI_FRAG at 0x202c, REG_SP_DFT_CPORT(3) at 0x20ec).
+ */
+static u32 airoha_ppe_meter_qdma_param_word(u8 group,
+					    enum trtcm_param_type type)
+{
+	return FIELD_PREP(RATE_LIMIT_PARAM_TYPE_MASK, type) |
+	       FIELD_PREP(RATE_LIMIT_METER_GROUP_MASK,
+			  QDMA_METER_GROUP(group)) |
+	       FIELD_PREP(RATE_LIMIT_PARAM_INDEX_MASK, QDMA_METER_IDX(group));
+}
+
+static int airoha_ppe_meter_qdma_get(struct airoha_qdma *qdma, u8 group,
+				     u32 addr, enum trtcm_param_type type,
+				     u32 *val)
+{
+	u32 config = airoha_ppe_meter_qdma_param_word(group, type);
+	u32 data = 0;
+
+	airoha_qdma_wr(qdma, REG_TRTCM_CFG_PARAM(addr), config);
+	if (read_poll_timeout(airoha_qdma_rr, data,
+			      data & RATE_LIMIT_PARAM_RW_DONE_MASK,
+			      USEC_PER_MSEC, 10 * USEC_PER_MSEC, true,
+			      qdma, REG_TRTCM_CFG_PARAM(addr)))
+		return -ETIMEDOUT;
+
+	*val = airoha_qdma_rr(qdma, REG_TRTCM_DATA_LOW(addr));
+
+	return 0;
+}
+
+static int airoha_ppe_meter_qdma_set(struct airoha_qdma *qdma, u8 group,
+				     u32 addr, enum trtcm_param_type type,
+				     u32 val)
+{
+	u32 config = RATE_LIMIT_PARAM_RW_MASK |
+		     airoha_ppe_meter_qdma_param_word(group, type);
+	int i;
+
+	/* The block can be in the middle of a bucket update; the vendor
+	 * SDK retries the whole read-back sequence in that case.
+	 */
+	for (i = 0; i < TRTCM_CONFIG_RETRY_MAX; i++) {
+		u32 data = 0;
+
+		airoha_qdma_wr(qdma, REG_TRTCM_DATA_LOW(addr), val);
+		airoha_qdma_wr(qdma, REG_TRTCM_CFG_PARAM(addr), config);
+		if (read_poll_timeout(airoha_qdma_rr, data,
+				      data & RATE_LIMIT_PARAM_RW_DONE_MASK,
+				      USEC_PER_MSEC, 10 * USEC_PER_MSEC,
+				      true, qdma,
+				      REG_TRTCM_CFG_PARAM(addr)))
+			continue;
+
+		if (airoha_ppe_meter_qdma_get(qdma, group, addr, type, &data))
+			continue;
+		if (data == val)
+			return 0;
+	}
+
+	return -EBUSY;
+}
+
+static void airoha_ppe_meter_hw_disable(struct airoha_eth *eth, u8 group)
+{
+	struct airoha_qdma *qdma = &eth->qdma[0];
+	u32 misc = 0;
+
+	/* Do not write AIROHA_PPE_METER_GROUP(group) in the FE window:
+	 * 0x200c + 16 * group reads 0xdeadbeef on AN7581 and collides
+	 * with live FE registers (group 2 = REG_FE_GDM4_RMBI_FRAG at
+	 * 0x202c, group 14 = REG_SP_DFT_CPORT(3) at 0x20ec).
+	 */
+	if (airoha_ppe_meter_qdma_get(qdma, group, REG_INGRESS_TRTCM_CFG,
+				      TRTCM_MISC_MODE, &misc))
+		return;
+	if (!(misc & TRTCM_METER_MODE))
+		return;
+
+	misc &= ~TRTCM_METER_MODE;
+	airoha_ppe_meter_qdma_set(qdma, group, REG_INGRESS_TRTCM_CFG,
+				  TRTCM_MISC_MODE, misc);
+}
+
+static int airoha_ppe_meter_hw_config(struct airoha_eth *eth, u8 group,
+				      u64 rate_bytes_ps, u64 burst)
+{
+	struct airoha_qdma *qdma = &eth->qdma[0];
+	u64 rate_bits_ps, rate_kbps, rate64;
+	u32 config, fast_tick, slow_ratio, tick_us, unit;
+	u32 rate, frac, rate_val, bucket, misc, burst_u32;
+	bool slow_tick;
+	int err;
+
+	if (!rate_bytes_ps || !burst)
+		return -EINVAL;
+	if (rate_bytes_ps > (U64_MAX - 999) / 8)
+		return -ERANGE;
+
+	rate_bits_ps = rate_bytes_ps * 8;
+	burst_u32 = min_t(u64, burst, U32_MAX);
+
+	/* The ingress TRTCM index space is shared with the per-RX-ring
+	 * matchall meters (rings 0..7).  This PoC uses the PPE group
+	 * number as the QDMA index so both ends stay in lockstep; a
+	 * deployment should not combine it with matchall police on the
+	 * same QDMA.
+	 */
+	config = airoha_qdma_rr(qdma, REG_INGRESS_TRTCM_CFG);
+	if (!(config & INGRESS_TRTCM_EN_MASK))
+		return -EOPNOTSUPP;
+	if (config & INGRESS_TRTCM_MODE_MASK) {
+		/* The probe leaves ingress in rate-limit mode, where each
+		 * index carries one rate.  TRTCM mode pairs indexes and
+		 * changes the meaning of the whole RX-ring space, so do
+		 * not repurpose the block here.
+		 */
+		return -EOPNOTSUPP;
+	}
+
+	fast_tick = FIELD_GET(INGRESS_FAST_TICK_MASK, config);
+	slow_ratio = FIELD_GET(INGRESS_SLOW_TICK_RATIO_MASK, config);
+	slow_tick = rate_bits_ps < 100000000ULL; /* vendor: 100 Mbit/s */
+	tick_us = slow_tick ? fast_tick * slow_ratio : fast_tick;
+	if (!tick_us)
+		return -EINVAL;
+	unit = 8000 / tick_us; /* kbit/s per count */
+	if (!unit)
+		return -EINVAL;
+
+	rate_kbps = DIV_ROUND_UP_ULL(rate_bits_ps, 1000);
+	rate64 = div_u64_rem(rate_kbps, unit, &frac);
+	frac = FIELD_PREP(TRTCM_TOKEN_RATE_MASK, frac) / unit;
+	if (rate64 > (TRTCM_TOKEN_RATE_MASK >> 6)) {
+		rate = TRTCM_TOKEN_RATE_MASK >> 6;
+		frac = 0;
+	} else {
+		rate = rate64;
+	}
+	rate_val = FIELD_PREP(TRTCM_TOKEN_RATE_MASK, rate) |
+		   FIELD_PREP(TRTCM_TOKEN_RATE_FRACTION_MASK, frac);
+
+	bucket = max_t(u32, burst_u32, MIN_TOKEN_SIZE);
+	bucket = min_t(u32, __fls(bucket), MAX_TOKEN_SIZE_OFFSET);
+
+	if (airoha_ppe_meter_qdma_get(qdma, group, REG_INGRESS_TRTCM_CFG,
+				      TRTCM_MISC_MODE, &misc))
+		return -EINVAL;
+	misc &= ~(TRTCM_PKT_MODE | TRTCM_TICK_SEL);
+	misc |= TRTCM_METER_MODE;
+	if (slow_tick)
+		misc |= TRTCM_TICK_SEL;
+
+	err = airoha_ppe_meter_qdma_set(qdma, group, REG_INGRESS_TRTCM_CFG,
+					TRTCM_MISC_MODE, misc);
+	if (err)
+		return err;
+	err = airoha_ppe_meter_qdma_set(qdma, group, REG_INGRESS_TRTCM_CFG,
+					TRTCM_TOKEN_RATE_MODE, rate_val);
+	if (err)
+		goto err_disable_qdma;
+	err = airoha_ppe_meter_qdma_set(qdma, group, REG_INGRESS_TRTCM_CFG,
+					TRTCM_BUCKETSIZE_SHIFT_MODE, bucket);
+	if (err)
+		goto err_disable_qdma;
+
+	/* Skip writing FE + AIROHA_PPE_METER_GROUP(group): on AN7581 that
+	 * window reads 0xdeadbeef and collides with live FE registers
+	 * (group 2 = REG_FE_GDM4_RMBI_FRAG, group 14 = REG_SP_DFT_CPORT(3)).
+	 */
+	return 0;
+
+err_disable_qdma:
+	airoha_ppe_meter_qdma_set(qdma, group, REG_INGRESS_TRTCM_CFG,
+				  TRTCM_MISC_MODE, misc & ~TRTCM_METER_MODE);
+	return err;
+}
+
+static int airoha_ppe_meter_validate(const struct flow_action_entry *act,
+				     struct netlink_ext_ack *extack)
+{
+	const struct flow_action_police *police = &act->police;
+
+	if (!airoha_ppe_meter)
+		return -EOPNOTSUPP;
+
+	if (police->exceed.act_id != FLOW_ACTION_DROP) {
+		NL_SET_ERR_MSG_MOD(extack, "police exceed action must drop");
+		return -EOPNOTSUPP;
+	}
+	if (police->notexceed.act_id != FLOW_ACTION_ACCEPT) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "police not-exceed action must accept");
+		return -EOPNOTSUPP;
+	}
+	if (police->rate_pkt_ps || police->burst_pkt) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "packet-rate police is not supported");
+		return -EOPNOTSUPP;
+	}
+	if (police->avrate || police->overhead || police->mtu) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "avrate/overhead/mtu police is not supported");
+		return -EOPNOTSUPP;
+	}
+	/* The PPE group carries one token rate and the probe leaves the
+	 * QDMA block in rate-limit mode, so there is no second bucket to
+	 * put a PIR in.  Refuse it instead of quietly shaping at CIR and
+	 * calling it done.
+	 */
+	if (police->peakrate_bytes_ps) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "peakrate police is not implemented yet");
+		return -EOPNOTSUPP;
+	}
+	if (!police->rate_bytes_ps) {
+		NL_SET_ERR_MSG_MOD(extack, "police rate must be non-zero");
+		return -EINVAL;
+	}
+	if (!police->burst) {
+		NL_SET_ERR_MSG_MOD(extack, "police burst must be non-zero");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int airoha_ppe_meter_alloc(struct airoha_ppe *ppe,
+				  const struct flow_action_entry *act,
+				  u8 *group)
+{
+	int id = find_first_zero_bit(ppe->meter_bitmap, AIROHA_PPE_METER_NUM);
+	int err;
+
+	if (id >= AIROHA_PPE_METER_NUM)
+		return -EBUSY;
+
+	err = airoha_ppe_meter_hw_config(ppe->eth, id, act->police.rate_bytes_ps,
+					 act->police.burst);
+	if (err)
+		return err;
+
+	set_bit(id, ppe->meter_bitmap);
+	ppe->meter[id].refcount = 1;
+	ppe->meter[id].rate_bps = min_t(u64, act->police.rate_bytes_ps,
+					U32_MAX);
+	ppe->meter[id].peakrate_bps =
+		min_t(u64, act->police.peakrate_bytes_ps, U32_MAX);
+	ppe->meter[id].burst = act->police.burst;
+	*group = id;
+
+	return 0;
+}
+
+static void airoha_ppe_meter_free(struct airoha_ppe *ppe, u8 group)
+{
+	if (group >= AIROHA_PPE_METER_NUM)
+		return;
+	if (!test_bit(group, ppe->meter_bitmap))
+		return;
+
+	if (WARN_ON_ONCE(!ppe->meter[group].refcount))
+		goto release;
+
+	if (--ppe->meter[group].refcount)
+		return;
+
+release:
+	clear_bit(group, ppe->meter_bitmap);
+	memset(&ppe->meter[group], 0, sizeof(ppe->meter[group]));
+	airoha_ppe_meter_hw_disable(ppe->eth, group);
+}
+
 /* How many counter slots per PPE this build could ask the NPU for.  This is
  * a property of the build and the SoC, not of what the NPU ended up agreeing
  * to, and it has to stay that way: the counter buffer is allocated in
@@ -704,7 +998,7 @@ static int airoha_ppe_foe_entry_prepare(
 	if (airoha_ppe_netdev_is_shaped(egress))
 		return -EOPNOTSUPP;
 
-	qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f);
+	qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, data->meter);
 
 	val = FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE, AIROHA_FOE_STATE_BIND) |
 	      FIELD_PREP(AIROHA_FOE_IB1_BIND_PACKET_TYPE, type) |
@@ -1364,6 +1658,13 @@ static void airoha_ppe_foe_flow_remove_e
 
 	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T)
 		airoha_ppe_put_smac_id(ppe->eth, smac_id);
+
+	/* The meter group is released only after the hardware entry has
+	 * been invalidated, so the group cannot be reused while an FOE
+	 * entry still names it.
+	 */
+	if (e->meter != AIROHA_PPE_METER_NONE)
+		airoha_ppe_meter_free(ppe, e->meter);
 }
 
 static int
@@ -1731,11 +2032,14 @@ static int airoha_ppe_flow_offload_repla
 {
 	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
 	struct airoha_flow_table_entry *e;
-	struct airoha_flow_data data = {};
+	struct airoha_flow_data data = {
+		.meter = AIROHA_PPE_METER_NONE,
+	};
 	struct net_device *odev = NULL;
+	const struct flow_action_entry *police = NULL;
 	struct flow_action_entry *act;
 	struct flow_match_meta meta;
-	u8 dsfield = 0, l4proto = 0;
+	u8 dsfield = 0, l4proto = 0, meter = AIROHA_PPE_METER_NONE;
 	struct airoha_foe_entry hwe;
 	struct net_device *indev;
 	bool bridged, has_ports, use_3t;
@@ -1840,6 +2144,18 @@ static int airoha_ppe_flow_offload_repla
 			data.pppoe.sid = act->pppoe.sid;
 			data.pppoe.num++;
 			break;
+		case FLOW_ACTION_POLICE:
+			if (offload_type == PPE_PKT_TYPE_BRIDGE)
+				return -EOPNOTSUPP;
+			if (police)
+				return -EOPNOTSUPP;
+
+			err = airoha_ppe_meter_validate(act, f->common.extack);
+			if (err)
+				return err;
+
+			police = act;
+			break;
 		default:
 			return -EOPNOTSUPP;
 		}
@@ -1849,6 +2165,19 @@ static int airoha_ppe_flow_offload_repla
 	    !is_valid_ether_addr(data.eth.h_dest))
 		return -EINVAL;
 
+	/* Allocate the meter only after every action and the L2 header
+	 * have been accepted: all the early returns above then stay
+	 * allocation-free, and from here on put_smac is the single
+	 * cleanup path.
+	 */
+	if (police) {
+		err = airoha_ppe_meter_alloc(eth->ppe, police, &meter);
+		if (err)
+			return err;
+
+		data.meter = meter;
+	}
+
 	/* A flow whose ingress and egress devices are both ports of the same
 	 * bridge never leaves L2, so the PPE must forward it without touching
 	 * the IP TTL.  Routing -- including entering or leaving the bridge --
@@ -1872,7 +2201,7 @@ static int airoha_ppe_flow_offload_repla
 	err = airoha_ppe_foe_entry_prepare(eth, &hwe, odev, offload_type,
 					   &data, l4proto, dsfield, bridged);
 	if (err)
-		return err;
+		goto put_smac;
 
 	if (has_ports) {
 		struct flow_match_ports ports;
@@ -1956,6 +2285,7 @@ static int airoha_ppe_flow_offload_repla
 	}
 
 	e->cookie = f->cookie;
+	e->meter = meter;
 	e->ingress_dev_idx = meta.key->ingress_ifindex;
