+/* Read-only view of the opt-in per-flow meters.  The software record is
+ * what was requested; the register value next to it is what the PPE
+ * actually holds, so a dump can tell "never programmed" apart from
+ * "programmed with a rate the driver did not intend".
+ */
+static int airoha_ppe_debugfs_meter_show(struct seq_file *m, void *private)
+{
+	static const u32 bucket_kb[] = { 64, 32, 16, 4 };
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	int i;
+
+	seq_printf(m, "enabled=%u groups=%u\n", ppe->meter_enabled,
+		   AIROHA_PPE_METER_NUM);
+
+	for (i = 0; i < AIROHA_PPE_METER_NUM; i++) {
+		const struct airoha_ppe_meter *meter = &ppe->meter[i];
+		u32 reg = airoha_fe_rr(eth, AIROHA_PPE_METER_GROUP(i));
+		u32 bucket = FIELD_GET(AIROHA_PPE_METER_BUCKET, reg);
+		u32 rate = FIELD_GET(AIROHA_PPE_METER_RATE, reg);
+		u64 hw_rate = (u64)rate *
+			      ((reg & AIROHA_PPE_METER_TICK) ? 16000 : 128000);
+
+		if (!meter->refcount && !reg)
+			continue;
+
+		seq_printf(m,
+			   "meter %2u refcount %u rate %u peakrate %u burst %u",
+			   i, meter->refcount, meter->rate_bps,
+			   meter->peakrate_bps, meter->burst);
+		seq_printf(m, " hw_rate %llu hw_bucket %uK reg %08x\n",
+			   hw_rate, bucket_kb[bucket & 3], reg);
+	}
+
+	return 0;
+}
