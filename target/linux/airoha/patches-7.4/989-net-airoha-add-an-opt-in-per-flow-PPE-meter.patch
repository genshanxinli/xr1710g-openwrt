@@ -1798,9 +2128,9 @@ static int airoha_ppe_flow_offload_repla
 	err = airoha_ppe_foe_entry_prepare(eth, &hwe, odev, offload_type,
 					   &data, l4proto, dsfield, bridged);
 	if (err)
-		return err;
+		goto put_smac;
 
-	if (has_ports) {
