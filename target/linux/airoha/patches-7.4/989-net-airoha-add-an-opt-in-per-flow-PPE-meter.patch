+/* Read-only view of the opt-in per-flow meters.  The software columns are
+ * what tc requested.  reg is the frame-engine word returned at
+ * FE + 0x200c + 16 * group; on AN7581 that read returns 0xdeadbeef, so
+ * hw_rate and hw_bucket derived from it are not the rate the PPE holds.
+ * FE writes are skipped on AN7581 (and the vendor layout uses only bits
+ * 2..18: TICK bit 2, RATE bits 16..3, BUCKET bits 18..17),
+ * so a word with bit 31 set cannot be that write coming back.  The three
+ * register columns stay so a vendor-SDK dump can be compared once silicon
+ * answers at this offset.
+ */
+static int airoha_ppe_debugfs_meter_show(struct seq_file *m, void *private)
+{
+	static const u32 bucket_kb[] = { 64, 32, 16, 4 };
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	int i;
+
+	/* enabled= is the value airoha_ppe_meter had when this module
+	 * probed, not the live switch: airoha_ppe_meter is writable at run
+	 * time and the gate that accepts a police action
+	 * (airoha_ppe_meter_validate()) reads the parameter itself.  For the
+	 * current value read
+	 * /sys/module/airoha_eth/parameters/airoha_ppe_meter.  This field
+	 * keeps the probe-time snapshot on purpose: it is the only place
+	 * that records whether the image that booted had the meter on, and
+	 * making it follow the parameter would trade that away.
+	 * groups_total= is AIROHA_PPE_METER_NUM, not the number of free groups.
+	 */
+	seq_printf(m, "enabled=%u groups_total=%u\n", ppe->meter_enabled,
+		   AIROHA_PPE_METER_NUM);
+
+	mutex_lock(&flow_offload_mutex);
+	for (i = 0; i < AIROHA_PPE_METER_NUM; i++) {
+		const struct airoha_ppe_meter *meter = &ppe->meter[i];
+		u32 reg, bucket, rate;
+		u64 hw_rate;
+
+		/* Only a group this driver allocated has its state in
+		 * ppe->meter[].  The register window holding the groups is
+		 * shared with the rest of the frame engine, so reading a
+		 * group that was never ours returns an unrelated register
+		 * (0x200c + 16 * i, a fragment counter, a WAN MTU, ...)
+		 * that cannot be told apart from a programmed meter.
+		 */
+		if (!meter->refcount)
+			continue;
+
+		reg = airoha_fe_rr(eth, AIROHA_PPE_METER_GROUP(i));
+		bucket = FIELD_GET(AIROHA_PPE_METER_BUCKET, reg);
+		rate = FIELD_GET(AIROHA_PPE_METER_RATE, reg);
+		hw_rate = (u64)rate *
+			  ((reg & AIROHA_PPE_METER_TICK) ? 16000 : 128000);
+
+		seq_printf(m,
+			   "meter %2u refcount %u rate %u peakrate %u burst %u",
+			   i, meter->refcount, meter->rate_bps,
+			   meter->peakrate_bps, meter->burst);
+		seq_printf(m, " hw_rate %llu hw_bucket %uK reg %08x\n",
+			   hw_rate, bucket_kb[bucket & 3], reg);
+	}
+	mutex_unlock(&flow_offload_mutex);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_meter);
