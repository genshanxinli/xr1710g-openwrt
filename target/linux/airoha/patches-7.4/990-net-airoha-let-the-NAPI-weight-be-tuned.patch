+/* The RX and TX NAPI instances are registered with this weight.  It
+ * defaults to NAPI_POLL_WEIGHT (64), which is what the driver hardcoded
+ * before this knob existed, so an untouched parameter keeps the old round
+ * size.  Out-of-range requests are clamped instead of rejected so that a
+ * typo on the kernel command line still boots, and the clamp is reported
+ * once via dev_warn.
+ *
+ * The weight is latched when a NAPI instance is registered, so a write
+ * after probe shows up in the read-back and takes effect on the next probe
+ * (boot or a driver rebind), not on the instances already running.
+ */
+#define AIROHA_NAPI_MIN_WEIGHT		16
+#define AIROHA_NAPI_MAX_WEIGHT		512
+#define AIROHA_NAPI_DEFAULT_WEIGHT	NAPI_POLL_WEIGHT
+
+static_assert(AIROHA_NAPI_DEFAULT_WEIGHT == 64);
+
+static uint airoha_napi_weight = AIROHA_NAPI_DEFAULT_WEIGHT;
+static uint airoha_napi_weight_rejected;
+static struct device *airoha_napi_weight_dev;
+static bool airoha_napi_weight_clamped;
+static bool airoha_napi_weight_warned;
+static DEFINE_MUTEX(airoha_napi_weight_lock);
+
+/* The caller holds airoha_napi_weight_lock, which keeps the device pointer
+ * alive until the warning has been emitted.
+ */
+static void airoha_napi_weight_warn_clamped(void)
+{
+	if (!airoha_napi_weight_clamped || airoha_napi_weight_warned ||
+	    !airoha_napi_weight_dev)
+		return;
+
+	airoha_napi_weight_warned = true;
+	dev_warn(airoha_napi_weight_dev,
+		 "napi_weight %u out of range (%u..%u), using %u\n",
+		 airoha_napi_weight_rejected, AIROHA_NAPI_MIN_WEIGHT,
+		 AIROHA_NAPI_MAX_WEIGHT, READ_ONCE(airoha_napi_weight));
+}
+
+static int airoha_napi_weight_set(const char *val,
+				  const struct kernel_param *kp)
+{
+	uint weight;
+	int err;
+
+	err = kstrtouint(val, 0, &weight);
+	if (err)
+		return err;
+
+	mutex_lock(&airoha_napi_weight_lock);
+	if (weight < AIROHA_NAPI_MIN_WEIGHT ||
+	    weight > AIROHA_NAPI_MAX_WEIGHT) {
+		airoha_napi_weight_rejected = weight;
+		weight = clamp(weight, AIROHA_NAPI_MIN_WEIGHT,
+			       AIROHA_NAPI_MAX_WEIGHT);
+		airoha_napi_weight_clamped = true;
+	}
+
+	WRITE_ONCE(airoha_napi_weight, weight);
+	airoha_napi_weight_warn_clamped();
+	mutex_unlock(&airoha_napi_weight_lock);
+
+	return 0;
+}
+
+static const struct kernel_param_ops airoha_napi_weight_ops = {
+	.set	= airoha_napi_weight_set,
+	.get	= param_get_uint,
+};
+
+module_param_cb(napi_weight, &airoha_napi_weight_ops, &airoha_napi_weight,
+		0644);
+MODULE_PARM_DESC(napi_weight, "QDMA RX/TX NAPI weight (16-512, default 64)");
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
