 }
+
+static int airoha_qdma_debugfs_napi_weight_show(struct seq_file *m,
+						void *private)
+{
+	seq_printf(m, "napi_weight %u\n", READ_ONCE(airoha_napi_weight));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_qdma_debugfs_napi_weight);
+
+static void airoha_qdma_debugfs_init(struct airoha_eth *eth)
+{
+	eth->qdma_debugfs_dir = debugfs_create_dir("qdma", NULL);
+	debugfs_create_file("napi_weight", 0444, eth->qdma_debugfs_dir, NULL,
+			    &airoha_qdma_debugfs_napi_weight_fops);
+}
