 	/* Note: we do not own yet a reference on net.
 	 * This reference might be taken later from tcf_exts_get_net().
 	 */
@@ -3432,6 +3642,7 @@ void tcf_exts_destroy(struct tcf_exts *e
 	tcf_exts_miss_cookie_base_destroy(exts);
 
 #ifdef CONFIG_NET_CLS_ACT
+	tcf_exts_shaper_destroy(exts);
 	if (exts->actions) {
 		tcf_action_destroy(exts->actions, TCA_ACT_UNBIND);
 		kfree(exts->actions);
@@ -3482,6 +3693,18 @@ int tcf_exts_validate_ex(struct net *net
 				return err;
 			exts->nr_actions = err;
 		}
+
+		if (exts->nr_actions) {
+			int err = tcf_exts_shaper_register(exts, tp);
+
+			if (err) {
+				tcf_action_destroy(exts->actions,
+						   TCA_ACT_UNBIND);
+				exts->nr_actions = 0;
+				exts->type = 0;
+				return err;
+			}
+		}
 	}
 #else
 	if ((exts->action && tb[exts->action]) ||
@@ -3510,6 +3733,7 @@ void tcf_exts_change(struct tcf_exts *ds
 	struct tcf_exts old = *dst;
 
 	*dst = *src;
+	src->shaper_node = NULL;
 	tcf_exts_destroy(&old);
 #endif
 }
