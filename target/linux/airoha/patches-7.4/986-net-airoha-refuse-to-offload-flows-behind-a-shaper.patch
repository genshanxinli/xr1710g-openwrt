+#ifdef CONFIG_NET_CLS_ACT
+static DEFINE_SPINLOCK(tcf_block_shaper_lock);
+
+struct tcf_exts_shaper_node {
+	struct list_head list;
+	struct tcf_block *block;
+	struct rcu_head rcu;
+	bool has_police;
+	unsigned int nr_mirred;
+	struct tc_action *mirred[];
+};
+
+static void tcf_exts_shaper_destroy(struct tcf_exts *exts)
+{
+	struct tcf_exts_shaper_node *node = exts->shaper_node;
+
+	if (!node)
+		return;
+
+	exts->shaper_node = NULL;
+	spin_lock_bh(&tcf_block_shaper_lock);
+	if (node->block) {
+		list_del_rcu(&node->list);
+		node->block = NULL;
+	}
+	spin_unlock_bh(&tcf_block_shaper_lock);
+	kfree_rcu(node, rcu);
+}
+
+static int tcf_exts_shaper_register(struct tcf_exts *exts,
+				    struct tcf_proto *tp)
+{
+	struct tcf_exts_shaper_node *node;
+	struct tcf_block *block;
+	struct tc_action *a;
+	unsigned int nr_mirred = 0, idx = 0;
+	bool has_police = false;
+	int i;
+
+	tcf_exts_shaper_destroy(exts);
+
+	if (!tp || !tp->chain || !tp->chain->block ||
+	    !exts->actions || !exts->nr_actions)
+		return 0;
+
+	tcf_exts_for_each_action(i, a, exts) {
+		if (a->ops && a->ops->id == TCA_ID_POLICE)
+			has_police = true;
+		else if (is_tcf_mirred_egress_redirect(a) ||
+			 is_tcf_mirred_ingress_redirect(a))
+			nr_mirred++;
+	}
+
+	if (!has_police && !nr_mirred)
+		return 0;
+
+	node = kzalloc(struct_size(node, mirred, nr_mirred),
+		       GFP_KERNEL_ACCOUNT);
+	if (!node)
+		return -ENOMEM;
+
+	node->has_police = has_police;
+	node->nr_mirred = nr_mirred;
+	tcf_exts_for_each_action(i, a, exts) {
+		if (is_tcf_mirred_egress_redirect(a) ||
+		    is_tcf_mirred_ingress_redirect(a))
+			node->mirred[idx++] = a;
+	}
+
+	block = tp->chain->block;
+	spin_lock_bh(&tcf_block_shaper_lock);
+	node->block = block;
+	list_add_rcu(&node->list, &block->shaper_list);
+	spin_unlock_bh(&tcf_block_shaper_lock);
+
+	exts->shaper_node = node;
+	return 0;
+}
+
+static void tcf_block_shaper_flush(struct tcf_block *block)
+{
+	struct tcf_exts_shaper_node *node, *tmp;
+
+	spin_lock_bh(&tcf_block_shaper_lock);
+	list_for_each_entry_safe(node, tmp, &block->shaper_list, list) {
+		list_del_rcu(&node->list);
+		node->block = NULL;
+	}
+	spin_unlock_bh(&tcf_block_shaper_lock);
+}
+#else
+static inline void tcf_exts_shaper_destroy(struct tcf_exts *exts)
+{
+}
+
+static inline void tcf_block_shaper_flush(struct tcf_block *block)
+{
+}
+#endif
+
+static const char *const tc_sw_shaping_qdiscs[] = {
+	"tbf",
+	"htb",
+	"hfsc",
+	"cake",
+	"cake_mq",
+	"netem",
+	"mqprio",
+	"cbs",
+	"etf",
+	"taprio",
+};
+
+static bool tc_qdisc_is_sw_shaper(const struct Qdisc *q)
+{
+	size_t i;
+
+	if (!q || !q->ops || (q->flags & (TCQ_F_BUILTIN | TCQ_F_OFFLOADED)))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(tc_sw_shaping_qdiscs); i++) {
+		if (!strcmp(q->ops->id, tc_sw_shaping_qdiscs[i]))
+			return true;
+	}
+
+	return false;
+}
+
+static bool tc_netdev_has_egress_shaper_rcu(const struct net_device *dev)
+{
+	const struct Qdisc *q;
+	unsigned int bkt;
+
+	q = rcu_dereference(dev->qdisc);
+	if (tc_qdisc_is_sw_shaper(q))
+		return true;
+
+	if (q && (q->flags & TCQ_F_MQROOT)) {
+		unsigned int ntx;
+
+		for (ntx = 0; ntx < dev->num_tx_queues; ntx++) {
+			const struct netdev_queue *txq =
+				netdev_get_tx_queue(dev, ntx);
+
+			if (tc_qdisc_is_sw_shaper(rcu_dereference(txq->qdisc_sleeping)))
+				return true;
+		}
+	}
+
+	hash_for_each_rcu(dev->qdisc_hash, bkt, q, hash) {
+		if (tc_qdisc_is_sw_shaper(q))
+			return true;
+	}
+
+	return false;
+}
+
+bool tc_netdev_has_shaper_rcu(const struct net_device *dev)
+{
+	if (!dev)
+		return false;
+
+	if (tc_netdev_has_egress_shaper_rcu(dev))
+		return true;
+
+#if defined(CONFIG_NET_XGRESS) && defined(CONFIG_NET_CLS_ACT)
+	{
+		struct bpf_mprog_entry *entry;
+
+		entry = rcu_dereference(dev->tcx_ingress);
+		if (entry) {
+			struct mini_Qdisc *miniq;
+
+			miniq = rcu_dereference(tcx_entry(entry)->miniq);
+			if (miniq && miniq->block) {
+				struct tcf_exts_shaper_node *node;
+
+				list_for_each_entry_rcu(node,
+							&miniq->block->shaper_list,
+							list) {
+					unsigned int i;
+
+					if (node->has_police)
+						return true;
+
+					for (i = 0; i < node->nr_mirred; i++) {
+						const struct net_device *target;
+
+						target = rcu_dereference(
+							to_mirred(node->mirred[i])->tcfm_dev);
+						if (target &&
+						    tc_netdev_has_egress_shaper_rcu(target))
+							return true;
+					}
+				}
+			}
+		}
+	}
+#endif
+
+	return false;
+}
+EXPORT_SYMBOL_GPL(tc_netdev_has_shaper_rcu);
