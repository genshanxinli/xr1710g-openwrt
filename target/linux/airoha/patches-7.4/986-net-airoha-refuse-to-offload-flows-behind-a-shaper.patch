+static bool airoha_ppe_flow_is_shaped(const struct net_device *egress,
+				      int ingress_ifindex)
+{
+	bool shaped = false;
+
+	if (!egress)
+		return false;
+
+	rcu_read_lock();
+	if (tc_netdev_has_shaper_rcu(egress)) {
+		shaped = true;
+	} else if (ingress_ifindex > 0) {
+		struct net_device *ingress;
+
+		ingress = dev_get_by_index_rcu(dev_net(egress),
+					       ingress_ifindex);
+		if (ingress && tc_netdev_has_shaper_rcu(ingress))
+			shaped = true;
+	}
+	rcu_read_unlock();
+
+	return shaped;
+}
