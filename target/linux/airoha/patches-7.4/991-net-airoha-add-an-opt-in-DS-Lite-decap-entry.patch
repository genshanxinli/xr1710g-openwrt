From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt <openwrt@example.org>
Date: Sun, 15 Nov 2026 07:00:00 +0800
Subject: [PATCH] net: airoha: add an opt-in DS-Lite decapsulation entry path

The PPE has a dedicated IPv4-in-IPv6 DS-Lite packet type (type 3), but the
Linux driver never produces one: the type only exists in the debugfs name
table and the hash path treats it as unreachable.  This adds the minimal
decapsulation path.

The feature is opt-in through the airoha_ppe_dslite module parameter.  At
0 (default) nothing changes: no packet type 3 entry is built, the PPE flow
configuration is not touched and every flow keeps the old path.

At 1 the driver enables PPE_FLOW_CFG bit 14 (IP4_DSLITE), which is what
makes the parser create UNBIND entries for these packets, and turns a
flowtable rule whose ingress netdev is an IPv6 tunnel (ARPHRD_TUNNEL6 with
a 16-byte address, i.e. ip6_tnl in ipip6 mode) and whose inner address
family is IPv4 into a packet type 3 entry.  For such a flow it fills:

  - the tunnel marker, represented by the packet type itself (packet type
    3 is DS-Lite; the DS-Lite layout has no separate generic tunnel bit);
  - the inner IPv4 tuple (sip/dip/sport/dport), using the DS-Lite member
    of the FOE union;
  - rmt (IB1 bit 23), the vendor SDK's "remove tunnel IP header
    (6rd/dslite only)" flag, so the outer IPv6 header is stripped;
  - tunnel_mtu, taken from the MTU the IPv6 tunnel netdev advertises, so
    the inner packet is checked after the outer header disappears;
  - tunnel_id, the 4-bit UPDMEM IPv6 index the vendor SDK calls ip6_idx,
    left at 0 because this path does not program an outer IPv6 slot.

The generic tunnel/tunnel_id pair of the other packet types is deliberately
not written.  It selects the 64-entry GRE/VXLAN/L2TP tunnel table and is
reserved in the DS-Lite layout; writing it would turn a decapsulation entry
into a tunnel-table lookup.  This path only offloads the decapsulation
direction, which does not need the outer IPv6 addresses, so no UPDMEM IPv6
slot is programmed.  The reverse direction egresses the tunnel and still
encapsulates in software.

Packet type 3 also has no second tuple for a NAT rewrite.  A DS-Lite flow
whose rule carries NAT mangles is therefore refused and stays in the
software path instead of being programmed with a tuple that would not match
the packet or would translate to the wrong address.

Supporting changes:

  - the hash path maps packet type 3 onto the inner IPv4 hash instead of
    WARNing and putting every DS-Lite flow in slot 0;
  - the NPU counter path skips packet type 3, because it reuses the
    tunnel_mtu word to hide IB2 routing bits and would corrupt the MTU;
  - an IPv4 flow carrying a PPPoE push action is refused when it is also
    a DS-Lite flow instead of encoding two tunnel headers this path does
    not model;
  - ppe/entries no longer decodes the bytes at ipv4.new_tuple as a 5-tuple
    for packet type 3; they are the outer flow label and priority;
  - a read-only /sys/kernel/debug/ppe/dslite (0444) shows the gate, the
    live FLOW_CFG bit and every DS-Lite entry with its tunnel ID, MTU,
    rmt bit, flow label and priority.

Everything else is untouched: table capacity, BND_AGE, PPPoE bit 22, L2B,
QoS, multicast.  Non-DS-Lite flows keep every new field at its memset
value, i.e. zero.

Limitations:

  - Hardware validation is not done: the entry layout comes from the
    vendor SDK and the rmt/tunnel_mtu semantics are not measured on
    AN7581.
  - Only the decapsulation half is offloaded; encapsulation and the UPDMEM
    outer IPv6 compression table are out of scope.
  - NATed DS-Lite decapsulation flows stay in software for the reason
    above.
  - 6RD is not implemented.

Signed-off-by: OpenWrt <openwrt@example.org>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -389,6 +389,15 @@
 #define AIROHA_FOE_TUNNEL			BIT(6)
 #define AIROHA_FOE_TUNNEL_ID			GENMASK(5, 0)
 
+/* Packet type 3 (IPv4-in-IPv6 DS-Lite) has no generic tunnel/tunnel_id
+ * pair.  Its data word carries a 4-bit UPDMEM IPv6 slot instead, the
+ * selector the vendor SDK calls ip6_idx.  The bits the generic pair uses
+ * are reserved here, so they must not be written: a stray tunnel bit
+ * would be read as a tunnel-table lookup by the entry types that do have
+ * that table.  Keep the DS-Lite selector in its own field.
+ */
+#define AIROHA_FOE_DSLITE_TUNNEL_ID		GENMASK(3, 0)
+
 #define AIROHA_FOE_TUNNEL_MTU			GENMASK(31, 16)
 #define AIROHA_FOE_ACNT_GRP3			GENMASK(15, 9)
 #define AIROHA_FOE_METER_GRP3			GENMASK(8, 5)
@@ -567,6 +576,27 @@
 		u8 num;
 	} pppoe;
 
+	/* Parameters of an IPv4-in-IPv6 DS-Lite decapsulation flow.  They
+	 * come from the IPv6 tunnel netdev the inner packet arrived on,
+	 * not from the flow dissector: the kernel exposes the inner IPv4
+	 * tuple and the ingress ifindex, and the ingress device is the
+	 * per-flow DS-Lite mark.
+	 *
+	 * tunnel marks the flow as a tunnel decapsulation; packet type 3
+	 * is the hardware representation of that mark.  rmt is the IB1 bit
+	 * that asks the parser to remove the outer IPv6 header, and
+	 * tunnel_id is the 4-bit UPDMEM IPv6 slot the hardware reads as
+	 * the DS-Lite tunnel selector.  The decapsulation half does not
+	 * need the outer addresses, so the driver never programs a slot
+	 * and tunnel_id stays zero.
+	 */
+	struct {
+		bool tunnel;
+		bool rmt;
+		u8 tunnel_id;
+		u16 tunnel_mtu;
+	} dslite;
+
 	/* Meter group requested by a tc police action, or
 	 * AIROHA_PPE_METER_NONE.  Carried from the action parser to
 	 * airoha_ppe_foe_entry_prepare().
@@ -924,6 +954,11 @@
 void airoha_ppe_foe_entry_get_stats(struct airoha_ppe *ppe, u32 hash,
 				    struct airoha_foe_stats64 *stats);
 
+/* DS-Lite decapsulation offload, default off.  Declared unconditionally
+ * because the flow path reads it whether or not debugfs is compiled in.
+ */
+extern bool airoha_ppe_dslite;
+
 #ifdef CONFIG_DEBUG_FS
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe);
 void airoha_ppe_apply_bind_rate(struct airoha_ppe *ppe);
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -6,6 +6,7 @@
 
 #include <linux/ip.h>
 #include <linux/ipv6.h>
+#include <linux/if_arp.h>
 #include <linux/moduleparam.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
@@ -47,6 +48,22 @@
 MODULE_PARM_DESC(airoha_ppe_3t,
 		 "Offload flows without L4 ports as 3-tuple PPE entries");
 
+/* Offload IPv4-in-IPv6 DS-Lite decapsulation flows to the PPE.  Off by
+ * default: only the positive path of the entry fields is known from the
+ * vendor SDK, and a wrong rmt bit or tunnel MTU can black-hole a live WAN
+ * without any obvious symptom.  Enable it from the kernel command line
+ * (airoha_eth.airoha_ppe_dslite=1) or, for a modular build, through
+ * /sys/module/airoha_eth/parameters/airoha_ppe_dslite.
+ *
+ * With it at 0 the driver behaves exactly as before: no DS-Lite entry is
+ * built, the PPE flow configuration is not touched and every packet keeps
+ * running through the software path.
+ */
+bool airoha_ppe_dslite;
+module_param(airoha_ppe_dslite, bool, 0444);
+MODULE_PARM_DESC(airoha_ppe_dslite,
+		 "Offload IPv4-in-IPv6 DS-Lite decapsulation flows to the PPE");
+
 static const struct rhashtable_params airoha_flow_table_params = {
 	.head_offset = offsetof(struct airoha_flow_table_entry, node),
 	.key_offset = offsetof(struct airoha_flow_table_entry, cookie),
@@ -637,6 +654,15 @@
 		airoha_fe_clear(eth, REG_PPE_PPE_FLOW_CFG(i),
 				PPE_FLOW_CFG_IP6_6RD_MASK);
 
+		/* The parser only builds UNBIND entries for packet type 3
+		 * while this bit is set.  6RD stays off: this driver does
+		 * not create 6RD entries.
+		 */
+		if (airoha_ppe_dslite)
+			airoha_fe_set(eth, REG_PPE_PPE_FLOW_CFG(i),
+				      PPE_FLOW_CFG_IP4_DSLITE_MASK);
+	}
+
 		/* The parser only recognises the packet types that are
 		 * enabled here.  IPv4 type 1 is IPv4 NAT (address-only
 		 * translation, no port rewrite) and IPv6 type 4 is the
@@ -1069,6 +1095,36 @@
 		hwe->bridge.data = qdata;
 		hwe->bridge.ib2 = val;
 		l2 = &hwe->bridge.l2.common;
+	} else if (type == PPE_PKT_TYPE_IPV4_DSLITE) {
+		/* DS-Lite decapsulation entry.  The packet type is the
+		 * marker: the parser has to recognise an IPv4-in-IPv6
+		 * packet, match the inner IPv4 tuple and strip the outer
+		 * IPv6 header.  rmt (IB1 bit 23) asks for that removal;
+		 * tunnel_mtu is the inner MTU the tunnel netdev
+		 * advertises, so the PPE can drop oversized inner packets
+		 * after the header is gone.
+		 *
+		 * Packet type 3 has no generic tunnel/tunnel_id pair --
+		 * those bits belong to the GRE/VXLAN/L2TP tunnel-table
+		 * entries and are reserved in this layout.  The hardware
+		 * selector here is the 4-bit UPDMEM IPv6 slot.  This
+		 * driver only offloads decapsulation, which never reads
+		 * the outer addresses back, so no slot is programmed and
+		 * tunnel_id stays zero.
+		 */
+		hwe->dslite.data = qdata;
+		hwe->dslite.ib2 = val;
+		l2 = &hwe->dslite.l2.common;
+		l2->etype = ETH_P_IP;
+
+		if (data->dslite.tunnel && data->dslite.rmt)
+			hwe->ib1 |= AIROHA_FOE_IB1_BIND_TUNNEL_DECAP;
+		hwe->dslite.data |=
+			FIELD_PREP(AIROHA_FOE_DSLITE_TUNNEL_ID,
+				   data->dslite.tunnel_id);
+		hwe->dslite.l2.meter |=
+			FIELD_PREP(AIROHA_FOE_TUNNEL_MTU,
+				   data->dslite.tunnel_mtu);
 	} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
 		hwe->ipv6.data = qdata;
 		hwe->ipv6.ib2 = val;
@@ -1129,8 +1185,12 @@
 			t = &hwe->ipv4.new_tuple;
 			break;
 		}
-		fallthrough;
+		t = &hwe->ipv4.orig_tuple;
+		break;
 	case PPE_PKT_TYPE_IPV4_DSLITE:
+		t = &hwe->dslite.ip4;
+		break;
+	case PPE_PKT_TYPE_IPV4_ROUTE:
 		t = &hwe->ipv4.orig_tuple;
 		break;
 	case PPE_PKT_TYPE_IPV4_ROUTE:
@@ -1199,6 +1259,15 @@
 		hv2 = hwe->ipv4.orig_tuple.dest_ip;
 		hv3 = hwe->ipv4.orig_tuple.src_ip;
 		break;
+	case PPE_PKT_TYPE_IPV4_DSLITE:
+		/* The hardware hashes the inner IPv4 tuple of a DS-Lite
+		 * entry exactly like an IPv4 one; the outer IPv6 header is
+		 * not part of the lookup key.
+		 */
+		hv1 = hwe->dslite.ip4.ports;
+		hv2 = hwe->dslite.ip4.dest_ip;
+		hv3 = hwe->dslite.ip4.src_ip;
+		break;
 	case PPE_PKT_TYPE_IPV6_ROUTE_3T:
 	case PPE_PKT_TYPE_IPV6_ROUTE_5T:
 		hv1 = hwe->ipv6.src_ip[3] ^ hwe->ipv6.dest_ip[3];
@@ -1223,7 +1292,6 @@
 		hv3 = l2->common.dest_mac_hi;
 		break;
 	}
-	case PPE_PKT_TYPE_IPV4_DSLITE:
 	case PPE_PKT_TYPE_IPV6_6RD:
 	default:
 		WARN_ON_ONCE(1);
@@ -1300,6 +1368,14 @@
 	if (unlikely(!ppe->foe_stats_enabled))
 		return;
 
+	/* The counter path below stores the IB2 routing bits in the
+	 * entry's tunnel_mtu word.  A DS-Lite entry owns that word for the
+	 * real inner MTU, so keep these flows off the hardware counters
+	 * instead of silently corrupting the MTU.
+	 */
+	if (type == PPE_PKT_TYPE_IPV4_DSLITE)
+		return;
+
 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
 	if (ppe_num_stats_entries < 0)
 		return;
@@ -1954,6 +2030,33 @@
 	return airoha_ppe_get_entry_idle_time(ppe, e->data.ib1);
 }
 
+/* A DS-Lite decapsulation flow reaches the flowtable on the IPv6 tunnel
+ * interface that carried the outer IPv6 header.  The kernel only exposes
+ * the inner IPv4 tuple and the ingress ifindex, so the ingress netdev is
+ * the per-flow DS-Lite mark.  ip6_tnl registers ARPHRD_TUNNEL6 for both
+ * ip6ip6 and ipip6; an IPv4 inner address family narrows it to ipip6,
+ * which is DS-Lite (6RD is IPv6-in-IPv4 and has its own packet type).
+ */
+static bool airoha_ppe_dslite_flow(struct airoha_eth *eth, u32 ifindex,
+				   struct airoha_flow_data *data)
+{
+	struct net_device *dev;
+	bool ret = false;
+
+	rcu_read_lock();
+	dev = dev_get_by_index_rcu(dev_net(eth->napi_dev), ifindex);
+	if (dev && dev->type == ARPHRD_TUNNEL6 &&
+	    dev->addr_len == sizeof(struct in6_addr)) {
+		data->dslite.tunnel = true;
+		data->dslite.rmt = true;
+		data->dslite.tunnel_mtu = min_t(u32, dev->mtu, U16_MAX);
+		ret = true;
+	}
+	rcu_read_unlock();
+
+	return ret;
+}
+
 static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
 					   struct flow_cls_offload *f)
 {
@@ -1969,7 +2072,7 @@
 	u8 dsfield = 0, l4proto = 0, meter = AIROHA_PPE_METER_NONE;
 	struct airoha_foe_entry hwe;
 	struct net_device *indev;
-	bool bridged;
+	bool bridged, nat_rewrite = false;
 	int err, i, offload_type;
 	u16 addr_type = 0;
 
@@ -2038,6 +2141,18 @@
 		return -EOPNOTSUPP;
 	}
 
+	/* The flowtable rule for the decapsulation direction arrives on the
+	 * IPv6 tunnel netdev.  Mark that rule as a DS-Lite flow and build a
+	 * packet type 3 entry instead of an HNAPT one.  The reverse
+	 * direction egresses the tunnel and still has to encapsulate in
+	 * software, so it is left alone (airoha_ppe_foe_entry_prepare()
+	 * refuses the non-GDM egress device).
+	 */
+	if (airoha_ppe_dslite &&
+	    addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS &&
+	    airoha_ppe_dslite_flow(eth, meta.key->ingress_ifindex, &data))
+		offload_type = PPE_PKT_TYPE_IPV4_DSLITE;
+
 	flow_action_for_each(i, act, &rule->action) {
 		switch (act->id) {
 		case FLOW_ACTION_MANGLE:
@@ -2105,6 +2220,13 @@
 		data.meter = meter;
 	}
 
+	/* A DS-Lite decapsulation flow is plain IPv4-in-IPv6; a PPPoE
+	 * session inside the tunnel would need both headers encoded,
+	 * which this minimal path does not do.
+	 */
+	if (offload_type == PPE_PKT_TYPE_IPV4_DSLITE && data.pppoe.num)
+		return -EOPNOTSUPP;
+
 	/* A flow whose ingress and egress devices are both ports of the same
 	 * bridge never leaves L2, so the PPE must forward it without touching
 	 * the IP TTL.  Routing -- including entering or leaving the bridge --
@@ -2183,9 +2305,11 @@
 		case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
 		case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
 			err = airoha_ppe_flow_mangle_ports(act, &data);
+			nat_rewrite = true;
 			break;
 		case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
 			err = airoha_ppe_flow_mangle_ipv4(act, &data);
+			nat_rewrite = true;
 			break;
 		case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
 			/* handled earlier */
@@ -2199,6 +2323,18 @@
 			goto put_smac;
 	}
 
+	/* Packet type 3 carries only the inner original tuple; there is no
+	 * second tuple to hold the NAT rewrite.  A decapsulation flow that
+	 * needs address or port translation therefore cannot be encoded
+	 * here, and guessing would either fail to match the hardware UNBIND
+	 * entry or translate to the wrong inner address.  Leave it in the
+	 * software path.
+	 */
+	if (offload_type == PPE_PKT_TYPE_IPV4_DSLITE && nat_rewrite) {
+		err = -EOPNOTSUPP;
+		goto put_smac;
+	}
+
 	if (addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
 		err = airoha_ppe_foe_entry_set_ipv4_tuple(&hwe, &data, true);
 		if (err)
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -124,7 +124,6 @@
 
 		switch (type) {
 		case PPE_PKT_TYPE_IPV4_HNAPT:
-		case PPE_PKT_TYPE_IPV4_DSLITE:
 			src_port = &hwe->ipv4.new_tuple.src_port;
 			dest_port = &hwe->ipv4.new_tuple.dest_port;
 			src_addr = &hwe->ipv4.new_tuple.src_ip;
@@ -134,6 +133,20 @@
 						       src_port, dest_port,
 						       ipv6);
 			break;
+		case PPE_PKT_TYPE_IPV4_DSLITE:
+			/* Packet type 3 has no new tuple: the bytes at
+			 * ipv4.new_tuple are the outer flow label and
+			 * priority.  Print the decapsulation parameters
+			 * instead of a plausible but wrong 5-tuple.
+			 */
+			seq_printf(m, " tunnel_id=%u tunnel_mtu=%u rmt=%u",
+				   (u32)FIELD_GET(AIROHA_FOE_DSLITE_TUNNEL_ID,
+						  hwe->dslite.data),
+				   (u32)FIELD_GET(AIROHA_FOE_TUNNEL_MTU,
+						  hwe->dslite.l2.meter),
+				   !!(hwe->ib1 &
+				      AIROHA_FOE_IB1_BIND_TUNNEL_DECAP));
+			break;
 		default:
 			break;
 		}
@@ -408,6 +421,66 @@
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_meter);
 
+/* Read-only DS-Lite view.  It reports the feature gate, the live
+ * PPE_FLOW_CFG bit that makes the parser build packet type 3 entries, and
+ * every current DS-Lite entry with the four fields the entry carries:
+ * the UPDMEM IPv6 tunnel selector (tunnel_id), the inner MTU, the rmt
+ * flag and the outer IPv6 flow label/priority.
+ */
+static int airoha_ppe_debugfs_dslite_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	u32 num_entries = airoha_ppe_get_total_num_entries(ppe);
+	u32 flow_cfg = airoha_fe_rr(eth, REG_PPE_PPE_FLOW_CFG(0));
+	u32 count = 0;
+	int i;
+
+	seq_printf(m, "enabled %u\n", airoha_ppe_dslite ? 1 : 0);
+	seq_printf(m, "flow_cfg %08x dslite %u\n", flow_cfg,
+		   !!(flow_cfg & PPE_FLOW_CFG_IP4_DSLITE_MASK));
+
+	for (i = 0; i < num_entries; i++) {
+		struct airoha_foe_entry *hwe;
+		u32 state, type;
+
+		hwe = airoha_ppe_foe_get_entry(ppe, i);
+		if (!hwe)
+			continue;
+
+		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+		if (!state)
+			continue;
+
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+		if (type != PPE_PKT_TYPE_IPV4_DSLITE)
+			continue;
+
+		seq_printf(m,
+			   "%05x %s orig=%pI4h:%u->%pI4h:%u tunnel_id=%u tunnel_mtu=%u rmt=%u flow_label=%02x%02x%02x priority=%u\n",
+			   i, state == AIROHA_FOE_STATE_BIND ? "BND" : "UNB",
+			   &hwe->dslite.ip4.src_ip,
+			   hwe->dslite.ip4.src_port,
+			   &hwe->dslite.ip4.dest_ip,
+			   hwe->dslite.ip4.dest_port,
+			   (u32)FIELD_GET(AIROHA_FOE_DSLITE_TUNNEL_ID,
+					  hwe->dslite.data),
+			   (u32)FIELD_GET(AIROHA_FOE_TUNNEL_MTU,
+					  hwe->dslite.l2.meter),
+			   !!(hwe->ib1 & AIROHA_FOE_IB1_BIND_TUNNEL_DECAP),
+			   hwe->dslite.flow_label[0],
+			   hwe->dslite.flow_label[1],
+			   hwe->dslite.flow_label[2],
+			   hwe->dslite.priority);
+		count++;
+	}
+
+	seq_printf(m, "entries %u\n", count);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_dslite);
+
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
@@ -525,6 +598,8 @@
 			    &airoha_ppe_debugfs_tb_regs_fops);
 	debugfs_create_file("meter", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_meter_fops);
+	debugfs_create_file("dslite", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_dslite_fops);
 
 	return 0;
 }
