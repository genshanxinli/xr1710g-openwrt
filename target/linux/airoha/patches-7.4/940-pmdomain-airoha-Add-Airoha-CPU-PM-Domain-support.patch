From: Christian Marangi <ansuelsmth@gmail.com>
Date: Thu, 9 Jan 2025 14:12:57 +0100
Subject: [PATCH] pmdomain: airoha: Add Airoha CPU PM Domain support

Add the Airoha CPU PM domain driver with direct PLL fallback (500-1200 MHz
via shared chip_scu syscon), export airoha_cpu_pmdomain_get_state() and
airoha_chip_scu_pllrg_lock for PLLRG_PROTECT (0x268) save/restore, sequence
posdiv/PCW across 1 GHz, and verify both PCW and PCW_CHG readback.

Link: https://lore.kernel.org/r/20250109131313.32317-1-ansuelsmth@gmail.com
Origin: archive/xr1710g-v1@e85677d284c0
Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
Signed-off-by: Ulf Hansson <ulf.hansson@linaro.org>
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
+++ b/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
@@ -3,10 +3,16 @@
 #include <linux/arm-smccc.h>
 #include <linux/bitfield.h>
 #include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
+#include <linux/regmap.h>
 #include <linux/slab.h>
+#include <linux/spinlock.h>
 
 #define AIROHA_SIP_AVS_HANDLE			0x82000301
 #define AIROHA_AVS_OP_BASE			0xddddddd0
@@ -16,47 +22,301 @@
 #define AIROHA_AVS_OP_GET_FREQ			(AIROHA_AVS_OP_BASE | \
 						 FIELD_PREP(AIROHA_AVS_OP_MASK, 0x2))
 
+/* CPU PLL register offsets (chip-SCU region) */
+#define CPUPLL_CLK_MUX			0x1e0
+#define PLLRG_PROTECT			0x268
+#define CPUPLL_SDM_PCW			0x2b4
+#define CPUPLL_SDM_PCW_CHG		0x2b8
+
+#define CPUPLL_PCW_INT_MASK		GENMASK(30, 24)
+#define CPUPLL_XTAL_MHZ		50
+#define CPUPLL_CHG_BIT			BIT(0)
+#define CPUPLL_CHG_POSDIV_MASK		GENMASK(6, 4)
+#define PLLRG_PROTECT_MASK		GENMASK(7, 0)
+#define PLLRG_PROTECT_KEY		0x12
+
+/* MCUCFG clock switch register offsets */
+#define MCUCFG_CK_SWITCH_UNLOCK	0x640
+#define MCUCFG_CK_SOURCE_SEL		0x7c0
+
+#define MCUCFG_CK_UNLOCK_KEY		0x12
+#define MCUCFG_CK_SEL_MASK		GENMASK(10, 9)
+#define MCUCFG_CK_SEL_ARMPLL		1
+#define MCUCFG_CK_SEL_PLL2		3
+
+/* Matches an7581.dtsi cpu_smcc_opp_table (smcc_opp0..14: 500..1200 MHz). */
+#define AIROHA_CPU_MIN_FREQ_MHZ		500
+#define AIROHA_CPU_FREQ_STEP_MHZ	50
+#define AIROHA_CPU_MAX_OPP_STATE	14
+
+/* Shared with airoha_thermal to serialize chip-SCU PLLRG_PROTECT (0x268). */
+extern spinlock_t airoha_chip_scu_pllrg_lock;
+DEFINE_SPINLOCK(airoha_chip_scu_pllrg_lock);
+EXPORT_SYMBOL_GPL(airoha_chip_scu_pllrg_lock);
+
 struct airoha_cpu_pmdomain_priv {
+	struct device *dev;
 	struct clk_hw hw;
 	struct generic_pm_domain pd;
+	bool use_smc;
+	struct regmap *chip_scu;
+	void __iomem *mcucfg;
 };
 
-static unsigned long airoha_cpu_pmdomain_clk_get(struct clk_hw *hw,
-						 unsigned long parent_rate)
+static unsigned long airoha_cpu_smc_clk_get(void)
 {
 	struct arm_smccc_res res;
 
 	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_GET_FREQ,
 			     0, 0, 0, 0, 0, 0, &res);
 
-	/* SMCCC returns freq in MHz */
-	return (int)(res.a0 * 1000 * 1000);
+	return (unsigned long)(res.a0 * 1000 * 1000);
+}
+
+static unsigned long airoha_cpu_pll_clk_get(struct airoha_cpu_pmdomain_priv *priv)
+{
+	unsigned long flags;
+	u32 pcw = 0, chg = 0;
+	unsigned int pcw_int, posdiv;
+
+	spin_lock_irqsave(&airoha_chip_scu_pllrg_lock, flags);
+	regmap_read(priv->chip_scu, CPUPLL_SDM_PCW, &pcw);
+	regmap_read(priv->chip_scu, CPUPLL_SDM_PCW_CHG, &chg);
+	spin_unlock_irqrestore(&airoha_chip_scu_pllrg_lock, flags);
+
+	pcw_int = FIELD_GET(CPUPLL_PCW_INT_MASK, pcw);
+	posdiv = FIELD_GET(CPUPLL_CHG_POSDIV_MASK, chg);
+
+	return (unsigned long)pcw_int * CPUPLL_XTAL_MHZ * 1000000UL >> posdiv;
+}
+
+static unsigned long airoha_cpu_pmdomain_clk_get(struct clk_hw *hw,
+						 unsigned long parent_rate)
+{
+	struct airoha_cpu_pmdomain_priv *priv =
+		container_of(hw, struct airoha_cpu_pmdomain_priv, hw);
+
+	if (priv->use_smc)
+		return airoha_cpu_smc_clk_get();
+
+	return airoha_cpu_pll_clk_get(priv);
 }
 
-/* Airoha CPU clk SMCC is always enabled */
 static int airoha_cpu_pmdomain_clk_is_enabled(struct clk_hw *hw)
 {
 	return true;
 }
 
+/* Single CPU PM domain instance for cpufreq boot-OPP sync. */
+static struct airoha_cpu_pmdomain_priv *airoha_cpu_pmdomain;
+
 static const struct clk_ops airoha_cpu_pmdomain_clk_ops = {
 	.recalc_rate = airoha_cpu_pmdomain_clk_get,
 	.is_enabled = airoha_cpu_pmdomain_clk_is_enabled,
 	.determine_rate = clk_determine_rate_noop,
 };
 
-static int airoha_cpu_pmdomain_set_performance_state(struct generic_pm_domain *domain,
-						     unsigned int state)
+/* Only used here and by the airoha cpufreq driver, which declares it too */
+int airoha_cpu_pmdomain_get_state(void);
+
+/* Return current hardware OPP state to seed genpd caches at boot. */
+int airoha_cpu_pmdomain_get_state(void)
+{
+	struct airoha_cpu_pmdomain_priv *priv = smp_load_acquire(&airoha_cpu_pmdomain);
+	unsigned int freq_mhz, state;
+	unsigned long freq_hz;
+
+	if (!priv)
+		return -ENODEV;
+
+	freq_hz = airoha_cpu_pmdomain_clk_get(&priv->hw, 0);
+	if (freq_hz < AIROHA_CPU_MIN_FREQ_MHZ * 1000000UL ||
+	    freq_hz > 2000000000UL)
+		return -EINVAL;
+
+	freq_mhz = freq_hz / 1000000;
+	if ((freq_mhz - AIROHA_CPU_MIN_FREQ_MHZ) % AIROHA_CPU_FREQ_STEP_MHZ)
+		return -EINVAL;
+
+	state = (freq_mhz - AIROHA_CPU_MIN_FREQ_MHZ) / AIROHA_CPU_FREQ_STEP_MHZ;
+	if (state > AIROHA_CPU_MAX_OPP_STATE)
+		return -EINVAL;
+
+	return state;
+}
+EXPORT_SYMBOL_GPL(airoha_cpu_pmdomain_get_state);
+
+static int airoha_cpu_smc_set_freq(unsigned int state)
 {
 	struct arm_smccc_res res;
 
 	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_FREQ_DYN_ADJ,
 			     0, state, 0, 0, 0, 0, &res);
 
-	/* SMC signal correct apply by unsetting BIT 0 */
 	return res.a0 & BIT(0) ? -EINVAL : 0;
 }
 
+/* Switch CPU clock source via CLK_MUX/MCUCFG (matches ATF BL31). */
+static void airoha_cpu_clock_switch(struct regmap *chip_scu,
+				    void __iomem *mcucfg, unsigned int sel)
+{
+	u32 val;
+
+	if (sel != 0)
+		regmap_write_bits(chip_scu, CPUPLL_CLK_MUX,
+				  BIT(sel - 1), BIT(sel - 1));
+
+	val = readl(mcucfg + MCUCFG_CK_SWITCH_UNLOCK);
+	writel((val & ~0x1f) | MCUCFG_CK_UNLOCK_KEY,
+	       mcucfg + MCUCFG_CK_SWITCH_UNLOCK);
+
+	val = readl(mcucfg + MCUCFG_CK_SOURCE_SEL);
+	val &= ~MCUCFG_CK_SEL_MASK;
+	val |= FIELD_PREP(MCUCFG_CK_SEL_MASK, sel);
+	writel(val, mcucfg + MCUCFG_CK_SOURCE_SEL);
+}
+
+static int airoha_cpu_pll_write_pcw(struct regmap *chip_scu,
+				    unsigned int pcw_int, u32 *pcw_read)
+{
+	u32 val = 0;
+
+	regmap_read(chip_scu, CPUPLL_SDM_PCW, &val);
+	val = (val & ~CPUPLL_PCW_INT_MASK) |
+	      FIELD_PREP(CPUPLL_PCW_INT_MASK, pcw_int);
+	regmap_write(chip_scu, CPUPLL_SDM_PCW, val);
+
+	regmap_read(chip_scu, CPUPLL_SDM_PCW, &val);
+	*pcw_read = FIELD_GET(CPUPLL_PCW_INT_MASK, val);
+	return *pcw_read == pcw_int ? 0 : -EIO;
+}
+
+static int airoha_cpu_pll_latch_chg(struct regmap *chip_scu,
+				    unsigned int posdiv, u32 *chg_read)
+{
+	u32 old_chg = 0, want, got = 0;
+
+	regmap_read(chip_scu, CPUPLL_SDM_PCW_CHG, &old_chg);
+	want = (old_chg & ~(CPUPLL_CHG_POSDIV_MASK | CPUPLL_CHG_BIT)) |
+	       FIELD_PREP(CPUPLL_CHG_POSDIV_MASK, posdiv);
+	if (!(old_chg & CPUPLL_CHG_BIT))
+		want |= CPUPLL_CHG_BIT;
+
+	regmap_write(chip_scu, CPUPLL_SDM_PCW_CHG, want);
+	regmap_read(chip_scu, CPUPLL_SDM_PCW_CHG, &got);
+	if (chg_read)
+		*chg_read = got;
+
+	if ((got & (CPUPLL_CHG_POSDIV_MASK | CPUPLL_CHG_BIT)) !=
+	    (want & (CPUPLL_CHG_POSDIV_MASK | CPUPLL_CHG_BIT)))
+		return -EIO;
+
+	udelay(50);
+	return 0;
+}
+
+/* Direct PLL fallback (VCO >= 1000 MHz): <1G posdiv=1 (freq/25); >=1G posdiv=0 (freq/50). */
+static int airoha_cpu_pll_set_freq(struct airoha_cpu_pmdomain_priv *priv,
+				   unsigned int state)
+{
+	struct regmap *chip_scu = priv->chip_scu;
+	unsigned int freq_mhz = AIROHA_CPU_MIN_FREQ_MHZ +
+				state * AIROHA_CPU_FREQ_STEP_MHZ;
+	unsigned int posdiv, pcw_int, old_posdiv, old_pcw_int;
+	unsigned long flags;
+	u32 old_chg = 0, old_pcw = 0, saved_protect = 0;
+	u32 pcw_read = 0, chg_read = 0;
+	int ret = 0;
+
+	if (freq_mhz < 1000) {
+		posdiv = 1;
+		pcw_int = freq_mhz / 25;
+	} else {
+		posdiv = 0;
+		pcw_int = freq_mhz / 50;
+	}
+
+	spin_lock_irqsave(&airoha_chip_scu_pllrg_lock, flags);
+
+	regmap_read(chip_scu, CPUPLL_SDM_PCW, &old_pcw);
+	regmap_read(chip_scu, CPUPLL_SDM_PCW_CHG, &old_chg);
+	old_pcw_int = FIELD_GET(CPUPLL_PCW_INT_MASK, old_pcw);
+	old_posdiv = FIELD_GET(CPUPLL_CHG_POSDIV_MASK, old_chg);
+
+	if (((unsigned long)old_pcw_int * CPUPLL_XTAL_MHZ >> old_posdiv) == freq_mhz) {
+		spin_unlock_irqrestore(&airoha_chip_scu_pllrg_lock, flags);
+		return 0;
+	}
+
+	/* Switch CPU to PLL2 (400 MHz backup) */
+	airoha_cpu_clock_switch(chip_scu, priv->mcucfg, MCUCFG_CK_SEL_PLL2);
+
+	regmap_read(chip_scu, PLLRG_PROTECT, &saved_protect);
+	regmap_write(chip_scu, PLLRG_PROTECT,
+		     (saved_protect & ~PLLRG_PROTECT_MASK) | PLLRG_PROTECT_KEY);
+
+	/* Sequence posdiv and PCW across 1 GHz so output never exceeds 1200 MHz. */
+	if (old_posdiv < posdiv)
+		ret = airoha_cpu_pll_latch_chg(chip_scu, posdiv, &chg_read);
+	if (!ret)
+		ret = airoha_cpu_pll_write_pcw(chip_scu, pcw_int, &pcw_read);
+	if (!ret && old_posdiv > posdiv)
+		ret = airoha_cpu_pll_latch_chg(chip_scu, old_posdiv, &chg_read);
+	if (!ret)
+		ret = airoha_cpu_pll_latch_chg(chip_scu, posdiv, &chg_read);
+
+	if (ret) {
+		if (old_posdiv > posdiv)
+			airoha_cpu_pll_latch_chg(chip_scu, old_posdiv, NULL);
+		regmap_write(chip_scu, CPUPLL_SDM_PCW, old_pcw);
+		if (old_posdiv < posdiv)
+			airoha_cpu_pll_latch_chg(chip_scu, posdiv, NULL);
+		airoha_cpu_pll_latch_chg(chip_scu, old_posdiv, NULL);
+	}
+
+	airoha_cpu_clock_switch(chip_scu, priv->mcucfg, MCUCFG_CK_SEL_ARMPLL);
+	regmap_write_bits(chip_scu, CPUPLL_CLK_MUX,
+			  BIT(MCUCFG_CK_SEL_PLL2 - 1), 0);
+	regmap_write(chip_scu, PLLRG_PROTECT, saved_protect);
+
+	spin_unlock_irqrestore(&airoha_chip_scu_pllrg_lock, flags);
+
+	if (ret)
+		dev_err(priv->dev,
+			"PLL write failed (want pcw=%u posdiv=%u, read pcw=%u chg=%#x)\n",
+			pcw_int, posdiv, pcw_read, chg_read);
+
+	return ret;
+}
+
+static int airoha_cpu_pmdomain_set_performance_state(
+		struct generic_pm_domain *domain, unsigned int state)
+{
+	struct airoha_cpu_pmdomain_priv *priv =
+		container_of(domain, struct airoha_cpu_pmdomain_priv, pd);
+
+	if (state > AIROHA_CPU_MAX_OPP_STATE) {
+		dev_err(priv->dev, "invalid performance state: %u\n", state);
+		return -EINVAL;
+	}
+
+	if (priv->use_smc)
+		return airoha_cpu_smc_set_freq(state);
+
+	return airoha_cpu_pll_set_freq(priv, state);
+}
+
+static bool airoha_cpu_smc_available(void)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_GET_FREQ,
+			     0, 0, 0, 0, 0, 0, &res);
+
+	/* SMC returns frequency in MHz; 0 or very large = not supported */
+	return res.a0 > 0 && res.a0 < 2000;
+}
+
 static int airoha_cpu_pmdomain_probe(struct platform_device *pdev)
 {
 	struct airoha_cpu_pmdomain_priv *priv;
@@ -64,18 +324,48 @@ static int airoha_cpu_pmdomain_probe(str
 	const struct clk_init_data init = {
 		.name = "cpu",
 		.ops = &airoha_cpu_pmdomain_clk_ops,
-		/* Clock with no set_rate, can't cache */
 		.flags = CLK_GET_RATE_NOCACHE,
 	};
 	struct generic_pm_domain *pd;
+	unsigned long freq_hz;
 	int ret;
 
 	priv = devm_kzalloc_obj(dev, *priv);
 	if (!priv)
 		return -ENOMEM;
 
-	/* Init and register a get-only clk for Cpufreq */
+	priv->dev = dev;
+
+	if (airoha_cpu_smc_available()) {
+		priv->use_smc = true;
+		dev_info(dev, "using ATF SMC for CPU frequency control\n");
+	} else {
+		priv->use_smc = false;
+
+		if (of_property_present(dev->of_node, "airoha,chip-scu"))
+			priv->chip_scu = syscon_regmap_lookup_by_phandle(dev->of_node,
+									 "airoha,chip-scu");
+		else
+			priv->chip_scu = syscon_regmap_lookup_by_compatible("airoha,en7581-chip-scu");
+		if (IS_ERR(priv->chip_scu))
+			return dev_err_probe(dev, PTR_ERR(priv->chip_scu),
+					     "ATF SMC not available and no chip-scu syscon\n");
+
+		priv->mcucfg = devm_platform_ioremap_resource_byname(pdev, "mcucfg");
+		if (IS_ERR(priv->mcucfg))
+			return dev_err_probe(dev, PTR_ERR(priv->mcucfg),
+					     "ATF SMC not available and no mcucfg reg in DT\n");
+
+		dev_info(dev, "ATF SMC not available, using direct PLL programming\n");
+	}
+
 	priv->hw.init = &init;
+	freq_hz = airoha_cpu_pmdomain_clk_get(&priv->hw, 0);
+	if (!freq_hz || freq_hz > 2000000000UL)
+		return dev_err_probe(dev, -ENODEV,
+				     "invalid CPU frequency: %lu Hz\n", freq_hz);
+
+	dev_info(dev, "CPU frequency: %lu MHz\n", freq_hz / 1000000);
 	ret = devm_clk_hw_register(dev, &priv->hw);
 	if (ret)
 		return ret;
@@ -95,17 +385,19 @@ static int airoha_cpu_pmdomain_probe(str
 	if (ret)
 		return ret;
 
+	/* Publish before the provider: attaching consumers read the state */
+	smp_store_release(&airoha_cpu_pmdomain, priv);
+
 	ret = of_genpd_add_provider_simple(dev->of_node, pd);
 	if (ret)
 		goto err_add_provider;
 
 	platform_set_drvdata(pdev, priv);
-
 	return 0;
 
 err_add_provider:
+	smp_store_release(&airoha_cpu_pmdomain, NULL);
 	pm_genpd_remove(pd);
-
 	return ret;
 }
 
@@ -115,6 +407,7 @@ static void airoha_cpu_pmdomain_remove(s
 
 	of_genpd_del_provider(pdev->dev.of_node);
 	pm_genpd_remove(&priv->pd);
+	smp_store_release(&airoha_cpu_pmdomain, NULL);
 }
 
