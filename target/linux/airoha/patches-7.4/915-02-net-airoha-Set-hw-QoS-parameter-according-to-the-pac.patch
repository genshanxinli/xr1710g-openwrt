From: Lorenzo Bianconi <lorenzo@kernel.org>
Date: Mon, 18 May 2026 08:36:20 +0200
Subject: [PATCH net-next 2/2] net: airoha: Set hw QoS parameter according to the packet dscp

Program Airoha PPE hw QoS queue and DSCP from FLOW_DISSECTOR_KEY_IP when
present, masking match.key->tos with match.mask->tos and dropping the
redundant post-prepare IB2 DSCP clear.

Origin: archive/xr1710g-v1@e85677d284c0; xr1710g #413
Signed-off-by: Lorenzo Bianconi <lorenzo@kernel.org>
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -11,6 +11,7 @@
 #include <linux/rhashtable.h>
 #include <net/ipv6.h>
 #include <net/pkt_cls.h>
+#include <net/route.h>
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
@@ -389,7 +390,7 @@ static int airoha_ppe_foe_entry_prepare(
 					struct airoha_foe_entry *hwe,
 					struct net_device *netdev, int type,
 					struct airoha_flow_data *data,
-					int l4proto, u8 priority)
+					int l4proto, u8 dsfield)
 {
 	u32 qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f), ports_pad, val;
 	int wlan_etype = -EINVAL, dsa_port = airoha_get_dsa_port(&netdev);
@@ -424,7 +425,7 @@ static int airoha_ppe_foe_entry_prepare(
 		} else {
 			struct airoha_gdm_dev *dev = netdev_priv(netdev);
 			struct airoha_gdm_port *port;
-			u8 pse_port, channel;
+			u8 pse_port, channel, priority;
 
 			if (!airoha_is_valid_gdm_dev(eth, dev))
 				return -EINVAL;
@@ -444,11 +445,13 @@ static int airoha_ppe_foe_entry_prepare(
 			 */
 			channel = dsa_port >= 0 ? dsa_port : port->id;
 			channel = channel % AIROHA_NUM_QOS_CHANNELS;
+			priority = rt_tos2priority(dsfield);
 			priority = priority % AIROHA_NUM_QOS_QUEUES;
 			qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL, channel) |
 				 FIELD_PREP(AIROHA_FOE_QID, priority);
 
 			val |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, pse_port) |
+			       FIELD_PREP(AIROHA_FOE_IB2_DSCP, dsfield) |
 			       AIROHA_FOE_IB2_PSE_QOS;
 			/* For downlink traffic consume SRAM memory for hw
 			 * forwarding descriptors queue.
@@ -1175,7 +1178,7 @@ static int airoha_ppe_flow_offload_repla
 	struct airoha_flow_data data = {};
 	struct net_device *odev = NULL;
 	struct flow_action_entry *act;
-	u8 l4proto = 0, priority = 0;
+	u8 dsfield = 0, l4proto = 0;
 	struct airoha_foe_entry hwe;
 	int err, i, offload_type;
 	u16 addr_type = 0;
@@ -1208,6 +1211,13 @@ static int airoha_ppe_flow_offload_repla
 		return -EOPNOTSUPP;
 	}
 
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IP)) {
+		struct flow_match_ip match;
+
+		flow_rule_match_ip(rule, &match);
+		dsfield = match.key->tos & match.mask->tos;
+	}
+
 	switch (addr_type) {
 	case 0:
 		offload_type = PPE_PKT_TYPE_BRIDGE;
@@ -1274,7 +1284,7 @@ static int airoha_ppe_flow_offload_repla
 		return -EINVAL;
 
 	err = airoha_ppe_foe_entry_prepare(eth, &hwe, odev, offload_type,
-					   &data, l4proto, priority);
+					   &data, l4proto, dsfield);
 	if (err)
 		return err;
 
