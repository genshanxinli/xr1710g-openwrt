From: OpenWrt <openwrt@example.org>
Subject: [PATCH] net: airoha: npu: add read-only support-map and counter probes

debugfs npu/support_map and npu/counters expose the two read-only NPU
WiFi mailbox commands that the D7 tunnel/counter work needs:
WLAN_FUNC_GET_WAIT_NPU_SUPPORT_MAP (8) and WLAN_FUNC_GET_WAIT_COUNTER
(2).  Both files are 0444 and the probe only ever issues GET_WAIT
requests.  It never sends a SET command: in particular
WLAN_FUNC_SET_WAIT_HWNAT_INIT (30), every other
WLAN_FUNC_SET_WAIT_* (0..33), the PPE_SET_WAIT_* commands and the
tunnel SET_* commands are forbidden in this path.  The mailbox stays
shared with the live WiFi and PPE paths; the existing per-core lock in
__airoha_npu_send_msg() serialises the probe with them, and the seq_file
read runs in process context, not atomic context.

support_map prints the 28-byte reply as raw hex plus one line per byte
with all eight bit positions.  Firmware v08 does not publish a bit-name
table for this reply, so every name is the "?" placeholder; the raw
bytes are the authoritative part and can be decoded once the layout is
known.

counters prints the 584-byte reply as 112 idx/value slots followed by
the remaining 128 bytes as a raw tail.  Firmware v08 writes its
576-byte counter block at payload offset 8, so the slots start there;
the exact meaning of each slot is follow-up hardware work, not
something this read-only interface has to decide.

The mailbox bounce buffer was sized for the 16-byte in-tree WLAN
payloads.  The counter reply needs 584 bytes, and the vendor WLAN mail
structure is 4416 bytes, so size the shared buffer for that ceiling.
It is one coherent allocation per core, 4416 bytes each.

A failed GET returns -EIO to the reader and logs the reason once
through dev_err_once(), so reading the files in a loop cannot flood
dmesg.  Nothing else in the Ethernet/PPE/Wi-Fi paths changes.

Signed-off-by: OpenWrt <openwrt@example.org>
---
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -25,11 +25,14 @@
 #define NPU_EN7581_FIRMWARE_DATA_MAX_SIZE	0x10000
 #define NPU_DUMP_SIZE				512
 /*
- * Mailbox DMA payload size. Covers sizeof(struct ppe_mbox_data) (28) and
- * WLAN TLV messages (header + payload); largest in-tree WLAN payload today
- * is 16 bytes (INODE_TXRX_REG_ADDR). Keep headroom for future commands.
+ * Mailbox DMA payload size.  Covers sizeof(struct ppe_mbox_data) (28) and
+ * every WLAN message this driver can send or receive.  The largest reply
+ * requested here is WLAN_FUNC_GET_WAIT_COUNTER: an 8-byte wlan_mbox_data
+ * header plus a 584-byte counter payload.  The vendor WLAN mail structure
+ * is 4416 bytes (8-byte header + 4408-byte counter_t), so size the shared
+ * bounce buffer for that ceiling as well and leave room for future GETs.
  */
-#define AIROHA_NPU_MBOX_SIZE			256
+#define AIROHA_NPU_MBOX_SIZE			4416
 
 #define REG_NPU_LOCAL_SRAM		0x0
 
@@ -715,6 +718,180 @@ void airoha_npu_put(struct airoha_npu *n
 }
 EXPORT_SYMBOL_GPL(airoha_npu_put);
 
+#if IS_ENABLED(CONFIG_DEBUG_FS)
+/*
+ * Read-only mailbox probes for the NPU WiFi mailbox (function slot 0).
+ *
+ * The two files below are observation-only: they issue
+ * WLAN_FUNC_GET_WAIT_NPU_SUPPORT_MAP (8) and WLAN_FUNC_GET_WAIT_COUNTER (2)
+ * and never program the NPU.  The mailbox is shared with the live WiFi and
+ * PPE paths, so the existing per-core lock in __airoha_npu_send_msg()
+ * serialises these requests; the probes run in process context and must
+ * never be called from an atomic one.
+ *
+ * Never send a SET command from this file.  In particular:
+ *   WLAN_FUNC_SET_WAIT_HWNAT_INIT (30) - programs the PPE twice
+ *   any other WLAN_FUNC_SET_WAIT_* (0..33)
+ *   PPE_FUNC_SET_WAIT_* (0..4) and the tunnel SET_* commands
+ * The support map and the counters are the only data this step needs.
+ */
+#define AIROHA_NPU_SUPPORT_MAP_SIZE	28
+#define AIROHA_NPU_COUNTERS_SIZE	584
+#define AIROHA_NPU_COUNTER_SLOTS	112
+#define AIROHA_NPU_COUNTER_SLOT_OFF	8
+#define AIROHA_NPU_COUNTER_TAIL_OFF	(AIROHA_NPU_COUNTER_SLOT_OFF + \
+					 AIROHA_NPU_COUNTER_SLOTS * 4)
+
+static bool airoha_npu_mbox_ready(struct airoha_npu *npu)
+{
+	/* The bounce buffer is allocated for every core before the firmware
+	 * is started, and the debugfs files are only created after the boot
+	 * sequence completed.  A NULL buffer therefore means the node did not
+	 * probe or the mailbox was torn down.
+	 */
+	return npu->regmap && npu->cores[0].buf;
+}
+
+static int airoha_npu_support_map_show(struct seq_file *m, void *private)
+{
+	struct airoha_npu *npu = m->private;
+	u8 map[AIROHA_NPU_SUPPORT_MAP_SIZE];
+	int err, i, bit;
+
+	if (!npu)
+		return -EIO;
+
+	if (!airoha_npu_mbox_ready(npu)) {
+		dev_err_once(npu->dev, "support_map: NPU mailbox is not ready\n");
+		return -EIO;
+	}
+
+	memset(map, 0, sizeof(map));
+	err = airoha_npu_wlan_msg_get(npu, 0,
+				      WLAN_FUNC_GET_WAIT_NPU_SUPPORT_MAP,
+				      map, sizeof(map), GFP_KERNEL);
+	if (err) {
+		dev_err_once(npu->dev,
+			     "support_map: GET_NPU_SUPPORT_MAP failed: %d\n",
+			     err);
+		return -EIO;
+	}
+
+	seq_printf(m, "support_map: %zu bytes (%zu bits)\n",
+		   sizeof(map), sizeof(map) * 8);
+	seq_puts(m, "raw:");
+	for (i = 0; i < sizeof(map); i++)
+		seq_printf(m, " %02x", map[i]);
+	seq_puts(m, "\n");
+
+	/* No bit-name table is published for the firmware's support map, so
+	 * every bit is reported with the "?" placeholder while the raw bytes
+	 * above remain authoritative.
+	 */
+	for (i = 0; i < sizeof(map); i++) {
+		seq_printf(m, "byte %2d: %02x ", i, map[i]);
+		for (bit = 7; bit >= 0; bit--)
+			seq_printf(m, "b%d=%s ", i * 8 + bit, "?");
+		seq_puts(m, "\n");
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_npu_support_map);
+
+static int airoha_npu_counters_show(struct seq_file *m, void *private)
+{
+	struct airoha_npu *npu = m->private;
+	u8 *counters;
+	int err, i;
+	u32 val;
+
+	if (!npu)
+		return -EIO;
+
+	if (!airoha_npu_mbox_ready(npu)) {
+		dev_err_once(npu->dev, "counters: NPU mailbox is not ready\n");
+		return -EIO;
+	}
+
+	counters = kzalloc(AIROHA_NPU_COUNTERS_SIZE, GFP_KERNEL);
+	if (!counters)
+		return -ENOMEM;
+
+	err = airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_COUNTER,
+				      counters, AIROHA_NPU_COUNTERS_SIZE,
+				      GFP_KERNEL);
+	if (err) {
+		dev_err_once(npu->dev,
+			     "counters: GET_COUNTER failed: %d\n", err);
+		kfree(counters);
+		return -EIO;
+	}
+
+	/* Firmware v08 writes a 576-byte counter block starting at payload
+	 * byte 8; the first 112 32-bit slots are printed as idx/value pairs
+	 * and the remaining 128 bytes are kept as a raw tail.  The exact
+	 * meaning of each slot is follow-up hardware work, not something
+	 * this read-only probe needs to decide.
+	 */
+	seq_printf(m, "counters: %d bytes, %d slots\n",
+		   AIROHA_NPU_COUNTERS_SIZE, AIROHA_NPU_COUNTER_SLOTS);
+	memcpy(&val, counters, sizeof(val));
+	seq_printf(m, "head: 0x%08x", val);
+	memcpy(&val, counters + 4, sizeof(val));
+	seq_printf(m, " 0x%08x\n", val);
+
+	for (i = 0; i < AIROHA_NPU_COUNTER_SLOTS; i++) {
+		memcpy(&val, counters + AIROHA_NPU_COUNTER_SLOT_OFF + i * 4,
+		       sizeof(val));
+		seq_printf(m, "%3d 0x%08x\n", i, val);
+	}
+
+	seq_puts(m, "tail:");
+	for (i = AIROHA_NPU_COUNTER_TAIL_OFF;
+	     i < AIROHA_NPU_COUNTERS_SIZE; i += 4) {
+		memcpy(&val, counters + i, sizeof(val));
+		seq_printf(m, " 0x%08x", val);
+	}
+	seq_puts(m, "\n");
+
+	kfree(counters);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_npu_counters);
+
+static void airoha_npu_debugfs_register(struct airoha_npu *npu)
+{
+	struct dentry *dir;
+	bool looked_up = false;
+
+	dir = debugfs_create_dir("npu", NULL);
+	if (IS_ERR(dir)) {
+		if (PTR_ERR(dir) != -EEXIST)
+			return;
+
+		/* Another probe (for example the tunnel one) may have created
+		 * the shared directory already.  Attach our files to it
+		 * instead of failing, and drop the lookup reference after the
+		 * children have pinned it.
+		 */
+		dir = debugfs_lookup("npu", NULL);
+		if (!dir)
+			return;
+		looked_up = true;
+	}
+
+	debugfs_create_file("support_map", 0444, dir, npu,
+			    &airoha_npu_support_map_fops);
+	debugfs_create_file("counters", 0444, dir, npu,
+			    &airoha_npu_counters_fops);
+
+	if (looked_up)
+		dput(dir);
+}
+#endif /* CONFIG_DEBUG_FS */
+
 static const struct airoha_npu_soc_data en7581_npu_soc_data = {
 	.fw_rv32 = {
 		.name = NPU_EN7581_FIRMWARE_RV32,
@@ -872,6 +1049,13 @@ static int airoha_npu_probe(struct platf
 
 	platform_set_drvdata(pdev, npu);
 
+#if IS_ENABLED(CONFIG_DEBUG_FS)
+	/* Read-only observation: npu/support_map and npu/counters.  Failure to
+	 * create them is not fatal for the network data path.
+	 */
+	airoha_npu_debugfs_register(npu);
+#endif
+
 	return 0;
 }
 
