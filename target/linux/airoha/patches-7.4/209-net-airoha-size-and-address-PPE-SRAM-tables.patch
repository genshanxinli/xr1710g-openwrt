From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Thu, 29 Oct 2026 12:00:00 +0800
Subject: [PATCH] net: airoha: size and address PPE SRAM tables with fixed hardware stride

Keep PPE2 SRAM addressing at the fixed hardware PPE_SRAM_NUM_ENTRIES (8192)
stride so total_num_entries never drifts dynamically between 32768 and
24576 when flow stats are active. Derive usable per-PPE data entries via
airoha_ppe_get_sram_num_entries(), reject the stats carve-out holes
(4096..8191 and 12288..16383) plus 0xffff/OOB FOE indices in
airoha_ppe_check_skb() and airoha_ppe_foe_get_entry_locked(), address
REG_PPE_RAM_CTRL relative to the selected PPE, and fold software bucket
hashes without runtime udiv via airoha_ppe_fold_hash().

Origin: archive/xr1710g-v1@e85677d284c0; xr1710g #413
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -59,6 +59,36 @@ static int airoha_ppe_get_total_num_stat
 	return num_stats;
 }
 
+/* Per-PPE usable SRAM data entries (excluding flow-stats carve-out). */
+static u32 airoha_ppe_get_sram_num_entries(struct airoha_ppe *ppe)
+{
+	int num_stats = airoha_ppe_get_num_stats_entries(ppe);
+
+	if (num_stats > 0)
+		return PPE_SRAM_NUM_ENTRIES - num_stats;
+
+	return PPE_SRAM_NUM_ENTRIES;
+}
+
+static bool airoha_ppe_is_valid_sram_hash(struct airoha_ppe *ppe, u32 hash)
+{
+	return (hash % PPE_SRAM_NUM_ENTRIES) <
+	       airoha_ppe_get_sram_num_entries(ppe);
+}
+
+/* Fold hash without runtime udiv for power-of-two and 3 * 8192 (24576) tables. */
+static u32 airoha_ppe_fold_hash(u32 hash, u32 num_entries)
+{
+	if (!(num_entries & (num_entries - 1)))
+		return hash & (num_entries - 1);
+
+	if (num_entries == 3 * PPE_SRAM_NUM_ENTRIES)
+		return ((hash >> 13) % 3) * PPE_SRAM_NUM_ENTRIES +
+		       (hash & (PPE_SRAM_NUM_ENTRIES - 1));
+
+	return hash % num_entries;
+}
+
 static u32 airoha_ppe_get_total_sram_num_entries(struct airoha_ppe *ppe)
 {
 	struct airoha_eth *eth = ppe->eth;
@@ -129,7 +159,8 @@ void airoha_ppe_set_xmit_frame_size(stru
 
 static void airoha_ppe_hw_init(struct airoha_ppe *ppe)
 {
-	u32 sram_ppe_num_data_entries = PPE_SRAM_NUM_ENTRIES, sram_num_entries;
+	u32 sram_ppe_num_data_entries = airoha_ppe_get_sram_num_entries(ppe);
+	u32 sram_num_entries;
 	u32 sram_tb_size, dram_num_entries;
 	struct airoha_eth *eth = ppe->eth;
 	int i, sram_num_stats_entries;
@@ -139,8 +170,6 @@ static void airoha_ppe_hw_init(struct ai
 	dram_num_entries = PPE_RAM_NUM_ENTRIES_SHIFT(PPE_DRAM_NUM_ENTRIES);
 
 	sram_num_stats_entries = airoha_ppe_get_num_stats_entries(ppe);
-	if (sram_num_stats_entries > 0)
-		sram_ppe_num_data_entries -= sram_num_stats_entries;
 	sram_ppe_num_data_entries =
 		PPE_RAM_NUM_ENTRIES_SHIFT(sram_ppe_num_data_entries);
 
@@ -548,7 +577,7 @@ static u32 airoha_ppe_foe_get_entry_hash
 					 struct airoha_foe_entry *hwe)
 {
 	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
-	u32 ppe_hash_mask = airoha_ppe_get_total_num_entries(ppe) - 1;
+	u32 num_entries = airoha_ppe_get_total_num_entries(ppe);
 	u32 hash, hv1, hv2, hv3;
 
 	switch (type) {
@@ -586,16 +615,15 @@ static u32 airoha_ppe_foe_get_entry_hash
 	case PPE_PKT_TYPE_IPV6_6RD:
 	default:
 		WARN_ON_ONCE(1);
-		return ppe_hash_mask;
+		return 0;
 	}
 
 	hash = (hv1 & hv2) | ((~hv1) & hv3);
 	hash = (hash >> 24) | ((hash & 0xffffff) << 8);
 	hash ^= hv1 ^ hv2 ^ hv3;
 	hash ^= hash >> 16;
-	hash &= ppe_hash_mask;
 
-	return hash;
+	return airoha_ppe_fold_hash(hash, num_entries);
 }
 
 static int airoha_ppe_foe_get_flow_stats_index(struct airoha_ppe *ppe,
@@ -704,15 +732,23 @@ airoha_ppe_foe_get_entry_locked(struct a
 
 	lockdep_assert_held(&ppe_lock);
 
+	if (hash >= airoha_ppe_get_total_num_entries(ppe))
+		return NULL;
+
 	if (hash < sram_num_entries) {
 		u32 *hwe = ppe->foe + hash * sizeof(struct airoha_foe_entry);
+		u32 entry = hash % PPE_SRAM_NUM_ENTRIES;
 		bool ppe2 = hash >= PPE_SRAM_NUM_ENTRIES;
 		struct airoha_eth *eth = ppe->eth;
 		u32 val;
 		int i;
 
+		if (entry >= airoha_ppe_get_sram_num_entries(ppe))
+			return NULL;
+
+		/* PPE_SRAM_CTRL_ENTRY_MASK indexes relative to the selected PPE. */
 		airoha_fe_wr(ppe->eth, REG_PPE_RAM_CTRL(ppe2),
-			     FIELD_PREP(PPE_SRAM_CTRL_ENTRY_MASK, hash) |
+			     FIELD_PREP(PPE_SRAM_CTRL_ENTRY_MASK, entry) |
 			     PPE_SRAM_CTRL_REQ_MASK);
 		if (read_poll_timeout_atomic(airoha_fe_rr, val,
 					     val & PPE_SRAM_CTRL_ACK_MASK,
@@ -761,6 +797,7 @@ static bool airoha_ppe_foe_compare_entry
 static int airoha_ppe_foe_commit_sram_entry(struct airoha_ppe *ppe, u32 hash)
 {
 	struct airoha_foe_entry *hwe = ppe->foe + hash * sizeof(*hwe);
+	u32 entry = hash % PPE_SRAM_NUM_ENTRIES;
 	bool ppe2 = hash >= PPE_SRAM_NUM_ENTRIES;
 	u32 *ptr = (u32 *)hwe, val;
 	int i;
@@ -769,8 +806,9 @@ static int airoha_ppe_foe_commit_sram_en
 		airoha_fe_wr(ppe->eth, REG_PPE_RAM_ENTRY(ppe2, i), ptr[i]);
 
 	wmb();
+	/* PPE_SRAM_CTRL_ENTRY_MASK indexes relative to the selected PPE. */
 	airoha_fe_wr(ppe->eth, REG_PPE_RAM_CTRL(ppe2),
-		     FIELD_PREP(PPE_SRAM_CTRL_ENTRY_MASK, hash) |
+		     FIELD_PREP(PPE_SRAM_CTRL_ENTRY_MASK, entry) |
 		     PPE_SRAM_CTRL_WR_MASK | PPE_SRAM_CTRL_REQ_MASK);
 
 	return read_poll_timeout_atomic(airoha_fe_rr, val,
@@ -1547,14 +1585,19 @@ void airoha_ppe_check_skb(struct airoha_
 			  u16 hash, bool rx_wlan)
 {
 	struct airoha_ppe *ppe = dev->priv;
-	u32 ppe_hash_mask;
+	u32 num_entries, sram_num_entries;
 	u16 now, diff;
 
 	if (unlikely(!rcu_access_pointer(ppe->eth->npu)))
 		return;
 
-	ppe_hash_mask = airoha_ppe_get_total_num_entries(ppe) - 1;
-	if (hash > ppe_hash_mask)
+	num_entries = airoha_ppe_get_total_num_entries(ppe);
+	if (hash == AIROHA_RXD4_FOE_ENTRY || hash >= num_entries)
+		return;
+
+	sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+	if (hash < sram_num_entries &&
+	    !airoha_ppe_is_valid_sram_hash(ppe, hash))
 		return;
 
 	now = (u16)jiffies;
