 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_tb_regs);
 
+/* The L2B fields in the PPE window: 64 words starting at FE 0xe00.  The
+ * ethertype enable mask sits at 0xe8c and the 8-entry ethertype table at
+ * 0xed0..0xedc, eight slots in four words.
+ */
+#define AIROHA_PPE_L2B_BASE		0x0e00
+#define AIROHA_PPE_L2B_WORDS		64
+#define AIROHA_PPE_L2B_ETYPE_EN		(AIROHA_PPE_L2B_BASE + 0x08c)
+#define AIROHA_PPE_L2B_ETYPE_N(_n) \
+	(AIROHA_PPE_L2B_BASE + 0x0d0 + (((_n) >> 1) << 2))
+
+/*
+ * The L2B ethertype table and its enable mask are owned by the NPU firmware:
+ * the host driver never writes them, it only sets the multicast bit in its
+ * own FOE entries.  The dump is a live snapshot, not a lock-protected view,
+ * so the NPU can rewrite a word between two reads.  Do not confuse this with
+ * the NPU's own 0x1e900000..0x1ebfffff window, which must not be read from
+ * the A53: a read there hangs the SoC.
+ *
+ * The rest of the window is printed raw because nothing else in it is
+ * documented.
+ */
+static int airoha_ppe_debugfs_l2b_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	int i;
+
+	for (i = 0; i < AIROHA_PPE_L2B_WORDS; i++) {
+		u32 off = AIROHA_PPE_L2B_BASE + i * 4;
+		u32 val = airoha_fe_rr(eth, off);
+
+		/* idx, register offset, raw value. */
+		seq_printf(m, "%02d 0x%04x %08x", i, off, val);
+
+		if (off == AIROHA_PPE_L2B_ETYPE_EN)
+			seq_printf(m, " EN=0x%08x inner=0x%04x outer=0x%04x",
+				   val, val & 0xffff, val >> 16);
+		else if (off >= AIROHA_PPE_L2B_ETYPE_N(0) &&
+			 off <= AIROHA_PPE_L2B_ETYPE_N(7)) {
+			u32 base = (off - AIROHA_PPE_L2B_ETYPE_N(0)) / 4 * 2;
+
+			/* Even slots are in the low half of the word. */
+			seq_printf(m, " N%u=0x%04x N%u=0x%04x", base,
+				   val & 0xffff, base + 1, val >> 16);
+		}
+
+		seq_putc(m, '\n');
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_l2b);
+
