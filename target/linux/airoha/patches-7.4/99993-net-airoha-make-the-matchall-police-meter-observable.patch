+/* A tc matchall police is one meter for the whole block: it programs the
+ * ingress TRTCM of every RX ring this QDMA owns, so a single action covers
+ * all traffic arriving on the port.  It deliberately takes no ppe->meter[]
+ * group.  Those groups are named per FOE entry through AIROHA_FOE_SHAPER_ID
+ * and there are only AIROHA_PPE_METER_NUM (63) of them, so a group is a
+ * per-flow resource; a matchall rule names no flow, and spending one of the
+ * 63 on "everything on this port" would take a group away from the flows
+ * that can be shaped individually.  The two meters also sit in different
+ * blocks -- the group register is frame-engine space at 0x200c + 16 *
+ * group, this TRTCM is in the QDMA window -- so ppe/meter staying empty for
+ * matchall is the design, not a gap.  qdma/rx_meter shows what this path
+ * was asked for.
+ */
 static int airoha_qdma_set_rx_meter(struct airoha_gdm_dev *dev,
 				    u32 rate, u32 bucket_size,
 				    enum trtcm_unit_type unit_type)
@@ -3978,6 +4126,14 @@
 			return err;
 	}
 
+	/* The request, not a register readback: the TRTCM token-rate and
+	 * bucket-shift parameters are write-only for this driver, see
+	 * airoha_qdma_debugfs_rx_meter_show().
+	 */
+	qdma->rx_meter_rate = rate;
+	qdma->rx_meter_burst = bucket_size;
+	qdma->rx_meter_unit = unit_type;
+
 	return 0;
 }
 
