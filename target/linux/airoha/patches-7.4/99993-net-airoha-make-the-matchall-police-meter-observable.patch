From: OpenWrt <openwrt@example.org>
Date: Sun, 22 Nov 2026 00:30:00 +0800
Subject: [PATCH] net: airoha: make the matchall police meter observable

tc matchall police lands on the QDMA RX TRTCM, not on a PPE meter group:
airoha_qdma_set_rx_meter() programs every RX ring of the block, while
ppe->meter[] names one group per FOE entry through AIROHA_FOE_SHAPER_ID, so
ppe/meter has no row for matchall and cannot grow one.  That difference is
the design, not a missing allocation, but until now the matchall side had no
readback at all.

Record the request in struct airoha_qdma and add qdma/rx_meter: the
requested rate, burst and unit, plus the per-ring arming read back through
TRTCM_MISC_MODE -- the same parameter airoha_qdma_set_rl_config() reads
before every write.  The token rate and bucket shift are deliberately not
printed: the driver writes them through the TRTCM parameter window and never
reads them back, so a number re-derived from the write would restate the
software record while looking like a register value.

Also state in airoha_qdma_set_rx_meter() why matchall takes no ppe->meter[]
group, so the empty ppe/meter dump is not read as a gap.

The 7.4 and 7.3 queues apply this with -F0 and no fuzz.  Not run on a device:
the per-ring mode readback still needs one capture on r38242+.

Signed-off-by: OpenWrt <openwrt@example.org>
---

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -753,6 +753,14 @@
 }
 
 #ifdef CONFIG_DEBUG_FS
+
+/* Defined with the TRTCM writers further down; the meter dump below needs
+ * the same indirect parameter read the rate-limit path already uses.
+ */
+static int airoha_qdma_get_rl_param(struct airoha_qdma *qdma, int queue_id,
+				    u32 addr, enum trtcm_param_type param,
+				    u32 *val_low, u32 *val_high);
+
 static int airoha_pse_debugfs_show(struct seq_file *m, void *private)
 {
 	struct airoha_eth *eth = m->private;
@@ -906,6 +914,63 @@
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_qdma_debugfs_tx_ring_hist);
 
+/* The tc matchall police leaves no ppe/meter row: it arms the RX TRTCM of
+ * this block instead (see airoha_qdma_set_rx_meter()).  The requested rate
+ * and burst are the software record of the last request -- tc's own
+ * parameters, not a register -- and the per-ring arming is read back through
+ * TRTCM_MISC_MODE, the parameter the driver reads before every write.  The
+ * token rate and bucket shift are not printed: they go through the TRTCM
+ * parameter window and nothing in this driver reads them back, so a value
+ * re-derived from what was written would only restate the software record.
+ */
+static int airoha_qdma_debugfs_rx_meter_show(struct seq_file *m, void *private)
+{
+	static const char * const units[] = { "byte", "packet" };
+	struct airoha_eth *eth = m->private;
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		struct airoha_qdma *qdma = &eth->qdma[i];
+		const char *unit = "unknown";
+
+		if (qdma->rx_meter_unit <= TRTCM_PACKET_UNIT)
+			unit = units[qdma->rx_meter_unit];
+
+		seq_printf(m, "qdma %d requested rate %u bps burst %u unit %s\n",
+			   i, qdma->rx_meter_rate, qdma->rx_meter_burst,
+			   unit);
+
+		for (j = 0; j < ARRAY_SIZE(qdma->q_rx); j++) {
+			u32 mode;
+			int err;
+
+			if (!qdma->q_rx[j].ndesc)
+				continue;
+
+			err = airoha_qdma_get_rl_param(qdma, j,
+						       REG_INGRESS_TRTCM_CFG,
+						       TRTCM_MISC_MODE, &mode,
+						       NULL);
+			if (err) {
+				seq_printf(m,
+					   "qdma %d ring %2d mode unreadable %d\n",
+					   i, j, err);
+				continue;
+			}
+
+			seq_printf(m,
+				   "qdma %d ring %2d mode %08x meter_en %u pps %u tick_sel %u\n",
+				   i, j, mode,
+				   !!(mode & TRTCM_METER_MODE),
+				   !!(mode & TRTCM_PKT_MODE),
+				   !!(mode & TRTCM_TICK_SEL));
+		}
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_qdma_debugfs_rx_meter);
+
 static void airoha_qdma_debugfs_init(struct airoha_eth *eth)
 {
 	eth->qdma_debugfs_dir = debugfs_create_dir("qdma", NULL);
@@ -913,6 +978,8 @@
 			    &airoha_qdma_debugfs_napi_weight_fops);
 	debugfs_create_file("tx_ring_hist", 0444, eth->qdma_debugfs_dir, eth,
 			    &airoha_qdma_debugfs_tx_ring_hist_fops);
+	debugfs_create_file("rx_meter", 0444, eth->qdma_debugfs_dir, eth,
+			    &airoha_qdma_debugfs_rx_meter_fops);
 }
 #else
 static void airoha_pse_debugfs_init(struct airoha_eth *eth) {}
@@ -3911,6 +3978,19 @@
 	return err;
 }
 
+/* A tc matchall police is one meter for the whole block: it programs the
+ * ingress TRTCM of every RX ring this QDMA owns, so a single action covers
+ * all traffic arriving on the port.  It deliberately takes no ppe->meter[]
+ * group.  Those groups are named per FOE entry through AIROHA_FOE_SHAPER_ID
+ * and there are only AIROHA_PPE_METER_NUM (63) of them, so a group is a
+ * per-flow resource; a matchall rule names no flow, and spending one of the
+ * 63 on "everything on this port" would take a group away from the flows
+ * that can be shaped individually.  The two meters also sit in different
+ * blocks -- the group register is frame-engine space at 0x200c + 16 *
+ * group, this TRTCM is in the QDMA window -- so ppe/meter staying empty for
+ * matchall is the design, not a gap.  qdma/rx_meter shows what this path
+ * was asked for.
+ */
 static int airoha_qdma_set_rx_meter(struct airoha_gdm_dev *dev,
 				    u32 rate, u32 bucket_size,
 				    enum trtcm_unit_type unit_type)
@@ -3934,6 +4014,14 @@
 			return err;
 	}
 
+	/* The request, not a register readback: the TRTCM token-rate and
+	 * bucket-shift parameters are write-only for this driver, see
+	 * airoha_qdma_debugfs_rx_meter_show().
+	 */
+	qdma->rx_meter_rate = rate;
+	qdma->rx_meter_burst = bucket_size;
+	qdma->rx_meter_unit = unit_type;
+
 	return 0;
 }
 
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -743,6 +743,14 @@
 	 * port-derived channel.
 	 */
 	u64 tx_ring_hash_fallback;
+
+	/* Last tc matchall police request programmed into this block's RX
+	 * rings.  A software record: the RX TRTCM token rate is never read
+	 * back, so this is what was asked for, not what latched.
+	 */
+	u32 rx_meter_rate;
+	u32 rx_meter_burst;
+	u8 rx_meter_unit;
 };
 
 enum airoha_dev_flags {
