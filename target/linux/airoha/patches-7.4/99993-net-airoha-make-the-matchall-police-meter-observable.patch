-	return airoha_qdma_set_rl_param(qdma, queue_id, REG_INGRESS_TRTCM_CFG,
-					TRTCM_BUCKETSIZE_SHIFT_MODE, val);
+	err = __airoha_qdma_set_rl_param(qdma, queue_id, REG_INGRESS_TRTCM_CFG,
