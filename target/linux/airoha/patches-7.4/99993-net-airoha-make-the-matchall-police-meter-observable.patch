+	mutex_lock(&qdma->eth->trtcm_lock);
+	err = __airoha_qdma_get_rl_param(qdma, queue_id, addr, TRTCM_MISC_MODE,
+					 &val, NULL);
+	if (!err) {
+		val = enable ? val | enable_mask : val & ~enable_mask;
+		err = __airoha_qdma_set_rl_param(qdma, queue_id, addr,
+						 TRTCM_MISC_MODE, val);
