-				       &val, NULL);
-	if (err)
-		return err;
-
-	val = enable ? val | enable_mask : val & ~enable_mask;
+	/* Read the mode and write it back under one lock: a reader of the
+	 * parameter between the two would cost the update, not just see a
+	 * stale value.
