-				       TRTCM_MISC_MODE, &config, NULL);
-	if (err)
+	mutex_lock(&qdma->eth->trtcm_lock);
+	err = __airoha_qdma_get_rl_param(qdma, queue_id, REG_INGRESS_TRTCM_CFG,
+					 TRTCM_MISC_MODE, &config, NULL);
