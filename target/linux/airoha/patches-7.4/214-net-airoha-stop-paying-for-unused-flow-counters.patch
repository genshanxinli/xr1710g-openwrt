From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Thu, 29 Oct 2026 12:10:00 +0800
Subject: [PATCH] net: airoha: stop paying for flow counters the NPU never provides

Avoid carving out half of PPE SRAM when the NPU refuses flow counters,
keeping PPE_DRAM_TABLE_EN and PPE_DRAM_HASH1_EN disabled (pure 16K SRAM
mode to prevent concurrent dual-PPE corruption of a shared DRAM table).
Bounds-check hash against total entries and SRAM carve-out holes in
airoha_ppe_foe_commit_entry(), and publish hwe->ib1 with wmb() strictly
after payload copy and airoha_ppe_foe_flow_stats_update().

Origin: archive/xr1710g-v1@e85677d284c0; xr1710g #413
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -35,7 +35,8 @@ static const struct rhashtable_params ai
 	.automatic_shrinking = true,
 };
 
-static int airoha_ppe_get_num_stats_entries(struct airoha_ppe *ppe)
+/* Max flow-stats slots per PPE for init buffer allocation. */
+static int airoha_ppe_stats_capable_entries(struct airoha_ppe *ppe)
 {
 	if (!IS_ENABLED(CONFIG_NET_AIROHA_FLOW_STATS))
 		return -EOPNOTSUPP;
@@ -46,9 +47,20 @@ static int airoha_ppe_get_num_stats_entr
 	return PPE_STATS_NUM_ENTRIES;
 }
 
+/* Active SRAM flow-stats carve-out per PPE (0 when NPU refuses stats). */
+static int airoha_ppe_get_num_stats_entries(struct airoha_ppe *ppe)
+{
+	int num_stats = airoha_ppe_stats_capable_entries(ppe);
+
+	if (num_stats > 0 && !READ_ONCE(ppe->foe_stats_enabled))
+		return -EOPNOTSUPP;
+
+	return num_stats;
+}
+
 static int airoha_ppe_get_total_num_stats_entries(struct airoha_ppe *ppe)
 {
-	int num_stats = airoha_ppe_get_num_stats_entries(ppe);
+	int num_stats = airoha_ppe_stats_capable_entries(ppe);
 
 	if (num_stats > 0) {
 		struct airoha_eth *eth = ppe->eth;
@@ -196,6 +208,7 @@ static void airoha_ppe_hw_init(struct ai
 			      PPE_SRAM_TABLE_EN_MASK |
 			      PPE_SRAM_HASH1_EN_MASK |
 			      PPE_DRAM_TABLE_EN_MASK |
+			      PPE_DRAM_HASH1_EN_MASK |
 			      PPE_SRAM_HASH0_MODE_MASK |
 			      PPE_SRAM_HASH1_MODE_MASK |
 			      PPE_DRAM_HASH0_MODE_MASK |
@@ -678,9 +691,9 @@ static void airoha_ppe_foe_flow_stats_re
 static void airoha_ppe_foe_flow_stats_update(struct airoha_ppe *ppe,
 					     struct airoha_npu *npu,
 					     struct airoha_foe_entry *hwe,
-					     u32 hash)
+					     u32 hash, u32 ib1)
 {
-	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, ib1);
 	u32 index, pse_port, val, *data, *ib2, *meter;
 	int ppe_num_stats_entries;
 	u8 nbq;
@@ -831,18 +844,23 @@ static int airoha_ppe_foe_commit_entry(s
 				       u32 hash, bool rx_wlan)
 {
 	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
-	struct airoha_foe_entry *hwe = ppe->foe + hash * sizeof(*hwe);
+	struct airoha_foe_entry *hwe;
 	u32 ts = airoha_ppe_get_timestamp(ppe);
 	struct airoha_eth *eth = ppe->eth;
 	struct airoha_npu *npu;
 	int err = 0;
 
-	memcpy(&hwe->d, &e->d, sizeof(*hwe) - sizeof(hwe->ib1));
-	wmb();
+	/* Bounds-check before writing host buffer or SRAM. */
+	if (hash >= airoha_ppe_get_total_num_entries(ppe))
+		return -EINVAL;
+	if (hash < sram_num_entries &&
+	    !airoha_ppe_is_valid_sram_hash(ppe, hash))
+		return -EINVAL;
+
+	hwe = ppe->foe + hash * sizeof(*hwe);
 
 	e->ib1 &= ~AIROHA_FOE_IB1_BIND_TIMESTAMP;
 	e->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_TIMESTAMP, ts);
-	hwe->ib1 = e->ib1;
 
 	rcu_read_lock();
 
@@ -852,8 +870,13 @@ static int airoha_ppe_foe_commit_entry(s
 		goto unlock;
 	}
 
+	/* Populate entry payload and stats rewrite before publishing ib1. */
+	memcpy(&hwe->d, &e->d, sizeof(*hwe) - sizeof(hwe->ib1));
 	if (!rx_wlan)
-		airoha_ppe_foe_flow_stats_update(ppe, npu, hwe, hash);
+		airoha_ppe_foe_flow_stats_update(ppe, npu, hwe, hash, e->ib1);
+	wmb();
+	WRITE_ONCE(hwe->ib1, e->ib1);
+	wmb();
 
 	if (hash < sram_num_entries)
 		err = airoha_ppe_foe_commit_sram_entry(ppe, hash);
