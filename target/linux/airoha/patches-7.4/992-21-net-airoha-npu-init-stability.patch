 					      val, (val & MBOX_MSG_DONE),
-					      100, 1000 * USEC_PER_MSEC);
-	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
+					      AIROHA_NPU_MBOX_POLL_US,
+					      timeout_us);
+	if (ret) {
+		dev_warn_ratelimited(npu->dev,
+				     "mailbox timed out after %u us (func %#x)\n",
+				     timeout_us, func_id);
