+/* A mailbox round trip takes microseconds, so these bounds exist to give up on
+ * an NPU that stopped answering, not to wait for a slow one. The runtime
+ * callers already hold spin_lock_bh() here (station teardown under
+ * rcu_read_lock() in mt76, flow commit under BH disable in the PPE path), so
+ * the tight bound is what keeps a wedged NPU from stalling a CPU for most of
+ * a second. Probe-time setup keeps the generous bound: a slow firmware
+ * start-up there costs a failed boot instead of a hiccup.
+ */
+#define AIROHA_NPU_MBOX_POLL_US		100
+#define AIROHA_NPU_MBOX_TIMEOUT_US	(20 * USEC_PER_MSEC)
+#define AIROHA_NPU_MBOX_INIT_TIMEOUT_US	(500 * USEC_PER_MSEC)
+
+static u32 airoha_npu_mbox_timeout(gfp_t gfp)
+{
+	return gfpflags_allow_blocking(gfp) ? AIROHA_NPU_MBOX_INIT_TIMEOUT_US :
+					      AIROHA_NPU_MBOX_TIMEOUT_US;
+}
+
