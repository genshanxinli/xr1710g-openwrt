From: fanboy <fanboy@openwrt.org>
Date: Sun, 9 Aug 2026 07:53:16 -1000
Subject: [PATCH] net: airoha: npu: split atomic/init mailbox timeouts and retry WLAN init

Retry transient WLAN NPU mailbox init commands using sleepable msleep(10)
delays and split mailbox poll timeouts into 20 ms for atomic/BH callers vs
500 ms for blocking init callers, logging ratelimited warnings on timeout.

Origin: archive/xr1710g-v1@e85677d284c0; https://github.com/openwrt/openwrt/pull/26812 (msleep retry)
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -167,9 +167,23 @@ struct wlan_mbox_data {
 	DECLARE_FLEX_ARRAY(u8, d);
 };
 
-static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
-				 const void *data, int len, void *reply,
-				 u16 reply_len)
+/* Use 20 ms timeout for atomic/BH callers and 500 ms for blocking init calls
+ * so a wedged NPU cannot stall a CPU under spin_lock_bh().
+ */
+#define AIROHA_NPU_MBOX_POLL_US		100
+#define AIROHA_NPU_MBOX_TIMEOUT_US	(20 * USEC_PER_MSEC)
+#define AIROHA_NPU_MBOX_INIT_TIMEOUT_US	(500 * USEC_PER_MSEC)
+
+static u32 airoha_npu_mbox_timeout(gfp_t gfp)
+{
+	return gfpflags_allow_blocking(gfp) ? AIROHA_NPU_MBOX_INIT_TIMEOUT_US :
+					      AIROHA_NPU_MBOX_TIMEOUT_US;
+}
+
+static int
+__airoha_npu_send_msg_timeout(struct airoha_npu *npu, int func_id,
+			      const void *data, int len, void *reply,
+			      u16 reply_len, u32 timeout_us)
 {
 	struct airoha_npu_core *core = &npu->cores[0]; /* FIXME: core */
 	u32 val, offset = 0;
@@ -204,19 +218,46 @@ static int __airoha_npu_send_msg(struct
 	ret = regmap_read_poll_timeout_atomic(npu->regmap,
 					      REG_CR_MBQ0_CTRL(3) + offset,
 					      val, (val & MBOX_MSG_DONE),
-					      100, 1000 * MSEC_PER_SEC);
-	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
+					      AIROHA_NPU_MBOX_POLL_US,
+					      timeout_us);
+	if (ret) {
+		dev_warn_ratelimited(npu->dev,
+				     "mailbox timed out after %u us (func %#x)\n",
+				     timeout_us, func_id);
+		goto out;
+	}
+
+	if (FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;
 
 	/* Copy the trailing reply_len bytes of the response. */
 	if (!ret && reply)
 		memcpy(reply, core->buf + len - reply_len, reply_len);
-
+out:
 	spin_unlock_bh(&core->lock);
 
 	return ret;
 }
 
+static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
+				 const void *data, int len, void *reply,
+				 u16 reply_len)
+{
+	return __airoha_npu_send_msg_timeout(npu, func_id, data, len, reply,
+					     reply_len,
+					     AIROHA_NPU_MBOX_INIT_TIMEOUT_US);
+}
+
+/* Flow commits reach this from the PPE table under rcu_read_lock(), so they
+ * cannot sit in the mailbox for the probe-time budget.
+ */
+static int airoha_npu_send_msg_atomic(struct airoha_npu *npu, int func_id,
+				      void *data, int len)
+{
+	return __airoha_npu_send_msg_timeout(npu, func_id, data, len, data, len,
+					     AIROHA_NPU_MBOX_TIMEOUT_US);
+}
+
 static int airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 			       void *data, int len)
 {
@@ -439,8 +480,8 @@ static int airoha_npu_foe_commit_entry(s
 	ppe_data->set_info.func_id = ppe2 ? PPE2_SRAM_SET_ENTRY
 					  : PPE_SRAM_SET_ENTRY;
 
-	err = airoha_npu_send_msg(npu, NPU_FUNC_PPE, ppe_data,
-				  sizeof(*ppe_data));
+	err = airoha_npu_send_msg_atomic(npu, NPU_FUNC_PPE, ppe_data,
+					 sizeof(*ppe_data));
 	if (err)
 		goto out;
 
@@ -448,8 +489,8 @@ static int airoha_npu_foe_commit_entry(s
 	ppe_data->set_info.data = hash;
 	ppe_data->set_info.size = sizeof(u32);
 
-	err = airoha_npu_send_msg(npu, NPU_FUNC_PPE, ppe_data,
-				  sizeof(*ppe_data));
+	err = airoha_npu_send_msg_atomic(npu, NPU_FUNC_PPE, ppe_data,
+					 sizeof(*ppe_data));
 out:
 	kfree(ppe_data);
 
@@ -510,7 +551,9 @@ static int airoha_npu_wlan_msg_send(stru
 	wlan_data->func_id = func_id;
 	memcpy(wlan_data->d, data, data_len);
 
-	err = airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len);
+	err = __airoha_npu_send_msg_timeout(npu, NPU_FUNC_WIFI, wlan_data,
+					    len, wlan_data, len,
+					    airoha_npu_mbox_timeout(gfp));
 	kfree(wlan_data);
 
 	return err;
@@ -532,8 +575,9 @@ static int airoha_npu_wlan_msg_get(struc
 	wlan_data->func_type = NPU_OP_GET;
 	wlan_data->func_id = func_id;
 
-	err = __airoha_npu_send_msg(npu, NPU_FUNC_WIFI, wlan_data, len,
-				    data, data_len);
+	err = __airoha_npu_send_msg_timeout(npu, NPU_FUNC_WIFI, wlan_data,
+					    len, data, data_len,
+					    airoha_npu_mbox_timeout(gfp));
 	kfree(wlan_data);
 
 	return err;
@@ -559,29 +603,55 @@ airoha_npu_wlan_set_reserved_memory(stru
 					sizeof(val), GFP_KERNEL);
 }
 
+static int airoha_npu_wlan_cmd_with_retry(struct airoha_npu *npu, int ifindex,
+					  enum airoha_npu_wlan_set_cmd cmd,
+					  const char *name, int is_msg_send,
+					  u32 *val)
+{
+	int err = 0, retry_cnt = 3;
+
+	while (retry_cnt) {
+		if (is_msg_send)
+			err = airoha_npu_wlan_msg_send(npu, ifindex, cmd, val,
+						       sizeof(*val),
+						       GFP_KERNEL);
+		else
+			err = airoha_npu_wlan_set_reserved_memory(npu, ifindex,
+								  name, cmd);
+		if (!err)
+			break;
+		msleep(10);
+		retry_cnt--;
+	}
+	msleep(10);
+	if (!retry_cnt)
+		return err;
+	return 0;
+}
+
 static int airoha_npu_wlan_init_memory(struct airoha_npu *npu)
 {
 	enum airoha_npu_wlan_set_cmd cmd = WLAN_FUNC_SET_WAIT_NPU_BAND0_ONCPU;
 	u32 val = 0;
 	int err;
 
-	err = airoha_npu_wlan_msg_send(npu, 1, cmd, &val, sizeof(val),
-				       GFP_KERNEL);
+	err = airoha_npu_wlan_cmd_with_retry(npu, 1, cmd, "band0_oncpu", 1,
+					    &val);
 	if (err)
 		return err;
 
 	cmd = WLAN_FUNC_SET_WAIT_TX_BUF_CHECK_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-bufid", cmd);
+	err = airoha_npu_wlan_cmd_with_retry(npu, 0, cmd, "tx-bufid", 0, NULL);
 	if (err)
 		return err;
 
 	cmd = WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "pkt", cmd);
+	err = airoha_npu_wlan_cmd_with_retry(npu, 0, cmd, "pkt", 0, NULL);
 	if (err)
 		return err;
 
 	cmd = WLAN_FUNC_SET_WAIT_TX_PKT_BUF_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-pkt", cmd);
+	err = airoha_npu_wlan_cmd_with_retry(npu, 0, cmd, "tx-pkt", 0, NULL);
 	if (err)
 		return err;
 
@@ -594,8 +664,8 @@ static int airoha_npu_wlan_init_memory(s
 	}
 
 	cmd = WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU;
-	return airoha_npu_wlan_msg_send(npu, 0, cmd, &val, sizeof(val),
-					GFP_KERNEL);
+	return airoha_npu_wlan_cmd_with_retry(npu, 0, cmd, "force_to_cpu", 1,
+					      &val);
 }
 
 static u32 airoha_npu_wlan_queue_addr_get(struct airoha_npu *npu, int qid,
