From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:10:00 +0800
Subject: [PATCH] net: airoha: deepen the PSE reserve of GDM4

GDM4 is a 10G port with only two PSE egress queues, leaving 16 KiB (~13 us
at 10G) of guaranteed reserve under the stock 64-page per-queue setting.
Deepen GDM4's per-queue PSE reserve to 4x stock, tuning CDM5 before GDM4
and subtracting the port's existing per-queue reserve sum from all_rsv so
final all_rsv never exceeds fq_limit - 0x400.

Origin: archive/xr1710g-v1@e85677d284c0; xr1710g #413
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -323,21 +323,65 @@ static int airoha_fe_set_pse_oq_rsv(stru
 	return 0;
 }
 
+static const u32 pse_port_num_queues[] = {
+	[FE_PSE_PORT_CDM1] = 6,
+	[FE_PSE_PORT_GDM1] = 6,
+	[FE_PSE_PORT_GDM2] = 32,
+	[FE_PSE_PORT_GDM3] = 6,
+	[FE_PSE_PORT_PPE1] = 4,
+	[FE_PSE_PORT_CDM2] = 6,
+	[FE_PSE_PORT_CDM3] = 8,
+	[FE_PSE_PORT_CDM4] = 10,
+	[FE_PSE_PORT_PPE2] = 4,
+	[FE_PSE_PORT_GDM4] = 2,
+	[FE_PSE_PORT_CDM5] = 2,
+};
+
+/* Per-queue PSE reserve (128B pages); GDM4 needs 4x for 2-queue 10G. */
+static const u32 pse_port_weight[] = {
+	[FE_PSE_PORT_CDM1] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_GDM1] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_GDM3] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_PPE1] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_CDM2] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_CDM4] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_PPE2] = PSE_QUEUE_RSV_PAGES,
+	[FE_PSE_PORT_GDM4] = PSE_QUEUE_RSV_PAGES * 4,
+	[FE_PSE_PORT_CDM5] = PSE_QUEUE_RSV_PAGES,
+};
+
+/* Cap per-queue PSE reserve against remaining shared-pool headroom. */
+static void airoha_pse_tune_port(struct airoha_eth *eth, u32 port,
+				 u32 weight_pages)
+{
+	u32 nq = pse_port_num_queues[port];
+	u32 weight = weight_pages;
+	u32 q;
+
+	if (weight > PSE_QUEUE_RSV_PAGES) {
+		u32 fq_limit, all_rsv, orig_sum = 0, base_rsv, max_weight;
+
+		for (q = 0; q < nq; q++)
+			orig_sum += airoha_fe_get_pse_queue_rsv_pages(eth, port, q);
+
+		fq_limit = airoha_fe_get(eth, PSE_FQ_CFG, PSE_FQ_LIMIT_MASK);
+		all_rsv = airoha_fe_get_pse_all_rsv(eth);
+		base_rsv = all_rsv > orig_sum ? all_rsv - orig_sum : 0;
+
+		if (fq_limit > base_rsv + 0x400)
+			max_weight = (fq_limit - base_rsv - 0x400) / nq;
+		else
+			max_weight = 0;
+
+		weight = min(weight, max_weight);
+	}
+
+	for (q = 0; q < nq; q++)
+		airoha_fe_set_pse_oq_rsv(eth, port, q, weight);
+}
