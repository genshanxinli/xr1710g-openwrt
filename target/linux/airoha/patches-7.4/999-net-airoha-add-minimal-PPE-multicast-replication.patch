+/* Minimal multicast replication.  The PPE entry keeps the conduit PSE
+ * port and carries the DSA/switch destination bitmap in the L2 etype
+ * word; IB2.MULTICAST additionally keeps a CPU copy for members that are
+ * not behind that switch (WLAN).  The legacy PPE2_MCAST_PPSE register is
+ * not implemented on AN7581 and is not used.
+ */
+#define AIROHA_PPE_MCAST_SWITCH_PORTS	6
+
+struct airoha_flow_data {
+	struct ethhdr eth;
+
  * word, and the tunnel-decap bit ("rmt") in information block 1.  The driver
  * only maps values the flow offload API reports; it does not create, program
  * or tear down the tunnel or its table.
@@ -612,10 +620,16 @@
 		u16 sid;
 		u8 num;
 	} pppoe;
-	struct airoha_ppe_6rd sixrd;
+
+	/* DSA/switch destination bitmap for a multicast flow, zero for a
+	 * unicast flow.  A multicast flow is only offloaded when at least
+	 * two switch ports can be replicated in hardware.
+	 */
+	u16 mcast_mask;
 };
 
 enum airoha_flow_entry_type {
+enum airoha_flow_entry_type {
 	 * not from the flow dissector: the kernel exposes the inner IPv4
 	 * tuple and the ingress ifindex, and the ingress device is the
 	 * per-flow DS-Lite mark.
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -826,6 +826,97 @@
 #endif
 }
 
+/* The vendor SDK's LAN 1->N path does not use the legacy
+ * PPE2_MCAST_PPSE register (FE + 0x284): that address reads back as
+ * 0xdeadbeef on AN7581 and the SDK never writes it.  The hardware path it
+ * does use keeps the conduit PSE port and carries the switch destination
+ * bitmap in the L2 etype word, with the QDMA1 hardware path selected by
+ * the force-QoS bit the LAN entries already set.  Widening that bitmap
+ * from one DSA port to every DSA port of the egress bridge gives one
+ * hardware copy per switch port without a new table or register.
+ *
+ * Members that are not behind the switch (WLAN, direct GDM ports) cannot
+ * be named by this bitmap; the IB2.MULTICAST CPU copy keeps them working
+ * while the LAN ports are replicated in hardware.
+ */
+struct airoha_ppe_mcast_walk {
+	u32 ingress_ifindex;
+	u16 switch_mask;
+	int switch_ports;
+};
+
+#if IS_ENABLED(CONFIG_NET_DSA)
+static int airoha_ppe_mcast_walk_dev(struct net_device *dev,
+				     struct netdev_nested_priv *priv)
+{
+	struct airoha_ppe_mcast_walk *walk = priv->data;
+	struct dsa_port *dp;
+
+	if (dev->ifindex == walk->ingress_ifindex || !netif_running(dev))
+		return 0;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp) || dp->index >= AIROHA_PPE_MCAST_SWITCH_PORTS)
+		return 0;
+
+	walk->switch_mask |= BIT(dp->index);
+	walk->switch_ports++;
+
+	return 0;
+}
+
+static u16 airoha_ppe_mcast_switch_mask(struct net_device *netdev,
+					u32 ingress_ifindex)
+{
+	struct netdev_nested_priv priv = {};
+	struct net_device *master;
+	struct airoha_ppe_mcast_walk walk = {
+		.ingress_ifindex = ingress_ifindex,
+	};
+
+	if (!netdev)
+		return 0;
+
+	priv.data = &walk;
+
+	rcu_read_lock();
+	master = netdev_master_upper_dev_get_rcu(netdev);
+	if (!master || !netif_is_bridge_master(master))
+		master = netif_is_bridge_master(netdev) ? netdev : NULL;
+	if (master)
+		netdev_walk_all_lower_dev_rcu(master,
+					      airoha_ppe_mcast_walk_dev,
+					      &priv);
+	rcu_read_unlock();
+
+	/* Replication is only useful (and only provable) with at least two
+	 * switch-facing members; otherwise leave the entry on the old
+	 * single-port path.
+	 */
+	return walk.switch_ports > 1 ? walk.switch_mask : 0;
+}
+#else
+static u16 airoha_ppe_mcast_switch_mask(struct net_device *netdev,
+					u32 ingress_ifindex)
+{
+	return 0;
+}
+#endif
+
+/* The switch port bitmap is only meaningful when the redirect target is a
+ * DSA user port behind the switch.
+ */
+static bool airoha_ppe_mcast_switch_egress(struct net_device *netdev)
+{
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct dsa_port *dp = dsa_port_from_netdev(netdev);
+
+	return !IS_ERR(dp);
+#else
+	return false;
+#endif
+}
+
 static void airoha_ppe_foe_set_bridge_addrs(struct airoha_foe_bridge *br,
 					    struct ethhdr *eh)
 {
@@ -1098,6 +1189,14 @@
 		}
 	}
 
+	if (data->mcast_mask) {
+		/* The hardware replicates through the switch port mask
+		 * written below.  The SDK keeps multicast entries off the
+		 * SRAM fast path; do the same.
+		 */
+		val &= ~AIROHA_FOE_IB2_FAST_PATH;
+	}
+
 	if (is_multicast_ether_addr(data->eth.h_dest))
 		val |= AIROHA_FOE_IB2_MULTICAST;
 
@@ -1180,7 +1279,8 @@
 	if (wlan_etype >= 0) {
 		l2->etype = wlan_etype;
 	} else if (dsa_port >= 0) {
-		l2->etype = BIT(dsa_port);
+		l2->etype = data->mcast_mask ? data->mcast_mask :
+						     BIT(dsa_port);
 		l2->etype |= !data->vlan.num ? BIT(15) : 0;
 	} else if (data->pppoe.num) {
 		l2->etype = ETH_P_PPP_SES;
@@ -2370,12 +2470,29 @@
 	}
 
 	if (!is_valid_ether_addr(data.eth.h_source) ||
-	    !is_valid_ether_addr(data.eth.h_dest))
+	    (!is_valid_ether_addr(data.eth.h_dest) &&
+	     !is_multicast_ether_addr(data.eth.h_dest)))
 		return -EINVAL;
 
-	/* Allocate the meter only after every action and the L2 header
-	 * have been accepted: all the early returns above then stay
-	 * allocation-free, and from here on put_smac is the single
+	/* A multicast flow cannot be sent to the single port of the
+	 * unicast path.  Accept it only when the egress is a switch port
+	 * and at least two members of its bridge can be replicated in
+	 * hardware; otherwise leave it entirely to software.
+	 */
+	if (is_multicast_ether_addr(data.eth.h_dest)) {
+		u32 ingress = meta.key->ingress_ifindex;
+
+		if (!airoha_ppe_mcast_switch_egress(odev))
+			return -EOPNOTSUPP;
+
+		data.mcast_mask = airoha_ppe_mcast_switch_mask(odev, ingress);
+		if (!data.mcast_mask)
+			return -EOPNOTSUPP;
+	}
+
+	/* A flow whose ingress and egress devices are both ports of the same
+	 * bridge never leaves L2, so the PPE must forward it without touching
+	 * the IP TTL.  Routing -- including entering or leaving the bridge --
 	 * cleanup path.
 	 */
 	if (police) {
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -383,9 +383,112 @@
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_tb_regs);
 
-/* Read-only view of the opt-in per-flow meters.  The software record is
- * what was requested; the register value next to it is what the PPE
- * actually holds, so a dump can tell "never programmed" apart from
+/* Bound multicast entries and their replication port masks.  The masks
+ * live in the entry itself: the DSA/switch port bitmap is the low part of
+ * the L2 etype word and the QDMA NBQ/channel fields select the egress
+ * queue.  The legacy PPE2_MCAST_PPSE register is printed once per PPE as
+ * read-only evidence; it is not implemented on AN7581 (it reads back as
+ * 0xdeadbeef) and the driver never writes it.
+ */
+static int airoha_ppe_debugfs_mcast_show(struct seq_file *m, void *private)
+{
+	static const char *const ppe_type_str[] = {
+		[PPE_PKT_TYPE_IPV4_HNAPT] = "IPv4 5T",
+		[PPE_PKT_TYPE_IPV4_ROUTE] = "IPv4 3T",
+		[PPE_PKT_TYPE_BRIDGE] = "L2B",
+		[PPE_PKT_TYPE_IPV4_DSLITE] = "DS-LITE",
+		[PPE_PKT_TYPE_IPV6_ROUTE_3T] = "IPv6 3T",
+		[PPE_PKT_TYPE_IPV6_ROUTE_5T] = "IPv6 5T",
+		[PPE_PKT_TYPE_IPV6_6RD] = "6RD",
+	};
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_eth *eth = ppe->eth;
+	u32 num_entries = airoha_ppe_get_total_num_entries(ppe);
+	int i;
+
+	for (i = 0; i < eth->soc->num_ppe; i++)
+		seq_printf(m, "PPE%u MCAST_PPSE %#010x (legacy, not written)\n",
+			   i + 1, airoha_fe_rr(eth, REG_PPE_MCAST_PPSE(i)));
+
+	for (i = 0; i < num_entries; i++) {
+		struct airoha_foe_entry *hwe;
+		const char *type_str = "UNKNOWN";
+		u32 type, ib2, data, etype, pse;
+		unsigned char dest[ETH_ALEN];
+		u16 ports;
+		bool ipv6 = false;
+
+		hwe = airoha_ppe_foe_get_entry(ppe, i);
+		if (!hwe)
+			continue;
+
+		if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) !=
+		    AIROHA_FOE_STATE_BIND)
+			continue;
+
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+		if (type < ARRAY_SIZE(ppe_type_str) && ppe_type_str[type])
+			type_str = ppe_type_str[type];
+
+		if (type == PPE_PKT_TYPE_BRIDGE) {
+			ib2 = hwe->bridge.ib2;
+			data = hwe->bridge.data;
+			etype = hwe->bridge.l2.common.etype;
+			put_unaligned_be32(hwe->bridge.dest_mac_hi, dest);
+			put_unaligned_be16(hwe->bridge.dest_mac_lo, dest + 4);
+		} else if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T) {
+			ib2 = hwe->ipv6.ib2;
+			data = hwe->ipv6.data;
+			etype = hwe->ipv6.l2.etype;
+			put_unaligned_be32(hwe->ipv6.l2.dest_mac_hi, dest);
+			put_unaligned_be16(hwe->ipv6.l2.dest_mac_lo, dest + 4);
+			ipv6 = true;
+		} else {
+			ib2 = hwe->ipv4.ib2;
+			data = hwe->ipv4.data;
+			etype = hwe->ipv4.l2.common.etype;
+			put_unaligned_be32(hwe->ipv4.l2.common.dest_mac_hi,
+					   dest);
+			put_unaligned_be16(hwe->ipv4.l2.common.dest_mac_lo,
+					   dest + 4);
+		}
+
+		if (!(ib2 & AIROHA_FOE_IB2_MULTICAST))
+			continue;
+
+		pse = FIELD_GET(AIROHA_FOE_IB2_PSE_PORT, ib2);
+		/* Only switch-facing entries carry the DSA port bitmap in
+		 * etype; the WLAN egress reuses that word for band/WCID.
+		 */
+		ports = pse == FE_PSE_PORT_CDM4 ? 0 :
+			etype & GENMASK(AIROHA_PPE_MCAST_SWITCH_PORTS - 1, 0);
+
+		seq_printf(m, "%05x %-7s pse=%u ports=%#04x nbq=%u chan=%u ",
+			   i, type_str, pse, ports,
+			   (u32)FIELD_GET(AIROHA_FOE_IB2_NBQ, ib2),
+			   (u32)FIELD_GET(AIROHA_FOE_CHANNEL, data));
+		seq_printf(m, "etype=%#06x group=", etype);
+
+		if (type == PPE_PKT_TYPE_BRIDGE) {
+			seq_printf(m, "%pM", dest);
+		} else if (ipv6) {
+			__be32 addr[IPV6_ADDR_WORDS];
+
+			ipv6_addr_cpu_to_be32(addr, hwe->ipv6.dest_ip);
+			seq_printf(m, "%pI6", addr);
+		} else {
+			seq_printf(m, "%pI4h", &hwe->ipv4.orig_tuple.dest_ip);
+		}
+		seq_puts(m, "\n");
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_mcast);
+
+int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
+{
+	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
  * "programmed with a rate the driver did not intend".
  */
 static int airoha_ppe_debugfs_meter_show(struct seq_file *m, void *private)
@@ -558,11 +661,13 @@
 			    &airoha_ppe_debugfs_bind_rate_fops);
 	debugfs_create_file("tb_regs", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_tb_regs_fops);
-	debugfs_create_file("6rd", 0444, ppe->debugfs_dir, ppe,
-			    &airoha_ppe_debugfs_6rd_fops);
+	debugfs_create_file("mcast", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_mcast_fops);
 
 	return 0;
 }
+	return 0;
+}
  * The tables are cleared, not the flows: pair it with
  * "nft flush flowtable inet fw4 ft" or the conntrack entries that keep their
  * IPS_OFFLOAD bit will keep sending packets to a table that no longer holds
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -345,6 +345,14 @@
 #define PPE_SRAM_HASH0_MODE_MASK		GENMASK(7, 4)
 #define PPE_SRAM_TABLE_EN_MASK			BIT(0)
 
+/* Legacy PPE multicast PSE-port map (vendor SDK: PPE2_MCAST_PPSE).
+ * The register is not implemented on AN7581: it reads back as
+ * 0xdeadbeef and the vendor SDK never writes it, so the hardware 1->N
+ * path used by this driver is the QDMA1/switch port bitmap carried in
+ * the L2 etype word instead.  ppe/mcast prints the raw value.
+ */
+#define REG_PPE_MCAST_PPSE(_n)			(((_n) ? PPE2_BASE : PPE1_BASE) + 0x284)
+
 #define REG_PPE_MTU_BASE(_n)			(((_n) ? PPE2_BASE : PPE1_BASE) + 0x304)
 #define REG_PPE_MTU(_m, _n)			(REG_PPE_MTU_BASE(_m) + (((_n) / 2) << 2))
 #define FP_EGRESS_MTU_MASK(_n)			GENMASK(13 + (((_n) % 2) << 4), ((_n) % 2) << 4)
