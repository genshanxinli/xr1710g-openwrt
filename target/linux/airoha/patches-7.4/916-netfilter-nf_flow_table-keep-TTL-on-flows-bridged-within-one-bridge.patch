From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Fri, 23 Oct 2026 22:40:00 +0800
Subject: [PATCH] netfilter: nf_flow_table: keep TTL on flows bridged within one bridge

nf_flow_offload_forward() and nf_flow_offload_ipv6_forward() decremented
IPv4 TTL and IPv6 hop limit unconditionally, causing bridged flows to lose
a hop during software fast-path packets before hardware binding. Skip TTL
decrement when ingress and egress ports share the same bridge master.

Origin: archive/xr1710g-v1@e85677d284c0
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -473,6 +473,37 @@ nf_flow_offload_lookup(struct nf_flowtab
 	return flow_offload_lookup(flow_table, &tuple);
 }
 
+/* Skip IP TTL/hop-limit decrement when both endpoints are ports of the same
+ * bridge, matching L2 forwarding before hardware offload binds.
+ */
+static bool nf_flow_bridged_within_one_bridge(struct nf_flowtable_ctx *ctx,
+					      struct flow_offload_tuple_rhash *tuplehash)
+{
+	const struct flow_offload_tuple *tuple = &tuplehash->tuple;
+	struct net_device *outdev, *indev, *out_master, *in_master;
+	struct net *net;
+	bool bridged = false;
+
+	if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT ||
+	    !ctx->in || !netif_is_bridge_port(ctx->in))
+		return false;
+
+	net = dev_net(ctx->in);
+
+	rcu_read_lock();
+	outdev = dev_get_by_index_rcu(net, tuple->out.ifidx);
+	indev = dev_get_by_index_rcu(net, tuple->iifidx);
+	if (outdev && indev &&
+	    netif_is_bridge_port(outdev) && netif_is_bridge_port(indev)) {
+		out_master = netdev_master_upper_dev_get_rcu(outdev);
+		in_master = netdev_master_upper_dev_get_rcu(indev);
+		bridged = out_master && out_master == in_master;
+	}
+	rcu_read_unlock();
+
+	return bridged;
+}
+
 static int nf_flow_offload_forward(struct nf_flowtable_ctx *ctx,
 				   struct nf_flowtable *flow_table,
 				   struct flow_offload_tuple_rhash *tuplehash,
@@ -522,7 +553,8 @@ static int nf_flow_offload_forward(struc
 				    FIELD_PREP(INET_DSCP_MASK,
 					       tuplehash->tuple.dscp));
 
-	ip_decrease_ttl(iph);
+	if (!nf_flow_bridged_within_one_bridge(ctx, tuplehash))
+		ip_decrease_ttl(iph);
 	skb_clear_tstamp(skb);
 
 	/* As ip_forward() does for the packets the flow did not take. */
@@ -1163,7 +1195,8 @@ static int nf_flow_offload_ipv6_forward(
 				    FIELD_PREP(INET_DSCP_MASK,
 					       tuplehash->tuple.dscp));
 
-	ip6h->hop_limit--;
+	if (!nf_flow_bridged_within_one_bridge(ctx, tuplehash))
+		ip6h->hop_limit--;
 	skb_clear_tstamp(skb);
 
 	if (flow->priority)
