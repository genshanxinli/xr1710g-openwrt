From: OpenWrt <openwrt@example.org>
Subject: [PATCH] net: airoha: hash offloaded flows across the 32 TX rings

airoha_dev_select_queue() picks the QDMA channel from port->id and the
queue inside that channel from skb->priority, so the ring a packet lands
on is a function of its egress port and its priority alone.  Every flow
leaving one port therefore shares eight of the 32 TX rings no matter how
many 5-tuples the box carries: one busy TCP stream and forty small ones
are enqueued on the same eight rings, and the other 24 stay idle.

Deriving the channel from the flow hash instead spreads unrelated flows
over the four HW QoS channels.  The queue inside the channel still
follows skb->priority, so DSCP/QoS classification keeps choosing among
the eight queues of whichever channel the flow landed on.  The ring
count, the queue mapping and the IRQ affinity are untouched: only which
of the 32 rings a packet joins changes.

ndo_select_queue() only ever sees packets the CPU transmits, so this
cannot be gated on "the flow is offloaded": a PPE-bound flow's packets
never reach the stack at all.  What the knob spreads is the traffic that
does cross the CPU - flows before they are offloaded, and flows the PPE
declined.

The knob is off by default and stays inert while any QoS channel of the
QDMA is claimed by an HTB leaf: the channels are a shared per-QDMA
resource, and a hashed packet on a shaped channel would be scheduled by
another port's shaper.  In that state the port-derived channel is used
as before, so the knob can never silently bypass or misapply a
configured rate.

A packet with no 5-tuple keeps the port-derived channel too, and is
counted: landing it on ring 0 would move every ARP frame of every port
onto port 0's channel.

It is a 0444 parameter - set on the kernel command line or at insmod -
since the channel binding is a property of the device's lifetime, not
something to flip under flows that are already enqueued.

Getting the distribution from userspace needs a counter, and ethtool -S
is the wrong shape for it: the rings belong to a QDMA block that several
net_devices share, so per-netdev statistics would report the same 32
rings five times.  qdma/tx_ring_hist reports them once, where they are
accounted, and is only filled while the knob is on.

Signed-off-by: OpenWrt <openwrt@example.org>
Ported to the 6.18 tree: identical change, anchors recomputed against the
queue position this file occupies there (after 989, before 992-x/999x).

---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2024 AIROHA Inc
  * Author: Lorenzo Bianconi <lorenzo@kernel.org>
  */
+#include <linux/jump_label.h>
 #include <linux/of.h>
 #include <linux/of_net.h>
 #include <linux/of_reserved_mem.h>
@@ -20,6 +21,28 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+/* airoha_dev_select_queue() derives the QDMA channel from port->id, so every
+ * packet of one port - and therefore every flow of one 5-tuple - is enqueued
+ * on the same channel, i.e. on the same eight of the 32 TX rings.  With this
+ * knob on the channel instead comes from the flow hash, which spreads
+ * unrelated flows over the four HW QoS channels.
+ *
+ * The parameter is 0444: the choice has to hold for the lifetime of the
+ * device, and a writable knob would let an operator change it under flows
+ * that are already enqueued.  Set it on the kernel command line
+ * (airoha_eth.tx_ring_hash=1) or at insmod.
+ */
+static bool airoha_tx_ring_hash;
+module_param_named(tx_ring_hash, airoha_tx_ring_hash, bool, 0444);
+MODULE_PARM_DESC(tx_ring_hash,
+		 "derive the TX ring from the flow hash (default 0)");
+
+/* Off by default, and the off case must not cost the TX path a branch: the
+ * key is enabled once, from airoha_hw_init(), and the two call sites are
+ * patched to a nop while it stays disabled.
+ */
+static DEFINE_STATIC_KEY_FALSE(airoha_tx_ring_hash_key);
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
@@ -683,14 +706,53 @@
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_pse_debugfs);
 
+/* The rings belong to a QDMA and are shared by every net_device queued on it,
+ * so this cannot be a per-netdev ethtool counter: five netdevices would each
+ * report the same 32 rings.  One file per QDMA block keeps the numbers where
+ * they are accounted.
+ */
+static int airoha_qdma_debugfs_tx_ring_hist_show(struct seq_file *m,
+						 void *private)
+{
+	struct airoha_eth *eth = m->private;
+	int i, j;
+
+	seq_printf(m, "tx_ring_hash %u\n", airoha_tx_ring_hash);
+	seq_puts(m, "qdma ring channel queue pkts bytes\n");
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		struct airoha_qdma *qdma = &eth->qdma[i];
+
+		for (j = 0; j < ARRAY_SIZE(qdma->tx_ring_stat); j++)
+			seq_printf(m, "%4d %4d %7d %5d %12llu %12llu\n",
+				   i, j, j / AIROHA_NUM_QOS_QUEUES,
+				   j % AIROHA_NUM_QOS_QUEUES,
+				   qdma->tx_ring_stat[j].pkts,
+				   qdma->tx_ring_stat[j].bytes);
+
+		seq_printf(m, "qdma %d unhashed_fallback %llu\n", i,
+			   qdma->tx_ring_hash_fallback);
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_qdma_debugfs_tx_ring_hist);
+
 static void airoha_pse_debugfs_init(struct airoha_eth *eth)
 {
 	eth->debugfs_dir = debugfs_create_dir("pse", NULL);
 	debugfs_create_file("usage", 0444, eth->debugfs_dir, eth,
 			    &airoha_pse_debugfs_fops);
 }
+
+static void airoha_qdma_debugfs_init(struct airoha_eth *eth)
+{
+	eth->qdma_debugfs_dir = debugfs_create_dir("qdma", NULL);
+	debugfs_create_file("tx_ring_hist", 0444, eth->qdma_debugfs_dir, eth,
+			    &airoha_qdma_debugfs_tx_ring_hist_fops);
+}
 #else
 static void airoha_pse_debugfs_init(struct airoha_eth *eth) {}
+static void airoha_qdma_debugfs_init(struct airoha_eth *eth) {}
 #endif
 
 static int airoha_fe_init(struct airoha_eth *eth)
@@ -2075,6 +2137,13 @@
 		goto error;
 
 	airoha_pse_debugfs_init(eth);
+	airoha_qdma_debugfs_init(eth);
+
+	if (airoha_tx_ring_hash) {
+		static_branch_enable(&airoha_tx_ring_hash_key);
+		dev_info(eth->dev,
+			 "TX rings follow the flow hash, not the port\n");
+	}
 
 	set_bit(DEV_STATE_INITIALIZED, &eth->state);
 
@@ -2093,6 +2162,7 @@
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
 		airoha_qdma_cleanup(eth, &eth->qdma[i]);
 	airoha_ppe_deinit(eth);
+	debugfs_remove(eth->qdma_debugfs_dir);
 	debugfs_remove(eth->debugfs_dir);
 }
 
@@ -2699,6 +2769,60 @@
 	return 0;
 }
 
+/* Channel to enqueue a non-DSA device's packet on, or -1 to keep the one the
+ * caller derived from port->id.
+ *
+ * skb_get_hash() runs the flow dissector over the 5-tuple and caches the
+ * result in skb->hash, which the stack has usually done already, so the hash
+ * is not recomputed per packet.
+ *
+ * -1 is also returned while any QoS channel of this QDMA is claimed by an HTB
+ * leaf: the channels are a per-QDMA resource and a hashed packet on a shaped
+ * channel would be scheduled by another port's shaper.  Staying inert there
+ * is the only way this knob cannot silently bypass a configured rate.
+ *
+ * A packet with no 5-tuple to hash keeps the port-derived channel as well,
+ * and is counted in tx_ring_hash_fallback.  Landing it on ring 0 instead
+ * would move every ARP frame and every unparsed frame of every port onto
+ * port 0's channel - a change to exactly the traffic the hash cannot
+ * classify, which is the case worth leaving alone.
+ */
+static int airoha_tx_hash_channel(struct net_device *netdev,
+				  struct sk_buff *skb)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	struct airoha_qdma *qdma;
+	u32 hash;
+
+	if (!static_branch_unlikely(&airoha_tx_ring_hash_key))
+		return -1;
+
+	hash = skb_get_hash(skb);
+
+	rcu_read_lock();
+	qdma = rcu_dereference(dev->qdma);
+	if (!qdma || !bitmap_empty(qdma->qos_channel_map,
+				   AIROHA_NUM_QOS_CHANNELS)) {
+		rcu_read_unlock();
+		return -1;
+	}
+
+	if (!hash) {
+		/* No 5-tuple to hash - a non-IP frame, or one the dissector
+		 * could not read.  Counted, so that a shaper-less setup with
+		 * the knob on does not look like a box whose flows all happen
+		 * to hash to one channel.  The count is racy: this is a debug
+		 * counter on the TX fast path, an undercount costs nothing.
+		 */
+		qdma->tx_ring_hash_fallback++;
+		rcu_read_unlock();
+		return -1;
+	}
+	rcu_read_unlock();
+
+	return hash % AIROHA_NUM_QOS_CHANNELS;
+}
+
 static u16 airoha_dev_select_queue(struct net_device *netdev,
 				   struct sk_buff *skb,
 				   struct net_device *sb_dev)
@@ -2708,10 +2832,16 @@
 	int queue, channel;
 
 	/* For dsa device select QoS channel according to the dsa user port
-	 * index, rely on port id otherwise. Select QoS queue based on the
-	 * skb priority.
+	 * index, rely on the flow hash - or on the port id when it is off -
+	 * otherwise. Select QoS queue based on the skb priority.
 	 */
-	channel = netdev_uses_dsa(netdev) ? skb_get_queue_mapping(skb) : port->id;
+	if (netdev_uses_dsa(netdev)) {
+		channel = skb_get_queue_mapping(skb);
+	} else {
+		channel = airoha_tx_hash_channel(netdev, skb);
+		if (channel < 0)
+			channel = port->id;
+	}
 	channel = channel % AIROHA_NUM_QOS_CHANNELS;
 	queue = skb->priority % AIROHA_NUM_QOS_QUEUES;
 	queue = channel * AIROHA_NUM_QOS_QUEUES + queue;
@@ -2910,6 +3040,11 @@
 	}
 	q->queued += i;
 
+	if (static_branch_unlikely(&airoha_tx_ring_hash_key)) {
+		qdma->tx_ring_stat[qid].pkts++;
+		qdma->tx_ring_stat[qid].bytes += skb->len;
+	}
+
 	skb_tx_timestamp(skb);
 	netdev_tx_sent_queue(txq, skb->len);
 	if (q->ndesc - q->queued < q->free_thr) {
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/.stage/drivers/net/ethernet/airoha/airoha_eth.h
@@ -613,6 +613,21 @@
 	struct airoha_queue q_rx[AIROHA_NUM_RX_RING];
 
 	DECLARE_BITMAP(qos_channel_map, AIROHA_NUM_QOS_CHANNELS);
+
+	/* Packets enqueued on each TX ring, filled only while tx_ring_hash is
+	 * on.  Every enqueue takes the ring's own q->lock, so a plain u64
+	 * increment from airoha_dev_xmit() has a single writer per entry and
+	 * needs no seqcount.
+	 */
+	struct {
+		u64 pkts;
+		u64 bytes;
+	} tx_ring_stat[AIROHA_NUM_TX_RING];
+
+	/* Packets tx_ring_hash could not classify and that kept the
+	 * port-derived channel.
+	 */
+	u64 tx_ring_hash_fallback;
 };
 
 enum airoha_dev_flags {
@@ -724,6 +739,7 @@
 	struct airoha_gdm_port *ports[AIROHA_MAX_NUM_GDM_PORTS];
 
 	struct dentry *debugfs_dir;
+	struct dentry *qdma_debugfs_dir;
 };
 
 u32 airoha_rr(void __iomem *base, u32 offset);
