From: OpenWrt <openwrt@example.org>
Subject: [PATCH] net: airoha: allow LRO on a QDMA shared by several devices

LRO is enabled and disabled on the QDMA, not on the net_device, and on
the AN7581 two devices can sit on the same QDMA (on the XR1710G the CPU
port and the 10G LAN port both use QDMA0).

The LRO patch therefore had to refuse the second device:

	required to disable LRO on QDMA%d
	return -EBUSY;

and it also stripped NETIF_F_LRO from the feature set of every device
sharing a used QDMA, which made LRO impossible on the LAN side of the
board.  Both are unnecessary: the RX ring is shared, but the driver
picks the destination net_device per packet from the source port stored
in the DMA descriptor (airoha_qdma_get_gdm_dev), so aggregating frames
from two ports into one ring cannot deliver a frame to the wrong device.

Turn the enable/disable pair into a reference count instead, so the
block is programmed when the first device asks for LRO and torn down
only when the last one stops asking.  This lets a device sharing its
QDMA with another one use hardware LRO.

Signed-off-by: OpenWrt <openwrt@example.org>
---

--- a/drivers/net/ethernet/airoha/airoha_eth.h	2026-10-18 15:26:32.891391560 +0800
+++ b/drivers/net/ethernet/airoha/airoha_eth.h	2026-10-18 15:26:32.892975308 +0800
@@ -579,6 +579,11 @@
 	void __iomem *regs;
 
 	int users;
+	/* Number of net_devices on this QDMA that asked for LRO. LRO is a
+	 * per-QDMA block, shared by every device queued on it, so one
+	 * device tearing down must not disable it for the others.
+	 */
+	int lro_users;
 
 	struct airoha_irq_bank irq_banks[AIROHA_MAX_NUM_IRQ_BANKS];
 
--- a/drivers/net/ethernet/airoha/airoha_eth.c	2026-10-18 15:26:32.890503579 +0800
+++ b/drivers/net/ethernet/airoha/airoha_eth.c	2026-10-18 15:26:32.892162107 +0800
@@ -544,6 +544,11 @@
 	int qdma_id = qdma - &eth->qdma[0];
 	int i, lro_queue_index = 0;
 
+	/* Counted per net_device: the block itself is shared by every
+	 * device on this QDMA, so only the first one has to program it.
+	 */
+	qdma->lro_users++;
+
 	if (airoha_fe_lro_is_enabled(eth, qdma_id))
 		return;
 
@@ -571,6 +576,13 @@
 	struct airoha_eth *eth = qdma->eth;
 	int qdma_id = qdma - &eth->qdma[0];
 
+	if (qdma->lro_users > 0)
+		qdma->lro_users--;
+
+	/* Another device on this QDMA still wants LRO, leave it running. */
+	if (qdma->lro_users)
+		return;
+
 	if (!airoha_fe_lro_is_enabled(eth, qdma_id))
 		return;
 
@@ -2196,22 +2208,9 @@
 	struct airoha_gdm_port *port = dev->port;
 	u32 pse_port = FE_PSE_PORT_PPE1;
 	struct airoha_qdma *qdma;
-	int qdma_id, err;
+	int err;
 
-	/* LRO is configured on the QDMA and it is shared between all
-	 * the devices using it. Refuse to open a second device on the
-	 * same QDMA if LRO is enabled on any device sharing it or if
-	 * this device has LRO enabled in its feature set.
-	 */
 	qdma = airoha_qdma_deref(dev);
-	qdma_id = qdma - &qdma->eth->qdma[0];
-
-	if (qdma->users > 1 && (airoha_fe_lro_is_enabled(qdma->eth, qdma_id) ||
-				(netdev->features & NETIF_F_LRO))) {
-		netdev_warn(netdev, "required to disable LRO on QDMA%d\n",
-			    qdma_id);
-		return -EBUSY;
-	}
 
 	err = phylink_of_phy_connect(dev->phylink, netdev->dev.of_node, 0);
 	if (err) {
@@ -2608,13 +2607,6 @@
 static netdev_features_t airoha_dev_fix_features(struct net_device *netdev,
 						 netdev_features_t features)
 {
-	struct airoha_gdm_dev *dev = netdev_priv(netdev);
-	struct airoha_qdma *qdma;
-
-	qdma = airoha_qdma_deref(dev);
-	if (qdma->users > 1)
-		features &= ~NETIF_F_LRO;
-
 	return features;
 }
 
