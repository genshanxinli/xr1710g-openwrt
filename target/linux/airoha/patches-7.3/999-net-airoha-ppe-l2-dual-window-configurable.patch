From: OpenWrt <openwrt@example.org>
Date: Sun, 15 Nov 2026 16:16:44 +0800
Subject: [PATCH] net: airoha: make the PPE L2 dual window configurable

The cross-ingress L2 guard keeps a station that moves to another ingress
in the software path for ten seconds, because the hardware entry built
from the old ingress must not be reused while both sides can still be
active.  That window is currently a hardcoded macro, so shortening it
for the post-roaming A/B test means rebuilding the driver.

Add a dual_window_ms module parameter, defaulting to the current
10000 ms and clamped to 1000-60000 ms, and use the effective value in
the two claim checks.  Expose the clamped value through the PPE device
ops so the mt76 debugfs can print it next to the station queues.

Signed-off-by: OpenWrt <openwrt@example.org>
---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1901,7 +1901,52 @@ static u32 airoha_ppe_foe_ingress(struct sk_buff *skb)
 	return ndev ? ndev->ifindex : 0;
 }
 
-#define AIROHA_L2_DUAL_WINDOW	msecs_to_jiffies(10000)
+#define AIROHA_L2_DUAL_WINDOW_MIN_MS	1000U
+#define AIROHA_L2_DUAL_WINDOW_MAX_MS	60000U
+#define AIROHA_L2_DUAL_WINDOW_DEFAULT_MS	10000U
+
+static unsigned int dual_window_ms = AIROHA_L2_DUAL_WINDOW_DEFAULT_MS;
+
+static unsigned int airoha_ppe_dual_window_ms(void)
+{
+	return clamp(dual_window_ms, AIROHA_L2_DUAL_WINDOW_MIN_MS,
+		     AIROHA_L2_DUAL_WINDOW_MAX_MS);
+}
+
+static int airoha_ppe_dual_window_ms_set(const char *val,
+					 const struct kernel_param *kp)
+{
+	unsigned int ms;
+	int err;
+
+	err = kstrtouint(val, 0, &ms);
+	if (err)
+		return err;
+
+	*(unsigned int *)kp->arg = clamp(ms, AIROHA_L2_DUAL_WINDOW_MIN_MS,
+					 AIROHA_L2_DUAL_WINDOW_MAX_MS);
+	return 0;
+}
+
+static const struct kernel_param_ops airoha_ppe_dual_window_ms_ops = {
+	.set = airoha_ppe_dual_window_ms_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(dual_window_ms, &airoha_ppe_dual_window_ms_ops,
+		&dual_window_ms, 0644);
+MODULE_PARM_DESC(dual_window_ms,
+		 "Airoha PPE L2 dual-ingress window in milliseconds (1000-60000)");
+
+static unsigned long airoha_l2_dual_window(void)
+{
+	return msecs_to_jiffies(airoha_ppe_dual_window_ms());
+}
+
+static u32 airoha_ppe_get_l2_dual_window_ms(struct airoha_ppe_dev *dev)
+{
+	return airoha_ppe_dual_window_ms();
+}
 
 static bool airoha_ppe_foe_l2_claim(struct airoha_ppe *ppe,
 				    struct airoha_flow_table_entry *e,
@@ -1910,16 +1955,17 @@ static bool airoha_ppe_foe_l2_claim(struct airoha_ppe *ppe,
 	struct airoha_flow_table_entry *f;
 	struct hlist_node *n;
 	unsigned long now = jiffies;
+	unsigned long window = airoha_l2_dual_window();
 	bool dual;
 
 	if (e->no_hw_since &&
-	    time_after(now, e->no_hw_since + AIROHA_L2_DUAL_WINDOW))
+	    time_after(now, e->no_hw_since + window))
 		e->no_hw_since = 0;
 
 	dual = e->no_hw_since ||
 	       (ingress && e->ingress_dev_idx &&
 		ingress != e->ingress_dev_idx &&
-		time_before(now, e->ingress_stamp + AIROHA_L2_DUAL_WINDOW));
+		time_before(now, e->ingress_stamp + window));
 	if (dual) {
 		hlist_for_each_entry_safe(f, n, &e->l2_flows,
 					  l2_subflow_node)
@@ -3077,6 +3123,7 @@ int airoha_ppe_init(struct airoha_eth *eth)
 
 	ppe->dev.ops.setup_tc_block_cb = airoha_ppe_setup_tc_block_cb;
 	ppe->dev.ops.check_skb = airoha_ppe_check_skb;
+	ppe->dev.ops.get_l2_dual_window_ms = airoha_ppe_get_l2_dual_window_ms;
 	ppe->dev.priv = ppe;
 	ppe->eth = eth;
 	eth->ppe = ppe;
--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -21,6 +21,7 @@ struct airoha_ppe_dev {
 		void (*check_skb)(struct airoha_ppe_dev *dev,
 				  struct sk_buff *skb, u16 hash,
 				  bool rx_wlan);
+		u32 (*get_l2_dual_window_ms)(struct airoha_ppe_dev *dev);
 	} ops;
 
 	void *priv;
@@ -42,6 +43,12 @@ static inline void airoha_ppe_dev_check_skb(struct airoha_ppe_dev *dev,
 {
 	dev->ops.check_skb(dev, skb, hash, rx_wlan);
 }
+
+static inline u32
+airoha_ppe_dev_get_l2_dual_window_ms(struct airoha_ppe_dev *dev)
+{
+	return dev->ops.get_l2_dual_window_ms(dev);
+}
 #else
 static inline struct airoha_ppe_dev *airoha_ppe_get_dev(struct device *dev)
 {
@@ -63,6 +70,12 @@ static inline void airoha_ppe_dev_check_skb(struct airoha_ppe_dev *dev,
 					    bool rx_wlan)
 {
 }
+
+static inline u32
+airoha_ppe_dev_get_l2_dual_window_ms(struct airoha_ppe_dev *dev)
+{
+	return 0;
+}
 #endif
 
 #define NPU_NUM_CORES		8
