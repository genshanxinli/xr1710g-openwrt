From: OpenWrt <openwrt@example.org>
Subject: [PATCH] net: airoha: add minimal PPE 6rd tunnel offload

The PPE entry layouts already describe the fields a 6rd tunnel needs: the
tunnel bit and tunnel id in a route entry's data word, the tunnel MTU in
the meter word, and the tunnel-decap bit in information block 1.  Nothing
in the Linux driver ever writes them: every flow is built as an ordinary
IPv4 or IPv6 route.

Map the host-side tunnel parameters the flow offload API reports onto
those fields.  A flow is marked as 6rd when it is an IPv6 flow carried by
a plain IPv4-in-IP tunnel, that is the rule carries a TUNNEL_ENCAP action
whose ip_tunnel_info has an IPv4 outer address family and no UDP
encapsulation, or a TUNNEL_DECAP action with an IPv4 ENC_CONTROL.  The
tunnel id comes from the action key (ENC_KEYID on the decap side), the MTU
from the underlay device, and rmt is set only for the decapsulation
direction.  Ordinary flows never set a tunnel field.

The mapping is gated by the airoha_ppe_6rd module parameter (default 0).
The driver does not program the PPE tunnel table that supplies the outer
IPv4 header, so a 6rd entry is not usable end to end until that table is
managed.  With the parameter off, tunnel actions are rejected exactly as
before and every 6rd field keeps the zero the entry builder writes.

Add /sys/kernel/debug/ppe/6rd (0444), a read-only dump of the marked
entries and their tunnel parameters.  It reads FOE entries and the module
parameter only.

Table sizing, bind/aging, PPPoE, L2B, QoS and multicast are untouched.

Signed-off-by: OpenWrt <openwrt@example.org>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -549,6 +549,20 @@
 	u64 packets;
 };
 
+/* Host-side parameters of an IPv6-in-IPv4 tunnel (6rd).  A 6rd entry uses
+ * the PPE's generic tunnel fields: a tunnel bit plus a tunnel table index in
+ * the route entry's data word, the maximum inner packet size in the meter
+ * word, and the tunnel-decap bit ("rmt") in information block 1.  The driver
+ * only maps values the flow offload API reports; it does not create, program
+ * or tear down the tunnel or its table.
+ */
+struct airoha_ppe_6rd {
+	bool tunnel;		/* flow is marked as 6rd */
+	bool rmt;		/* remove the outer IPv4 header */
+	u8 tunnel_id;		/* PPE tunnel table index */
+	u16 tunnel_mtu;		/* maximum inner packet size */
+};
+
 struct airoha_flow_data {
 	struct ethhdr eth;
 
@@ -605,6 +619,8 @@
 		u8 tunnel_id;
 		u16 tunnel_mtu;
 	} dslite;
+
+	struct airoha_ppe_6rd sixrd;
 };
 
 enum airoha_flow_entry_type {
@@ -972,6 +988,7 @@
 int airoha_ppe_probe_entry_alias(struct airoha_ppe *ppe);
 void airoha_ppe_foe_entry_get_stats(struct airoha_ppe *ppe, u32 hash,
 				    struct airoha_foe_stats64 *stats);
+bool airoha_ppe_6rd_enabled(void);
 
 /* DS-Lite decapsulation offload, default off.  Declared unconditionally
  * because the flow path reads it whether or not debugfs is compiled in.
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -13,6 +13,7 @@
 #include <linux/platform_device.h>
 #include <linux/rhashtable.h>
 #include <net/dst_metadata.h>
+#include <net/ip_tunnels.h>
 #include <net/ipv6.h>
 #include <linux/if_vlan.h>
 #include <net/pkt_cls.h>
@@ -83,6 +84,21 @@
 module_param(airoha_ppe_dslite, bool, 0444);
 MODULE_PARM_DESC(airoha_ppe_dslite,
 		 "Offload IPv4-in-IPv6 DS-Lite decapsulation flows to the PPE");
+
+/* A 6rd entry still needs the outer IPv4 header from a PPE tunnel table
+ * entry, which this driver does not manage.  Mapping the host-side tunnel
+ * parameters onto the FOE entry is therefore opt-in: at 0 no flow is marked
+ * and every 6rd field keeps the value the entry builder gives it, zero.
+ */
+static bool airoha_ppe_6rd;
+module_param(airoha_ppe_6rd, bool, 0444);
+MODULE_PARM_DESC(airoha_ppe_6rd,
+		 "Map IPv6-in-IPv4 tunnel flows onto the PPE 6rd fields");
+
+bool airoha_ppe_6rd_enabled(void)
+{
+	return airoha_ppe_6rd;
+}
 
 static const struct rhashtable_params airoha_flow_table_params = {
 	.head_offset = offsetof(struct airoha_flow_table_entry, node),
@@ -1455,7 +1471,9 @@
 
 	val = *ib2 & (AIROHA_FOE_IB2_NBQ | AIROHA_FOE_IB2_PSE_PORT |
 		      AIROHA_FOE_IB2_PSE_QOS | AIROHA_FOE_IB2_FAST_PATH);
-	*meter |= FIELD_PREP(AIROHA_FOE_TUNNEL_MTU, val);
+	/* For a marked 6rd entry the word is tunnel_mtu, not scratch. */
+	if (!(*data & AIROHA_FOE_TUNNEL))
+		*meter |= FIELD_PREP(AIROHA_FOE_TUNNEL_MTU, val);
 
 	nbq = pse_port == 1 ? 6 : 5;
 	*ib2 &= ~(AIROHA_FOE_IB2_NBQ | AIROHA_FOE_IB2_PSE_PORT |
@@ -2146,6 +2164,120 @@
 	return ret;
 }
 
+/* A 6rd flow is an IPv6 flow whose outer header is IPv4.  The flow offload
+ * API reports that shape as a tunnel encapsulation action on the transmit
+ * side and a decapsulation action plus ENC_* dissector keys on the receive
+ * side; the outer address family and the tunnel key come from those keys.
+ *
+ * Only plain IPv4-in-IP is accepted.  IPv6 carried over a UDP encapsulation
+ * (VXLAN, GENEVE) is not 6rd and stays rejected, exactly as it was before
+ * this mapping existed.
+ */
+static int airoha_ppe_flow_6rd_parse(struct flow_rule *rule, u16 addr_type,
+				     struct airoha_flow_data *data)
+{
+	struct flow_action_entry *act;
+	u16 outer_addr_type = 0;
+	bool encap = false, decap = false;
+	int i;
+
+	if (!airoha_ppe_6rd)
+		return 0;
+
+	if (addr_type != FLOW_DISSECTOR_KEY_IPV6_ADDRS)
+		return 0;
+
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_CONTROL)) {
+		struct flow_match_control match;
+
+		flow_rule_match_enc_control(rule, &match);
+		outer_addr_type = match.key->addr_type;
+	}
+
+	flow_action_for_each(i, act, &rule->action) {
+		switch (act->id) {
+		case FLOW_ACTION_TUNNEL_ENCAP:
+			if (!act->tunnel ||
+			    ip_tunnel_info_af(act->tunnel) != AF_INET ||
+			    act->tunnel->encap.type != TUNNEL_ENCAP_NONE)
+				return -EOPNOTSUPP;
+
+			data->sixrd.tunnel_id =
+				ntohl(tunnel_id_to_key32(act->tunnel->key.tun_id)) &
+				FIELD_MAX(AIROHA_FOE_TUNNEL_ID);
+			encap = true;
+			break;
+		case FLOW_ACTION_TUNNEL_DECAP:
+			if (outer_addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS)
+				return -EOPNOTSUPP;
+
+			decap = true;
+			break;
+		default:
+			break;
+		}
+	}
+
+	if (!encap && !decap)
+		return 0;
+
+	if (!encap && flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_KEYID)) {
+		/* The decap action itself carries no key; nf_flow_table
+		 * leaves it in the ENC_KEYID dissector key.
+		 */
+		struct flow_match_enc_keyid match;
+
+		flow_rule_match_enc_keyid(rule, &match);
+		data->sixrd.tunnel_id =
+			ntohl(match.key->keyid) &
+			FIELD_MAX(AIROHA_FOE_TUNNEL_ID);
+	}
+
+	data->sixrd.tunnel = true;
+	data->sixrd.rmt = decap;
+
+	return 0;
+}
+
+static u16 airoha_ppe_6rd_mtu(u32 underlay_mtu)
+{
+	/* 6rd prepends one IPv4 header to the inner packet. */
+	if (underlay_mtu <= sizeof(struct iphdr))
+		return 0;
+
+	return min_t(u32, underlay_mtu - sizeof(struct iphdr),
+		     FIELD_MAX(AIROHA_FOE_TUNNEL_MTU));
+}
+
+/* Write the host-side tunnel parameters into an IPv6 route entry.  The
+ * entry builder cleared the whole entry first, so a flow that is not marked
+ * keeps tunnel, tunnel_id and tunnel_mtu at zero.  rmt is the "remove the
+ * outer header" bit, set for the decapsulation direction.
+ */
+static void airoha_ppe_foe_entry_set_6rd(struct airoha_foe_entry *hwe,
+					 const struct airoha_flow_data *data)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+
+	if (!data->sixrd.tunnel)
+		return;
+
+	/* Only the IPv6 route layouts carry these fields; the parser marks
+	 * no other flow, so this cannot normally trigger.
+	 */
+	if (type != PPE_PKT_TYPE_IPV6_ROUTE_3T &&
+	    type != PPE_PKT_TYPE_IPV6_ROUTE_5T)
+		return;
+
+	hwe->ipv6.data |= AIROHA_FOE_TUNNEL |
+			  FIELD_PREP(AIROHA_FOE_TUNNEL_ID,
+				     data->sixrd.tunnel_id);
+	hwe->ipv6.meter = FIELD_PREP(AIROHA_FOE_TUNNEL_MTU,
+				     data->sixrd.tunnel_mtu);
+	if (data->sixrd.rmt)
+		hwe->ib1 |= AIROHA_FOE_IB1_BIND_TUNNEL_DECAP;
+}
+
 static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
 					   struct flow_cls_offload *f)
 {
@@ -2242,6 +2374,10 @@
 	    airoha_ppe_dslite_flow(eth, meta.key->ingress_ifindex, &data))
 		offload_type = PPE_PKT_TYPE_IPV4_DSLITE;
 
+	err = airoha_ppe_flow_6rd_parse(rule, addr_type, &data);
+	if (err)
+		return err;
+
 	flow_action_for_each(i, act, &rule->action) {
 		switch (act->id) {
 		case FLOW_ACTION_MANGLE:
@@ -2286,9 +2422,38 @@
 
 			police = act;
 			break;
+		case FLOW_ACTION_TUNNEL_ENCAP:
+		case FLOW_ACTION_TUNNEL_DECAP:
+			/* Only the IPv6-in-IPv4 flows accepted by
+			 * airoha_ppe_flow_6rd_parse() may carry these.
+			 */
+			if (!data.sixrd.tunnel)
+				return -EOPNOTSUPP;
+			break;
 		default:
 			return -EOPNOTSUPP;
 		}
+	}
+
+	/* The underlay is the redirect target when the inner packet is
+	 * encapsulated, and the device the tunnel packet arrived on when it
+	 * is decapsulated.  Its MTU bounds the inner packet.
+	 */
+	if (data.sixrd.tunnel && odev) {
+		u32 mtu;
+
+		if (data.sixrd.rmt) {
+			const struct net_device *indev;
+
+			rcu_read_lock();
+			indev = dev_get_by_index_rcu(dev_net(odev),
+						     meta.key->ingress_ifindex);
+			mtu = indev ? indev->mtu : 0;
+			rcu_read_unlock();
+		} else {
+			mtu = odev->mtu;
+		}
+		data.sixrd.tunnel_mtu = airoha_ppe_6rd_mtu(mtu);
 	}
 
 	/* A DS-Lite decapsulation flow is plain IPv4-in-IPv6; a PPPoE
@@ -2430,6 +2595,8 @@
 		if (err)
 			goto put_smac;
 	}
+
+	airoha_ppe_foe_entry_set_6rd(&hwe, &data);
 
 	e = kzalloc_obj(*e);
 	if (!e) {
--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
@@ -591,6 +591,73 @@
 }
 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_dslite);
 
+/* The 6rd view is the set of IPv6 route entries whose data word carries the
+ * tunnel mark, plus the parameters those entries were built with.  A flow
+ * that was never marked as 6rd does not appear: its tunnel fields are zero
+ * and it is indistinguishable from an ordinary IPv6 route.
+ *
+ * Read-only: everything here comes from the FOE entries and the module
+ * parameter, no register is touched.
+ */
+static int airoha_ppe_debugfs_6rd_show(struct seq_file *m, void *private)
+{
+	static const char *const state_str[] = {
+		[AIROHA_FOE_STATE_INVALID] = "INV",
+		[AIROHA_FOE_STATE_UNBIND] = "UNB",
+		[AIROHA_FOE_STATE_BIND] = "BND",
+		[AIROHA_FOE_STATE_FIN] = "FIN",
+	};
+	struct airoha_ppe *ppe = m->private;
+	u32 total = airoha_ppe_get_total_num_entries(ppe);
+	int i;
+
+	seq_printf(m, "enabled %u\n", airoha_ppe_6rd_enabled());
+
+	for (i = 0; i < total; i++) {
+		struct airoha_foe_entry *hwe;
+		u16 *src_port = NULL, *dest_port = NULL;
+		u32 state, type, data;
+
+		hwe = airoha_ppe_foe_get_entry(ppe, i);
+		if (!hwe)
+			continue;
+
+		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+		if (!state)
+			continue;
+
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+		if (type != PPE_PKT_TYPE_IPV6_ROUTE_3T &&
+		    type != PPE_PKT_TYPE_IPV6_ROUTE_5T)
+			continue;
+
+		data = hwe->ipv6.data;
+		if (!(data & AIROHA_FOE_TUNNEL))
+			continue;
+
+		if (type == PPE_PKT_TYPE_IPV6_ROUTE_5T) {
+			src_port = &hwe->ipv6.src_port;
+			dest_port = &hwe->ipv6.dest_port;
+		}
+
+		seq_printf(m,
+			   "%05x %s IPv6 %s tunnel_id=%u tunnel_mtu=%u rmt=%u orig=",
+			   i, state_str[state % ARRAY_SIZE(state_str)],
+			   type == PPE_PKT_TYPE_IPV6_ROUTE_5T ? "5T" : "3T",
+			   (u32)FIELD_GET(AIROHA_FOE_TUNNEL_ID, data),
+			   (u32)FIELD_GET(AIROHA_FOE_TUNNEL_MTU,
+					  hwe->ipv6.meter),
+			   !!(hwe->ib1 & AIROHA_FOE_IB1_BIND_TUNNEL_DECAP));
+		airoha_debugfs_ppe_print_tuple(m, &hwe->ipv6.src_ip,
+					       &hwe->ipv6.dest_ip,
+					       src_port, dest_port, true);
+		seq_puts(m, "\n");
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_6rd);
+
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
@@ -606,6 +673,8 @@
 			    &airoha_ppe_debugfs_bind_rate_fops);
 	debugfs_create_file("tb_regs", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_tb_regs_fops);
+	debugfs_create_file("6rd", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_6rd_fops);
 	debugfs_create_file("dslite", 0444, ppe->debugfs_dir, ppe,
 			    &airoha_ppe_debugfs_dslite_fops);
 	debugfs_create_file("meter", 0444, ppe->debugfs_dir, ppe,
