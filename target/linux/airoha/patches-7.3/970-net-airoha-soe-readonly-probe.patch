From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Sun, 15 Nov 2026 04:53:16 +0800
Subject: [PATCH] net: airoha: add a read-only SOE probe skeleton

Add a compile-ready, strictly read-only probe for the Airoha EN7581
Secure Offload Engine (SOE) register window described by the upstream
RFC "net: airoha: add EN7581 SOE ESP packet offload".

The new NET_AIROHA_SOE Kconfig option is disabled by default and is not
selected by any target or package. When enabled, the probe maps the
0x1fbfa000 window, reads GLB_CFG, SA_CTRL, SA_DONE, INT_EN and INT_STS,
logs them and returns. It does not write any register, program an SA,
submit ESP, request the SOE interrupt or register an XFRM/netdev offload
provider. The full SOE data path remains out of scope; see
tools/soe/README.md for the register sources and known gaps.

Assisted-by: DeepSeek Harness
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
 drivers/net/ethernet/airoha/Kconfig            |  14 ++++
 drivers/net/ethernet/airoha/Makefile           |   1 +
 drivers/net/ethernet/airoha/airoha_soe_probe.c | 106 +++++++++++++++++++++++++
 3 files changed, 121 insertions(+)

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index 7899065..62bd6d0 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -32,4 +32,18 @@ config NET_AIROHA_FLOW_STATS
 	help
 	  Enable Airoha flowtable statistic counters.
 
+config NET_AIROHA_SOE
+	tristate "Airoha SOE read-only probe skeleton"
+	depends on NET_AIROHA
+	default n
+	help
+	  Compile a read-only probe for the Airoha Secure Offload Engine
+	  (SOE) block on EN7581. The probe maps the 0x1fbfa000 register
+	  window and reads GLB_CFG, SA_CTRL, SA_DONE, INT_EN and INT_STS.
+	  It never writes a register, programs an SA, transmits ESP or
+	  registers an XFRM offload provider.
+
+	  The full SOE ESP offload provider is not part of this option.
+	  Say N unless you are bringing up SOE support.
+
 endif #NET_VENDOR_AIROHA
diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
index 9446805..2763956 100644
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -6,4 +6,5 @@
 obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
 airoha-eth-y := airoha_eth.o airoha_ppe.o
 airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
+obj-$(CONFIG_NET_AIROHA_SOE) += airoha_soe_probe.o
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
diff --git a/drivers/net/ethernet/airoha/airoha_soe_probe.c b/drivers/net/ethernet/airoha/airoha_soe_probe.c
new file mode 100644
index 0000000..9ab9136
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_soe_probe.c
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Airoha EN7581 Secure Offload Engine (SOE) read-only probe skeleton.
+ *
+ * This is step one of the D10 SOE IPsec-offload roadmap item: a compile-ready,
+ * strictly read-only probe. It maps the SOE register window described by the
+ * RFC "net: airoha: add EN7581 SOE ESP packet offload" and reports the
+ * identification and status registers of a live system.
+ *
+ * The probe does not write any register, program an SA, submit ESP, request
+ * the SOE interrupt or register an XFRM/netdev offload provider. The full
+ * data path is a separate change; see tools/soe/README.md.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define AIROHA_SOE_DRIVER_VERSION	"0.1"
+
+/*
+ * Register offsets come from RFC PATCH net-next 4/7 and 7/7:
+ * https://patchew.org/linux/20260614040032.1567994-1-hurryman2212@gmail.com/
+ * The DT node describes a 0x268-byte window at 0x1fbfa000, IRQ GIC SPI 79.
+ */
+#define AIROHA_SOE_GLB_CFG		0x000
+#define AIROHA_SOE_GLB_CFG_ENC_EN	BIT(0)
+#define AIROHA_SOE_GLB_CFG_DEC_EN	BIT(1)
+#define AIROHA_SOE_INT_EN		0x020
+#define AIROHA_SOE_INT_STS		0x024
+#define AIROHA_SOE_SA_CTRL		0x100
+#define AIROHA_SOE_SA_DONE		0x104
+#define AIROHA_SOE_SA_CTRL_WR		BIT(0)
+#define AIROHA_SOE_SA_CTRL_IDX		GENMASK(15, 8)
+#define AIROHA_SOE_SA_DONE_W1C		BIT(0)
+
+static int airoha_soe_probe(struct platform_device *pdev)
+{
+	void __iomem *base;
+	u32 glb_cfg, int_en, int_sts, sa_ctrl, sa_done;
+	int irq;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	irq = platform_get_irq_optional(pdev, 0);
+	if (irq == -ENXIO)
+		irq = 0;
+	else if (irq < 0)
+		return irq;
+
+	/*
+	 * Read-only by construction: keep this block limited to readl().
+	 * writel(), request_irq(), SA programming and xfrm registration belong
+	 * to the full provider and would change hardware or stack state.
+	 */
+	glb_cfg = readl(base + AIROHA_SOE_GLB_CFG);
+	sa_ctrl = readl(base + AIROHA_SOE_SA_CTRL);
+	sa_done = readl(base + AIROHA_SOE_SA_DONE);
+	int_en = readl(base + AIROHA_SOE_INT_EN);
+	int_sts = readl(base + AIROHA_SOE_INT_STS);
+
+	dev_info(&pdev->dev,
+		 "read-only probe v%s: irq=%d glb_cfg=%#010x (enc_en=%u dec_en=%u) "
+		 "sa_ctrl=%#010x (wr=%u idx=%u) sa_done=%#010x (done=%u) "
+		 "int_en=%#010x int_sts=%#010x\n",
+		 AIROHA_SOE_DRIVER_VERSION, irq, glb_cfg,
+		 !!(glb_cfg & AIROHA_SOE_GLB_CFG_ENC_EN),
+		 !!(glb_cfg & AIROHA_SOE_GLB_CFG_DEC_EN),
+		 sa_ctrl, !!(sa_ctrl & AIROHA_SOE_SA_CTRL_WR),
+		 (u32)FIELD_GET(AIROHA_SOE_SA_CTRL_IDX, sa_ctrl),
+		 sa_done, !!(sa_done & AIROHA_SOE_SA_DONE_W1C),
+		 int_en, int_sts);
+
+	return 0;
+}
+
+static void airoha_soe_remove(struct platform_device *pdev)
+{
+	/* The probe never wrote to the block, so there is nothing to undo. */
+}
+
+static const struct of_device_id airoha_soe_of_match[] = {
+	{ .compatible = "airoha,en7581-soe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, airoha_soe_of_match);
+
+static struct platform_driver airoha_soe_driver = {
+	.probe = airoha_soe_probe,
+	.remove = airoha_soe_remove,
+	.driver = {
+		.name = "airoha-soe-probe",
+		.of_match_table = airoha_soe_of_match,
+	},
+};
+module_platform_driver(airoha_soe_driver);
+
+MODULE_AUTHOR("genshanxinli");
+MODULE_DESCRIPTION("Airoha EN7581 SOE read-only probe skeleton");
+MODULE_LICENSE("GPL");
+MODULE_VERSION(AIROHA_SOE_DRIVER_VERSION);
