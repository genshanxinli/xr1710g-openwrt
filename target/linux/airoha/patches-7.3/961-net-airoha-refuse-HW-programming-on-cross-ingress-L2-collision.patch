+static u32 airoha_ppe_foe_ingress(struct sk_buff *skb)
+{
+	struct net_device *ndev = skb->dev;
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct metadata_dst *md_dst = skb_metadata_dst(skb);
+	struct dsa_port *udp;
+
+	if (md_dst && md_dst->type == METADATA_HW_PORT_MUX && ndev->dsa_ptr) {
+		udp = dsa_to_port(ndev->dsa_ptr->ds,
+				  md_dst->u.port_info.port_id);
+		if (udp && dsa_port_is_user(udp) && udp->user)
+			return udp->user->ifindex;
+	}
+#endif
+	return ndev ? ndev->ifindex : 0;
+}
+
+#define AIROHA_L2_DUAL_WINDOW_MIN_MS	1000U
+#define AIROHA_L2_DUAL_WINDOW_MAX_MS	60000U
+#define AIROHA_L2_DUAL_WINDOW_DEFAULT_MS	10000U
+
+static unsigned int dual_window_ms = AIROHA_L2_DUAL_WINDOW_DEFAULT_MS;
+
+static unsigned int airoha_ppe_dual_window_ms(void)
+{
+	return clamp(dual_window_ms, AIROHA_L2_DUAL_WINDOW_MIN_MS,
+		     AIROHA_L2_DUAL_WINDOW_MAX_MS);
+}
+
+static int airoha_ppe_dual_window_ms_set(const char *val,
+					 const struct kernel_param *kp)
+{
+	unsigned int ms;
+	int err;
+
+	err = kstrtouint(val, 0, &ms);
+	if (err)
+		return err;
+
+	*(unsigned int *)kp->arg = clamp(ms, AIROHA_L2_DUAL_WINDOW_MIN_MS,
+					 AIROHA_L2_DUAL_WINDOW_MAX_MS);
+	return 0;
+}
+
+static const struct kernel_param_ops airoha_ppe_dual_window_ms_ops = {
+	.set = airoha_ppe_dual_window_ms_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(dual_window_ms, &airoha_ppe_dual_window_ms_ops,
+		&dual_window_ms, 0644);
+MODULE_PARM_DESC(dual_window_ms,
+		 "Airoha PPE L2 dual-ingress window in milliseconds (1000-60000)");
+
+static unsigned long airoha_l2_dual_window(void)
+{
+	return msecs_to_jiffies(airoha_ppe_dual_window_ms());
+}
+
+static u32 airoha_ppe_get_l2_dual_window_ms(struct airoha_ppe_dev *dev)
+{
+	return airoha_ppe_dual_window_ms();
+}
