+static bool airoha_ppe_foe_l2_claim(struct airoha_ppe *ppe,
+				    struct airoha_flow_table_entry *e,
+				    u32 ingress)
+{
+	struct airoha_flow_table_entry *f;
+	struct hlist_node *n;
+	unsigned long now = jiffies;
+	unsigned long window = airoha_l2_dual_window();
+	bool dual;
+
+	if (e->no_hw_since &&
+	    time_after(now, e->no_hw_since + window))
+		e->no_hw_since = 0;
+
+	dual = e->no_hw_since ||
+	       (ingress && e->ingress_dev_idx &&
+		ingress != e->ingress_dev_idx &&
+		time_before(now, e->ingress_stamp + window));
+	if (dual) {
+		hlist_for_each_entry_safe(f, n, &e->l2_flows,
+					  l2_subflow_node)
+			airoha_ppe_foe_remove_flow(ppe, f);
+		if (!e->no_hw_since)
+			e->no_hw_since = now;
+		return true;
+	}
+
+	if (ingress) {
+		e->ingress_dev_idx = ingress;
+		e->ingress_stamp = now;
+	}
+
+	return false;
+}
