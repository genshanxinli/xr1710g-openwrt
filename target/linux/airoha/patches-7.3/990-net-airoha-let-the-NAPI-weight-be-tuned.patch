From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt <openwrt@example.org>
Date: Sun, 15 Nov 2026 07:00:00 +0800
Subject: [PATCH] net: airoha: add an opt-in DS-Lite decapsulation entry path

The PPE has a dedicated IPv4-in-IPv6 DS-Lite packet type (type 3), but the
Linux driver never produces one: the type only exists in the debugfs name
table and the hash path treats it as unreachable.  This adds the minimal
decapsulation path.

The feature is opt-in through the airoha_ppe_dslite module parameter.  At
0 (default) nothing changes: no packet type 3 entry is built, the PPE flow
configuration is not touched and every flow keeps the old path.

At 1 the driver enables PPE_FLOW_CFG bit 14 (IP4_DSLITE), which is what
makes the parser create UNBIND entries for these packets, and turns a
flowtable rule whose ingress netdev is an IPv6 tunnel (ARPHRD_TUNNEL6 with
a 16-byte address, i.e. ip6_tnl in ipip6 mode) and whose inner address
family is IPv4 into a packet type 3 entry.  For such a flow it fills:

  - the tunnel marker, represented by the packet type itself (packet type
    3 is DS-Lite; the DS-Lite layout has no separate generic tunnel bit);
  - the inner IPv4 tuple (sip/dip/sport/dport), using the DS-Lite member
    of the FOE union;
  - rmt (IB1 bit 23), the vendor SDK's "remove tunnel IP header
    (6rd/dslite only)" flag, so the outer IPv6 header is stripped;
  - tunnel_mtu, taken from the MTU the IPv6 tunnel netdev advertises, so
    the inner packet is checked after the outer header disappears;
  - tunnel_id, the 4-bit UPDMEM IPv6 index the vendor SDK calls ip6_idx,
    left at 0 because this path does not program an outer IPv6 slot.

The generic tunnel/tunnel_id pair of the other packet types is deliberately
not written.  It selects the 64-entry GRE/VXLAN/L2TP tunnel table and is
reserved in the DS-Lite layout; writing it would turn a decapsulation entry
into a tunnel-table lookup.  This path only offloads the decapsulation
direction, which does not need the outer IPv6 addresses, so no UPDMEM IPv6
slot is programmed.  The reverse direction egresses the tunnel and still
encapsulates in software.

Packet type 3 also has no second tuple for a NAT rewrite.  A DS-Lite flow
whose rule carries NAT mangles is therefore refused and stays in the
software path instead of being programmed with a tuple that would not match
the packet or would translate to the wrong address.

Supporting changes:

  - the hash path maps packet type 3 onto the inner IPv4 hash instead of
    WARNing and putting every DS-Lite flow in slot 0;
  - the NPU counter path skips packet type 3, because it reuses the
    tunnel_mtu word to hide IB2 routing bits and would corrupt the MTU;
  - an IPv4 flow carrying a PPPoE push action is refused when it is also
    a DS-Lite flow instead of encoding two tunnel headers this path does
    not model;
  - ppe/entries no longer decodes the bytes at ipv4.new_tuple as a 5-tuple
    for packet type 3; they are the outer flow label and priority;
  - a read-only /sys/kernel/debug/ppe/dslite (0444) shows the gate, the
    live FLOW_CFG bit and every DS-Lite entry with its tunnel ID, MTU,
    rmt bit, flow label and priority.

Everything else is untouched: table capacity, BND_AGE, PPPoE bit 22, L2B,
QoS, multicast.  Non-DS-Lite flows keep every new field at its memset
value, i.e. zero.

Limitations:

  - Hardware validation is not done: the entry layout comes from the
    vendor SDK and the rmt/tunnel_mtu semantics are not measured on
    AN7581.
  - Only the decapsulation half is offloaded; encapsulation and the UPDMEM
    outer IPv6 compression table are out of scope.
  - NATed DS-Lite decapsulation flows stay in software for the reason
    above.
  - 6RD is not implemented.

Signed-off-by: OpenWrt <openwrt@example.org>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -8,6 +8,8 @@
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
 #include <linux/tcp.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/pcs/pcs.h>
 #include <linux/u64_stats_sync.h>
 #include <net/dst_metadata.h>
@@ -20,6 +22,81 @@
 #include "airoha_regs.h"
 #include "airoha_eth.h"
 
+/* The RX and TX NAPI instances are registered with this weight.  It
+ * defaults to NAPI_POLL_WEIGHT (64), which is what the driver hardcoded
+ * before this knob existed, so an untouched parameter keeps the old round
+ * size.  Out-of-range requests are clamped instead of rejected so that a
+ * typo on the kernel command line still boots, and the clamp is reported
+ * once via dev_warn.
+ *
+ * The weight is latched when a NAPI instance is registered, so a write
+ * after probe shows up in the read-back and takes effect on the next probe
+ * (boot or a driver rebind), not on the instances already running.
+ */
+#define AIROHA_NAPI_MIN_WEIGHT		16
+#define AIROHA_NAPI_MAX_WEIGHT		512
+#define AIROHA_NAPI_DEFAULT_WEIGHT	NAPI_POLL_WEIGHT
+
+static_assert(AIROHA_NAPI_DEFAULT_WEIGHT == 64);
+
+static uint airoha_napi_weight = AIROHA_NAPI_DEFAULT_WEIGHT;
+static uint airoha_napi_weight_rejected;
+static struct device *airoha_napi_weight_dev;
+static bool airoha_napi_weight_clamped;
+static bool airoha_napi_weight_warned;
+static DEFINE_MUTEX(airoha_napi_weight_lock);
+
+/* The caller holds airoha_napi_weight_lock, which keeps the device pointer
+ * alive until the warning has been emitted.
+ */
+static void airoha_napi_weight_warn_clamped(void)
+{
+	if (!airoha_napi_weight_clamped || airoha_napi_weight_warned ||
+	    !airoha_napi_weight_dev)
+		return;
+
+	airoha_napi_weight_warned = true;
+	dev_warn(airoha_napi_weight_dev,
+		 "napi_weight %u out of range (%u..%u), using %u\n",
+		 airoha_napi_weight_rejected, AIROHA_NAPI_MIN_WEIGHT,
+		 AIROHA_NAPI_MAX_WEIGHT, READ_ONCE(airoha_napi_weight));
+}
+
+static int airoha_napi_weight_set(const char *val,
+				  const struct kernel_param *kp)
+{
+	uint weight;
+	int err;
+
+	err = kstrtouint(val, 0, &weight);
+	if (err)
+		return err;
+
+	mutex_lock(&airoha_napi_weight_lock);
+	if (weight < AIROHA_NAPI_MIN_WEIGHT ||
+	    weight > AIROHA_NAPI_MAX_WEIGHT) {
+		airoha_napi_weight_rejected = weight;
+		weight = clamp(weight, AIROHA_NAPI_MIN_WEIGHT,
+			       AIROHA_NAPI_MAX_WEIGHT);
+		airoha_napi_weight_clamped = true;
+	}
+
+	WRITE_ONCE(airoha_napi_weight, weight);
+	airoha_napi_weight_warn_clamped();
+	mutex_unlock(&airoha_napi_weight_lock);
+
+	return 0;
+}
+
+static const struct kernel_param_ops airoha_napi_weight_ops = {
+	.set	= airoha_napi_weight_set,
+	.get	= param_get_uint,
+};
+
+module_param_cb(napi_weight, &airoha_napi_weight_ops, &airoha_napi_weight,
+		0644);
+MODULE_PARM_DESC(napi_weight, "QDMA RX/TX NAPI weight (16-512, default 64)");
+
 u32 airoha_rr(void __iomem *base, u32 offset)
 {
 	return readl(base + offset);
@@ -721,8 +798,25 @@ static void airoha_pse_debugfs_init(struct airoha_eth *eth)
 	debugfs_create_file("queues", 0444, eth->debugfs_dir, eth,
 			    &airoha_pse_debugfs_queues_fops);
 }
+
+static int airoha_qdma_debugfs_napi_weight_show(struct seq_file *m,
+						void *private)
+{
+	seq_printf(m, "napi_weight %u\n", READ_ONCE(airoha_napi_weight));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_qdma_debugfs_napi_weight);
+
+static void airoha_qdma_debugfs_init(struct airoha_eth *eth)
+{
+	eth->qdma_debugfs_dir = debugfs_create_dir("qdma", NULL);
+	debugfs_create_file("napi_weight", 0444, eth->qdma_debugfs_dir, NULL,
+			    &airoha_qdma_debugfs_napi_weight_fops);
+}
 #else
 static void airoha_pse_debugfs_init(struct airoha_eth *eth) {}
+static void airoha_qdma_debugfs_init(struct airoha_eth *eth) {}
 #endif
 
 static int airoha_fe_init(struct airoha_eth *eth)
@@ -1221,7 +1315,9 @@ static int airoha_qdma_init_rx_queue(struct airoha_queue *q,
 
 	q->buf_size = lro_q ? pp_params.max_len : pp_params.max_len / 2;
 	q->ndesc = ndesc;
-	netif_napi_add(eth->napi_dev, &q->napi, airoha_qdma_rx_napi_poll);
+	netif_napi_add_weight(eth->napi_dev, &q->napi,
+			      airoha_qdma_rx_napi_poll,
+			      READ_ONCE(airoha_napi_weight));
 
 	airoha_qdma_wr(qdma, REG_RX_RING_BASE(qid), dma_addr);
 	airoha_qdma_rmw(qdma, REG_RX_RING_SIZE(qid),
@@ -1548,8 +1644,9 @@ static int airoha_qdma_tx_irq_init(struct airoha_tx_irq_queue *irq_q,
 	irq_q->size = size;
 	irq_q->qdma = qdma;
 
-	netif_napi_add_tx(eth->napi_dev, &irq_q->napi,
-			  airoha_qdma_tx_napi_poll);
+	netif_napi_add_tx_weight(eth->napi_dev, &irq_q->napi,
+				 airoha_qdma_tx_napi_poll,
+				 READ_ONCE(airoha_napi_weight));
 
 	airoha_qdma_wr(qdma, REG_TX_IRQ_BASE(id), dma_addr);
 	airoha_qdma_rmw(qdma, REG_TX_IRQ_CFG(id), TX_IRQ_DEPTH_MASK,
@@ -2062,6 +2159,7 @@ static int airoha_hw_init(struct platform_device *pdev,
 		goto error;
 
 	airoha_pse_debugfs_init(eth);
+	airoha_qdma_debugfs_init(eth);
 
 	set_bit(DEV_STATE_INITIALIZED, &eth->state);
 
@@ -2077,9 +2175,14 @@ static void airoha_hw_cleanup(struct airoha_eth *eth)
 {
 	int i;
 
+	mutex_lock(&airoha_napi_weight_lock);
+	airoha_napi_weight_dev = NULL;
+	mutex_unlock(&airoha_napi_weight_lock);
+
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
 		airoha_qdma_cleanup(eth, &eth->qdma[i]);
 	airoha_ppe_deinit(eth);
+	debugfs_remove(eth->qdma_debugfs_dir);
 	debugfs_remove(eth->debugfs_dir);
 }
 
@@ -4447,6 +4550,11 @@ static int airoha_probe(struct platform_device *pdev)
 	if (err)
 		goto error_netdev_free;
 
+	mutex_lock(&airoha_napi_weight_lock);
+	airoha_napi_weight_dev = eth->dev;
+	airoha_napi_weight_warn_clamped();
+	mutex_unlock(&airoha_napi_weight_lock);
+
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
 		airoha_qdma_start_napi(&eth->qdma[i]);
 		airoha_qdma_set(&eth->qdma[i], REG_QDMA_GLOBAL_CFG,
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -826,6 +826,7 @@ struct airoha_eth {
 	u32 updmem_seq;
 
 	struct dentry *debugfs_dir;
+	struct dentry *qdma_debugfs_dir;
 };
 
 /* Slot 0xf tells the hardware to keep the frame's own source address. */
