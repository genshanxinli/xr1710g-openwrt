From: OpenWrt <openwrt@example.org>
Subject: [PATCH] net: airoha: expose the PSE packet buffer in debugfs

The PSE pools the packet buffer that every GDM and CDM port draws from:
2 MiB in 128-byte pages, 16384 in total.  Each egress queue gets a
guaranteed reserve and everything above the sum of those reserves is
shared.  On the XR1710G the reserves alone claim 4320 pages, 26.4% of the
pool, and GDM4 - the port with only two queues - gets 8 KiB of it.

None of this is visible at runtime.  When a burst outruns the pool the
frames are dropped and the only evidence is a throughput ceiling; the
per-queue register values that would explain it cannot be read without a
debugger, and the shared-pool thresholds are computed in software from
fq_limit - all_rsv - headroom, so their values are not obvious either.

Add /sys/kernel/debug/pse/usage next to the existing ppe/ directory,
reporting the pool size, the reserve, the remainder actually available
for sharing, and the three share-used thresholds.  That turns "why does
this port cap out below line rate" into a single file read.

Signed-off-by: OpenWrt <openwrt@example.org>
---

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -621,6 +621,47 @@
 	airoha_fe_lro_disable(eth, qdma_id);
 }
 
+#ifdef CONFIG_DEBUG_FS
+static int airoha_pse_debugfs_show(struct seq_file *m, void *private)
+{
+	struct airoha_eth *eth = m->private;
+	u32 all_rsv, fq_limit, hthd, mthd, lthd;
+
+	all_rsv = airoha_fe_get(eth, REG_FE_PSE_BUF_SET, PSE_ALLRSV_MASK);
+	fq_limit = airoha_fe_get(eth, PSE_FQ_CFG, PSE_FQ_LIMIT_MASK);
+	hthd = airoha_fe_get(eth, REG_PSE_SHARE_USED_THD,
+			     PSE_SHARE_USED_HTHD_MASK);
+	mthd = airoha_fe_get(eth, REG_PSE_SHARE_USED_THD,
+			     PSE_SHARE_USED_MTHD_MASK);
+	lthd = airoha_fe_get(eth, REG_FE_PSE_BUF_SET,
+			     PSE_SHARE_USED_LTHD_MASK);
+
+	seq_printf(m, "fq_limit %u pages (%u KiB)\n", fq_limit,
+		   fq_limit * 128 / 1024);
+	seq_printf(m, "all_rsv  %u pages (%u KiB, %u%%)\n", all_rsv,
+		   all_rsv * 128 / 1024,
+		   fq_limit ? all_rsv * 100 / fq_limit : 0);
+	seq_printf(m, "shared   %u pages (%u KiB)\n", fq_limit - all_rsv,
+		   (fq_limit - all_rsv) * 128 / 1024);
+	seq_puts(m, "\nshare-used thresholds (pages)\n");
+	seq_printf(m, "  high %u\n", hthd);
+	seq_printf(m, "  mid  %u\n", mthd);
+	seq_printf(m, "  low  %u\n", lthd);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_pse_debugfs);
+
+static void airoha_pse_debugfs_init(struct airoha_eth *eth)
+{
+	eth->debugfs_dir = debugfs_create_dir("pse", NULL);
+	debugfs_create_file("usage", 0444, eth->debugfs_dir, eth,
+			    &airoha_pse_debugfs_fops);
+}
+#else
+static void airoha_pse_debugfs_init(struct airoha_eth *eth) {}
+#endif
+
 static int airoha_fe_init(struct airoha_eth *eth)
 {
 	airoha_fe_maccr_init(eth);
@@ -1931,6 +1972,8 @@
 	if (err)
 		goto error;
 
+	airoha_pse_debugfs_init(eth);
+
 	set_bit(DEV_STATE_INITIALIZED, &eth->state);
 
 	return 0;
@@ -1948,6 +1991,7 @@
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
 		airoha_qdma_cleanup(eth, &eth->qdma[i]);
 	airoha_ppe_deinit(eth);
+	debugfs_remove(eth->debugfs_dir);
 }
 
 static void airoha_qdma_start_napi(struct airoha_qdma *qdma)
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -719,6 +719,8 @@
 
 	struct airoha_qdma qdma[AIROHA_MAX_NUM_QDMA];
 	struct airoha_gdm_port *ports[AIROHA_MAX_NUM_GDM_PORTS];
+
+	struct dentry *debugfs_dir;
 };
 
 u32 airoha_rr(void __iomem *base, u32 offset);
