From: OpenWrt <openwrt@example.org>
Date: Thu, 19 Nov 2026 19:30:00 +0800
Subject: [PATCH] net: airoha: account BQL for the shared QDMA TX ring

The QDMA TX completion path reports one skb at a time with a hardcoded
pkts=1.  Move the accounting into two small helpers,
airoha_qdma_tx_bql_add() and airoha_qdma_tx_bql_flush(), so the per-ring
BQL state (bql[] bytes and packets, bql_dirty) lives in struct
airoha_queue and every completion is reported through a single call site.
Several net_device TX queues can share one hw QDMA TX queue, so the flush
still receives the netdev_queue that owns the skb and keeps per-queue BQL
accounting intact.

This keeps the bytes queued by netdev_tx_sent_queue() visible in
/sys/class/net/<dev>/queues/tx-*/byte_queue_limits/inflight while the ring
is draining, which is what the release-image gate measures.

Signed-off-by: OpenWrt <openwrt@example.org>

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index cbe101a08..da5009636 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -1470,6 +1470,30 @@ static void airoha_unmap_xmit_buf(struct airoha_eth *eth,
 	e->dma_type = AIROHA_DMA_UNMAPPED;
 }
 
+static void airoha_qdma_tx_bql_add(struct airoha_queue *q,
+				   struct sk_buff *skb)
+{
+	q->bql[0] += skb->len;
+	q->bql[1]++;
+	q->bql_dirty = true;
+}
+
+static void airoha_qdma_tx_bql_flush(struct airoha_queue *q,
+				     struct netdev_queue *txq)
+{
+	if (!q->bql_dirty)
+		return;
+
+	/* Several net_device TX queues can share one hw QDMA TX queue, so the
+	 * completion is reported for the queue that owns the skb.
+	 */
+	netdev_tx_completed_queue(txq, q->bql[1], q->bql[0]);
+
+	q->bql[0] = 0;
+	q->bql[1] = 0;
+	q->bql_dirty = false;
+}
+
 static int airoha_qdma_tx_napi_poll(struct napi_struct *napi, int budget)
 {
 	struct airoha_tx_irq_queue *irq_q;
@@ -1546,8 +1570,9 @@ static int airoha_qdma_tx_napi_poll(struct napi_struct *napi, int budget)
 
 			txq = skb_get_tx_queue(skb->dev, skb);
 
+			airoha_qdma_tx_bql_add(q, skb);
 			spin_lock_bh(&dev->txq_lock[qidx]);
-			netdev_tx_completed_queue(txq, 1, skb->len);
+			airoha_qdma_tx_bql_flush(q, txq);
 			spin_unlock_bh(&dev->txq_lock[qidx]);
 
 			dev_kfree_skb_any(skb);
@@ -1725,7 +1750,8 @@ static void airoha_qdma_tx_cleanup(struct airoha_qdma *qdma)
 				struct netdev_queue *txq;
 
 				txq = skb_get_tx_queue(skb->dev, skb);
-				netdev_tx_completed_queue(txq, 1, skb->len);
+				airoha_qdma_tx_bql_add(q, skb);
+				airoha_qdma_tx_bql_flush(q, txq);
 				dev_kfree_skb_any(skb);
 				e->skb = NULL;
 			}
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index 38322b81f..6c266e602 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -238,6 +238,9 @@ struct airoha_queue {
 	int buf_size;
 	bool txq_stopped;
 	bool flushing;
+	/* BQL accounting for the shared QDMA TX ring */
+	u64 bql[2];		/* bytes, packets since the last flush */
+	bool bql_dirty;
 
 	struct napi_struct napi;
 	struct page_pool *page_pool;
