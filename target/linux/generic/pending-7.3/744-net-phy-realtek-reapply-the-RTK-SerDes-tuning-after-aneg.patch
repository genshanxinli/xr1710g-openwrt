From: Balázs Triszka <info@balika011.hu>
Subject: [PATCH] net: phy: realtek: reapply the RTK SerDes tuning after aneg

The Realtek SDK applies two additional host SerDes writes on boards that
need the RTK SerDes tuning sequence.  The RTL826x common firmware table
programs flow_s 0x8003 for SDS 7.0x10, but on the XR1710G that value stops
working once copper Clause 45 auto-negotiation starts: the PHY reports a
completed copper link while the attached AN7581 USXGMII PCS never sees an
in-band partner word, so the netdev stays NO-CARRIER with the media side
apparently healthy.

Three pieces are needed, none of which this tree carries:

  1. an opt-in for the board, because the sequence is not valid on every
     RTL826x host;
  2. the two PSDS0 writes appended to the common firmware table, which is
     what the SDK does and what survives a cold boot;
  3. a re-pulse after copper autonegotiation, because writing the table
     once is not enough - the values have to be re-applied each time AN
     restarts.

The board-specific host SDS mode (realtek,sds-mode) is part of (1): the
XR1710G vendor bootloader programs SDS page 6 register 3 to 0x88c6, and
the common Linux init leaves that value out.

For (3) the driver closes the loop on the attached netdev's carrier rather
than on the PHY's own link bits.  Neither a single early pulse nor the
RTL8261 DTE XS and SDS link bits prove the outgoing word reached the MAC
PCS - a failing cold boot had both PHY-side bits set while the PCS counter
stayed at zero.  Each new AN cycle pulses SDS 7.0x10 through 0x8003 for
10-12 ms, restores 0x80aa, sets SDS 6.0x12 back to 0x5078, and only then
lets phylink sample the PCS.  If carrier is still down after 120 complete
poll rounds the pulse is repeated; the state machine is re-armed from
rtl826x_config_aneg() and also restarts if carrier drops while copper
stays up.

This does not read Airoha MMIO and does not add a retry limit, a DTE XS or
PCS reset, a TXPLL reset, or a TX FIR default.

Signed-off-by: Balázs Triszka <info@balika011.hu>
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
[reworked for this tree: the sds-mode option, the firmware-table append and
 the carrier-closed-loop retry are one patch instead of three, because this
 tree has no per-board patch selection and a partial stack is worse than
 none of it]
---
--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
@@ -117,6 +117,36 @@
 	return rtl826x_phy_patch_sds_set(phydev, sds_page, sds_reg, (ret & ~mask) | data);
 }
 
+int rtl826x_phy_patch_rtk_serdes(struct phy_device *phydev)
+{
+	struct rtl826x_priv *priv = phydev->priv;
+	int ret;
+
+	if (!priv || !priv->patch_rtk_serdes)
+		return 0;
+
+	/* A value transition is intentional even when the final value already
+	 * matches. Keep 0x8003 active long enough for the Host AN state to
+	 * settle before restoring the tuned value. Do not reset the running
+	 * DTE XS.
+	 */
+	ret = rtl826x_phy_patch_sds_set(phydev, 0x07, 0x10, 0x8003);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(10000, 12000);
+
+	ret = rtl826x_phy_patch_sds_set(phydev, 0x07, 0x10, 0x80aa);
+	if (ret < 0)
+		return ret;
+
+	ret = rtl826x_phy_patch_sds_set(phydev, 0x06, 0x12, 0x5078);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
 static int rtl826x_phy_patch_op(struct phy_device *phydev, const struct rtlgen_hwpatch *patch)
 {
 	u32 mask = GENMASK(patch->msb, patch->lsb);
@@ -230,7 +260,7 @@
 	struct rtlgen_phy_patch_db *patch_db;
 	struct rtlgen_hwpatch *patches;
 	const struct firmware *fw;
-	size_t count;
+	size_t count, extra_count, total_count;
 	int ret;
 
 	ret = request_firmware_direct(&fw, fw_name, dev);
@@ -253,17 +283,43 @@
 
 	patches = (struct rtlgen_hwpatch *)fw->data;
 	count = fw->size / sizeof(*patches);
+	extra_count = priv->patch_rtk_serdes ? 2 : 0;
+	if (check_add_overflow(count, extra_count, &total_count)) {
+		ret = -EOVERFLOW;
+		goto out;
+	}
 
-	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, count), GFP_KERNEL);
+	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, total_count),
+				GFP_KERNEL);
 	if (!patch_db) {
 		ret = -ENOMEM;
 		goto out;
 	}
 
-	patch_db->count = count;
+	patch_db->count = total_count;
 	patch_db->patch_op_exec = rtl826x_phy_patch_op;
 
 	memcpy(patch_db->conf, patches, flex_array_size(patch_db, conf, count));
+	if (priv->patch_rtk_serdes) {
+		patch_db->conf[count] = (struct rtlgen_hwpatch) {
+			.patch_op = RTK_PATCH_OP_PSDS0,
+			.portmask = 0xff,
+			.pagemmd = cpu_to_le16(0x07),
+			.addr = cpu_to_le16(0x10),
+			.msb = 15,
+			.lsb = 0,
+			.data = cpu_to_le16(0x80aa),
+		};
+		patch_db->conf[count + 1] = (struct rtlgen_hwpatch) {
+			.patch_op = RTK_PATCH_OP_PSDS0,
+			.portmask = 0xff,
+			.pagemmd = cpu_to_le16(0x06),
+			.addr = cpu_to_le16(0x12),
+			.msb = 15,
+			.lsb = 0,
+			.data = cpu_to_le16(0x5078),
+		};
+	}
 
 	priv->patch = patch_db;
 
--- a/drivers/net/phy/realtek/phy_patch_rtl826x.h
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.h
@@ -11,5 +11,6 @@
 
 int rtl8261n_phy_patch_db_init(struct phy_device *phydev);
 int rtl8264b_phy_patch_db_init(struct phy_device *phydev);
+int rtl826x_phy_patch_rtk_serdes(struct phy_device *phydev);
 
 #endif
--- a/drivers/net/phy/realtek/realtek.h
+++ b/drivers/net/phy/realtek/realtek.h
@@ -8,9 +8,20 @@
 #include "phy_patch.h"
 #include "phy_patch_rtl826x.h"
 
+enum rtl826x_rtk_serdes_state {
+	RTL826X_RTK_SERDES_IDLE,
+	RTL826X_RTK_SERDES_PULSE,
+	RTL826X_RTK_SERDES_RELEASE,
+	RTL826X_RTK_SERDES_CHECK_CARRIER,
+};
+
 struct rtl826x_priv {
 	struct rtlgen_phy_patch_db *patch;
+	enum rtl826x_rtk_serdes_state rtk_serdes_state;
+	u32 rtk_serdes_pulse_count;
+	u8 rtk_serdes_carrier_polls;
 	bool enable_pma_low_power:1;
+	bool patch_rtk_serdes:1;
 	struct phy_device *phydev;
 	struct delayed_work sds_work;
 	bool sds_work_disabled;
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -365,9 +365,15 @@
 #define   RTL826X_SDS_RESET_ASSERT		0x40
 #define   RTL826X_SDS_RESET_RELEASE		0xc0
 
+#define RTL826X_SDS_HOST_MODE_PAGE		6
+#define RTL826X_SDS_HOST_MODE_REG		3
+
 #define RTL826X_SDS_POLL_MS			100
 #define RTL826X_SDS_MAX_RESETS			20
 
+/* Let the HZ-driven PCS poll observe the new in-band word before retrying. */
+#define RTL826X_RTK_SERDES_CARRIER_GRACE_POLLS	120
+
 #define RTL826X_VEND1_PKG_MODEL			0x103
 #define   RTL826X_VEND1_PKG_MODEL_8251		0x8251
 #define   RTL826X_VEND1_PKG_MODEL_8254		0x8254
@@ -3745,7 +3751,11 @@
 		return -ENOMEM;
 
 	priv->enable_pma_low_power = device_property_read_bool(dev, "realtek,enable-pma-low-power");
+	priv->patch_rtk_serdes =
+		device_property_read_bool(dev, "realtek,patch-rtk-serdes");
 	priv->phydev = phydev;
+	if (priv->patch_rtk_serdes)
+		priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
 	phydev->priv = priv;
 
 	INIT_DELAYED_WORK(&priv->sds_work, rtl826x_sds_reset_work);
@@ -3773,6 +3783,39 @@
 	return 0;
 }
 
+static int rtl826x_config_sds_mode(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	u32 mode;
+	int ret;
+
+	if (!device_property_present(dev, "realtek,sds-mode"))
+		return 0;
+
+	ret = device_property_read_u32(dev, "realtek,sds-mode", &mode);
+	if (ret) {
+		phydev_err(phydev, "failed to read SDS mode: %d\n", ret);
+		return ret;
+	}
+
+	if (mode > 0xffff) {
+		phydev_err(phydev, "invalid SDS mode 0x%x\n", mode);
+		return -EINVAL;
+	}
+
+	ret = rtl826x_phy_patch_sds_set(phydev, RTL826X_SDS_HOST_MODE_PAGE,
+					RTL826X_SDS_HOST_MODE_REG, mode);
+	if (ret) {
+		phydev_err(phydev, "failed to set SDS mode 0x%04x: %d\n",
+			   mode, ret);
+		return ret;
+	}
+
+	phydev_info(phydev, "configured SDS mode 0x%04x\n", mode);
+
+	return 0;
+}
+
 static int rtl826x_config_serdes_polarity(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
@@ -3849,6 +3892,10 @@
 		return ret;
 	}
 
+	ret = rtl826x_config_sds_mode(phydev);
+	if (ret)
+		return ret;
+
 	return rtl826x_config_serdes_polarity(phydev);
 }
 
@@ -3902,11 +3949,17 @@
 
 static int rtl826x_config_aneg(struct phy_device *phydev)
 {
+	struct rtl826x_priv *priv = phydev->priv;
 	bool changed = false;
 	u16 reg;
 	int ret;
 
 	phydev->mdix_ctrl = ETH_TP_MDI_AUTO;
+	if (priv && priv->patch_rtk_serdes) {
+		priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
+		priv->rtk_serdes_pulse_count = 0;
+		priv->rtk_serdes_carrier_polls = 0;
+	}
 	if (phydev->autoneg == AUTONEG_DISABLE)
 		return genphy_c45_pma_setup_forced(phydev);
 
@@ -3936,8 +3989,33 @@
 	return genphy_c45_check_and_restart_aneg(phydev, changed);
 }
 
+static int rtl826x_rtk_serdes_pulse(struct phy_device *phydev)
+{
+	struct rtl826x_priv *priv = phydev->priv;
+	int ret;
+
+	ret = rtl826x_phy_patch_rtk_serdes(phydev);
+	if (ret < 0)
+		return ret;
+
+	priv->rtk_serdes_pulse_count++;
+	if (priv->rtk_serdes_pulse_count == 1)
+		phydev_info(phydev,
+			    "pulsed RTK SerDes flow_s 0x8003->0x80aa/0x5078 after copper AN\n");
+	else
+		phydev_dbg(phydev, "repeated RTK SerDes flow_s pulse %u\n",
+			   priv->rtk_serdes_pulse_count);
+
+	priv->rtk_serdes_state = RTL826X_RTK_SERDES_RELEASE;
+	priv->rtk_serdes_carrier_polls = 0;
+
+	return 0;
+}
+
 static int rtl826x_read_status(struct phy_device *phydev)
 {
+	struct rtl826x_priv *priv = phydev->priv;
+	bool aneg_done = phydev->autoneg == AUTONEG_DISABLE;
 	int status;
 	int ret;
 
@@ -3968,7 +4046,98 @@
 			return ret;
 	}
 
-	return genphy_c45_read_mdix(phydev);
+	ret = genphy_c45_read_mdix(phydev);
+	if (ret)
+		return ret;
+
+	if (!priv || !priv->patch_rtk_serdes)
+		return 0;
+
+	if (!aneg_done) {
+		ret = genphy_c45_aneg_done(phydev);
+		if (ret < 0)
+			return ret;
+		aneg_done = ret > 0;
+	}
+
+	phydev_dbg(phydev,
+		   "RTK status link=%u aneg_done=%u phy_state=%u rtk_state=%u attached=%s carrier=%d grace=%u\n",
+		   phydev->link, aneg_done, phydev->state,
+		   priv->rtk_serdes_state,
+		   phydev->attached_dev ? phydev->attached_dev->name : "<none>",
+		   phydev->attached_dev ? netif_carrier_ok(phydev->attached_dev) : -1,
+		   priv->rtk_serdes_carrier_polls);
+
+	if (!phydev->link) {
+		/* A flow_s pulse can make C45 report link down while AN restarts.
+		 * Keep the retry state across that interval. The initial pulse
+		 * still waits for a reported copper link, while a pending retry
+		 * may consume the carrier grace window even when the link is
+		 * latched down.
+		 */
+		if (priv->rtk_serdes_state == RTL826X_RTK_SERDES_IDLE) {
+			priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
+			priv->rtk_serdes_pulse_count = 0;
+			priv->rtk_serdes_carrier_polls = 0;
+		}
+
+		if (!aneg_done ||
+		    priv->rtk_serdes_state == RTL826X_RTK_SERDES_PULSE) {
+			priv->rtk_serdes_carrier_polls = 0;
+			return 0;
+		}
+	}
+
+	if (priv->rtk_serdes_state == RTL826X_RTK_SERDES_IDLE) {
+		if (!phydev->attached_dev ||
+		    netif_carrier_ok(phydev->attached_dev))
+			return 0;
+
+		phydev_info(phydev,
+			    "netdev carrier lost with copper link up, restarting RTK SerDes\n");
+		priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
+		priv->rtk_serdes_pulse_count = 0;
+		priv->rtk_serdes_carrier_polls = 0;
+	}
+
+	if (!aneg_done) {
+		phydev->link = false;
+		return 0;
+	}
+
+	switch (priv->rtk_serdes_state) {
+	case RTL826X_RTK_SERDES_PULSE:
+		return rtl826x_rtk_serdes_pulse(phydev);
+	case RTL826X_RTK_SERDES_RELEASE:
+		priv->rtk_serdes_state = RTL826X_RTK_SERDES_CHECK_CARRIER;
+		priv->rtk_serdes_carrier_polls = 0;
+		return 0;
+	case RTL826X_RTK_SERDES_CHECK_CARRIER:
+		if (!phydev->attached_dev) {
+			priv->rtk_serdes_state = RTL826X_RTK_SERDES_IDLE;
+			return 0;
+		}
+
+		if (netif_carrier_ok(phydev->attached_dev)) {
+			phydev_info(phydev,
+				    "RTK SerDes carrier recovered after %u flow_s pulse(s)\n",
+				    priv->rtk_serdes_pulse_count);
+			priv->rtk_serdes_state = RTL826X_RTK_SERDES_IDLE;
+			return 0;
+		}
+
+		if (priv->rtk_serdes_carrier_polls++ <
+		    RTL826X_RTK_SERDES_CARRIER_GRACE_POLLS)
+			return 0;
+
+		priv->rtk_serdes_carrier_polls = 0;
+
+		return rtl826x_rtk_serdes_pulse(phydev);
+	case RTL826X_RTK_SERDES_IDLE:
+		return 0;
+	}
+
+	return 0;
 }
 
 static int rtl826x_config_intr(struct phy_device *phydev)
