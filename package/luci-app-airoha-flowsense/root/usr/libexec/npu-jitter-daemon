#!/bin/sh

# NPU Jitter Daemon
# Continuously pings a target and writes jitter stats to /tmp/npu-jitter.json
# Started by /etc/init.d/npu-jitter at boot

TARGET="${1:-1.1.1.1}"
RESULT_FILE="/tmp/npu-jitter.json"
WINDOW=10
INTERVAL=2  # seconds between pings

# Optional throughput shaping driven by the measured jitter.
#
# The PPE is congestion unaware: when a downstream port is slower than the
# incoming burst it drops instead of pushing back, so a 10G ingress aimed at a
# 1G LAN port or at a Wi-Fi client loses packets well before the link itself is
# saturated.  Capping the WAN egress at slightly less than the rate the link
# can actually sustain keeps the PPE queues short and removes that loss.
#
# Only wan (GDM2) is shaped.  The driver treats any other GDM as the WAN role
# when HTB is configured on it (airoha_enable_qos_for_gdm34 converts the port
# to WAN and refuses if another device already holds the role), so touching
# lan2 would silently re-route the WAN role.
SHAPE_ENABLE="${SHAPE_ENABLE:-0}"
SHAPE_IFACE="${SHAPE_IFACE:-wan}"
SHAPE_MIN_MBPS="${SHAPE_MIN_MBPS:-100}"
SHAPE_MAX_MBPS="${SHAPE_MAX_MBPS:-9500}"
SHAPE_JITTER_MS="${SHAPE_JITTER_MS:-25}"
shaped_mbps=0

ping_values=""
count=0

# Install, raise or remove the wan egress cap. Called only when SHAPE_ENABLE is
# set, so an unconfigured box never touches the qdisc tree.
apply_shaper() {
	local jitter="$1" link_mbps new_mbps

	# jitter carries two decimals (printf '%.2f' below) and the shell has no
	# float arithmetic: [ 12.34 -lt 25 ] is an error in ash, so the comparison
	# has to happen in awk.
	if awk -v j="$jitter" -v t="$SHAPE_JITTER_MS" 'BEGIN { exit !(j < t) }'; then
		# Below the threshold the link is keeping up: drop any cap we added so
		# the full rate stays available.
		if [ "$shaped_mbps" -gt 0 ]; then
			tc qdisc del dev "$SHAPE_IFACE" root 2>/dev/null
			shaped_mbps=0
			logger -t npu-jitter "jitter ${jitter}ms below ${SHAPE_JITTER_MS}ms, cap removed" 2>/dev/null
		fi
		return 0
	fi

	# Jitter is above the threshold. Start from half of what the link
	# negotiated and halve again on each further sample until it settles; a
	# small first step would take minutes to matter.
	if [ "$shaped_mbps" -eq 0 ]; then
		link_mbps=$(ethtool "$SHAPE_IFACE" 2>/dev/null |
			    sed -n 's/.*Speed: \([0-9]*\)Mb\/s.*/\1/p')
		[ -n "$link_mbps" ] && [ "$link_mbps" -gt 0 ] 2>/dev/null || link_mbps="$SHAPE_MAX_MBPS"
		new_mbps=$((link_mbps / 2))
	else
		new_mbps=$((shaped_mbps / 2))
	fi
	[ "$new_mbps" -gt "$SHAPE_MAX_MBPS" ] && new_mbps="$SHAPE_MAX_MBPS"
	[ "$new_mbps" -lt "$SHAPE_MIN_MBPS" ] && new_mbps="$SHAPE_MIN_MBPS"
	[ "$new_mbps" -eq "$shaped_mbps" ] && return 0

	tc qdisc del dev "$SHAPE_IFACE" root 2>/dev/null
	if tc qdisc add dev "$SHAPE_IFACE" root \
		tbf rate "${new_mbps}mbit" burst 32k latency 20ms 2>/dev/null; then
		shaped_mbps="$new_mbps"
		logger -t npu-jitter "jitter ${jitter}ms, wan capped to ${new_mbps}mbit" 2>/dev/null
	fi
}

cpu_prev=""

while true; do
	# System CPU % over the loop window (delta vs the previous iteration).
	# Sampled here in the background daemon (steady ~2s window, and the daemon
	# itself is lightweight) rather than in the RPC on every page poll, so it
	# reflects real background load instead of FlowSense's own polling burst -
	# the old in-RPC /proc/stat delta measured its own overhead and read
	# ~15-20% at idle vs ~0% in top.
	cpu_now=$(awk '/^cpu /{print $2,$3,$4,$5,$6,$7,$8; exit}' /proc/stat 2>/dev/null)
	cpu_pct=0
	if [ -n "$cpu_prev" ] && [ -n "$cpu_now" ]; then
		cpu_pct=$(awk -v a="$cpu_prev" -v b="$cpu_now" 'BEGIN {
			split(a, p, " "); split(b, c, " ")
			pt = p[1]+p[2]+p[3]+p[4]+p[5]+p[6]+p[7]
			ct = c[1]+c[2]+c[3]+c[4]+c[5]+c[6]+c[7]
			dt = ct - pt; di = c[4] - p[4]
			if (dt > 0) printf "%d", int((dt - di) * 100 / dt)
			else print 0
		}')
	fi
	cpu_prev="$cpu_now"

	# Single ping, 1 second timeout.
	# NB: on busybox ping the summary splits by '/' so $5 is the MAX rtt -
	# identical to avg only because -c 1 sends a single probe. If the probe
	# count ever changes, this field must be revisited.
	rtt=$(ping -c 1 -W 1 "$TARGET" 2>/dev/null | awk -F'/' '/min.*avg/{printf "%.2f", $5}')

	if [ -n "$rtt" ]; then
		ping_values="$ping_values $rtt"
		count=$((count + 1))

		# Trim to window size
		if [ "$count" -gt "$WINDOW" ]; then
			ping_values=$(echo "$ping_values" | awk '{
				for (i = NF - '"$WINDOW"' + 1; i <= NF; i++) printf $i " "
			}')
			count=$WINDOW
		fi

		# Calculate mean absolute deviation (jitter) and last ping
		result=$(echo "$ping_values" | awk -v c="$count" -v cpu="$cpu_pct" '{
			n = NF
			sum = 0
			for (i = 1; i <= n; i++) sum += $i
			avg = sum / n
			dev = 0
			for (i = 1; i <= n; i++) dev += ($i > avg ? $i - avg : avg - $i)
			jitter = dev / n
			last = $n
			printf "{\"jitter\":%.2f,\"last_ping\":%.2f,\"samples\":%d,\"target\":\"%s\",\"reachable\":true,\"available\":true,\"cpu_pct\":%d}", \
				jitter, last, c, "'"$TARGET"'", cpu
		}')

		# Write atomically so a reader never sees a half-written file
		echo "$result" > "$RESULT_FILE.tmp" && mv "$RESULT_FILE.tmp" "$RESULT_FILE"

		if [ "$SHAPE_ENABLE" = "1" ]; then
			_jit=$(echo "$result" | sed -n 's/.*"jitter":\([0-9.]*\).*/\1/p')
			[ -n "$_jit" ] && apply_shaper "$_jit"
		fi
	else
		# Unreachable — preserve sample count but mark unreachable
		printf '{"jitter":0,"last_ping":0,"samples":%d,"target":"%s","reachable":false,"available":true,"cpu_pct":%d}\n' \
			"$count" "$TARGET" "$cpu_pct" > "$RESULT_FILE.tmp" && mv "$RESULT_FILE.tmp" "$RESULT_FILE"
	fi

	sleep "$INTERVAL"
done
