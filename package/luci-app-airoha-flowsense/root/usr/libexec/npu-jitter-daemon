#!/bin/sh
# Opt-in latency/CPU sampler; writes JSON atomically inside 0700 /var/run/flowsense.

TARGET="${1:-1.1.1.1}"
case "$TARGET" in
	''|-*|*[!a-zA-Z0-9.:_-]*) TARGET="1.1.1.1" ;;
esac

RUN_DIR="${FLOWSENSE_RUN_DIR:-/var/run/flowsense}"
RESULT_FILE="$RUN_DIR/npu-jitter.json"
WINDOW=10
INTERVAL=2

if [ -L "$RUN_DIR" ] || { [ -e "$RUN_DIR" ] && [ ! -d "$RUN_DIR" ]; }; then
	exit 1
fi
mkdir -p "$RUN_DIR" && chmod 0700 "$RUN_DIR" || exit 1

write_result() {
	local tmp
	tmp=$(mktemp "$RUN_DIR/npu-jitter.XXXXXX") || return 1
	if printf '%s\n' "$1" > "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$RESULT_FILE"; then
		return 0
	fi
	rm -f "$tmp"
	return 1
}

cleanup() {
	rm -f "$RESULT_FILE" "$RUN_DIR"/npu-jitter.*
	exit 0
}
trap cleanup TERM INT

ping_values=""
count=0
cpu_prev=""

while true; do
	cpu_now=$(awk '/^cpu /{print $2,$3,$4,$5,$6,$7,$8; exit}' /proc/stat 2>/dev/null)
	cpu_pct=0
	if [ -n "$cpu_prev" ] && [ -n "$cpu_now" ]; then
		cpu_pct=$(awk -v a="$cpu_prev" -v b="$cpu_now" 'BEGIN {
			split(a, p, " "); split(b, c, " ")
			pt = p[1]+p[2]+p[3]+p[4]+p[5]+p[6]+p[7]
			ct = c[1]+c[2]+c[3]+c[4]+c[5]+c[6]+c[7]
			dt = ct - pt; di = c[4] - p[4]
			if (dt > 0) printf "%d", int((dt - di) * 100 / dt)
			else print 0
		}')
	fi
	cpu_prev="$cpu_now"

	rtt=$(ping -c 1 -W 1 "$TARGET" 2>/dev/null | awk -F'/' '/min.*avg/{printf "%.2f", $5}')

	if [ -n "$rtt" ]; then
		ping_values="$ping_values $rtt"
		count=$((count + 1))

		if [ "$count" -gt "$WINDOW" ]; then
			ping_values=$(printf '%s\n' "$ping_values" | awk -v w="$WINDOW" '{
				for (i = NF - w + 1; i <= NF; i++) printf $i " "
			}')
			count=$WINDOW
		fi

		result=$(printf '%s\n' "$ping_values" | awk -v c="$count" -v cpu="$cpu_pct" -v target="$TARGET" '{
			n = NF
			sum = 0
			for (i = 1; i <= n; i++) sum += $i
			avg = sum / n
			dev = 0
			for (i = 1; i <= n; i++) dev += ($i > avg ? $i - avg : avg - $i)
			jitter = dev / n
			last = $n
			printf "{\"jitter\":%.2f,\"last_ping\":%.2f,\"samples\":%d,\"target\":\"%s\",\"reachable\":true,\"available\":true,\"cpu_pct\":%d}", \
				jitter, last, c, target, cpu
		}')

		write_result "$result"
	else
		result=$(printf '{"jitter":0,"last_ping":0,"samples":%d,"target":"%s","reachable":false,"available":true,"cpu_pct":%d}' \
			"$count" "$TARGET" "$cpu_pct")
		write_result "$result"
	fi

	sleep "$INTERVAL"
done
