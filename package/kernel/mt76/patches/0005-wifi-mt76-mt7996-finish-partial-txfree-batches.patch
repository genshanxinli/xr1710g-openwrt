From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Thu, 16 Oct 2026 12:10:00 +0800
Subject: [PATCH] wifi: mt76: mt7996: finish partial TX free batches

A truncated TX completion batch can be discovered after valid tokens
have already been released. Returning at that point skips the local skb
free list, the TX unblock flag and the TX worker, leaking completed
skbs and leaving transmissions stopped despite newly available tokens.

Finish the valid prefix through the normal completion epilogue instead
of warning and returning; validate the fixed header and every whole info
word, including the version 7 pair extension, before reading them, and
linearize fragmented TXFREE skbs before parsing.

[xr1710g: refresh hunk context for mt76 acb7b1c8 so patch applies with fuzz=0]

Origin: local, xr1710g
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
diff --git a/mt7996/mac.c b/mt7996/mac.c
index cb27809..d755f77 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -1268,11 +1268,16 @@ mt7996_mac_tx_free(struct mt7996_dev *dev, void *data, int len)
 	struct mt76_wcid *wcid = NULL;
 	LIST_HEAD(free_list);
 	struct sk_buff *skb, *tmp;
-	void *end = data + len;
+	void *end;
 	bool wake = false;
 	u16 total, count = 0;
 	u8 ver;
 
+	if (len < 2 * (int)sizeof(*tx_free))
+		return;
+
+	end = data + len;
+
 	/* clean DMA queues and unmap buffers first */
 	mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[MT_TXQ_PSD], false);
 	mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[MT_TXQ_BE], false);
@@ -1294,8 +1299,9 @@ mt7996_mac_tx_free(struct mt7996_dev *dev, void *data, int len)
 		u32 msdu, info;
 		u8 i;
 
-		if (WARN_ON_ONCE((void *)cur_info >= end))
-			return;
+		if ((void *)cur_info >= end ||
+		    end - (void *)cur_info < sizeof(*cur_info))
+			break;
 		/* 1'b1: new wcid pair.
 		 * 1'b0: msdu_id with the same 'wcid pair' as above.
 		 */
@@ -1317,7 +1323,8 @@ mt7996_mac_tx_free(struct mt7996_dev *dev, void *data, int len)
 				goto next;
 next:
 			/* ver 7 has a new DW with pair = 1, skip it */
-			if (ver == 7 && ((void *)(cur_info + 1) < end) &&
+			if (ver == 7 &&
+			    end - (void *)(cur_info + 1) >= sizeof(*cur_info) &&
 			    (le32_to_cpu(*(cur_info + 1)) & MT_TXFREE_INFO_PAIR))
 				cur_info++;
 			continue;
@@ -1597,7 +1604,8 @@ void mt7996_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
 			break;
 		}
 
-		mt7996_mac_tx_free(dev, skb->data, skb->len);
+		if (pskb_may_pull(skb, skb->len))
+			mt7996_mac_tx_free(dev, skb->data, skb->len);
 		napi_consume_skb(skb, 1);
 		break;
 	case PKT_TYPE_RX_EVENT:
