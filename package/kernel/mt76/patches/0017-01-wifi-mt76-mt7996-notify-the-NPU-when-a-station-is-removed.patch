From: genshanxinli <genshanxinli@users.noreply.github.com>
Date: Sat, 15 Nov 2026 08:00:00 +0800
Subject: [PATCH] wifi: mt76: mt7996: tell the NPU when a station is removed

The Airoha NPU offload path keeps per-WCID state for stations it has
seen. When a station link is torn down, mt7996 releases the WTBL entry,
the BA sessions and the keys of that link but never tells the NPU, so the
stale state stays behind. A later station that reuses the same WCID index
can inherit the old forwarding state. On the AN7581 this shows up as a
station that reconnects with the same MAC address downloading at a crawl
until it is forgotten and re-added with a new private MAC address.

Send WLAN_FUNC_SET_WAIT_DEL_STA through the existing NPU mailbox from
mt7996_mac_sta_remove_link(), before the link state is destroyed, passing
the band and the WCID index being retired. Hooking the per-link helper
instead of mt7996_mac_sta_remove() covers every teardown path: full
station removal, link removal from mt7996_mac_sta_change_links() and the
mt7996_mac_sta_add_links() unwind. The latter two pass flush == false and
keep the WCID allocated, so the index outlives the hardware state that
the NPU still refers to - that is the stale-WCID window this closes.

Skip the notification while MT76_MCU_RESET is set: a firmware or chip
reset has already stopped the NPU and quiesced the mailbox, and per-WCID
state does not survive it. A mailbox error is logged once at debug level
and never fails the station removal.

While here, print the effective Airoha PPE L2 dual-ingress window in the
existing hw-queues debugfs file so the dual-window A/B test can see the
value in use from the same place as the station queues.

Signed-off-by: genshanxinli <genshanxinli@users.noreply.github.com>
---
--- a/mt7996/debugfs.c
+++ b/mt7996/debugfs.c
@@ -829,11 +829,28 @@ mt7996_sta_hw_queue_read(void *data, str
 	rcu_read_unlock();
 }
 
+#ifdef CONFIG_MT76_NPU
+static void mt7996_dual_window_show(struct seq_file *s, struct mt7996_dev *dev)
+{
+	struct airoha_ppe_dev *ppe_dev;
+
+	rcu_read_lock();
+	ppe_dev = rcu_dereference(dev->mt76.mmio.ppe_dev);
+	if (ppe_dev)
+		seq_printf(s, "Airoha PPE L2 dual window: %u ms\n",
+			   airoha_ppe_dev_get_l2_dual_window_ms(ppe_dev));
+	rcu_read_unlock();
+}
+#endif
+
 static int
 mt7996_hw_queues_show(struct seq_file *s, void *data)
 {
 	struct mt7996_dev *dev = s->private;
 
+#ifdef CONFIG_MT76_NPU
+	mt7996_dual_window_show(s, dev);
+#endif
 	seq_puts(s, "PLE page info:\n");
 	mt7996_freepg_show(s, mt76_rr(dev, MT_PLE_FREEPG_CNT),
 			   mt76_rr(dev, MT_PLE_FREEPG_HEAD_TAIL));
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1452,6 +1452,17 @@ void mt7996_mac_sta_remove_link(struct m
 	if (!msta_link)
 		return;
 
+	/*
+	 * The WTBL entry and the BA/key state of this link are torn down below
+	 * whether or not the WCID index itself is released (flush == false),
+	 * so the NPU's per-WCID state is stale either way. Tell it while the
+	 * hardware state still exists. Doing this here instead of in
+	 * mt7996_mac_sta_remove() also covers link teardown from
+	 * mt7996_mac_sta_change_links() and the mt7996_mac_sta_add_links()
+	 * unwind, both of which keep the WCID allocated.
+	 */
+	mt7996_npu_del_sta(dev, msta_link->wcid.phy_idx, msta_link->wcid.idx);
+
 	spin_lock_bh(&dev->mt76.sta_poll_lock);
 	if (!list_empty(&msta_link->wcid.poll_list))
 		list_del_init(&msta_link->wcid.poll_list);
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -574,6 +574,7 @@ struct mt7996_dev {
 	} wed_rro;
 
 	dma_addr_t npu_txd_addr[2 * MT7996_NPU_TXD_SIZE];
+	bool npu_del_sta_error;
 
 	struct {
 		bool requested;
@@ -1083,6 +1084,7 @@ int __mt7996_npu_hw_init(struct mt7996_d
 int mt7996_npu_hw_init(struct mt7996_dev *dev);
 int mt7996_npu_hw_stop(struct mt7996_dev *dev);
 int mt7996_npu_rx_queues_init(struct mt7996_dev *dev);
+void mt7996_npu_del_sta(struct mt7996_dev *dev, u8 band_idx, u16 wcid_idx);
 #else
 static inline int __mt7996_npu_hw_init(struct mt7996_dev *dev)
 {
@@ -1103,6 +1105,11 @@ static inline int mt7996_npu_rx_queues_i
 {
 	return 0;
 }
+
+static inline void mt7996_npu_del_sta(struct mt7996_dev *dev, u8 band_idx,
+				      u16 wcid_idx)
+{
+}
 #endif /* CONFIG_MT7996_NPU */
 
 #endif
--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -244,6 +244,46 @@ static int mt7996_npu_offload_init(struc
 	return 0;
 }
 
+void mt7996_npu_del_sta(struct mt7996_dev *dev, u8 band_idx, u16 wcid_idx)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	struct airoha_npu *npu;
+	int err;
+
+	/*
+	 * The NPU keeps per-WCID state for offloaded stations. Tell it when a
+	 * WCID is retired so that a later station reusing the index cannot
+	 * inherit stale forwarding state. Best effort only: a missing or older
+	 * NPU firmware must not fail station removal.
+	 */
+	if (!mt76_npu_device_active(mdev))
+		return;
+
+	/*
+	 * A chip or firmware reset has already stopped the NPU and left the
+	 * mailbox unresponsive, so a link teardown that runs inside the reset
+	 * path has nothing to report and must not wait for one. Per-WCID state
+	 * does not survive the reset anyway.
+	 */
+	if (test_bit(MT76_MCU_RESET, &dev->mphy.state))
+		return;
+
+	rcu_read_lock();
+	npu = rcu_dereference(mdev->mmio.npu);
+	if (npu) {
+		err = mt76_npu_send_msg(npu, band_idx,
+					WLAN_FUNC_SET_WAIT_DEL_STA, wcid_idx,
+					GFP_ATOMIC);
+		if (err && !dev->npu_del_sta_error) {
+			dev->npu_del_sta_error = true;
+			dev_dbg(mdev->dev,
+				"failed to notify the NPU of WCID %u removal: %d\n",
+				wcid_idx, err);
+		}
+	}
+	rcu_read_unlock();
+}
+
 static int mt7992_npu_rxd_init(struct mt7996_dev *dev, struct airoha_npu *npu)
 {
 	u32 val;
