From 0d0d6b3d8b6a4d9c7c8b0f3a5e2d1c4b6a8f9e0d Mon Sep 17 00:00:00 2001
From: Jiale Yao <yaojiale02@163.com>
Date: Wed, 21 Oct 2026 10:57:12 +0800
Subject: [PATCH] wifi: mt76: mt7996: clamp beamforming NSS

A peer can advertise a zero spatial-stream count in its VHT/HE MCS map,
and an EHT peer can advertise zero receive spatial streams for one MCS
range. The beamforming setup converts those counts with a plain -1, so
the value underflows to 255 (0xff) and that invalid column count is then
handed to the firmware in the STA_REC_BF TLV.

Clamp the converted value to zero in mt7996_mcu_get_sta_nss() and in the
EHT 80, 160 and 320 MHz beamforming paths. Well-behaved peers always
advertise at least one stream, so this changes nothing for them.

This is the serialised form of the series posted by Jiale Yao:

  1/2 wifi: mt76: mt7996: clamp VHT/HE beamforming NSS
  2/2 wifi: mt76: mt7996: clamp EHT beamforming NSS

Signed-off-by: Jiale Yao <yaojiale02@163.com>
---
 mt7996/mcu.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -357,7 +357,7 @@
 			break;
 	}
 
-	return nss - 1;
+	return nss ? nss - 1 : 0;
 }
 
 static void
@@ -2344,7 +2344,7 @@
 	struct ieee80211_eht_cap_elem_fixed *pe = &pc->eht_cap_elem;
 	struct ieee80211_eht_mcs_nss_supp *eht_nss = &pc->eht_mcs_nss_supp;
 	u8 nss_mcs = u8_get_bits(eht_nss->bw._80.rx_tx_mcs9_max_nss,
-				 IEEE80211_EHT_MCS_NSS_RX) - 1;
+				 IEEE80211_EHT_MCS_NSS_RX);
 	const struct ieee80211_eht_cap_elem_fixed *ve;
 	const struct ieee80211_sta_eht_cap *vc;
 	u8 snd_dim, sts;
@@ -2363,6 +2363,7 @@
 	snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_80MHZ_MASK, ve->phy_cap_info[2]);
 	sts = EHT_PHY(CAP0_BEAMFORMEE_SS_80MHZ_MASK, pe->phy_cap_info[0]) +
 	      (EHT_PHY(CAP1_BEAMFORMEE_SS_80MHZ_MASK, pe->phy_cap_info[1]) << 1);
+	nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
 	bf->nrow = min_t(u8, snd_dim, sts);
 	bf->ncol = min_t(u8, nss_mcs, bf->nrow);
 	bf->ibf_ncol = explicit ? min_t(u8, MT7996_IBF_MAX_NC, bf->ncol) :
@@ -2376,7 +2377,8 @@
 		snd_dim = EHT_PHY(CAP2_SOUNDING_DIM_160MHZ_MASK, ve->phy_cap_info[2]);
 		sts = EHT_PHY(CAP1_BEAMFORMEE_SS_160MHZ_MASK, pe->phy_cap_info[1]);
 		nss_mcs = u8_get_bits(eht_nss->bw._160.rx_tx_mcs9_max_nss,
-				      IEEE80211_EHT_MCS_NSS_RX) - 1;
+				      IEEE80211_EHT_MCS_NSS_RX);
+		nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
 
 		bf->nrow_gt_bw80 = min_t(u8, snd_dim, sts);
 		bf->ncol_gt_bw80 = nss_mcs;
@@ -2387,7 +2389,8 @@
 				   ve->phy_cap_info[3]) << 1);
 		sts = EHT_PHY(CAP1_BEAMFORMEE_SS_320MHZ_MASK, pe->phy_cap_info[1]);
 		nss_mcs = u8_get_bits(eht_nss->bw._320.rx_tx_mcs9_max_nss,
-				      IEEE80211_EHT_MCS_NSS_RX) - 1;
+				      IEEE80211_EHT_MCS_NSS_RX);
+		nss_mcs = nss_mcs ? nss_mcs - 1 : 0;
 
 		bf->nrow_gt_bw80 = min_t(u8, snd_dim, sts) << 4;
 		bf->ncol_gt_bw80 = nss_mcs << 4;
