From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Subject: [PATCH] wifi: mt76: count the NPU TX linearize instead of guessing

The NPU TX descriptor (struct airoha_npu_tx_dma_desc, airoha_offload.h)
carries one u32 address and one length field (NPU_TX_DMA_DESC_LEN_MASK,
GENMASK(30, 18), 13 bits).  It has no fragment list, no "last buffer" bit
and no chain pointer, unlike the RX descriptor, which has both
NPU_RX_DMA_DESC_LAST_MASK and NPU_RX_DMA_PKT_COUNT_MASK to describe a
frame spread over several descriptors.  The descriptor cannot gather, so
dma.c has to keep the frame contiguous before it reaches the NPU and a
nonlinear skb still needs skb_linearize().

The call itself is a no-op for an already linear skb, and mt7996 only
advertises NETIF_F_RXCSUM, so net/core/dev.c linearizes the skb before
ndo_start_xmit() and the NPU path never receives a frame that needs the
copy.  The previous opt-in npu_tx_sg knob could not show that: skipping
the call and calling the frame "passthrough" measures a branch, not a
copy, and the frame never reaches the copy branch either way.

Replace the knob with accounting that looks at the skb itself: linear
frames increment passthrough (no copy needed), nonlinear frames are
linearized and increment linearized, ENOMEM increments linearize_failed,
and a frame above the 13-bit descriptor length increments oversize.  The
behaviour is unchanged -- a linear skb never took the copy branch -- and
the read-only "npu-tx" debugfs file now answers the question the knob was
meant to answer: does the driver ever see a frame that needs the copy at
all.  Any future multi-buffer TX descriptor or firmware change has to
start from that answer.

Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/dma.c
+++ b/dma.c
@@ -8,6 +8,39 @@
 #include "dma.h"
 #include "mt76_connac.h"
 
+/* FIELD_MAX(NPU_TX_DMA_DESC_LEN_MASK) from airoha_offload.h: the NPU TX
+ * descriptor length field is 13 bits wide.
+ */
+#define NPU_TX_MAX_FRAME_LEN	0x1fff
+
+/* The NPU TX descriptor (struct airoha_npu_tx_dma_desc) carries one address
+ * plus one length field, so the NPU cannot gather fragments: a nonlinear skb
+ * still has to be copied into a single contiguous buffer.  A linear skb,
+ * which is what the stack hands over as long as the driver does not advertise
+ * NETIF_F_SG, needs no copy at all, so count the frames that actually needed
+ * one instead of calling skb_linearize() and calling it a linearize.
+ */
+static int mt76_npu_tx_prepare(struct mt76_dev *dev, struct sk_buff *skb)
+{
+	if (skb_is_nonlinear(skb)) {
+		if (skb_linearize(skb)) {
+			atomic64_inc(&dev->npu_tx.linearize_failed);
+			return -ENOMEM;
+		}
+		atomic64_inc(&dev->npu_tx.linearized);
+	} else {
+		atomic64_inc(&dev->npu_tx.passthrough);
+	}
+
+	/* FIELD_PREP() on the 13-bit descriptor length silently truncates a
+	 * longer frame, so count those too.
+	 */
+	if (skb->len > NPU_TX_MAX_FRAME_LEN)
+		atomic64_inc(&dev->npu_tx.oversize);
+
+	return 0;
+}
+
 static struct mt76_txwi_cache *
 mt76_alloc_txwi(struct mt76_dev *dev)
 {
@@ -685,8 +718,10 @@
 	if (test_bit(MT76_RESET, &phy->state))
 		goto free_skb;
 
-	/* TODO: Take into account unlinear skbs */
-	if (mt76_npu_device_active(dev) && skb_linearize(skb))
+	/* The NPU TX descriptor has a single address and a single length, so
+	 * the frame must be contiguous before it is handed to the NPU.
+	 */
+	if (mt76_npu_device_active(dev) && mt76_npu_tx_prepare(dev, skb))
 		goto free_skb;
 
 	t = mt76_get_txwi(dev);
--- a/debugfs.c
+++ b/debugfs.c
@@ -160,6 +160,22 @@
 DEFINE_DEBUGFS_ATTRIBUTE(fops_non_aql_limit, mt76_non_aql_limit_get,
 			 mt76_non_aql_limit_set, "%llu\n");
 
+static int mt76_npu_tx_read(struct seq_file *s, void *data)
+{
+	struct mt76_dev *dev = dev_get_drvdata(s->private);
+
+	seq_printf(s, "passthrough: %llu\n",
+		   (unsigned long long)atomic64_read(&dev->npu_tx.passthrough));
+	seq_printf(s, "linearized: %llu\n",
+		   (unsigned long long)atomic64_read(&dev->npu_tx.linearized));
+	seq_printf(s, "linearize_failed: %llu\n",
+		   (unsigned long long)atomic64_read(&dev->npu_tx.linearize_failed));
+	seq_printf(s, "oversize: %llu\n",
+		   (unsigned long long)atomic64_read(&dev->npu_tx.oversize));
+
+	return 0;
+}
+
 struct dentry *
 mt76_register_debugfs_fops(struct mt76_phy *phy,
 			   const struct file_operations *ops)
@@ -182,6 +198,8 @@
 				    mt76_rx_queues_read);
 	debugfs_create_devm_seqfile(dev->dev, "tx_burst", dir,
 				    mt76_tx_burst_read);
+	debugfs_create_devm_seqfile(dev->dev, "npu-tx", dir,
+				    mt76_npu_tx_read);
 	debugfs_create_file_unsafe("non_aql_limit", 0600, dir, dev,
 				   &fops_non_aql_limit);
 
--- a/mt76.h
+++ b/mt76.h
@@ -755,6 +755,17 @@
 	int npu_type;
 };
 
+/* NPU TX accounting, read by the mt76 "npu-tx" debugfs file. The NPU TX
+ * descriptor holds one address and one length, so it cannot gather
+ * fragments: a nonlinear skb always has to be linearized.
+ */
+struct mt76_npu_tx_stats {
+	atomic64_t passthrough;
+	atomic64_t linearized;
+	atomic64_t linearize_failed;
+	atomic64_t oversize;
+};
+
 struct mt76_rx_status {
 	union {
 		struct mt76_wcid *wcid;
@@ -1097,6 +1108,8 @@
 	};
 
 	atomic_t bus_hung;
+
+	struct mt76_npu_tx_stats npu_tx;
 };
 
 static inline unsigned int
@@ -1730,6 +1743,7 @@
 int mt76_testmode_set_state(struct mt76_phy *phy, enum mt76_testmode_state state);
 int mt76_testmode_alloc_skb(struct mt76_phy *phy, u32 len);
 
+
 #ifdef CONFIG_MT76_NPU
 void mt76_npu_check_ppe(struct mt76_dev *dev, struct sk_buff *skb,
 			u32 info);
