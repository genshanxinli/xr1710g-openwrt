From 00629ceff2a79d7f63639e33c877d60778ec48d5 Mon Sep 17 00:00:00 2001
From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Sun, 15 Nov 2026 08:45:24 +0800
Subject: [PATCH] wifi: mt76: mt7996: request multiple interrupt vectors

The MT7996 family can spread its WFDMA interrupt groups over several
MSI-X/MSI vectors, but the driver asks for a single vector, so every
queue is handled on one CPU.

Request up to eight vectors, program the number of vectors into
MT_WFDMA_HOST_CONFIG so the WFDMA maps its interrupt groups, and
register one handler per vector.  The MT7990 function on the AN7581
platform has no MSI-X capability but provides 32 MSI messages, so MSI
is requested as a fallback and a multi-vector setup is still possible
there.

Every vector schedules the existing shared interrupt tasklet, so the
interrupt work is entered from the vector that fired.  Binding
individual queue groups to vectors needs the per-chip WFDMA MSI mapping
and is left as a follow-up.

If neither MSI-X nor MSI is available, fall back to the previous
single-vector setup, which keeps the current behaviour.  The hif2
function keeps its single-vector path.  The allocated vector count and
the per-vector IRQ numbers are exposed through debugfs for A/B
testing.

Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
 mt7996/debugfs.c | 15 +++++++++
 mt7996/mt7996.h  |  8 +++++
 mt7996/pci.c     | 83 ++++++++++++++++++++++++++++++++++++++++++------
 mt7996/regs.h    |  1 +
 4 files changed, 98 insertions(+), 9 deletions(-)

diff --git a/mt7996/debugfs.c b/mt7996/debugfs.c
--- a/mt7996/debugfs.c
+++ b/mt7996/debugfs.c
@@ -5,6 +5,7 @@
 
 #include <linux/ktime.h>
 #include <linux/relay.h>
+#include <linux/seq_file.h>
 #include "mt7996.h"
 #include "../dma.h"
 #include "eeprom.h"
@@ -1452,6 +1453,19 @@
 
 DEFINE_SHOW_ATTRIBUTE(mt7996_npu_band1_tx);
 
+static int mt7996_msix_show(struct seq_file *s, void *data)
+{
+	struct mt7996_dev *dev = s->private;
+	int i;
+
+	seq_printf(s, "msix_vectors: %u\n", dev->msi.vectors);
+	for (i = 0; i < dev->msi.vectors; i++)
+		seq_printf(s, "vec%u irq: %d\n", i, dev->msi.irq[i]);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7996_msix);
+
 int mt7996_init_debugfs(struct mt7996_dev *dev)
 {
 	struct dentry *dir;
@@ -1466,6 +1480,7 @@
 	debugfs_create_file("npu_band1_tx", 0400, dir, dev,
 			    &mt7996_npu_band1_tx_fops);
 	debugfs_create_file("aql", 0400, dir, dev, &mt7996_aql_fops);
+	debugfs_create_file("msix", 0400, dir, dev, &mt7996_msix_fops);
 	debugfs_create_file("sys_recovery", 0600, dir, dev,
 			    &mt7996_sys_recovery_ops);
 	debugfs_create_file("fw_debug_wm", 0600, dir, dev, &fops_fw_debug_wm);
diff --git a/mt7996/mt7996.h b/mt7996/mt7996.h
index 69dff43c..553a4e4f 100644
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -466,6 +466,13 @@ struct mt7996_phy {
 	bool rdd_tx_paused;
 };
 
+#define MT7996_MAX_MSI_VECTORS	8
+
+struct mt7996_msi {
+	u8 vectors;
+	int irq[MT7996_MAX_MSI_VECTORS];
+};
+
 struct mt7996_dev {
 	union { /* must be first */
 		struct mt76_dev mt76;
@@ -478,6 +485,7 @@ struct mt7996_dev {
 	struct mac_address radio_addrs[MT7996_MAX_RADIOS];
 
 	struct mt7996_hif *hif2;
+	struct mt7996_msi msi;
 	struct mt7996_reg_desc reg;
 	u8 q_id[MT7996_MAX_QUEUE];
 	u32 q_int_mask[MT7996_MAX_QUEUE];
diff --git a/mt7996/pci.c b/mt7996/pci.c
index a7c23b33..643dd4b8 100644
--- a/mt7996/pci.c
+++ b/mt7996/pci.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/kernel.h>
+#include <linux/log2.h>
 #include <linux/module.h>
 #include <linux/pci.h>
 
@@ -102,6 +103,66 @@ static int mt7996_pci_hif2_probe(struct pci_dev *pdev)
 	return 0;
 }
 
+static int mt7996_pci_alloc_irqs(struct pci_dev *pdev,
+				 struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int i, n, ret;
+
+	/* Try MSI-X first; pci_alloc_irq_vectors() falls back to MSI on its
+	 * own when the device has no MSI-X capability.  The single-vector
+	 * allocation below keeps the previous behaviour when neither is
+	 * available.
+	 */
+	ret = pci_alloc_irq_vectors(pdev, 1, MT7996_MAX_MSI_VECTORS,
+				    PCI_IRQ_MSIX | PCI_IRQ_MSI);
+	if (ret < 0) {
+		ret = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_ALL_TYPES);
+		if (ret < 0)
+			return ret;
+	}
+
+	/* The WFDMA maps its interrupt groups using the log2 of the vector
+	 * count, so only a power-of-two number of vectors can be used.
+	 */
+	n = rounddown_pow_of_two(ret);
+	dev->msi.vectors = n;
+	for (i = 0; i < n; i++)
+		dev->msi.irq[i] = pci_irq_vector(pdev, i);
+
+	if (n == 1)
+		return 1;
+
+	mt76_rmw_field(dev, MT_WFDMA_HOST_CONFIG,
+		       MT_WFDMA_HOST_CONFIG_PCIE0_MSI_NUM, ilog2(n));
+
+	for (i = 0; i < n; i++) {
+		ret = devm_request_irq(mdev->dev, dev->msi.irq[i],
+				       mt7996_irq_handler, 0, KBUILD_MODNAME,
+				       dev);
+		if (ret)
+			goto free_irqs;
+	}
+
+	dev_info(mdev->dev, "using %d IRQ vectors\n", n);
+
+	return 0;
+
+free_irqs:
+	while (i--)
+		devm_free_irq(mdev->dev, dev->msi.irq[i], dev);
+
+	return ret;
+}
+
+static void mt7996_pci_free_irqs(struct mt7996_dev *dev)
+{
+	int i;
+
+	for (i = 0; i < dev->msi.vectors; i++)
+		devm_free_irq(dev->mt76.dev, dev->msi.irq[i], dev);
+}
+
 static int mt7996_pci_probe(struct pci_dev *pdev,
 			    const struct pci_device_id *id)
 {
@@ -154,17 +215,19 @@ static int mt7996_pci_probe(struct pci_dev *pdev,
 		goto free_wed_or_irq_vector;
 
 	if (!ret) {
-		ret = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_ALL_TYPES);
+		ret = mt7996_pci_alloc_irqs(pdev, dev);
 		if (ret < 0)
-			goto free_device;
+			goto free_wed_or_irq_vector;
 
-		irq = pdev->irq;
+		irq = dev->msi.irq[0];
 	}
 
-	ret = devm_request_irq(mdev->dev, irq, mt7996_irq_handler,
-			       IRQF_SHARED, KBUILD_MODNAME, dev);
-	if (ret)
-		goto free_wed_or_irq_vector;
+	if (dev->msi.vectors <= 1) {
+		ret = devm_request_irq(mdev->dev, irq, mt7996_irq_handler,
+				       IRQF_SHARED, KBUILD_MODNAME, dev);
+		if (ret)
+			goto free_wed_or_irq_vector;
+	}
 
 	mt76_wr(dev, MT_INT_MASK_CSR, 0);
 	/* master switch of PCIe interrupt enable */
@@ -217,13 +280,15 @@ free_hif2_wed_irq_vector:
 free_hif2:
 	if (dev->hif2)
 		put_device(dev->hif2->dev);
-	devm_free_irq(mdev->dev, irq, dev);
+	if (dev->msi.vectors <= 1)
+		devm_free_irq(mdev->dev, irq, dev);
+	else
+		mt7996_pci_free_irqs(dev);
 free_wed_or_irq_vector:
 	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
 		mtk_wed_device_detach(&dev->mt76.mmio.wed);
 	else
 		pci_free_irq_vectors(pdev);
-free_device:
 	mt76_free_device(&dev->mt76);
 
 	return ret;
diff --git a/mt7996/regs.h b/mt7996/regs.h
index 6df6e4c3..ae77c8a4 100644
--- a/mt7996/regs.h
+++ b/mt7996/regs.h
@@ -508,6 +508,7 @@ enum offs_rev {
 
 #define MT_WFDMA_HOST_CONFIG			MT_WFDMA_EXT_CSR(0x30)
 #define MT_WFDMA_HOST_CONFIG_PDMA_BAND		BIT(0)
+#define MT_WFDMA_HOST_CONFIG_PCIE0_MSI_NUM	GENMASK(3, 2)
 #define MT_WFDMA_HOST_CONFIG_BAND0_PCIE1	BIT(20)
 #define MT_WFDMA_HOST_CONFIG_BAND1_PCIE1	BIT(21)
 #define MT_WFDMA_HOST_CONFIG_BAND2_PCIE1	BIT(22)
-- 
2.56.0

