From: Yanghan Ye <yyh94306@gmail.com>
Date: Wed, 24 Jun 2026 20:19:12 +0800
Subject: [PATCH] wifi: mt76: mt7996: refresh power limits on txpower changes

Refresh firmware SKU and channel power info when mac80211 reports txpower or
channel updates. Always cache phy->txpower, but gate MCU calls on
MT76_STATE_RUNNING and a non-NULL chandef.chan so disabled/unstarted bands
neither dereference NULL nor emit spurious MCU commands.

Origin: backport, archive/xr1710g-v1
Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -915,9 +915,60 @@ static int mt7996_set_key(struct ieee802
 	return err;
 }
 
+static int mt7996_config_txpower(struct mt7996_phy *phy, int power_level,
+				 u32 changed)
+{
+	int ret;
+
+	if (changed & IEEE80211_CONF_CHANGE_POWER)
+		phy->txpower = power_level;
+
+	if (!test_bit(MT76_STATE_RUNNING, &phy->mt76->state) ||
+	    !phy->mt76->chandef.chan)
+		return 0;
+
+	ret = mt7996_mcu_set_txpower_sku(phy);
+	if (!ret && (changed & IEEE80211_CONF_CHANGE_POWER))
+		ret = mt7996_mcu_set_chan_info(phy, UNI_CHANNEL_SWITCH);
+
+	return ret;
+}
+
 static int mt7996_config(struct ieee80211_hw *hw, int radio_idx, u32 changed)
 {
-	return 0;
+	struct mt7996_dev *dev = mt7996_hw_dev(hw);
+	struct mt7996_phy *phy;
+	int ret = 0;
+
+	if (!(changed & (IEEE80211_CONF_CHANGE_POWER |
+			 IEEE80211_CONF_CHANGE_CHANNEL)))
+		return 0;
+
+	mutex_lock(&dev->mt76.mutex);
+
+	if (radio_idx >= 0) {
+		if (radio_idx >= ARRAY_SIZE(dev->radio_phy)) {
+			ret = -EINVAL;
+			goto out;
+		}
+
+		phy = dev->radio_phy[radio_idx];
+		if (phy)
+			ret = mt7996_config_txpower(phy, hw->conf.power_level,
+						    changed);
+	} else {
+		mt7996_for_each_phy(dev, phy) {
+			ret = mt7996_config_txpower(phy, hw->conf.power_level,
+						    changed);
+			if (ret)
+				break;
+		}
+	}
+
+out:
+	mutex_unlock(&dev->mt76.mutex);
+
+	return ret;
 }
 
 static int
@@ -1239,9 +1290,28 @@ mt7996_link_info_changed(struct ieee8021
 		mt7996_update_mu_group(hw, link, info);
 
 	if (changed & BSS_CHANGED_TXPOWER &&
+	    info->txpower != INT_MIN &&
 	    info->txpower != phy->txpower) {
 		phy->txpower = info->txpower;
-		mt7996_mcu_set_txpower_sku(phy);
+
+		if (test_bit(MT76_STATE_RUNNING, &phy->mt76->state) &&
+		    phy->mt76->chandef.chan) {
+			int ret;
+
+			ret = mt7996_mcu_set_txpower_sku(phy);
+			if (ret) {
+				dev_err_ratelimited(dev->mt76.dev,
+						    "failed to update txpower SKU: %d\n",
+						    ret);
+				goto out;
+			}
+
+			ret = mt7996_mcu_set_chan_info(phy, UNI_CHANNEL_SWITCH);
+			if (ret)
+				dev_err_ratelimited(dev->mt76.dev,
+						    "failed to update txpower channel info: %d\n",
+						    ret);
+		}
 	}
 
 out:
