-void __mt76_set_tx_blocked(struct mt76_dev *dev, bool blocked)
+#define MT76_TOKEN_QUOTA_IDLE_MS	500
+
+/*
+ * A band competes for the shared token pool while it has tokens in flight, or
+ * shortly after it queued or scheduled a frame. The idle window lets a band
+ * that is alone use the whole pool shortly after the other bands go quiet.
+ */
+static bool mt76_token_band_active(struct mt76_dev *dev, int band)
 {
-	struct mt76_phy *phy = &dev->phy;
-	struct mt76_queue *q = phy->q_tx[0];
+	unsigned long active = READ_ONCE(dev->token_band_active[band]);
 
-	if (blocked == q->blocked)
-		return;
+	if (READ_ONCE(dev->token_band_used[band]))
+		return true;
 
-	q->blocked = blocked;
+	return time_before(jiffies, active +
+			   msecs_to_jiffies(MT76_TOKEN_QUOTA_IDLE_MS));
+}
 
-	phy = dev->phys[MT_BAND1];
-	if (phy) {
-		q = phy->q_tx[0];
-		q->blocked = blocked;
+/*
+ * Returns the number of pool entries a band may occupy. The reservations of
+ * the other active bands are subtracted from the shared pool first, so they
+ * cannot be consumed by a burst on this band.
+ */
+static u32 mt76_token_band_limit(struct mt76_dev *dev, int band)
+{
+	u32 limit = dev->token_size;
+	u32 total = 0;
+	int i;
+
+	for (i = 0; i < __MT_MAX_BAND; i++)
+		total += READ_ONCE(dev->token_reserved[i]);
+
+	/*
+	 * WED can shrink the pool below a reservation set for the full pool.
+	 * Ignore the quota instead of blocking every band until it is reset.
+	 */
+	if (total >= dev->token_size)
+		return dev->token_size;
+
+	for (i = 0; i < __MT_MAX_BAND; i++) {
+		u32 reserved = READ_ONCE(dev->token_reserved[i]);
+
+		if (i == band || !reserved)
+			continue;
+		if (!mt76_token_band_active(dev, i))
+			continue;
+		if (reserved >= limit) {
+			limit = 0;
+			break;
+		}
+		limit -= reserved;
 	}
-	phy = dev->phys[MT_BAND2];
-	if (phy) {
+
+	/*
+	 * A limit within the free headroom cannot be enforced: a band blocked
+	 * there would stay blocked after the other bands go idle, because a
+	 * blocked band cannot consume the token that would trigger the next
+	 * re-evaluation. Keep the shared pool for that band instead; the
+	 * reservation is only a guarantee, not a cap.
+	 */
+	if (limit <= MT76_TOKEN_FREE_THR)
+		limit = dev->token_size;
+
+	return limit;
+}
+
+static bool mt76_token_band_blocked(struct mt76_dev *dev, int band)
+{
+	u32 limit = dev->token_size;
+
+	if (READ_ONCE(dev->token_quota))
+		limit = mt76_token_band_limit(dev, band);
+
+	return limit <= MT76_TOKEN_FREE_THR ||
+	       dev->token_count >= limit - MT76_TOKEN_FREE_THR;
+}
+
+/*
+ * Re-evaluates the blocked state of one band and returns true if it just
+ * became unblocked. The caller must hold @dev->token_lock.
+ */
+static bool mt76_token_band_update(struct mt76_dev *dev, int band)
+{
+	bool blocked;
+
+	if (band < 0 || band >= __MT_MAX_BAND || !dev->phys[band])
+		return false;
+
+	blocked = mt76_token_band_blocked(dev, band);
+	if (READ_ONCE(dev->token_band_stopped[band]) == blocked)
+		return false;
+
+	WRITE_ONCE(dev->token_band_stopped[band], blocked);
+	if (blocked) {
+		dev->token_band_blocked[band]++;
+		return false;
+	}
+
+	return true;
+}
+
+static bool mt76_token_quota_refresh(struct mt76_dev *dev)
+{
+	bool wake = false;
+	int i;
+
+	for (i = 0; i < __MT_MAX_BAND; i++)
+		wake |= mt76_token_band_update(dev, i);
+
+	return wake;
+}
+
+int mt76_token_set_reserved(struct mt76_dev *dev, unsigned int band,
+			    unsigned int reserved)
+{
+	u32 old_total, total = 0;
+	bool wake;
+	int i;
+
+	if (band >= __MT_MAX_BAND)
+		return -EINVAL;
+
+	spin_lock_bh(&dev->token_lock);
+
+	if (reserved > dev->token_size)
+		goto out;
+
+	for (i = 0; i < __MT_MAX_BAND; i++) {
+		u32 val = i == band ? reserved :
+			  READ_ONCE(dev->token_reserved[i]);
+
+		if (val > dev->token_size || total > dev->token_size - val)
+			goto out;
+		total += val;
+	}
+
+	old_total = total - reserved + READ_ONCE(dev->token_reserved[band]);
+
+	/*
+	 * An increase has to leave two free thresholds in the pool, so that
+	 * every band keeps a limit above MT76_TOKEN_FREE_THR and the blocked
+	 * state can always be left again. A decrease or clearing is always
+	 * accepted so a reservation can be backed out after WED shrank the
+	 * pool or after an over-commit was configured.
+	 */
+	if (dev->token_size <= 2 * MT76_TOKEN_FREE_THR ||
+	    (total > dev->token_size - 2 * MT76_TOKEN_FREE_THR &&
+	     total > old_total))
+		goto out;
+
+	WRITE_ONCE(dev->token_reserved[band], reserved);
+	WRITE_ONCE(dev->token_quota, total != 0);
+
+	wake = mt76_token_quota_refresh(dev);
+
+	spin_unlock_bh(&dev->token_lock);
+
+	if (wake)
+		mt76_worker_schedule(&dev->tx_worker);
+
+	return 0;
+
+out:
+	spin_unlock_bh(&dev->token_lock);
+
+	return -EINVAL;
+}
+EXPORT_SYMBOL_GPL(mt76_token_set_reserved);
+
+void __mt76_set_tx_blocked(struct mt76_dev *dev, bool blocked)
+{
+	struct mt76_phy *phy;
+	struct mt76_queue *q;
+	int i;
+
+	/*
+	 * Without a reservation the pool has no per-band split: keep the
+	 * original global code path untouched.
+	 */
+	if (!READ_ONCE(dev->token_quota)) {
+		phy = &dev->phy;
 		q = phy->q_tx[0];
+
+		if (blocked == q->blocked)
+			return;
+
 		q->blocked = blocked;
+
+		phy = dev->phys[MT_BAND1];
+		if (phy) {
+			q = phy->q_tx[0];
+			q->blocked = blocked;
+		}
+		phy = dev->phys[MT_BAND2];
+		if (phy) {
+			q = phy->q_tx[0];
+			q->blocked = blocked;
+		}
+
+		if (!blocked)
+			mt76_worker_schedule(&dev->tx_worker);
+
+		return;
 	}
 
-	if (!blocked)
-		mt76_worker_schedule(&dev->tx_worker);
+	if (blocked) {
+		for (i = 0; i < __MT_MAX_BAND; i++) {
+			if (!dev->phys[i] ||
+			    READ_ONCE(dev->token_band_stopped[i]))
+				continue;
+
+			WRITE_ONCE(dev->token_band_stopped[i], true);
+			dev->token_band_blocked[i]++;
+		}
+
+		return;
+	}
+
+	/*
+	 * mt76_token_release() may already have cleared the blocked flag of
+	 * the band that made progress, so the refresh below can find nothing
+	 * to change. The worker still has to run to drain the queues that
+	 * were waiting on it.
+	 */
+	mt76_token_quota_refresh(dev);
+	mt76_worker_schedule(&dev->tx_worker);
 }
 EXPORT_SYMBOL_GPL(__mt76_set_tx_blocked);
 
 int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi)
 {
 	int token;
+	int band = (*ptxwi)->phy_idx;
+
+	if (band >= __MT_MAX_BAND)
+		band = MT_BAND0;
 
 	spin_lock_bh(&dev->token_lock);
 
@@ -978,6 +1205,7 @@
 			  GFP_ATOMIC);
 	if (token >= dev->token_start) {
 		dev->token_count++;
+		dev->token_band_used[band]++;
 
 		if ((*ptxwi)->qid == MT_TXQ_PSD) {
 			struct mt76_phy *mphy = mt76_dev_phy(dev, (*ptxwi)->phy_idx);
@@ -991,7 +1219,9 @@
 		dev->wed_token_count++;
 #endif
 
-	if (dev->token_count >= dev->token_size - MT76_TOKEN_FREE_THR)
+	if (READ_ONCE(dev->token_quota))
+		mt76_token_band_update(dev, band);
+	else if (dev->token_count >= dev->token_size - MT76_TOKEN_FREE_THR)
 		__mt76_set_tx_blocked(dev, true);
 
 	spin_unlock_bh(&dev->token_lock);
@@ -1022,12 +1252,20 @@
 mt76_token_release(struct mt76_dev *dev, int token, bool *wake)
 {
 	struct mt76_txwi_cache *txwi;
+	bool unblocked = false;
 
 	spin_lock_bh(&dev->token_lock);
 
 	txwi = idr_remove(&dev->token, token);
 	if (txwi) {
+		int band = txwi->phy_idx;
+
+		if (band >= __MT_MAX_BAND)
+			band = MT_BAND0;
+
 		dev->token_count--;
+		if (dev->token_band_used[band])
+			dev->token_band_used[band]--;
 
 		if (txwi->qid == MT_TXQ_PSD) {
 			struct mt76_phy *mphy = mt76_dev_phy(dev, txwi->phy_idx);
@@ -1043,12 +1281,26 @@
 #endif
 	}
 
-	if (wake && dev->token_count < dev->token_size - MT76_TOKEN_FREE_THR &&
-	    dev->phy.q_tx[0]->blocked)
+	if (READ_ONCE(dev->token_quota)) {
+		/*
+		 * Called with a NULL wake pointer, e.g. when a failed TX
+		 * preparation returns a token, the caller will not issue the
+		 * unblock request; schedule the worker here instead.
+		 */
+		unblocked = mt76_token_quota_refresh(dev);
+		if (unblocked && wake)
+			*wake = true;
+	} else if (wake && dev->token_count <
+		   dev->token_size - MT76_TOKEN_FREE_THR &&
+		   dev->phy.q_tx[0]->blocked) {
 		*wake = true;
+	}
 
 	spin_unlock_bh(&dev->token_lock);
 
+	if (unblocked && !wake)
+		mt76_worker_schedule(&dev->tx_worker);
+
 	return txwi;
 }
 EXPORT_SYMBOL_GPL(mt76_token_release);
