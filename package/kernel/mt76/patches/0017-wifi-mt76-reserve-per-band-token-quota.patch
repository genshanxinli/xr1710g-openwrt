 	u16 token_start;
 	u16 token_size;
 
+	/*
+	 * Per-band token quota. @token_reserved holds the number of pool
+	 * entries that a band may reclaim from the other bands while it is
+	 * active; everything is shared when it is zero. @token_band_used
+	 * tracks in-flight tokens per band, @token_band_stopped is the block
+	 * state the TX scheduler consults for a band, @token_band_blocked
+	 * counts the transitions into the blocked state and @token_band_active
+	 * keeps the last time a band scheduled or queued a frame.
+	 */
+	u16 token_reserved[__MT_MAX_BAND];
+	u16 token_band_used[__MT_MAX_BAND];
+	bool token_band_stopped[__MT_MAX_BAND];
+	u32 token_band_blocked[__MT_MAX_BAND];
+	unsigned long token_band_active[__MT_MAX_BAND];
+	bool token_quota;
+
 	spinlock_t rx_token_lock;
 	struct idr rx_token;
 	u16 rx_token_size;
