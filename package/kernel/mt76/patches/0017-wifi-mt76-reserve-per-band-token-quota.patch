+++ b/tx.c
@@ -613,6 +613,10 @@ mt76_txq_schedule_list(struct mt76_phy *phy, enum mt76_txq_id qid)
 		if (test_bit(MT76_RESET, &phy->state) || phy->offchannel)
 			continue;
 
+		if (READ_ONCE(dev->token_quota))
+			WRITE_ONCE(dev->token_band_active[phy->band_idx],
+				   jiffies);
+
 		q = phy->q_tx[qid];
 
 		if (test_bit(MT_WCID_FLAG_PS, &wcid->flags)) {
@@ -883,6 +887,9 @@ void mt76_wake_tx_queue(struct ieee80211_hw *hw, struct ieee80211_txq *txq)
 	struct mt76_phy *phy = hw->priv;
 	struct mt76_dev *dev = phy->dev;
 
