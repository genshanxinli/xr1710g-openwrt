+static ssize_t
+mt7996_token_quota_read(struct file *file, char __user *user_buf,
+			size_t count, loff_t *ppos)
+{
+	struct mt7996_dev *dev = file->private_data;
+	struct mt76_dev *mdev = &dev->mt76;
+	u16 used[__MT_MAX_BAND], reserved[__MT_MAX_BAND];
+	bool stopped[__MT_MAX_BAND];
+	u32 blocked[__MT_MAX_BAND];
+	bool quota, shared;
+	u16 tokens, size;
+	char buf[512];
+	int i, len = 0;
+
+	spin_lock_bh(&mdev->token_lock);
+	for (i = 0; i < __MT_MAX_BAND; i++) {
+		used[i] = mdev->token_band_used[i];
+		reserved[i] = mdev->token_reserved[i];
+		stopped[i] = mdev->token_band_stopped[i];
+		blocked[i] = mdev->token_band_blocked[i];
+	}
+	tokens = mdev->token_count;
+	size = mdev->token_size;
+	quota = mdev->token_quota;
+	spin_unlock_bh(&mdev->token_lock);
+
+	/*
+	 * With the NPU active, mt7996_register_phy() aliases the band2 queues
+	 * to the band1 q_tx[0], so the two bands feed one DMA ring. The quota
+	 * still blocks them separately, but a ring that fills up stops both.
+	 */
+	shared = mdev->phys[MT_BAND1] && mdev->phys[MT_BAND2] &&
+		 mdev->phys[MT_BAND1]->q_tx[0] == mdev->phys[MT_BAND2]->q_tx[0];
+
+	len += scnprintf(buf + len, sizeof(buf) - len,
+			 " band |   used | reserved | blocked | state\n");
+	for (i = 0; i < __MT_MAX_BAND; i++)
+		len += scnprintf(buf + len, sizeof(buf) - len,
+				 " %4d | %6u | %8u | %7u | %s\n",
+				 i, used[i], reserved[i], blocked[i],
+				 stopped[i] ? "stop" : "run");
+	len += scnprintf(buf + len, sizeof(buf) - len,
+			 "\n pool: %u of %u in flight, quota %s\n",
+			 tokens, size, quota ? "on" : "off");
+	if (shared)
+		len += scnprintf(buf + len, sizeof(buf) - len,
+				 " txq: band1 and band2 share one TX ring, so a full ring stops both;\n"
+				 "      only the token block is tracked (and cleared) per band\n");
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+/*
+ * Set the per-band token reservation: echo "<band> <tokens>" > token_quota.
+ * The sum of the reservations must leave MT76_TOKEN_FREE_THR entries free.
+ */
+static ssize_t
+mt7996_token_quota_write(struct file *file, const char __user *user_buf,
+			 size_t count, loff_t *ppos)
+{
+	struct mt7996_dev *dev = file->private_data;
+	unsigned int band, reserved;
+	char buf[32];
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+
+	buf[count] = '\0';
+	if (sscanf(buf, "%u %u", &band, &reserved) != 2)
+		return -EINVAL;
+
+	if (mt76_token_set_reserved(&dev->mt76, band, reserved))
+		return -EINVAL;
+
+	return count;
+}
+
+static const struct file_operations mt7996_token_quota_ops = {
+	.write = mt7996_token_quota_write,
+	.read = mt7996_token_quota_read,
+	.open = simple_open,
+	.llseek = default_llseek,
+};
