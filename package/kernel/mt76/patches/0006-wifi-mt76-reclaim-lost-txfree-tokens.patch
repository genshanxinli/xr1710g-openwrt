From: fanboy <fanboy@openwrt.org>
Date: Wed, 19 Aug 2026 15:54:54 +0000
Subject: [PATCH] wifi: mt76: reclaim tokens whose txfree completion was lost

Reclaim timed-out non-pktid tokens from mt7996_mac_work() on the primary
running PHY under local_bh_disable() so lost NO_ACK txfree events do not
leak AQL airtime or deadlock dev->lock. Bail out on reset and track atomic
txq_gen/txwi_gen across DMA/NPU enqueue and reap to prevent UAF/ABA races.

Origin: backport, archive/xr1710g-v1
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/mt76.h
+++ b/mt76.h
@@ -228,6 +228,7 @@ struct mt76_queue_entry {
 	dma_addr_t dma_addr[2];
 	u16 dma_len[2];
 	u16 wcid;
+	u32 txwi_gen;
 	bool skip_buf0:1;
 	bool skip_buf1:1;
 	bool done:1;
@@ -469,6 +470,7 @@ struct mt76_txwi_cache {
 
 	u8 qid;
 	u8 phy_idx;
+	atomic_t txq_gen;
 };
 
 struct mt76_rx_tid {
@@ -1009,6 +1011,7 @@ struct mt76_dev {
 
 	spinlock_t token_lock;
 	struct idr token;
+	atomic_t txwi_seq;
 	u16 wed_token_count;
 	u16 token_count;
 	u16 token_start;
@@ -2161,6 +2164,8 @@ static inline bool mt76_queue_is_npu_txf
 
 struct mt76_txwi_cache *
 mt76_token_release(struct mt76_dev *dev, int token, bool *wake);
+bool mt76_tx_token_reclaim(struct mt76_dev *dev, struct list_head *list,
+			   unsigned long timeout);
 int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi);
 void __mt76_set_tx_blocked(struct mt76_dev *dev, bool blocked);
 struct mt76_txwi_cache *mt76_rx_token_release(struct mt76_dev *dev, int token);
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2995,14 +2995,67 @@ static bool mt7996_is_primary_running_ph
 	return phy == &dev->phy;
 }
 
+static void
+mt7996_mac_token_check(struct mt7996_dev *dev)
+{
+	struct mt76_txwi_cache *t, *tmp;
+	LIST_HEAD(txwi_list);
+	LIST_HEAD(free_list);
+	struct sk_buff *skb, *skb_tmp;
+	struct mt76_phy *p;
+	bool wake;
+	int i;
+
+	if (test_bit(MT76_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_MCU_RESET, &dev->mphy.state))
+		return;
+
+	/* Reap completed DMA descriptors before freeing tokens to avoid double-freeing txwi. */
+	mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[MT_TXQ_PSD], false);
+	mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[MT_TXQ_BE], false);
+	for (i = MT_BAND1; i <= MT_BAND2; i++) {
+		p = dev->mt76.phys[i];
+		if (!p)
+			continue;
+
+		mt76_queue_tx_cleanup(dev, p->q_tx[MT_TXQ_PSD], false);
+		mt76_queue_tx_cleanup(dev, p->q_tx[MT_TXQ_BE], false);
+	}
+
+	wake = mt76_tx_token_reclaim(&dev->mt76, &txwi_list,
+				     MT7996_TOKEN_SKB_TIMEOUT);
+	if (list_empty(&txwi_list))
+		return;
+
+	local_bh_disable();
+	list_for_each_entry_safe(t, tmp, &txwi_list, list) {
+		list_del_init(&t->list);
+		mt7996_txwi_free(dev, t, NULL, NULL, &free_list);
+	}
+	local_bh_enable();
+
+	if (wake)
+		mt76_set_tx_blocked(&dev->mt76, false);
+
+	mt76_worker_schedule(&dev->mt76.tx_worker);
+
+	list_for_each_entry_safe(skb, skb_tmp, &free_list, list) {
+		skb_list_del_init(skb);
+		consume_skb(skb);
+	}
+}
+
 void mt7996_mac_work(struct work_struct *work)
 {
+	struct mt7996_dev *dev;
 	struct mt7996_phy *phy;
 	struct mt76_phy *mphy;
+	bool run_token_check;
 
 	mphy = (struct mt76_phy *)container_of(work, struct mt76_phy,
 					       mac_work.work);
 	phy = mphy->priv;
+	dev = phy->dev;
 
 	mutex_lock(&mphy->dev->mutex);
 
@@ -3023,10 +3076,15 @@ void mt7996_mac_work(struct work_struct
 		}
 	}
 
+	run_token_check = mt7996_is_primary_running_phy(phy) &&
+			  !(dev->token_check_count++ % 10);
+
 	mutex_unlock(&mphy->dev->mutex);
 
 	mt76_beacon_mon_check(mphy);
 	mt76_tx_status_check(mphy->dev, false);
+	if (run_token_check)
+		mt7996_mac_token_check(dev);
 
 	ieee80211_queue_delayed_work(mphy->hw, &mphy->mac_work,
 				     MT7996_WATCHDOG_TIME);
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -20,6 +20,7 @@
 					 mt7996_max_interface_num(dev))
 
 #define MT7996_WATCHDOG_TIME		(HZ / 10)
+#define MT7996_TOKEN_SKB_TIMEOUT	(5 * HZ)
 #define MT7996_RESET_TIMEOUT		(30 * HZ)
 #define MT7996_TSF_READ_TRIES		3
 #define MT7996_TSF_READ_SPAN_US		1000
@@ -507,6 +508,7 @@ struct mt7996_dev {
 	u16 chainmask;
 	u8 chainshift[__MT_MAX_BAND];
 	u32 hif_idx;
+	u8 token_check_count;
 
 	struct work_struct init_work;
 	struct work_struct rc_work;
--- a/tx.c
+++ b/tx.c
@@ -129,6 +129,8 @@ mt76_tx_status_skb_add(struct mt76_dev *
 
 	memset(cb, 0, sizeof(*cb));
 
+	cb->jiffies = jiffies;
+
 	if (!wcid)
 		return MT_PACKET_ID_NO_ACK;
 
@@ -1107,6 +1109,59 @@ mt76_token_release(struct mt76_dev *dev,
 }
 EXPORT_SYMBOL_GPL(mt76_token_release);
 
+bool mt76_tx_token_reclaim(struct mt76_dev *dev, struct list_head *list,
+			   unsigned long timeout)
+{
+	struct mt76_txwi_cache *t;
+	bool wake = false;
+	int id;
+
+	spin_lock_bh(&dev->token_lock);
+
+	idr_for_each_entry(&dev->token, t, id) {
+		struct sk_buff *skb = t->skb;
+		struct mt76_tx_cb *cb;
+
+		if (!skb || atomic_read_acquire(&t->txq_gen))
+			continue;
+
+		cb = mt76_tx_skb_cb(skb);
+		if (cb->pktid >= MT_PACKET_ID_FIRST)
+			continue;
+
+		if (!cb->jiffies ||
+		    time_is_after_jiffies(cb->jiffies + timeout))
+			continue;
+
+		idr_remove(&dev->token, id);
+		dev->token_count--;
+
+		if (t->qid == MT_TXQ_PSD) {
+			struct mt76_phy *mphy = mt76_dev_phy(dev, t->phy_idx);
+			if (atomic_dec_and_test(&mphy->mgmt_tx_pending))
+				wake_up(&dev->tx_wait);
+		}
+
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+		if (mtk_wed_device_active(&dev->mmio.wed) &&
+		    id >= dev->mmio.wed.wlan.token_start &&
+		    --dev->wed_token_count == 0)
+			wake_up(&dev->tx_wait);
+#endif
+
+		list_add_tail(&t->list, list);
+	}
+
+	if (dev->token_count < dev->token_size - MT76_TOKEN_FREE_THR &&
+	    dev->phy.q_tx[0]->blocked)
+		wake = true;
+
+	spin_unlock_bh(&dev->token_lock);
+
+	return wake;
+}
+EXPORT_SYMBOL_GPL(mt76_tx_token_reclaim);
+
 struct mt76_txwi_cache *
 mt76_rx_token_release(struct mt76_dev *dev, int token)
 {
--- a/dma.c
+++ b/dma.c
@@ -108,6 +108,7 @@ mt76_put_txwi(struct mt76_dev *dev, stru
 	if (!t)
 		return;
 
+	atomic_set(&t->txq_gen, 0);
 	spin_lock(&dev->lock);
 	list_add(&t->list, &dev->txwi_cache);
 	spin_unlock(&dev->lock);
@@ -322,7 +323,7 @@ done:
 static int
 mt76_dma_add_buf(struct mt76_dev *dev, struct mt76_queue *q,
 		 struct mt76_queue_buf *buf, int nbufs, u32 info,
-		 struct sk_buff *skb, void *txwi)
+		 struct sk_buff *skb, struct mt76_txwi_cache *txwi)
 {
 	struct mt76_queue_entry *entry;
 	struct mt76_desc *desc;
@@ -382,6 +383,7 @@ mt76_dma_add_buf(struct mt76_dev *dev, s
 	}
 
 	q->entry[idx].txwi = txwi;
+	q->entry[idx].txwi_gen = txwi ? atomic_read(&txwi->txq_gen) : 0;
 	q->entry[idx].skb = skb;
 	q->entry[idx].wcid = 0xffff;
 
@@ -440,6 +442,9 @@ mt76_dma_tx_cleanup(struct mt76_dev *dev
 		mt76_queue_tx_complete(dev, q, &entry);
 
 		if (entry.txwi) {
+			if (entry.txwi_gen)
+				atomic_cmpxchg(&entry.txwi->txq_gen,
+					       entry.txwi_gen, 0);
 			if (!(dev->drv->drv_flags & MT_DRV_TXWI_NO_FREE))
 				mt76_put_txwi(dev, entry.txwi);
 		}
@@ -665,6 +670,11 @@ error:
 	return -ENOMEM;
 }
 
+static inline u32 mt76_txwi_next_gen(struct mt76_dev *dev)
+{
+	return (u32)atomic_add_return(2, &dev->txwi_seq) | 1U;
+}
+
 static int
 mt76_dma_tx_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
 		      enum mt76_txq_id qid, struct sk_buff *skb,
@@ -682,6 +692,7 @@ mt76_dma_tx_queue_skb(struct mt76_phy *p
 	struct mt76_txwi_cache *t;
 	struct sk_buff *iter;
 	dma_addr_t addr;
+	u32 gen;
 	u8 *txwi;
 
 	if (test_bit(MT76_RESET, &phy->state))
@@ -732,6 +743,8 @@ mt76_dma_tx_queue_skb(struct mt76_phy *p
 		goto unmap;
 	}
 
+	gen = mt76_txwi_next_gen(dev);
+	atomic_set_release(&t->txq_gen, gen);
 	dma_sync_single_for_cpu(dev->dma_dev, t->dma_addr, dev->drv->txwi_size,
 				DMA_TO_DEVICE);
 	ret = dev->drv->tx_prepare_skb(dev, txwi, qid, wcid, sta, &tx_info);
--- a/npu.c
+++ b/npu.c
@@ -221,6 +221,8 @@ int mt76_npu_dma_add_buf(struct mt76_phy
 {
 	u16 txwi_len = min_t(u16, phy->dev->drv->txwi_size, NPU_TXWI_LEN);
 	struct airoha_npu_tx_dma_desc *desc = (void *)q->desc;
+	struct mt76_txwi_cache *t =
+		(struct mt76_txwi_cache *)((u8 *)txwi_ptr + phy->dev->drv->txwi_size);
 	int ret;
 
 	/* TODO: Take into account unlinear skbs */
@@ -233,7 +235,8 @@ int mt76_npu_dma_add_buf(struct mt76_phy
 	ret = q->head;
 	q->entry[q->head].skip_buf0 = true;
 	q->entry[q->head].skip_buf1 = true;
-	q->entry[q->head].txwi = NULL;
+	q->entry[q->head].txwi = t;
+	q->entry[q->head].txwi_gen = atomic_read(&t->txq_gen);
 	q->entry[q->head].skb = NULL;
 	q->entry[q->head].wcid = 0xffff;
 
