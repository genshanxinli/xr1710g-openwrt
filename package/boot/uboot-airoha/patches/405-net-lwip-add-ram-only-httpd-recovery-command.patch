+#define HTTPD_MAX_UPLOAD_SIZE		(64UL * 1024UL * 1024UL)
+#define HTTPD_MAX_ENVELOPE_OVERHEAD	(64UL * 1024UL)
+#define HTTPD_DEFAULT_LOAD_ADDR		0x89000000UL
+#define HTTPD_DEFAULT_IPADDR		"192.168.1.1"
+#define HTTPD_DEFAULT_NETMASK		"255.255.255.0"
+#define HTTPD_HDR_BUF_SIZE		2048
+#define HTTPD_MAX_BOUNDARY_LEN		128
+#define HTTPD_DELIM_MAX			(HTTPD_MAX_BOUNDARY_LEN + 5)
+#define HTTPD_MAX_CONNS			4
+#define HTTPD_MIN_CHECK_SIZE		4096UL
+#define HTTPD_POLL_INTERVAL		4
+#define HTTPD_IDLE_TIMEOUT_POLLS	15
+#define HTTPD_CLOSING_TIMEOUT_POLLS	5
+#define HTTPD_FLUSH_TIMEOUT_MS		2000
+#define HTTPD_FIN_DRAIN_MS		50
+#define HTTPD_PROGRESS_STEP		(1024UL * 1024UL)
+
+#define HTTPD_DHCP_POOL_SIZE		8U
+#define HTTPD_DHCP_LEASE_SEC		180U
+#define HTTPD_DHCP_T1_SEC		90U
+#define HTTPD_DHCP_T2_SEC		157U
+#define HTTPD_DHCP_LEASE_MS		(HTTPD_DHCP_LEASE_SEC * 1000UL)
+#define HTTPD_DHCP_MIN_RX_LEN		240U
+#define HTTPD_DHCP_MAX_RX_LEN		1500U
+#define HTTPD_DHCP_MIN_REPLY_LEN	300U
+#define HTTPD_DHCP_MAX_REPLY_LEN	384U
+#define HTTPD_DHCP_FLAG_BROADCAST	0x8000U
+#define HTTPD_DHCP_MAC_LEN		6U
+
+#define HTTPD_LED_IDLE_MS		500UL
+#define HTTPD_LED_UPLOAD_MS		100UL
+#define HTTPD_LED_ERR_HOLD_MS		1500UL
+
+enum httpd_result {
+	HTTPD_RES_PENDING = 0,
+	HTTPD_RES_GET_INDEX,
+	HTTPD_RES_UPLOAD_OK,
+	HTTPD_RES_BAD_REQUEST,
+	HTTPD_RES_BAD_FIT,
+	HTTPD_RES_NOT_FOUND,
+	HTTPD_RES_METHOD_NOT_ALLOWED,
+	HTTPD_RES_PAYLOAD_TOO_LARGE,
+	HTTPD_RES_BUSY,
+	HTTPD_RES_MEM_ERROR,
+};
+
+enum httpd_parse_state {
+	HTTPD_ST_HTTP_HDR = 0,
+	HTTPD_ST_MP_PREAMBLE,
+	HTTPD_ST_MP_AFTER_BOUNDARY,
+	HTTPD_ST_MP_PART_HDR,
+	HTTPD_ST_MP_PART_BODY,
+	HTTPD_ST_DONE,
+};
+
+struct httpd_parser {
+	enum httpd_parse_state state;
+	enum httpd_result result;
+	ulong load_addr;
+	u8 *dst_buf;
+	size_t max_size;
+	size_t file_size;
+	size_t body_bytes;
+	u64 content_length;
+	bool has_content_length;
+	bool need_100_continue;
+	bool is_post;
+	bool in_file_part;
+	bool got_file;
+	size_t next_progress;
+	char hdr_buf[HTTPD_HDR_BUF_SIZE + 1];
+	size_t hdr_len;
+	char delim[HTTPD_DELIM_MAX];
+	size_t delim_len;
+	u8 carry[HTTPD_DELIM_MAX];
+	size_t carry_len;
+	u8 after_buf[2];
+	size_t after_len;
+};
+
+struct httpd_dhcp_lease {
+	u32 ip_be;
+	u8 mac[HTTPD_DHCP_MAC_LEN];
+	bool in_use;
+	ulong last_seen;
+	u32 seq;
+};
+
+struct httpd_dhcp {
+	struct udp_pcb *pcb;
+	struct netif *netif;
+	u32 server_ip_be;
+	u32 netmask_be;
+	unsigned int pool_count;
+	u32 lru_seq;
+	unsigned int stat_rx;
+	unsigned int stat_offer;
+	unsigned int stat_ack;
+	unsigned int stat_nak;
+	unsigned int stat_drop;
+	unsigned int stat_tx_err;
+	struct httpd_dhcp_lease leases[HTTPD_DHCP_POOL_SIZE];
+	u8 rx_buf[HTTPD_DHCP_MAX_RX_LEN];
+	u8 tx_buf[HTTPD_DHCP_MAX_REPLY_LEN];
+};
+
+struct httpd_leds {
+	struct udevice *blue;
+	struct udevice *green;
+	struct udevice *red;
+	ulong blink_ts;
+	ulong err_ts;
+	bool err_active;
+	bool success_lit;
+};
+
+struct httpd_server;
+
+struct httpd_conn {
+	struct httpd_server *server;
+	struct tcp_pcb *pcb;
+	struct httpd_parser parser;
+	u32 tx_pending;
+	unsigned int idle_polls;
+	bool closing;
+	bool owns_upload;
+	bool is_success_upload;
+	bool in_use;
+};
+
+struct httpd_server {
+	ulong load_addr;
+	u8 *dst_buf;
+	size_t max_size;
+	struct tcp_pcb *listen_pcb;
+	struct httpd_conn conns[HTTPD_MAX_CONNS];
+	struct httpd_dhcp dhcp;
+	struct httpd_leds leds;
+	bool upload_active;
+	bool upload_succeeded;
+	bool response_flushed;
+	size_t uploaded_size;
+	ulong flush_start;
+};
