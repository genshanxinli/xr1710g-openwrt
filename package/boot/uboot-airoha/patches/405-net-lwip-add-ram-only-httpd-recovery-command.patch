From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Fri, 27 Nov 2026 15:10:00 +0800
Subject: [PATCH] cmd: lwip: add RAM-only httpd FIT recovery command

Add CONFIG_CMD_HTTPD (depends on NET_LWIP && FIT, selects PROT_TCP_LWIP)
and cmd/lwip/httpd.c implementing a strictly RAM-only HTTP/1.1 recovery
server on TCP port 80. The server serves a self-contained HTML upload
page on GET /, validates load addresses and every write chunk against
wrap and LMB reserved regions, streams multipart/form-data uploads
directly into RAM at loadaddr (default $initaddr or 0x89000000) with a
hard 64 MiB ceiling (HTTP 413 on overflow while allowing multipart
envelope overhead), validates FIT format via fit_check_format(),
/configurations, kernel presence, external data bounds, and rejects
flash filesystem/rootfs images (HTTP 400 while remaining listening),
reclaims stalled/idle connections via tcp_poll/tcp_abort, temporarily
enables Ctrl-C during preboot recovery while restoring the prior state
on exit, flushes HTTP 200 before closing, sets $filesize/$fileaddr, and
exits cleanly with CMD_RET_SUCCESS for caller-driven bootm without
touching flash.

Origin: local, xr1710g (#386, #429)
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -2227,6 +2227,15 @@ config CMD_DNS
 	help
 	  Lookup the IP of a hostname
 
+config CMD_HTTPD
+	bool "httpd"
+	depends on NET_LWIP && FIT
+	select PROT_TCP_LWIP
+	help
+	  Start a RAM-only HTTP recovery server on port 80 that accepts a
+	  FIT image upload over multipart/form-data into memory without
+	  writing to flash.
+
 config CMD_MII
 	bool "mii"
 	imply CMD_MDIO
--- a/cmd/lwip/Makefile
+++ b/cmd/lwip/Makefile
@@ -1,5 +1,6 @@
 obj-$(CONFIG_CMD_DHCP) += dhcp.o
 obj-$(CONFIG_CMD_DNS) += dns.o
+obj-$(CONFIG_CMD_HTTPD) += httpd.o
 obj-$(CONFIG_CMD_NFS) += nfs.o
 obj-$(CONFIG_CMD_PING) += ping.o
 obj-$(CONFIG_CMD_SNTP) += sntp.o
--- /dev/null
+++ b/cmd/lwip/httpd.c
@@ -0,0 +1,1459 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * RAM-only HTTP FIT recovery server for lwIP.
+ *
+ * Streams a multipart/form-data FIT image upload directly into RAM (capped at
+ * 64 MiB), validates the FDT/FIT header, sets $filesize/$fileaddr, and returns
+ * CMD_RET_SUCCESS for caller-driven RAM boot (bootm). Never writes to flash.
+ */
+
