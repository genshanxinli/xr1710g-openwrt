From: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
Date: Sat, 28 Nov 2026 12:30:00 +0800
Subject: [PATCH] cmd: lwip: add RAM-only httpd FIT recovery command

Add CONFIG_CMD_HTTPD (depends on NET_LWIP && FIT, selects PROT_TCP_LWIP
and PROT_UDP_LWIP), enable LWIP_IP_ACCEPT_UDP_PORT for UDP port 67 and
SO_REUSE when CONFIG_CMD_HTTPD is enabled in lib/lwip/u-boot/lwipopts.h,
and implement cmd/lwip/httpd.c as a strictly RAM-only HTTP/1.1 recovery
server on TCP port 80.

The server serves a compact HTML upload page with native form fallback
and XHR upload progress bar on GET /, sets SOF_REUSEADDR before binding
TCP port 80 and UDP port 67 (preventing 2nd-run bind failures from
TIME_WAIT PCBs) and aborts lingering active client PCBs on cleanup, runs
a scoped 8-slot UDP DHCPv4 server (180 s lease with RFC 2131 Options
28/58/59, anti-Rogue-NAK filtering, >= 300 B broadcast reply preserving
request flags, trailing padding tolerance, concise UART diagnostics, and
immediate teardown on every exit path) during httpd_loop(), drives DM
status LEDs (blue entry/slow/fast blink, 1500 ms red error hold, steady
green OK, no LEDST_BLINK), registers an EVT_POST_PREBOOT reset-button
fallback guard against stale ubootenv, validates load addresses and every
write chunk against wrap and LMB reserved regions, streams
multipart/form-data uploads directly into RAM (capped at 64 MiB),
validates FIT format via fit_check_format() while rejecting flash
filesystem/rootfs images, reclaims stalled connections via
tcp_poll/tcp_abort, restores Ctrl-C state on exit, sets
$filesize/$fileaddr, and exits cleanly for caller-driven bootm without
touching flash.

Origin: local, xr1710g (#386, #429, #441)
Signed-off-by: genshanxinli <127909456+genshanxinli@users.noreply.github.com>
---
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -2221,6 +2221,16 @@
 	help
 	  Lookup the IP of a hostname
 
+config CMD_HTTPD
+	bool "httpd"
+	depends on NET_LWIP && FIT
+	select PROT_TCP_LWIP
+	select PROT_UDP_LWIP
+	help
+	  Start a RAM-only HTTP recovery server on port 80 that accepts a
+	  FIT image upload over multipart/form-data into memory without
+	  writing to flash.
+
 config CMD_MII
 	bool "mii"
 	imply CMD_MDIO
--- a/cmd/lwip/Makefile
+++ b/cmd/lwip/Makefile
@@ -1,5 +1,6 @@
 obj-$(CONFIG_CMD_DHCP) += dhcp.o
 obj-$(CONFIG_CMD_DNS) += dns.o
+obj-$(CONFIG_CMD_HTTPD) += httpd.o
 obj-$(CONFIG_CMD_NFS) += nfs.o
 obj-$(CONFIG_CMD_PING) += ping.o
 obj-$(CONFIG_CMD_SNTP) += sntp.o
--- /dev/null
+++ b/cmd/lwip/httpd.c
@@ -0,0 +1,2342 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * RAM-only HTTP FIT recovery server for lwIP.
+ *
+ * Streams a multipart/form-data FIT image upload directly into RAM (capped at
+ * 64 MiB), validates the FDT/FIT header, sets $filesize/$fileaddr, and returns
+ * CMD_RET_SUCCESS for caller-driven RAM boot (bootm). While listening, serves
+ * a scoped UDP DHCPv4 pool on the active netif and drives DM status LEDs.
+ * Never writes to flash.
+ */
+
