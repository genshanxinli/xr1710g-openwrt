+/* =========================================================================
+ * DM LED state machine (strictly LEDST_ON / LEDST_OFF / LEDST_TOGGLE)
+ * ========================================================================= */
+
+#if CONFIG_IS_ENABLED(LED)
+static void httpd_led_set(struct udevice *dev, enum led_state_t state)
+{
+	if (dev)
+		led_set_state(dev, state);
+}
+
+static void httpd_led_init(struct httpd_leds *leds)
+{
+	struct udevice *dev;
+
+	memset(leds, 0, sizeof(*leds));
+	if (led_get_by_label("status:blue", &dev) == 0)
+		leds->blue = dev;
+	if (led_get_by_label("status:green", &dev) == 0)
+		leds->green = dev;
+	if (led_get_by_label("status:red", &dev) == 0)
+		leds->red = dev;
+
+	httpd_led_set(leds->red, LEDST_OFF);
+	httpd_led_set(leds->green, LEDST_OFF);
+	httpd_led_set(leds->blue, LEDST_ON);
+	leds->blink_ts = get_timer(0);
+}
+
+static void httpd_led_signal_error(struct httpd_leds *leds)
+{
+	leds->err_active = true;
+	leds->err_ts = get_timer(0);
+	httpd_led_set(leds->blue, LEDST_OFF);
+	httpd_led_set(leds->red, LEDST_ON);
+}
+
+static void httpd_led_signal_success(struct httpd_leds *leds)
+{
+	leds->err_active = false;
+	leds->success_lit = true;
+	httpd_led_set(leds->blue, LEDST_OFF);
+	httpd_led_set(leds->red, LEDST_OFF);
+	httpd_led_set(leds->green, LEDST_ON);
+}
+
+static void httpd_led_poll(struct httpd_leds *leds, bool upload_active)
+{
+	ulong period;
+
+	if (leds->success_lit)
+		return;
+
+	if (leds->err_active) {
+		if (get_timer(leds->err_ts) < HTTPD_LED_ERR_HOLD_MS)
+			return;
+		leds->err_active = false;
+		httpd_led_set(leds->red, LEDST_OFF);
+		httpd_led_set(leds->blue, LEDST_ON);
+		leds->blink_ts = get_timer(0);
+		return;
+	}
+
+	period = upload_active ? HTTPD_LED_UPLOAD_MS : HTTPD_LED_IDLE_MS;
+	if (get_timer(leds->blink_ts) >= period) {
+		httpd_led_set(leds->blue, LEDST_TOGGLE);
+		leds->blink_ts = get_timer(0);
+	}
+}
+
+static void httpd_led_finish(struct httpd_leds *leds, bool succeeded)
+{
+	if (succeeded) {
+		httpd_led_signal_success(leds);
+	} else {
+		httpd_led_set(leds->blue, LEDST_OFF);
+		httpd_led_set(leds->red, LEDST_OFF);
+		if (leds->success_lit)
+			httpd_led_set(leds->green, LEDST_OFF);
+	}
+}
+#else
+static inline void httpd_led_init(struct httpd_leds *leds) { (void)leds; }
+static inline void httpd_led_signal_error(struct httpd_leds *leds) { (void)leds; }
+static inline void httpd_led_signal_success(struct httpd_leds *leds) { (void)leds; }
+static inline void httpd_led_poll(struct httpd_leds *leds, bool upload_active)
+{
+	(void)leds;
+	(void)upload_active;
+}
+static inline void httpd_led_finish(struct httpd_leds *leds, bool succeeded)
+{
+	(void)leds;
+	(void)succeeded;
+}
+#endif
