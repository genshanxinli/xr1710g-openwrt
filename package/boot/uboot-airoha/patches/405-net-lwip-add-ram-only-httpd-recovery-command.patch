+/* =========================================================================
+ * Scoped lwIP UDP DHCPv4 server (active strictly during httpd_loop())
+ * ========================================================================= */
+
+static bool httpd_dhcp_pool_add(struct httpd_dhcp *dhcp, u32 cand_h,
+				u32 server_h)
+{
+	unsigned int i;
+	u32 cand_be;
+
+	if (dhcp->pool_count >= HTTPD_DHCP_POOL_SIZE)
+		return false;
+	if (cand_h == server_h || (cand_h & 0xffU) == 254U)
+		return false;
+
+	cand_be = lwip_htonl(cand_h);
+	for (i = 0; i < dhcp->pool_count; i++) {
+		if (dhcp->leases[i].ip_be == cand_be)
+			return false;
+	}
+
+	dhcp->leases[dhcp->pool_count].ip_be = cand_be;
+	dhcp->leases[dhcp->pool_count].in_use = false;
+	dhcp->pool_count++;
+	return true;
+}
+
+static void httpd_dhcp_init_pool(struct httpd_dhcp *dhcp, u32 server_ip_be,
+				 u32 netmask_be)
+{
+	u32 server_h = lwip_ntohl(server_ip_be);
+	u32 mask_h = lwip_ntohl(netmask_be);
+	u32 host_max;
+	u32 net_h;
+	u32 off;
+
+	dhcp->server_ip_be = server_ip_be;
+	dhcp->netmask_be = netmask_be;
+	dhcp->pool_count = 0;
+
+	if (!server_h || !mask_h)
+		return;
+
+	host_max = ~mask_h;
+	/* Require contiguous mask and at least /30 (2 host slots). */
+	if (host_max < 3U || (host_max & (host_max + 1U)) != 0U)
+		return;
+
+	net_h = server_h & mask_h;
+
+	/* Preferred pool: <net>.100 .. <net>.107 when within subnet. */
+	for (off = 100U;
+	     off <= 107U && off < host_max && dhcp->pool_count < HTTPD_DHCP_POOL_SIZE;
+	     off++)
+		httpd_dhcp_pool_add(dhcp, net_h + off, server_h);
+
+	/* Fallback: fill remaining slots above .107, then below .100. */
+	for (off = 108U;
+	     off < host_max && dhcp->pool_count < HTTPD_DHCP_POOL_SIZE;
+	     off++)
+		httpd_dhcp_pool_add(dhcp, net_h + off, server_h);
+
+	for (off = 1U;
+	     off < 100U && off < host_max && dhcp->pool_count < HTTPD_DHCP_POOL_SIZE;
+	     off++)
+		httpd_dhcp_pool_add(dhcp, net_h + off, server_h);
+}
+
+static void httpd_dhcp_expire_leases(struct httpd_dhcp *dhcp)
+{
+	unsigned int i;
+
+	for (i = 0; i < dhcp->pool_count; i++) {
+		if (dhcp->leases[i].in_use &&
+		    get_timer(dhcp->leases[i].last_seen) >= HTTPD_DHCP_LEASE_MS) {
+			dhcp->leases[i].in_use = false;
+			memset(dhcp->leases[i].mac, 0, HTTPD_DHCP_MAC_LEN);
+		}
+	}
+}
+
+static struct httpd_dhcp_lease *httpd_dhcp_find_mac(struct httpd_dhcp *dhcp,
+						    const u8 *mac)
+{
+	unsigned int i;
+
+	for (i = 0; i < dhcp->pool_count; i++) {
+		if (dhcp->leases[i].in_use &&
+		    memcmp(dhcp->leases[i].mac, mac, HTTPD_DHCP_MAC_LEN) == 0)
+			return &dhcp->leases[i];
+	}
+
+	return NULL;
+}
+
+static struct httpd_dhcp_lease *httpd_dhcp_find_ip(struct httpd_dhcp *dhcp,
+						   u32 ip_be)
+{
+	unsigned int i;
+
+	for (i = 0; i < dhcp->pool_count; i++) {
+		if (dhcp->leases[i].ip_be == ip_be)
+			return &dhcp->leases[i];
+	}
+
+	return NULL;
+}
+
+static void httpd_dhcp_bind_lease(struct httpd_dhcp *dhcp,
+				  struct httpd_dhcp_lease *lease,
+				  const u8 *mac)
+{
+	unsigned int i;
+
+	for (i = 0; i < dhcp->pool_count; i++) {
+		if (&dhcp->leases[i] != lease && dhcp->leases[i].in_use &&
+		    memcmp(dhcp->leases[i].mac, mac, HTTPD_DHCP_MAC_LEN) == 0) {
+			dhcp->leases[i].in_use = false;
+			memset(dhcp->leases[i].mac, 0, HTTPD_DHCP_MAC_LEN);
+		}
+	}
+
+	memcpy(lease->mac, mac, HTTPD_DHCP_MAC_LEN);
+	lease->in_use = true;
+	lease->last_seen = get_timer(0);
+	lease->seq = ++dhcp->lru_seq;
+}
+
+static struct httpd_dhcp_lease *httpd_dhcp_alloc_lease(struct httpd_dhcp *dhcp,
+						       const u8 *mac,
+						       bool has_req_ip,
+						       u32 req_ip_be)
+{
+	struct httpd_dhcp_lease *lease;
+	struct httpd_dhcp_lease *victim;
+	ulong victim_age;
+	unsigned int i;
+
+	httpd_dhcp_expire_leases(dhcp);
+
+	lease = httpd_dhcp_find_mac(dhcp, mac);
+	if (lease) {
+		httpd_dhcp_bind_lease(dhcp, lease, mac);
+		return lease;
+	}
+
+	if (has_req_ip) {
+		lease = httpd_dhcp_find_ip(dhcp, req_ip_be);
+		if (lease && !lease->in_use) {
+			httpd_dhcp_bind_lease(dhcp, lease, mac);
+			return lease;
+		}
+	}
+
+	for (i = 0; i < dhcp->pool_count; i++) {
+		if (!dhcp->leases[i].in_use) {
+			httpd_dhcp_bind_lease(dhcp, &dhcp->leases[i], mac);
+			return &dhcp->leases[i];
+		}
+	}
+
+	if (!dhcp->pool_count)
+		return NULL;
+
+	/* Pool full: evict least-recently-active lease without heap growth. */
+	victim = &dhcp->leases[0];
+	victim_age = get_timer(victim->last_seen);
+	for (i = 1; i < dhcp->pool_count; i++) {
+		struct httpd_dhcp_lease *cur = &dhcp->leases[i];
+		ulong cur_age = get_timer(cur->last_seen);
+
+		if (cur_age > victim_age ||
+		    (cur_age == victim_age && (s32)(victim->seq - cur->seq) > 0)) {
+			victim = cur;
+			victim_age = cur_age;
+		}
+	}
+
+	httpd_dhcp_bind_lease(dhcp, victim, mac);
+	return victim;
+}
+
+static bool httpd_dhcp_opt_put(u8 *buf, size_t cap, size_t *pos,
+			       u8 code, const void *val, u8 len)
+{
+	if (*pos + 2U + (size_t)len >= cap)
+		return false;
+
+	buf[(*pos)++] = code;
+	buf[(*pos)++] = len;
+	if (len > 0) {
+		memcpy(buf + *pos, val, len);
+		*pos += len;
+	}
+	return true;
+}
+
+static bool httpd_dhcp_msg_type_valid(u8 msg_type)
+{
+	return msg_type == DHCP_DISCOVER || msg_type == DHCP_REQUEST ||
+	       msg_type == DHCP_RELEASE || msg_type == DHCP_INFORM;
+}
+
+static void httpd_dhcp_log_event(const char *req_name, const u8 *mac,
+				 const char *rep_name, u32 ip_be)
+{
+	if (rep_name && ip_be) {
+		u32 ip_h = lwip_ntohl(ip_be);
+
+		printf("DHCP: %s %02x:%02x:%02x:%02x:%02x:%02x -> %s %u.%u.%u.%u\n",
+		       req_name,
+		       mac[0], mac[1], mac[2], mac[3], mac[4], mac[5],
+		       rep_name,
+		       (unsigned int)((ip_h >> 24) & 0xffU),
+		       (unsigned int)((ip_h >> 16) & 0xffU),
+		       (unsigned int)((ip_h >> 8) & 0xffU),
+		       (unsigned int)(ip_h & 0xffU));
+	} else if (rep_name) {
+		printf("DHCP: %s %02x:%02x:%02x:%02x:%02x:%02x -> %s\n",
+		       req_name,
+		       mac[0], mac[1], mac[2], mac[3], mac[4], mac[5],
+		       rep_name);
+	} else {
+		printf("DHCP: %s %02x:%02x:%02x:%02x:%02x:%02x\n",
+		       req_name,
+		       mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+	}
+}
+
+static bool httpd_dhcp_send_reply(struct httpd_dhcp *dhcp, const u8 *req_xid,
+				  u16 req_flags_be, const u8 *mac,
+				  u8 reply_type, u32 ciaddr_be, u32 yiaddr_be,
+				  u32 lease_sec)
+{
+	u8 *reply = dhcp->tx_buf;
+	size_t cap = sizeof(dhcp->tx_buf);
+	size_t pos = DHCP_OPTIONS_OFS;
+	u16 flags_be = req_flags_be | PP_HTONS(HTTPD_DHCP_FLAG_BROADCAST);
+	u32 cookie_be = PP_HTONL(DHCP_MAGIC_COOKIE);
+	struct pbuf *q;
+	ip_addr_t src_ip;
+	err_t err;
+
+	memset(reply, 0, cap);
+	reply[0] = DHCP_BOOTREPLY;
+	reply[1] = LWIP_IANA_HWTYPE_ETHERNET;
+	reply[2] = HTTPD_DHCP_MAC_LEN;
+	memcpy(reply + 4, req_xid, 4);
+	memcpy(reply + 10, &flags_be, 2);
+	memcpy(reply + 12, &ciaddr_be, 4);
+	memcpy(reply + 16, &yiaddr_be, 4);
+	if (reply_type != DHCP_NAK)
+		memcpy(reply + 20, &dhcp->server_ip_be, 4);
+	memcpy(reply + 28, mac, HTTPD_DHCP_MAC_LEN);
+	memcpy(reply + 236, &cookie_be, 4);
+
+	if (!httpd_dhcp_opt_put(reply, cap, &pos, DHCP_OPTION_MESSAGE_TYPE,
+				&reply_type, 1))
+		goto err_buf;
+	if (!httpd_dhcp_opt_put(reply, cap, &pos, DHCP_OPTION_SERVER_ID,
+				&dhcp->server_ip_be, 4))
+		goto err_buf;
+
+	if (reply_type != DHCP_NAK) {
+		u32 bcast_be = (dhcp->server_ip_be & dhcp->netmask_be) |
+			       ~dhcp->netmask_be;
+
+		if (!httpd_dhcp_opt_put(reply, cap, &pos,
+					DHCP_OPTION_SUBNET_MASK,
+					&dhcp->netmask_be, 4))
+			goto err_buf;
+		if (!httpd_dhcp_opt_put(reply, cap, &pos, DHCP_OPTION_ROUTER,
+					&dhcp->server_ip_be, 4))
+			goto err_buf;
+		if (!httpd_dhcp_opt_put(reply, cap, &pos,
+					DHCP_OPTION_DNS_SERVER,
+					&dhcp->server_ip_be, 4))
+			goto err_buf;
+		if (!httpd_dhcp_opt_put(reply, cap, &pos,
+					DHCP_OPTION_BROADCAST,
+					&bcast_be, 4))
+			goto err_buf;
+		if (lease_sec > 0) {
+			u32 lease_be = lwip_htonl(lease_sec);
+			u32 t1_be = lwip_htonl(HTTPD_DHCP_T1_SEC);
+			u32 t2_be = lwip_htonl(HTTPD_DHCP_T2_SEC);
+
+			if (!httpd_dhcp_opt_put(reply, cap, &pos,
+						DHCP_OPTION_LEASE_TIME,
+						&lease_be, 4))
+				goto err_buf;
+			if (!httpd_dhcp_opt_put(reply, cap, &pos,
+						DHCP_OPTION_T1, &t1_be, 4))
+				goto err_buf;
+			if (!httpd_dhcp_opt_put(reply, cap, &pos,
+						DHCP_OPTION_T2, &t2_be, 4))
+				goto err_buf;
+		}
+	}
+
+	if (pos >= cap)
+		goto err_buf;
+	reply[pos++] = DHCP_OPTION_END;
+
+	/* Pad BOOTP/DHCP reply to >= 300 bytes for Windows/macOS/Linux clients. */
+	if (pos < HTTPD_DHCP_MIN_REPLY_LEN)
+		pos = HTTPD_DHCP_MIN_REPLY_LEN;
+
+	q = pbuf_alloc(PBUF_TRANSPORT, (u16_t)pos, PBUF_RAM);
+	if (!q) {
+		err = ERR_MEM;
+		goto err_tx;
+	}
+
+	err = pbuf_take(q, reply, (u16_t)pos);
+	if (err == ERR_OK) {
+		ip_addr_set_ip4_u32_val(src_ip, dhcp->server_ip_be);
+		err = udp_sendto_if_src(dhcp->pcb, q, IP_ADDR_BROADCAST,
+					LWIP_IANA_PORT_DHCP_CLIENT, dhcp->netif,
+					&src_ip);
+	}
+	pbuf_free(q);
+	if (err != ERR_OK)
+		goto err_tx;
+
+	return true;
+
+err_buf:
+	err = ERR_BUF;
+err_tx:
+	dhcp->stat_tx_err++;
+	printf("DHCP: tx failed (err=%d)\n", (int)err);
+	return false;
+}
+
+static void httpd_dhcp_recv_cb(void *arg, struct udp_pcb *pcb, struct pbuf *p,
+			       const ip_addr_t *addr, u16_t port)
+{
+	struct httpd_server *srv = arg;
+	struct httpd_dhcp *dhcp;
+	u8 *buf;
+	size_t len;
+	size_t off;
+	u16 req_flags_be;
+	u32 cookie_be;
+	u32 ciaddr_be;
+	u32 giaddr_be;
+	u8 msg_type = 0;
+	bool has_msg_type = false;
+	u32 req_ip_be = 0;
+	bool has_req_ip = false;
+	u32 srv_id_be = 0;
+	bool has_srv_id = false;
+	const u8 *mac;
+	const u8 *xid;
+
+	(void)pcb;
+	(void)addr;
+
+	if (!p)
+		return;
+
+	if (!srv || !srv->dhcp.pcb || !srv->dhcp.netif ||
+	    !srv->dhcp.pool_count) {
+		pbuf_free(p);
+		return;
+	}
+
+	dhcp = &srv->dhcp;
+	dhcp->stat_rx++;
+
+	if (port != LWIP_IANA_PORT_DHCP_CLIENT ||
+	    p->tot_len < HTTPD_DHCP_MIN_RX_LEN ||
+	    p->tot_len > HTTPD_DHCP_MAX_RX_LEN) {
+		dhcp->stat_drop++;
+		pbuf_free(p);
+		return;
+	}
+
+	buf = dhcp->rx_buf;
+	len = p->tot_len;
+	if (pbuf_copy_partial(p, buf, (u16_t)len, 0) != (u16_t)len) {
+		dhcp->stat_drop++;
+		pbuf_free(p);
+		return;
+	}
+	pbuf_free(p);
+
+	if (buf[0] != DHCP_BOOTREQUEST ||
+	    buf[1] != LWIP_IANA_HWTYPE_ETHERNET ||
+	    buf[2] != HTTPD_DHCP_MAC_LEN) {
+		dhcp->stat_drop++;
+		return;
+	}
+
+	memcpy(&giaddr_be, buf + 24, 4);
+	if (giaddr_be != 0) {
+		dhcp->stat_drop++;
+		return;
+	}
+
+	memcpy(&cookie_be, buf + 236, 4);
+	if (cookie_be != PP_HTONL(DHCP_MAGIC_COOKIE)) {
+		dhcp->stat_drop++;
+		return;
+	}
+
+	memcpy(&req_flags_be, buf + 10, 2);
+	memcpy(&ciaddr_be, buf + 12, 4);
+	xid = buf + 4;
+	mac = buf + 28;
+
+	off = DHCP_OPTIONS_OFS;
+	while (off < len) {
+		u8 opt = buf[off++];
+		u8 opt_len;
+
+		if (opt == DHCP_OPTION_PAD)
+			continue;
+		if (opt == DHCP_OPTION_END)
+			break;
+		if (off >= len) {
+			if (has_msg_type && httpd_dhcp_msg_type_valid(msg_type))
+				break;
+			dhcp->stat_drop++;
+			return;
+		}
+		opt_len = buf[off++];
+		if ((size_t)opt_len > len - off) {
+			if (has_msg_type && httpd_dhcp_msg_type_valid(msg_type))
+				break;
+			dhcp->stat_drop++;
+			return;
+		}
+
+		switch (opt) {
+		case DHCP_OPTION_MESSAGE_TYPE:
+			if (opt_len != 1) {
+				dhcp->stat_drop++;
+				return;
+			}
+			msg_type = buf[off];
+			has_msg_type = true;
+			break;
+		case DHCP_OPTION_REQUESTED_IP:
+			if (opt_len != 4) {
+				dhcp->stat_drop++;
+				return;
+			}
+			memcpy(&req_ip_be, buf + off, 4);
+			has_req_ip = true;
+			break;
+		case DHCP_OPTION_SERVER_ID:
+			if (opt_len != 4) {
+				dhcp->stat_drop++;
+				return;
+			}
+			memcpy(&srv_id_be, buf + off, 4);
+			has_srv_id = true;
+			break;
+		default:
+			break;
+		}
+		off += opt_len;
+	}
+
+	if (!has_msg_type) {
+		dhcp->stat_drop++;
+		return;
+	}
+
+	switch (msg_type) {
+	case DHCP_DISCOVER: {
+		struct httpd_dhcp_lease *lease;
+
+		lease = httpd_dhcp_alloc_lease(dhcp, mac, has_req_ip, req_ip_be);
+		if (!lease) {
+			dhcp->stat_drop++;
+			break;
+		}
+		if (httpd_dhcp_send_reply(dhcp, xid, req_flags_be, mac,
+					  DHCP_OFFER, 0, lease->ip_be,
+					  HTTPD_DHCP_LEASE_SEC)) {
+			dhcp->stat_offer++;
+			httpd_dhcp_log_event("DISCOVER", mac, "OFFER",
+					     lease->ip_be);
+		}
+		break;
+	}
+	case DHCP_REQUEST: {
+		u32 target_ip_be = has_req_ip ? req_ip_be : ciaddr_be;
+		struct httpd_dhcp_lease *slot;
+
+		/* Selecting another server: silently ignore. */
+		if (has_srv_id && srv_id_be != dhcp->server_ip_be) {
+			dhcp->stat_drop++;
+			return;
+		}
+
+		/* No Server ID and foreign subnet: silently ignore (no Rogue NAK). */
+		if (!has_srv_id &&
+		    (!target_ip_be ||
+		     (target_ip_be & dhcp->netmask_be) !=
+		     (dhcp->server_ip_be & dhcp->netmask_be))) {
+			dhcp->stat_drop++;
+			return;
+		}
+
+		httpd_dhcp_expire_leases(dhcp);
+		slot = target_ip_be ? httpd_dhcp_find_ip(dhcp, target_ip_be) : NULL;
+		if (slot && (!slot->in_use ||
+			     memcmp(slot->mac, mac, HTTPD_DHCP_MAC_LEN) == 0)) {
+			httpd_dhcp_bind_lease(dhcp, slot, mac);
+			if (httpd_dhcp_send_reply(dhcp, xid, req_flags_be, mac,
+						  DHCP_ACK, 0, slot->ip_be,
+						  HTTPD_DHCP_LEASE_SEC)) {
+				dhcp->stat_ack++;
+				httpd_dhcp_log_event("REQUEST", mac, "ACK",
+						     slot->ip_be);
+			}
+		} else if (has_srv_id) {
+			/* Explicitly addressed to our Server ID with invalid/conflicting IP. */
+			if (httpd_dhcp_send_reply(dhcp, xid, req_flags_be, mac,
+						  DHCP_NAK, 0, 0, 0)) {
+				dhcp->stat_nak++;
+				httpd_dhcp_log_event("REQUEST", mac, "NAK", 0);
+			}
+		} else {
+			dhcp->stat_drop++;
+		}
+		break;
+	}
+	case DHCP_RELEASE: {
+		struct httpd_dhcp_lease *lease;
+
+		if (has_srv_id && srv_id_be != dhcp->server_ip_be) {
+			dhcp->stat_drop++;
+			return;
+		}
+
+		lease = httpd_dhcp_find_mac(dhcp, mac);
+		if (lease && (!ciaddr_be || lease->ip_be == ciaddr_be)) {
+			lease->in_use = false;
+			memset(lease->mac, 0, HTTPD_DHCP_MAC_LEN);
+		}
+		httpd_dhcp_log_event("RELEASE", mac, NULL, 0);
+		break;
+	}
+	case DHCP_INFORM:
+		if (has_srv_id && srv_id_be != dhcp->server_ip_be) {
+			dhcp->stat_drop++;
+			return;
+		}
+		if (httpd_dhcp_send_reply(dhcp, xid, req_flags_be, mac,
+					  DHCP_ACK, ciaddr_be, 0, 0)) {
+			dhcp->stat_ack++;
+			httpd_dhcp_log_event("INFORM", mac, "ACK", ciaddr_be);
+		}
+		break;
+	default:
+		dhcp->stat_drop++;
+		break;
+	}
+}
+
+static void httpd_dhcp_start(struct httpd_server *srv, struct netif *netif)
+{
+	struct httpd_dhcp *dhcp = &srv->dhcp;
+	struct udp_pcb *pcb;
+	err_t err;
+
+	dhcp->netif = netif;
+	httpd_dhcp_init_pool(dhcp, ip4_addr_get_u32(netif_ip4_addr(netif)),
+			     ip4_addr_get_u32(netif_ip4_netmask(netif)));
+	if (!dhcp->pool_count) {
+		printf("DHCP: disabled (invalid ipaddr/netmask or empty pool)\n");
+		return;
+	}
+
+	pcb = udp_new();
+	if (!pcb) {
+		printf("DHCP: failed to allocate UDP PCB\n");
+		return;
+	}
+
+	ip_set_option(pcb, SOF_REUSEADDR);
+	udp_bind_netif(pcb, netif);
+	err = udp_bind(pcb, IP4_ADDR_ANY, LWIP_IANA_PORT_DHCP_SERVER);
+	if (err != ERR_OK) {
+		printf("DHCP: failed to bind UDP port %d (err=%d)\n",
+		       LWIP_IANA_PORT_DHCP_SERVER, (int)err);
+		udp_remove(pcb);
+		return;
+	}
+
+	udp_recv(pcb, httpd_dhcp_recv_cb, srv);
+	dhcp->pcb = pcb;
+}
+
+static void httpd_dhcp_stop(struct httpd_dhcp *dhcp)
+{
+	if (dhcp->pcb) {
+		udp_recv(dhcp->pcb, NULL, NULL);
+		udp_remove(dhcp->pcb);
+		dhcp->pcb = NULL;
+	}
+}
+
+/* =========================================================================
+ * HTTP/1.1 multipart/form-data streaming parser & FIT validator
+ * ========================================================================= */
+
+static bool httpd_ci_eq_n(const char *a, const char *b, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		if (tolower((unsigned char)a[i]) !=
+		    tolower((unsigned char)b[i]))
+			return false;
+	}
+
+	return true;
+}
+
+static const char *httpd_ci_strstr(const char *hay, size_t hay_len,
+				   const char *needle)
+{
+	size_t nlen = strlen(needle);
+	size_t i;
+
+	if (!nlen || nlen > hay_len)
+		return NULL;
+
+	for (i = 0; i <= hay_len - nlen; i++) {
+		if (httpd_ci_eq_n(hay + i, needle, nlen))
+			return hay + i;
+	}
+
+	return NULL;
+}
+
+static const u8 *httpd_find_bytes(const u8 *hay, size_t hay_len,
+				  const u8 *needle, size_t needle_len)
+{
+	const u8 *p = hay;
+	size_t rem;
+
+	if (!needle_len || needle_len > hay_len)
+		return NULL;
+
+	rem = hay_len - needle_len + 1;
+	while (rem > 0) {
+		const u8 *hit = memchr(p, needle[0], rem);
+
+		if (!hit)
+			return NULL;
+		if (memcmp(hit, needle, needle_len) == 0)
+			return hit;
+		rem -= (size_t)(hit - p) + 1;
+		p = hit + 1;
+	}
+
+	return NULL;
+}
+
+static bool httpd_find_header_at(const char *hdr, size_t hdr_len,
+				 bool skip_first_line, const char *name,
+				 const char **val_out, size_t *val_len_out)
+{
+	size_t name_len = strlen(name);
+	const char *p = hdr;
+	const char *end = hdr + hdr_len;
+
+	if (skip_first_line) {
+		const char *nl = (const char *)httpd_find_bytes((const u8 *)p,
+								(size_t)(end - p),
+								(const u8 *)"\r\n", 2);
+		if (!nl)
+			return false;
+		p = nl + 2;
+	}
+
+	while (p < end) {
+		const char *nl = (const char *)httpd_find_bytes((const u8 *)p,
+								(size_t)(end - p),
+								(const u8 *)"\r\n", 2);
+		const char *line_end = nl ? nl : end;
+		size_t line_len = (size_t)(line_end - p);
+
+		if (line_len == 0)
+			break;
+
+		if (line_len > name_len && p[name_len] == ':' &&
+		    httpd_ci_eq_n(p, name, name_len)) {
+			const char *v = p + name_len + 1;
+			const char *ve = line_end;
+
+			while (v < ve && (*v == ' ' || *v == '\t'))
+				v++;
+			while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t'))
+				ve--;
+
+			*val_out = v;
+			*val_len_out = (size_t)(ve - v);
+			return true;
+		}
+
+		if (!nl)
+			break;
+		p = nl + 2;
+	}
+
+	return false;
+}
+
+static int httpd_parse_u64_dec(const char *s, size_t len, u64 *out)
+{
+	u64 val = 0;
+	size_t i = 0;
+
+	if (!len || s[0] < '0' || s[0] > '9')
+		return -EINVAL;
+
+	while (i < len && s[i] >= '0' && s[i] <= '9') {
+		u64 digit = (u64)(s[i] - '0');
+
+		if (val > ((~(u64)0) - digit) / 10)
+			return -ERANGE;
+		val = val * 10 + digit;
+		i++;
+	}
+
+	while (i < len) {
+		if (s[i] != ' ' && s[i] != '\t')
+			return -EINVAL;
+		i++;
+	}
+
+	*out = val;
+	return 0;
+}
+
+static int httpd_parse_boundary(const char *ct, size_t ct_len,
+				char *delim_out, size_t *delim_len_out)
+{
+	const char *p = ct;
+	const char *end = ct + ct_len;
+
+	if (ct_len < 19 || !httpd_ci_eq_n(ct, "multipart/form-data", 19))
+		return -EINVAL;
+
+	p += 19;
+	if (p < end && *p != ';' && *p != ' ' && *p != '\t')
+		return -EINVAL;
+
+	while (p < end) {
+		const char *semi = memchr(p, ';', (size_t)(end - p));
+
+		if (!semi)
+			break;
+		p = semi + 1;
+		while (p < end && (*p == ' ' || *p == '\t'))
+			p++;
+
+		if ((size_t)(end - p) >= 9 && httpd_ci_eq_n(p, "boundary=", 9)) {
+			const char *bstart;
+			const char *bend;
+			size_t blen;
+
+			p += 9;
+			if (p < end && *p == '"') {
+				bstart = p + 1;
+				bend = memchr(bstart, '"',
+					      (size_t)(end - bstart));
+				if (!bend)
+					return -EINVAL;
+			} else {
+				bstart = p;
+				bend = bstart;
+				while (bend < end && *bend != ';' &&
+				       *bend != ' ' && *bend != '\t' &&
+				       *bend != '\r' && *bend != '\n')
+					bend++;
+			}
+
+			blen = (size_t)(bend - bstart);
+			if (blen == 0 || blen > HTTPD_MAX_BOUNDARY_LEN)
+				return -EINVAL;
+			if (memchr(bstart, '\r', blen) ||
+			    memchr(bstart, '\n', blen))
+				return -EINVAL;
+
+			memcpy(delim_out, "\r\n--", 4);
+			memcpy(delim_out + 4, bstart, blen);
+			delim_out[4 + blen] = '\0';
+			*delim_len_out = 4 + blen;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int httpd_check_mem_range(ulong addr, size_t len)
+{
+	if (!addr || !len || len > (size_t)(~(ulong)0 - addr))
+		return -EFAULT;
+
+#if CONFIG_IS_ENABLED(LMB)
+	if (lmb_read_check(addr, len))
+		return -EFAULT;
+#endif
+
+	return 0;
+}
+
+static int httpd_validate_fit(const void *buf, size_t received_size)
+{
+	int images_noffset;
+	int confs_noffset;
+	int noffset;
+	bool has_kernel = false;
+	u32 totalsize;
+
+	if (!buf || received_size < sizeof(struct fdt_header))
+		return -EINVAL;
+
+	if (fdt_check_header(buf) != 0)
+		return -EINVAL;
+
+	totalsize = fdt_totalsize(buf);
+	if (totalsize < sizeof(struct fdt_header) || totalsize > received_size)
+		return -EINVAL;
+
+	if (fit_check_format(buf, (ulong)received_size) != 0)
+		return -EINVAL;
+
+	confs_noffset = fdt_path_offset(buf, FIT_CONFS_PATH);
+	if (confs_noffset < 0 || fdt_first_subnode(buf, confs_noffset) < 0)
+		return -EINVAL;
+
+	images_noffset = fdt_path_offset(buf, FIT_IMAGES_PATH);
+	if (images_noffset < 0)
+		return -EINVAL;
+
+	fdt_for_each_subnode(noffset, buf, images_noffset) {
+		const char *name = fdt_get_name(buf, noffset, NULL);
+		const char *type_str;
+		const fdt32_t *pos_prop;
+		const fdt32_t *off_prop;
+		const fdt32_t *size_prop;
+		int type_len = 0;
+		int pos_len = 0;
+		int off_len = 0;
+		int size_len = 0;
+
+		type_str = fdt_getprop(buf, noffset, FIT_TYPE_PROP, &type_len);
+		if (!type_str || type_len <= 0 ||
+		    type_str[type_len - 1] != '\0')
+			return -EINVAL;
+
+		/*
+		 * Reject sysupgrade.itb images containing a flash rootfs or
+		 * filesystem payload so RAM-only recovery stays listening
+		 * instead of handing an unbootable image to bootm.
+		 */
+		if (strcmp(type_str, "filesystem") == 0 ||
+		    (name && (strncmp(name, "rootfs", 6) == 0 ||
+			      strncmp(name, "filesystem", 10) == 0)))
+			return -EINVAL;
+
+		if (strcmp(type_str, "kernel") == 0 ||
+		    strcmp(type_str, "kernel_noload") == 0)
+			has_kernel = true;
+
+		pos_prop = fdt_getprop(buf, noffset, FIT_DATA_POSITION_PROP,
+				       &pos_len);
+		off_prop = fdt_getprop(buf, noffset, FIT_DATA_OFFSET_PROP,
+				       &off_len);
+		if (pos_prop && off_prop)
+			return -EINVAL;
+
+		if (pos_prop || off_prop) {
+			u64 ext_off;
+			u64 ext_size;
+
+			size_prop = fdt_getprop(buf, noffset,
+						FIT_DATA_SIZE_PROP, &size_len);
+			if (!size_prop || size_len != (int)sizeof(fdt32_t))
+				return -EINVAL;
+			ext_size = (u64)fdt32_ld(size_prop);
+			if (!ext_size)
+				return -EINVAL;
+
+			if (pos_prop) {
+				if (pos_len != (int)sizeof(fdt32_t))
+					return -EINVAL;
+				ext_off = (u64)fdt32_ld(pos_prop);
+			} else {
+				u64 base = ((u64)totalsize + 3ULL) & ~3ULL;
+				u64 rel;
+
+				if (off_len != (int)sizeof(fdt32_t))
+					return -EINVAL;
+				rel = (u64)fdt32_ld(off_prop);
+				if (base > (u64)received_size ||
+				    rel > (u64)received_size - base)
+					return -EINVAL;
+				ext_off = base + rel;
+			}
+
+			if (ext_off > (u64)received_size ||
+			    ext_size > (u64)received_size - ext_off)
+				return -EINVAL;
+		} else {
+			int data_len = 0;
+
+			if (!fdt_getprop(buf, noffset, FIT_DATA_PROP,
+					 &data_len) || data_len <= 0)
+				return -EINVAL;
+		}
+	}
+
+	if (noffset < 0 && noffset != -FDT_ERR_NOTFOUND)
+		return -EINVAL;
+
+	if (!has_kernel)
+		return -EINVAL;
+
+	return 0;
+}
+
+static void httpd_parser_init(struct httpd_parser *p, ulong load_addr,
+			      u8 *dst_buf, size_t max_size)
+{
+	memset(p, 0, sizeof(*p));
+	p->state = HTTPD_ST_HTTP_HDR;
+	p->result = HTTPD_RES_PENDING;
+	p->load_addr = load_addr;
+	p->dst_buf = dst_buf;
+	p->max_size = max_size;
+	p->next_progress = HTTPD_PROGRESS_STEP;
+}
+
+static int httpd_emit_file_bytes(struct httpd_parser *p, const u8 *src,
+				 size_t len)
+{
+	ulong write_addr;
+
+	if (!p->in_file_part || !len)
+		return 0;
+
+	if (!p->dst_buf || len > p->max_size - p->file_size) {
+		p->result = HTTPD_RES_PAYLOAD_TOO_LARGE;
+		p->state = HTTPD_ST_DONE;
+		return -EFBIG;
+	}
+
+	if (p->file_size > (size_t)(~(ulong)0 - p->load_addr)) {
+		p->result = HTTPD_RES_MEM_ERROR;
+		p->state = HTTPD_ST_DONE;
+		return -EFAULT;
+	}
+
+	write_addr = p->load_addr + (ulong)p->file_size;
+	if (httpd_check_mem_range(write_addr, len) != 0) {
+		p->result = HTTPD_RES_MEM_ERROR;
+		p->state = HTTPD_ST_DONE;
+		return -EFAULT;
+	}
+
+	memcpy(p->dst_buf + p->file_size, src, len);
+	p->file_size += len;
+
+	while (p->file_size >= p->next_progress) {
+		putc('.');
+		p->next_progress += HTTPD_PROGRESS_STEP;
+	}
+
+	return 0;
+}
+
+static void httpd_parse_http_hdr(struct httpd_parser *p)
+{
+	const char *hdr = p->hdr_buf;
+	size_t hdr_len = p->hdr_len;
+	const char *line_end;
+	const char *path;
+	const char *sp;
+	size_t path_len;
+	const char *val;
+	size_t val_len;
+
+	line_end = (const char *)httpd_find_bytes((const u8 *)hdr, hdr_len,
+						  (const u8 *)"\r\n", 2);
+	if (!line_end) {
+		p->result = HTTPD_RES_BAD_REQUEST;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	if ((size_t)(line_end - hdr) >= 4 && memcmp(hdr, "GET ", 4) == 0) {
+		path = hdr + 4;
+		sp = memchr(path, ' ', (size_t)(line_end - path));
+		if (!sp || sp == path) {
+			p->result = HTTPD_RES_BAD_REQUEST;
+			p->state = HTTPD_ST_DONE;
+			return;
+		}
+		path_len = (size_t)(sp - path);
+		if ((path_len == 1 && path[0] == '/') ||
+		    (path_len == 11 && memcmp(path, "/index.html", 11) == 0) ||
+		    (path_len >= 2 && path[0] == '/' && path[1] == '?'))
+			p->result = HTTPD_RES_GET_INDEX;
+		else
+			p->result = HTTPD_RES_NOT_FOUND;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	if ((size_t)(line_end - hdr) < 5 || memcmp(hdr, "POST ", 5) != 0) {
+		p->result = HTTPD_RES_METHOD_NOT_ALLOWED;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	path = hdr + 5;
+	sp = memchr(path, ' ', (size_t)(line_end - path));
+	if (!sp || sp == path || path[0] != '/') {
+		p->result = HTTPD_RES_BAD_REQUEST;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	p->is_post = true;
+
+	if (!p->dst_buf) {
+		p->result = HTTPD_RES_BUSY;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	if (httpd_find_header_at(hdr, hdr_len, true, "Transfer-Encoding",
+				 &val, &val_len) &&
+	    httpd_ci_strstr(val, val_len, "chunked")) {
+		p->result = HTTPD_RES_BAD_REQUEST;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	if (!httpd_find_header_at(hdr, hdr_len, true, "Content-Type",
+				  &val, &val_len) ||
+	    httpd_parse_boundary(val, val_len, p->delim, &p->delim_len) != 0) {
+		p->result = HTTPD_RES_BAD_REQUEST;
+		p->state = HTTPD_ST_DONE;
+		return;
+	}
+
+	if (httpd_find_header_at(hdr, hdr_len, true, "Content-Length",
+				 &val, &val_len)) {
+		int ret = httpd_parse_u64_dec(val, val_len, &p->content_length);
+
+		if (ret == -ERANGE ||
+		    (ret == 0 && p->content_length >
+		     (u64)p->max_size + HTTPD_MAX_ENVELOPE_OVERHEAD)) {
+			p->result = HTTPD_RES_PAYLOAD_TOO_LARGE;
+			p->state = HTTPD_ST_DONE;
+			return;
+		}
+		if (ret != 0) {
+			p->result = HTTPD_RES_BAD_REQUEST;
+			p->state = HTTPD_ST_DONE;
+			return;
+		}
+		p->has_content_length = true;
+	}
+
+	if (httpd_find_header_at(hdr, hdr_len, true, "Expect", &val, &val_len) &&
+	    httpd_ci_strstr(val, val_len, "100-continue"))
+		p->need_100_continue = true;
+
+	p->hdr_len = 0;
+	p->state = HTTPD_ST_MP_PREAMBLE;
+}
+
+static void httpd_parse_part_hdr(struct httpd_parser *p)
+{
+	const char *val;
+	size_t val_len;
+	bool is_file = false;
+
+	if (httpd_find_header_at(p->hdr_buf, p->hdr_len, false,
+				 "Content-Disposition", &val, &val_len)) {
+		if (httpd_ci_strstr(val, val_len, "filename="))
+			is_file = true;
+	}
+
+	if (!p->got_file && is_file) {
+		p->in_file_part = true;
+		p->got_file = true;
+		p->file_size = 0;
+	} else {
+		p->in_file_part = false;
+	}
+
+	p->carry_len = 0;
+	p->state = HTTPD_ST_MP_PART_BODY;
+}
+
+static int httpd_account_body(struct httpd_parser *p, size_t n)
+{
+	size_t cap = p->max_size + HTTPD_MAX_ENVELOPE_OVERHEAD;
+
+	if (n > cap - p->body_bytes) {
+		p->result = HTTPD_RES_PAYLOAD_TOO_LARGE;
+		p->state = HTTPD_ST_DONE;
+		return -EFBIG;
+	}
+
+	p->body_bytes += n;
+	return 0;
+}
+
+static enum httpd_result httpd_parser_feed(struct httpd_parser *p,
+					   const u8 *data, size_t len)
+{
+	while (len > 0 && p->state != HTTPD_ST_DONE) {
+		switch (p->state) {
+		case HTTPD_ST_HTTP_HDR: {
+			if (p->hdr_len >= HTTPD_HDR_BUF_SIZE) {
+				p->result = HTTPD_RES_BAD_REQUEST;
+				p->state = HTTPD_ST_DONE;
+				break;
+			}
+			p->hdr_buf[p->hdr_len++] = (char)*data++;
+			len--;
+			if (p->hdr_len >= 4 &&
+			    memcmp(p->hdr_buf + p->hdr_len - 4,
+				   "\r\n\r\n", 4) == 0) {
+				p->hdr_buf[p->hdr_len] = '\0';
+				httpd_parse_http_hdr(p);
+			}
+			break;
+		}
+		case HTTPD_ST_MP_PREAMBLE: {
+			const char *first_delim = p->delim + 2;
+			size_t first_len = p->delim_len - 2;
+
+			if (httpd_account_body(p, 1) != 0)
+				break;
+			if (p->hdr_len >= HTTPD_HDR_BUF_SIZE) {
+				p->result = HTTPD_RES_BAD_REQUEST;
+				p->state = HTTPD_ST_DONE;
+				break;
+			}
+			p->hdr_buf[p->hdr_len++] = (char)*data++;
+			len--;
+			if (p->hdr_len >= first_len &&
+			    memcmp(p->hdr_buf + p->hdr_len - first_len,
+				   first_delim, first_len) == 0) {
+				p->after_len = 0;
+				p->state = HTTPD_ST_MP_AFTER_BOUNDARY;
+			}
+			break;
+		}
+		case HTTPD_ST_MP_AFTER_BOUNDARY: {
+			if (httpd_account_body(p, 1) != 0)
+				break;
+			p->after_buf[p->after_len++] = *data++;
+			len--;
+			if (p->after_len == 2) {
+				if (p->after_buf[0] == '-' &&
+				    p->after_buf[1] == '-') {
+					if (!p->got_file)
+						p->result = HTTPD_RES_BAD_REQUEST;
+					else if (httpd_validate_fit(p->dst_buf,
+								    p->file_size) == 0)
+						p->result = HTTPD_RES_UPLOAD_OK;
+					else
+						p->result = HTTPD_RES_BAD_FIT;
+					p->state = HTTPD_ST_DONE;
+				} else if (p->after_buf[0] == '\r' &&
+					   p->after_buf[1] == '\n') {
+					p->in_file_part = false;
+					p->hdr_len = 0;
+					p->state = HTTPD_ST_MP_PART_HDR;
+				} else {
+					p->result = HTTPD_RES_BAD_REQUEST;
+					p->state = HTTPD_ST_DONE;
+				}
+			}
+			break;
+		}
+		case HTTPD_ST_MP_PART_HDR: {
+			if (httpd_account_body(p, 1) != 0)
+				break;
+			if (p->hdr_len >= HTTPD_HDR_BUF_SIZE) {
+				p->result = HTTPD_RES_BAD_REQUEST;
+				p->state = HTTPD_ST_DONE;
+				break;
+			}
+			p->hdr_buf[p->hdr_len++] = (char)*data++;
+			len--;
+			if (p->hdr_len >= 4 &&
+			    memcmp(p->hdr_buf + p->hdr_len - 4,
+				   "\r\n\r\n", 4) == 0) {
+				p->hdr_buf[p->hdr_len] = '\0';
+				httpd_parse_part_hdr(p);
+			}
+			break;
+		}
+		case HTTPD_ST_MP_PART_BODY: {
+			const u8 *delim = (const u8 *)p->delim;
+			size_t dlen = p->delim_len;
+
+			if (p->carry_len > 0) {
+				u8 seam[2 * HTTPD_DELIM_MAX];
+				size_t take;
+				size_t seam_len;
+				size_t limit;
+				size_t i;
+				bool matched = false;
+
+				if (p->carry_len + len < dlen) {
+					if (httpd_account_body(p, len) != 0)
+						break;
+					memcpy(p->carry + p->carry_len,
+					       data, len);
+					p->carry_len += len;
+					data += len;
+					len = 0;
+					break;
+				}
+
+				take = len < (dlen - 1) ? len : (dlen - 1);
+				memcpy(seam, p->carry, p->carry_len);
+				memcpy(seam + p->carry_len, data, take);
+				seam_len = p->carry_len + take;
+				limit = seam_len - dlen + 1;
+
+				for (i = 0; i < limit; i++) {
+					if (memcmp(seam + i, delim, dlen) == 0) {
+						size_t consumed = (i + dlen) -
+								  p->carry_len;
+
+						if (httpd_account_body(p, consumed) != 0)
+							return p->result;
+						if (httpd_emit_file_bytes(p, seam, i) != 0)
+							return p->result;
+						p->carry_len = 0;
+						p->after_len = 0;
+						p->state = HTTPD_ST_MP_AFTER_BOUNDARY;
+						data += consumed;
+						len -= consumed;
+						matched = true;
+						break;
+					}
+				}
+				if (matched)
+					break;
+
+				if (httpd_emit_file_bytes(p, seam, limit) != 0)
+					break;
+
+				if (take == dlen - 1) {
+					p->carry_len = 0;
+				} else {
+					if (httpd_account_body(p, take) != 0)
+						break;
+					memcpy(p->carry, seam + limit,
+					       dlen - 1);
+					p->carry_len = dlen - 1;
+					data += take;
+					len -= take;
+					break;
+				}
+			}
+
+			if (len < dlen) {
+				if (httpd_account_body(p, len) != 0)
+					break;
+				memcpy(p->carry, data, len);
+				p->carry_len = len;
+				data += len;
+				len = 0;
+			} else {
+				const u8 *hit = httpd_find_bytes(data, len,
+								 delim, dlen);
+
+				if (hit) {
+					size_t before = (size_t)(hit - data);
+					size_t consumed = before + dlen;
+
+					if (httpd_account_body(p, consumed) != 0)
+						break;
+					if (httpd_emit_file_bytes(p, data,
+								  before) != 0)
+						break;
+					p->carry_len = 0;
+					p->after_len = 0;
+					p->state = HTTPD_ST_MP_AFTER_BOUNDARY;
+					data += consumed;
+					len -= consumed;
+				} else {
+					size_t keep = dlen - 1;
+					size_t safe = len - keep;
+
+					if (httpd_account_body(p, len) != 0)
+						break;
+					if (httpd_emit_file_bytes(p, data,
+								  safe) != 0)
+						break;
+					memcpy(p->carry, data + safe, keep);
+					p->carry_len = keep;
+					data += len;
+					len = 0;
+				}
+			}
+			break;
+		}
+		case HTTPD_ST_DONE:
+			len = 0;
+			break;
+		}
+	}
+
+	if (p->state != HTTPD_ST_DONE && p->is_post && p->has_content_length &&
+	    p->body_bytes >= p->content_length) {
+		p->result = HTTPD_RES_BAD_REQUEST;
+		p->state = HTTPD_ST_DONE;
+	}
+
+	return p->result;
+}
+
+static void httpd_release_upload_lock(struct httpd_conn *conn)
+{
+	struct httpd_server *srv = conn->server;
+	int i;
+
+	if (!conn->owns_upload)
+		return;
+
+	conn->owns_upload = false;
+	srv->upload_active = false;
+
+	for (i = 0; i < HTTPD_MAX_CONNS; i++) {
+		struct httpd_conn *other = &srv->conns[i];
+
+		if (other->in_use && !other->closing &&
+		    !other->parser.is_post && !other->parser.dst_buf)
+			other->parser.dst_buf = srv->dst_buf;
+	}
+}
+
+static void httpd_claim_upload_lock(struct httpd_conn *conn)
+{
+	struct httpd_server *srv = conn->server;
+	int i;
+
+	if (conn->owns_upload)
+		return;
+
+	conn->owns_upload = true;
+	srv->upload_active = true;
+
+	for (i = 0; i < HTTPD_MAX_CONNS; i++) {
+		struct httpd_conn *other = &srv->conns[i];
+
+		if (other != conn && other->in_use && !other->owns_upload)
+			other->parser.dst_buf = NULL;
+	}
+}
+
+static void httpd_conn_release(struct httpd_conn *conn)
+{
+	httpd_release_upload_lock(conn);
+	conn->pcb = NULL;
+	conn->tx_pending = 0;
+	conn->idle_polls = 0;
+	conn->closing = false;
+	conn->is_success_upload = false;
+	conn->in_use = false;
+}
+
+static err_t httpd_poll_cb(void *arg, struct tcp_pcb *tpcb);
+static void httpd_err_cb(void *arg, err_t err);
+
+static err_t httpd_conn_close(struct httpd_conn *conn)
+{
+	struct tcp_pcb *pcb = conn->pcb;
+	err_t err;
+
+	if (!pcb) {
+		httpd_conn_release(conn);
+		return ERR_OK;
+	}
+
+	tcp_arg(pcb, NULL);
+	tcp_recv(pcb, NULL);
+	tcp_sent(pcb, NULL);
+	tcp_err(pcb, NULL);
+	tcp_poll(pcb, NULL, 0);
+
+	err = tcp_close(pcb);
+	if (err != ERR_OK) {
+		tcp_arg(pcb, conn);
+		tcp_err(pcb, httpd_err_cb);
+		tcp_poll(pcb, httpd_poll_cb, HTTPD_POLL_INTERVAL);
+		if (!conn->closing)
+			conn->idle_polls = 0;
+		conn->closing = true;
+		return err;
+	}
+
+	httpd_conn_release(conn);
+	return ERR_OK;
+}
+
+static void httpd_send_response(struct httpd_conn *conn, const char *status,
+				const char *body)
+{
+	char hdr[256];
+	size_t body_len = strlen(body);
+	int hdr_len;
+	err_t err;
+
+	if (!conn->pcb)
+		return;
+
+	hdr_len = snprintf(hdr, sizeof(hdr),
+			   "HTTP/1.1 %s\r\n"
+			   "Content-Type: text/html; charset=utf-8\r\n"
+			   "Content-Length: %zu\r\n"
+			   "Connection: close\r\n"
+			   "\r\n",
+			   status, body_len);
+	if (hdr_len <= 0 || (size_t)hdr_len >= sizeof(hdr))
+		return;
+
+	err = tcp_write(conn->pcb, hdr, (u16_t)hdr_len, TCP_WRITE_FLAG_COPY);
+	if (err == ERR_OK) {
+		conn->tx_pending += (u32)hdr_len;
+		if (body_len > 0) {
+			err = tcp_write(conn->pcb, body, (u16_t)body_len,
+					TCP_WRITE_FLAG_COPY);
+			if (err == ERR_OK)
+				conn->tx_pending += (u32)body_len;
+		}
+		tcp_output(conn->pcb);
+	}
+
+	conn->closing = true;
+	conn->idle_polls = 0;
+}
+
+static err_t httpd_sent_cb(void *arg, struct tcp_pcb *tpcb, u16_t len)
+{
+	struct httpd_conn *conn = arg;
+	struct httpd_server *srv;
+
+	(void)tpcb;
+	if (!conn)
+		return ERR_OK;
+
+	if (len > 0)
+		conn->idle_polls = 0;
+
+	srv = conn->server;
+	if (len >= conn->tx_pending)
+		conn->tx_pending = 0;
+	else
+		conn->tx_pending -= len;
+
+	if (conn->closing && conn->tx_pending == 0) {
+		bool was_ok = conn->is_success_upload;
+
+		httpd_conn_close(conn);
+		if (was_ok)
+			srv->response_flushed = true;
+	}
+
+	return ERR_OK;
+}
+
+static err_t httpd_poll_cb(void *arg, struct tcp_pcb *tpcb)
+{
+	struct httpd_conn *conn = arg;
+
+	if (!conn)
+		return ERR_OK;
+
+	if (conn->closing && conn->tx_pending == 0) {
+		bool was_ok = conn->is_success_upload;
+		struct httpd_server *srv = conn->server;
+
+		if (httpd_conn_close(conn) == ERR_OK) {
+			if (was_ok)
+				srv->response_flushed = true;
+			return ERR_OK;
+		}
+	}
+
+	conn->idle_polls++;
+	if ((conn->closing && conn->idle_polls >= HTTPD_CLOSING_TIMEOUT_POLLS) ||
+	    (!conn->closing && conn->idle_polls >= HTTPD_IDLE_TIMEOUT_POLLS)) {
+		bool was_ok = conn->is_success_upload;
+		struct httpd_server *srv = conn->server;
+		struct tcp_pcb *pcb = conn->pcb ? conn->pcb : tpcb;
+
+		if (pcb) {
+			tcp_arg(pcb, NULL);
+			tcp_recv(pcb, NULL);
+			tcp_sent(pcb, NULL);
+			tcp_err(pcb, NULL);
+			tcp_poll(pcb, NULL, 0);
+		}
+		httpd_conn_release(conn);
+		if (was_ok)
+			srv->response_flushed = true;
+		if (pcb) {
+			tcp_abort(pcb);
+			return ERR_ABRT;
+		}
+	}
+
+	return ERR_OK;
+}
+
+static void httpd_err_cb(void *arg, err_t err)
+{
+	struct httpd_conn *conn = arg;
+
+	(void)err;
+	if (!conn)
+		return;
+
+	/* lwIP has already freed the pcb when err_cb is invoked. */
+	if (conn->is_success_upload)
+		conn->server->response_flushed = true;
+	httpd_conn_release(conn);
+}
+
+static err_t httpd_recv_cb(void *arg, struct tcp_pcb *tpcb, struct pbuf *p,
+			   err_t err)
+{
+	struct httpd_conn *conn = arg;
+	struct httpd_server *srv;
+	struct pbuf *q;
+	enum httpd_result res = HTTPD_RES_PENDING;
+
+	if (!conn) {
+		if (p)
+			pbuf_free(p);
+		return ERR_OK;
+	}
+
+	srv = conn->server;
+
+	if (!p) {
+		httpd_conn_close(conn);
+		return ERR_OK;
+	}
+
+	if (err != ERR_OK) {
+		pbuf_free(p);
+		return ERR_OK;
+	}
+
+	if (!conn->closing && p->tot_len > 0)
+		conn->idle_polls = 0;
+
+	if (!conn->closing && !srv->upload_succeeded) {
+		for (q = p; q; q = q->next) {
+			res = httpd_parser_feed(&conn->parser,
+						(const u8 *)q->payload, q->len);
+			if (res == HTTPD_RES_PENDING &&
+			    conn->parser.is_post && !conn->owns_upload &&
+			    conn->parser.dst_buf)
+				httpd_claim_upload_lock(conn);
+			if (res != HTTPD_RES_PENDING)
+				break;
+		}
+		if (conn->parser.need_100_continue) {
+			conn->parser.need_100_continue = false;
+			if (res == HTTPD_RES_PENDING) {
+				static const char cont[] =
+					"HTTP/1.1 100 Continue\r\n\r\n";
+
+				if (tcp_write(tpcb, cont, sizeof(cont) - 1,
+					      TCP_WRITE_FLAG_COPY) == ERR_OK) {
+					conn->tx_pending += sizeof(cont) - 1;
+					tcp_output(tpcb);
+				}
+			}
+		}
+	}
+
+	tcp_recved(tpcb, p->tot_len);
+	pbuf_free(p);
+
+	if (conn->closing || res == HTTPD_RES_PENDING)
+		return ERR_OK;
+
+	switch (res) {
+	case HTTPD_RES_GET_INDEX:
+		httpd_send_response(conn, "200 OK", httpd_index_html);
+		break;
+	case HTTPD_RES_UPLOAD_OK:
+		printf("\nHTTP FIT upload complete: %zu bytes (0x%zx) at 0x%lx\n",
+		       conn->parser.file_size, conn->parser.file_size,
+		       srv->load_addr);
+		conn->is_success_upload = true;
+		srv->upload_succeeded = true;
+		srv->uploaded_size = conn->parser.file_size;
+		srv->flush_start = get_timer(0);
+		httpd_led_signal_success(&srv->leds);
+		httpd_send_response(conn, "200 OK", httpd_ok_html);
+		break;
+	case HTTPD_RES_BAD_FIT:
+		printf("\nHTTP upload rejected: invalid FIT image (%zu bytes)\n",
+		       conn->parser.file_size);
+		httpd_release_upload_lock(conn);
+		httpd_led_signal_error(&srv->leds);
+		httpd_send_response(conn, "400 Bad Request", httpd_bad_fit_html);
+		break;
+	case HTTPD_RES_PAYLOAD_TOO_LARGE:
+		printf("\nHTTP upload rejected: payload exceeds 64 MiB limit\n");
+		httpd_release_upload_lock(conn);
+		httpd_led_signal_error(&srv->leds);
+		httpd_send_response(conn, "413 Payload Too Large",
+				    httpd_too_large_html);
+		break;
+	case HTTPD_RES_NOT_FOUND:
+		httpd_send_response(conn, "404 Not Found", httpd_not_found_html);
+		break;
+	case HTTPD_RES_METHOD_NOT_ALLOWED:
+		httpd_send_response(conn, "405 Method Not Allowed",
+				    httpd_method_html);
+		break;
+	case HTTPD_RES_BUSY:
+		httpd_send_response(conn, "503 Service Unavailable",
+				    httpd_busy_html);
+		break;
+	case HTTPD_RES_MEM_ERROR:
+		printf("\nHTTP upload rejected: target memory reserved or out of bounds\n");
+		httpd_release_upload_lock(conn);
+		httpd_led_signal_error(&srv->leds);
+		httpd_send_response(conn, "500 Internal Server Error",
+				    httpd_mem_err_html);
+		break;
+	case HTTPD_RES_BAD_REQUEST:
+	default:
+		printf("\nHTTP upload rejected: malformed request\n");
+		httpd_release_upload_lock(conn);
+		httpd_led_signal_error(&srv->leds);
+		httpd_send_response(conn, "400 Bad Request", httpd_bad_req_html);
+		break;
+	}
+
+	return ERR_OK;
+}
+
+static err_t httpd_accept_cb(void *arg, struct tcp_pcb *newpcb, err_t err)
+{
+	struct httpd_server *srv = arg;
+	struct httpd_conn *conn = NULL;
+	int i;
+
+	if (err != ERR_OK || !newpcb || !srv)
+		return ERR_VAL;
+
+	for (i = 0; i < HTTPD_MAX_CONNS; i++) {
+		if (!srv->conns[i].in_use) {
+			conn = &srv->conns[i];
+			break;
+		}
+	}
+
+	if (!conn) {
+		tcp_abort(newpcb);
+		return ERR_ABRT;
+	}
+
+	memset(conn, 0, sizeof(*conn));
+	conn->server = srv;
+	conn->pcb = newpcb;
+	conn->in_use = true;
+	httpd_parser_init(&conn->parser, srv->load_addr,
+			  srv->upload_active ? NULL : srv->dst_buf,
+			  srv->max_size);
+
+	tcp_arg(newpcb, conn);
+	tcp_recv(newpcb, httpd_recv_cb);
+	tcp_sent(newpcb, httpd_sent_cb);
+	tcp_err(newpcb, httpd_err_cb);
+	tcp_poll(newpcb, httpd_poll_cb, HTTPD_POLL_INTERVAL);
+
+	return ERR_OK;
+}
+
+static void httpd_server_cleanup(struct httpd_server *srv)
+{
+	int i;
+
+	/* Stop UDP DHCP server immediately on every exit path. */
+	httpd_dhcp_stop(&srv->dhcp);
+
+	for (i = 0; i < HTTPD_MAX_CONNS; i++) {
+		struct httpd_conn *conn = &srv->conns[i];
+
+		if (!conn->in_use)
+			continue;
+		if (conn->pcb) {
+			struct tcp_pcb *pcb = conn->pcb;
+
+			tcp_arg(pcb, NULL);
+			tcp_recv(pcb, NULL);
+			tcp_sent(pcb, NULL);
+			tcp_err(pcb, NULL);
+			tcp_poll(pcb, NULL, 0);
+			tcp_abort(pcb);
+		}
+		httpd_conn_release(conn);
+	}
+
+	if (srv->listen_pcb) {
+		tcp_arg(srv->listen_pcb, NULL);
+		tcp_accept(srv->listen_pcb, NULL);
+		tcp_close(srv->listen_pcb);
+		srv->listen_pcb = NULL;
+	}
+}
+
+static int httpd_loop(struct udevice *udev, ulong load_addr)
+{
+	struct httpd_server *srv;
+	struct netif *netif;
+	struct tcp_pcb *pcb;
+	const char *ip_str;
+	int prev_ctrlc;
+	int ret = -1;
+
+	netif = net_lwip_new_netif(udev);
+	if (!netif)
+		return -ENODEV;
+
+	srv = calloc(1, sizeof(*srv));
+	if (!srv) {
+		net_lwip_remove_netif(netif);
+		return -ENOMEM;
+	}
+
+	httpd_led_init(&srv->leds);
+
+	srv->load_addr = load_addr;
+	srv->max_size = HTTPD_MAX_UPLOAD_SIZE;
+	srv->dst_buf = map_sysmem(load_addr, srv->max_size);
+
+	pcb = tcp_new();
+	if (!pcb) {
+		printf("httpd: failed to allocate TCP PCB\n");
+		ret = -ENOMEM;
+		goto out_cleanup;
+	}
+
+	ip_set_option(pcb, SOF_REUSEADDR);
+	if (tcp_bind(pcb, IP_ADDR_ANY, HTTPD_PORT) != ERR_OK) {
+		printf("httpd: failed to bind port %d\n", HTTPD_PORT);
+		tcp_close(pcb);
+		ret = -EADDRINUSE;
+		goto out_cleanup;
+	}
+
+	srv->listen_pcb = tcp_listen(pcb);
+	if (!srv->listen_pcb) {
+		printf("httpd: failed to listen on port %d\n", HTTPD_PORT);
+		tcp_close(pcb);
+		ret = -ENOMEM;
+		goto out_cleanup;
+	}
+
+	tcp_arg(srv->listen_pcb, srv);
+	tcp_accept(srv->listen_pcb, httpd_accept_cb);
+
+	httpd_dhcp_start(srv, netif);
+
+	ip_str = env_get("ipaddr");
+	printf("Using %s device\n", udev->name);
+	printf("RAM-only HTTP recovery listening on http://%s:%d/\n",
+	       ip_str ? ip_str : HTTPD_DEFAULT_IPADDR, HTTPD_PORT);
+	if (srv->dhcp.pcb)
+		printf("DHCPv4 server active on UDP port %d (%u-slot pool, %us lease)\n",
+		       LWIP_IANA_PORT_DHCP_SERVER, srv->dhcp.pool_count,
+		       HTTPD_DHCP_LEASE_SEC);
+	printf("Load address: 0x%lx (max %lu MiB, no flash writes)\n",
+	       load_addr, srv->max_size >> 20);
+	printf("Press Ctrl-C to abort.\n");
+
+	prev_ctrlc = disable_ctrlc(0);
+
+	while (1) {
+		net_lwip_rx(udev, netif);
+		httpd_led_poll(&srv->leds, srv->upload_active);
+
+		if (srv->upload_succeeded) {
+			if (srv->response_flushed ||
+			    get_timer(srv->flush_start) >= HTTPD_FLUSH_TIMEOUT_MS) {
+				ulong drain_start = get_timer(0);
+
+				while (get_timer(drain_start) < HTTPD_FIN_DRAIN_MS)
+					net_lwip_rx(udev, netif);
+				ret = 0;
+				break;
+			}
+		}
+
+		if (ctrlc()) {
+			printf("\nAbort\n");
+			ret = -EINTR;
+			break;
+		}
+	}
+
+	disable_ctrlc(prev_ctrlc);
+	printf("DHCP stats: rx=%u offer=%u ack=%u nak=%u drop=%u tx_err=%u\n",
+	       srv->dhcp.stat_rx, srv->dhcp.stat_offer, srv->dhcp.stat_ack,
+	       srv->dhcp.stat_nak, srv->dhcp.stat_drop,
+	       srv->dhcp.stat_tx_err);
+
+	if (ret == 0) {
+		if (env_set_hex("filesize", srv->uploaded_size) ||
+		    env_set_hex("fileaddr", load_addr)) {
+			printf("httpd: failed to set filesize/fileaddr\n");
+			ret = -EIO;
+		} else {
+			image_load_addr = load_addr;
+		}
+	}
+
+out_cleanup:
+	httpd_server_cleanup(srv);
+	httpd_led_finish(&srv->leds, ret == 0);
+	unmap_sysmem(srv->dst_buf);
+	free(srv);
+	net_lwip_remove_netif(netif);
+	return ret;
+}
+
+static int httpd_run_recovery(ulong load_addr)
+{
+	const char *val;
+	int ret;
+
+	httpd_ran_this_boot = true;
+
+	if (httpd_check_mem_range(load_addr, HTTPD_MIN_CHECK_SIZE) != 0) {
+		printf("httpd: load address 0x%lx is reserved or out of bounds\n",
+		       load_addr);
+		return -EFAULT;
+	}
+
+	/* Ensure RAM-only network defaults if an older ubootenv lacks them. */
+	val = env_get("ipaddr");
+	if (!val || !*val)
+		env_set("ipaddr", HTTPD_DEFAULT_IPADDR);
+	val = env_get("netmask");
+	if (!val || !*val)
+		env_set("netmask", HTTPD_DEFAULT_NETMASK);
+
+	if (net_lwip_eth_start() < 0)
+		return -ENODEV;
+
+	ret = httpd_loop(eth_get_dev(), load_addr);
+	net_lwip_eth_stop();
+
+	return ret;
+}
+
+#if CONFIG_IS_ENABLED(EVENT) && CONFIG_IS_ENABLED(BUTTON)
+static ulong httpd_resolve_fallback_addr(void)
+{
+	const char *val = env_get("initaddr");
+
+	if (val && *val) {
+		char *end;
+		ulong addr = hextoul(val, &end);
+
+		if (!*end && addr &&
+		    httpd_check_mem_range(addr, HTTPD_MIN_CHECK_SIZE) == 0)
+			return addr;
+	}
+
+	return HTTPD_DEFAULT_LOAD_ADDR;
+}
+
+static int httpd_post_preboot_reset_check(void)
+{
+	struct udevice *btn = NULL;
+	ulong load_addr;
+
+	if (httpd_ran_this_boot)
+		return 0;
+
+	if (button_get_by_label("reset", &btn) != 0 || !btn ||
+	    button_get_state(btn) != BUTTON_ON)
+		return 0;
+
+	printf("Reset button held - entering RAM-only HTTP recovery\n");
+	load_addr = httpd_resolve_fallback_addr();
+	if (httpd_run_recovery(load_addr) == 0)
+		run_command("bootm $fileaddr", 0);
+
+	return 0;
+}
+EVENT_SPY_SIMPLE(EVT_POST_PREBOOT, httpd_post_preboot_reset_check);
+#endif
+
+static int do_httpd(struct cmd_tbl *cmdtp, int flag, int argc,
+		    char *const argv[])
+{
+	ulong load_addr;
+	const char *val;
+
+	(void)cmdtp;
+	(void)flag;
+	httpd_ran_this_boot = true;
+
+	if (argc > 2)
+		return CMD_RET_USAGE;
+
+	if (argc == 2) {
+		char *end;
+
+		load_addr = hextoul(argv[1], &end);
+		if (*end || !load_addr)
+			return CMD_RET_USAGE;
+	} else {
+		val = env_get("initaddr");
+		if (val && *val) {
+			char *end;
+
+			load_addr = hextoul(val, &end);
+			if (*end) {
+				printf("httpd: invalid initaddr '%s'\n", val);
+				return CMD_RET_FAILURE;
+			}
+		} else {
+			load_addr = HTTPD_DEFAULT_LOAD_ADDR;
+		}
+	}
+
+	return httpd_run_recovery(load_addr) == 0 ?
+	       CMD_RET_SUCCESS : CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(httpd, 2, 0, do_httpd,
+	   "start RAM-only HTTP FIT recovery server",
+	   "[loadAddress]\n"
+	   "    - listen on TCP port 80 and load uploaded FIT image into RAM");
