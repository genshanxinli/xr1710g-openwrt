# Source: 本仓库自持（上游 PR #30370/#30406 仅改版本与 hash；本补丁多一个 ipset 依赖）
# Upstream: openwrt/packages PR #30370 / #30406（update netbird to 0.78.1，均仍 open）；合入即删
# Reason: 官方 feed 的 netbird 0.73.2 早于 v0.76.0 的本地提权修复（GHSA-qcpp-8vwj-hhwr）；
#         且本机要做内核态 WireGuard 组网（G3），需要新版客户端。
#
# ⚠️ **落地机制（实施期更正，代价是一次 CI 红）**：本补丁打的是 **feed 包 Makefile**，
#    位于 `<tree>/feeds/packages/net/netbird/Makefile`，相对 `feeds/packages` 根（`-p1` → `net/netbird/Makefile`）。
#
#    为什么**不能**走 `patches/packages/…` 拷贝到 `package/feeds/packages/net/netbird/patches/`：
#    那条路把补丁当成 **包源码补丁**，在解开的 netbird tarball 上以 `patch -p1` 应用。
#    但该 tarball 是**上游源码仓库**（含 netbird 项目自己的 Makefile），**没有** OpenWrt 包 Makefile；
#    而且 OpenWrt 的 Go 配方（`golang-package.mk` → `golang-build.sh build`）**根本不调用源码里的 make**。
#    ⇒ 补丁必然 `Patch failed!`（`verify-copy-patches.sh` 实机复现；改动前 CI 因"未知拷贝目标——跳过"
#      而**静默未校验**，是更危险的假绿）。
#    ⇒ 正确机制：feeds update/install **之后**用 `git apply` 打到 feed 克隆上（`scripts/patch-feeds.sh`，
#      由 build.sh 与 CI 在 feeds 步骤后调用）。
#
# 效果（对 feeds/packages/net/netbird/Makefile 应用）：
#   1) PKG_VERSION 0.73.2 → 0.78.1，PKG_HASH 同步（**实算**，非抄 PR）
#   2) DEPENDS 增补 +kmod-ipt-ipset（本地偏离，见下）
#
# 关于 +kmod-ipt-ipset（**刻意的本地偏离，必须记账**）：
#   - netbird 的 ipset 依赖只作用于 **iptables 后端**；nftables 后端用原生 nft set，不需要 ipset。
#   - 0.73.2 缺 ipset 时会把 ACL 规则**静默回滚为空**（netbirdio/netbird#7134）；
#     0.78.1 已含 v0.77.0 的 probeIPSetSupport 回退 ⇒ 该失败模式本身已被上游修掉。
#   - 保留 +kmod-ipt-ipset 是 belt and braces：一旦退回 iptables 后端（#4484/#3363），ACL 仍能建立。
#   - ⚠️ **不存在 kmod-ipset 这个包名**；提供 IP_SET_HASH_NET 的只有 kmod-ipt-ipset（netfilter.mk:403）。
#
# 关于 DEPENDS 未加 +ca-bundle：默认镜像 DEFAULT_PACKAGES 已含 ca-bundle（include/target.mk）。
# 关于 PKG_MIRROR_HASH：上游没有，本补丁也不加（见 include/download.mk）。
# 关于 CGO_ENABLED：**不要**改 CGO_ENABLED=0 —— golang-package.mk 强制 CGO_ENABLED=1 +
#   -linkmode external，两者组合是硬链接错误（本机已复现）。上游即动态链接，本仓库遵循。
--- a/net/netbird/Makefile	2026-09-12 00:37:48.225134601 +0800
+++ b/net/netbird/Makefile	2026-09-12 00:37:48.248241105 +0800
@@ -1,12 +1,12 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=netbird
-PKG_VERSION:=0.73.2
+PKG_VERSION:=0.78.1
 PKG_RELEASE:=1
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://codeload.github.com/netbirdio/netbird/tar.gz/v$(PKG_VERSION)?
-PKG_HASH:=ba8d1615a6676e6d17f5d4a3c8027cd2e7437c862da3f963d3b337c09efff423
+PKG_HASH:=2adde8bbd77ea595b5f50174be10574466f1c07fc9fbf827024245aec2f4dabc
 
 PKG_MAINTAINER:=Wesley Gimenes <wehagy@proton.me>
 PKG_LICENSE:=BSD-3-Clause
@@ -29,7 +29,7 @@
   SUBMENU:=VPN
   TITLE:=Connect your devices into a single secure private WireGuard®-based mesh network
   URL:=https://netbird.io
-  DEPENDS:=$(GO_ARCH_DEPENDS) +kmod-wireguard
+  DEPENDS:=$(GO_ARCH_DEPENDS) +kmod-wireguard +kmod-ipt-ipset
 endef
 
 define Package/netbird/description
