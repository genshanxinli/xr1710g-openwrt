# Source: orangeyoo（VRT/OpenW1700k 生态补丁层）`patches/openwrt/0103-*` + `0104-*`
#   （缓存 research-20260912/p2-src/0103-xr1710g-prevent-duplicate-dhcpv6-clients.patch、
#   0104-xr1710g-dhcpv6-package-revisions.patch，2026-09-12 抓取）
# Upstream: n/a（作者自持；无上游 PR——上游 PPP/odhcp6c 未内建双客户端互斥）
# Reason: **PPPoE 自动 IPv6 与显式 DHCPv6 双客户端互斥**（handoff P2 §2.2）。本仓
#   files/etc/config/network 预置 `config interface 'wan6' { proto 'dhcpv6' }`，注释写
#   "PPPoE 在 LuCI 面板改"；用户切成 PPPoE 后 PPP 的 ipv6=auto 再建一个动态 DHCPv6
#   接口（ppp6-up 的 AUTOIPV6 路径）→ 两个 odhcp6c 跑同一 L3 设备，而 odhcp6c 的 ubus
#   对象名是 `odhcp6c.<设备>`（真源 src/ubus.c ubus_init()：ifname = cmdline 末参，
#   proto_run_command 把 `$iface` 作为末参传入）→ 第二个 ubus_add_object 返回 EEXIST →
#   进程退出 → netifd 重启 → **IPv6 间歇不可用**。即"已文档化操作路径"必踩的坑。
#   修法：冲突时**只让后到的 netifd 客户端不启动**（不快刀杀进程、不重写用户 UCI）：
#     ① ppp6-up 建 auto IPv6 前问 guard：同设备已有启用的显式 dhcpv6 接口（含 @parent
#        间接引用，深度上限 16 防环）→ 清空 AUTOIPV6；
#     ② dhcpv6.sh 的 proto_dhcpv6_setup() 入口问 guard：同设备已有**另一个 netifd 接口**的
#        odhcp6c（/proc/<pid>/cmdline 末参比对设备、/proc/<pid>/environ 的 INTERFACE= 归属
#        不同接口）→ logger + proto_notify_error DHCPV6_DUPLICATE_CLIENT +
#        proto_block_restart 打断重启循环。
#   guard 脚本本体走 overlay：files/lib/netifd/xr1710g-dhcpv6-guard.sh（非本补丁，随
#   files/ 落盘）；其中 config_load/config_get_* 全包在**子 shell** 里，避免污染 PPP hook
#   的 JSON/env（config_* 会改写 CONFIG_* 变量）。
# 档位 **default**：不改变默认行为（无冲突时 guard 返回"无冲突"，两条路径与现状逐字等价），
#   只在真的出现双客户端时生效；且不杀无 INTERFACE= 的第三方 odhcp6c（手工调试不受影响）。
# 实证：对目标树 f0d3e332（dryrun/owrt）抽取内层后 `patch -p1 --fuzz=0 --dry-run` 全洁净
#   （见 FIXES F117 备注）。
# 注意：本项**修正**了缓存 0103 的两处基线漂移——原 @@ -85,6 与 @@ -16,6 的行号/上下文
#   是按作者树写的；此处按目标树真源重算为 @@ -72,6 +72,16 @@（dhcpv6.sh，插入点
#   `local iface="$2"` 之后）与 @@ -15,6 +15,13 @@（ppp6-up，插入点 19 行之前）。
# 目录形态：package/network/services/ppp/patches/ 上游已存在；package/network/ipv6/odhcp6c/
#   上游**无 patches/ 目录**——本外层 `new file mode` 直接创建，OpenWrt 构建期按目录 glob
#   应用，无需脚本 mkdir（对比 MANIFEST 中 mt76 的"目录由脚本 mkdir"做法，此处走补丁自带目录）。

diff --git a/package/network/ipv6/odhcp6c/patches/001-xr1710g-dhcpv6-duplicate-guard.patch b/package/network/ipv6/odhcp6c/patches/001-xr1710g-dhcpv6-duplicate-guard.patch
new file mode 100644
--- /dev/null
+++ b/package/network/ipv6/odhcp6c/patches/001-xr1710g-dhcpv6-duplicate-guard.patch
@@ -0,0 +1,29 @@
+#
+# 内层补丁（本文件由 patches/root/9056 外层包裹，构建时由包 patches/ 目录应用）。
+#
+# XR1710G: 显式 dhcpv6 客户端去重（F117，P2 §2.2）
+# 机制：proto_dhcpv6_setup() 入口检测同一 L3 设备上是否已有**另一个 netifd 接口**的
+#   odhcp6c（/proc/<pid>/cmdline 末参 = 设备名，environ INTERFACE= 归属不同逻辑接口）——
+#   有则 logger + proto_notify_error DHCPV6_DUPLICATE_CLIENT + proto_block_restart 拒绝启动，
+#   避免 odhcp6c 的 ubus 对象 `odhcp6c.<设备>`（src/ubus.c ubus_init()）注册 EEXIST → 反复重启。
+#   绝不杀没有 INTERFACE= 的第三方 odhcp6c。
+# 上下文按目标树 f0d3e332 真源重算：插入点 = `local iface="$2"`（真源 74 行）之后。
+--- a/package/network/ipv6/odhcp6c/files/dhcpv6.sh
++++ b/package/network/ipv6/odhcp6c/files/dhcpv6.sh
+@@ -72,6 +72,16 @@
+ proto_dhcpv6_setup() {
+ 	local config="$1"
+ 	local iface="$2"
++	if [ -r /lib/netifd/xr1710g-dhcpv6-guard.sh ]; then
++		. /lib/netifd/xr1710g-dhcpv6-guard.sh
++		if xr_dhcpv6_conflict "$config" "$iface"; then
++			logger -t dhcpv6 'Duplicate DHCPv6 client blocked; keep one IPv6 interface per device'
++			proto_notify_error "$config" DHCPV6_DUPLICATE_CLIENT
++			proto_block_restart "$config"
++			return 1
++		fi
++	fi
++
+ 
+ 	local reqaddress reqprefix clientid sendclientid reqopts defaultreqopts
+ 	local noslaaconly forceprefix extendprefix norelease strict_rfc7550

diff --git a/package/network/ipv6/odhcp6c/patches/002-xr1710g-dhcpv6-package-revision.patch b/package/network/ipv6/odhcp6c/patches/002-xr1710g-dhcpv6-package-revision.patch
new file mode 100644
--- /dev/null
+++ b/package/network/ipv6/odhcp6c/patches/002-xr1710g-dhcpv6-package-revision.patch
@@ -0,0 +1,18 @@
+#
+# 内层补丁（本文件由 patches/root/9056 外层包裹，构建时由包 patches/ 目录应用）。
+#
+# XR1710G: odhcp6c 包 revision bump（F117，P2 §2.2 的 0104 部分）
+# 目的：让内层 001（dhcpv6.sh 去重）带上本层特性标识——否则同版本号下 opkg 不重装。
+# 基线核对（目标树 f0d3e332 实测 grep）：PKG_RELEASE:=3 → 4
+#   （与缓存 0104 基线一致；上游 bump 版本号时接受漂移，届时按真源重对齐本内层）。
+--- a/package/network/ipv6/odhcp6c/Makefile
++++ b/package/network/ipv6/odhcp6c/Makefile
+@@ -8,7 +8,7 @@
+ include $(TOPDIR)/rules.mk
+ 
+ PKG_NAME:=odhcp6c
+-PKG_RELEASE:=3
++PKG_RELEASE:=4
+ 
+ PKG_SOURCE_PROTO:=git
+ PKG_SOURCE_URL=$(PROJECT_GIT)/project/odhcp6c.git

diff --git a/package/network/services/ppp/patches/001-xr1710g-dhcpv6-duplicate-guard.patch b/package/network/services/ppp/patches/001-xr1710g-dhcpv6-duplicate-guard.patch
new file mode 100644
--- /dev/null
+++ b/package/network/services/ppp/patches/001-xr1710g-dhcpv6-duplicate-guard.patch
@@ -0,0 +1,24 @@
+#
+# 内层补丁（本文件由 patches/root/9056 外层包裹，构建时由包 patches/ 目录应用）。
+#
+# XR1710G: PPP 自动 IPv6 与显式 dhcpv6 的双客户端互斥（F117，P2 §2.2）
+# 机制：ppp6-up 建 auto IPv6 之前先问 guard——同一 L3 设备上已有启用的显式 dhcpv6
+#   接口（wan6 device @wan 链）时清空 AUTOIPV6，不再 add_dynamic 第二个客户端。
+# guard：/lib/netifd/xr1710g-dhcpv6-guard.sh（overlay files/ 落盘，非本补丁）。
+# 上下文按目标树 f0d3e332 真源重算：插入点 = 真源 19 行 `if [ -n "$AUTOIPV6" ]` 之前。
+--- a/package/network/services/ppp/files/lib/netifd/ppp6-up
++++ b/package/network/services/ppp/files/lib/netifd/ppp6-up
+@@ -15,6 +15,13 @@
+ 		[ -x "$SCRIPT" ] && "$SCRIPT" "$@"
+ 	done
+ }
++
++if [ -n "$AUTOIPV6" ] && [ -r /lib/netifd/xr1710g-dhcpv6-guard.sh ]; then
++	. /lib/netifd/xr1710g-dhcpv6-guard.sh
++	if xr_dhcpv6_has_explicit "$PPP_IPPARAM" "$IFNAME"; then
++		AUTOIPV6=
++	fi
++fi
+ 
+ if [ -n "$AUTOIPV6" ]; then
+ 	ZONE=$(fw3 -q network $PPP_IPPARAM 2>/dev/null)

diff --git a/package/network/services/ppp/patches/002-xr1710g-dhcpv6-package-revision.patch b/package/network/services/ppp/patches/002-xr1710g-dhcpv6-package-revision.patch
new file mode 100644
--- /dev/null
+++ b/package/network/services/ppp/patches/002-xr1710g-dhcpv6-package-revision.patch
@@ -0,0 +1,18 @@
+#
+# 内层补丁（本文件由 patches/root/9056 外层包裹，构建时由包 patches/ 目录应用）。
+#
+# XR1710G: ppp 包 revision bump（F117，P2 §2.2 的 0104 部分）
+# 目的：让内层 001（ppp6-up guard 调用）带上本层特性标识——否则同版本号下 opkg 不重装。
+# 基线核对（目标树 f0d3e332 实测 grep）：PKG_VERSION:=2.5.3 / PKG_RELEASE:=2 → 3
