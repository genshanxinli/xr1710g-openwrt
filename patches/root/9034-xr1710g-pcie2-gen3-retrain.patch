diff --git a/target/linux/airoha/patches-6.18/9996-PCI-mediatek-gen3-EN7581-pcie2-Gen3-retrain.patch b/target/linux/airoha/patches-6.18/9996-PCI-mediatek-gen3-EN7581-pcie2-Gen3-retrain.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9996-PCI-mediatek-gen3-EN7581-pcie2-Gen3-retrain.patch
@@ -0,0 +1,131 @@
+--- a/drivers/pci/controller/pcie-mediatek-gen3.c
++++ b/drivers/pci/controller/pcie-mediatek-gen3.c
+@@ -35,6 +35,9 @@
+ #define SCU_PCIC			0x88
+ #define SCU_PCIC_PCIE_CTRL		GENMASK(7, 0)
+ 
++#define NP_SCU_LANE_CFG0		0x830
++#define NP_SCU_LANE_CFG0_PCIE2_SERDES_RST	BIT(27)
++
+ /* PCIe register */
+ #define PCIE_BASE_CFG_REG		0x14
+ #define PCIE_BASE_CFG_SPEED		GENMASK(15, 8)
+@@ -219,6 +222,9 @@
+ 	u8 max_link_speed;
+ 	u8 num_lanes;
+ 
++	struct regmap *np_scu;
++	unsigned int serdes_retrain;
++
+ 	int irq;
+ 	u32 saved_irq_state;
+ 	raw_spinlock_t irq_lock;
+@@ -411,6 +417,83 @@
+ 	writel_relaxed(val, pcie->base + PCIE_INT_ENABLE_REG);
+ }
+ 
++static int mtk_pcie_en7581_read_rootport_speed(struct mtk_gen3_pcie *pcie)
++{
++	void __iomem *cfg = pcie->base + PCIE_CFG_OFFSET_ADDR;
++	u32 val;
++	u8 cap_ptr;
++	int speed = 0;
++
++	writel_relaxed(PCIE_CFG_FORCE_BYTE_EN | PCIE_CFG_BYTE_EN(0xf) |
++		       PCIE_CFG_HEADER(0, 0), pcie->base + PCIE_CFGNUM_REG);
++
++	cap_ptr = readl_relaxed(cfg + PCI_CAPABILITY_LIST) & 0xff;
++	while (cap_ptr >= 0x40) {
++		val = readl_relaxed(cfg + cap_ptr);
++		if ((val & 0xff) == PCI_CAP_ID_EXP) {
++			val = readl_relaxed(cfg + cap_ptr + PCI_EXP_LNKSTA);
++			speed = val & PCI_EXP_LNKSTA_CLS;
++			break;
++		}
++		cap_ptr = (val >> 8) & 0xff;
++	}
++
++	return speed;
++}
++
++static void mtk_pcie_en7581_serdes_retrain_pcie2(struct mtk_gen3_pcie *pcie)
++{
++	struct device *dev = pcie->dev;
++	struct reset_control *perst = pcie->perstout_resets[0].rstc;
++	int speed;
++	u32 val;
++
++	if (!pcie->serdes_retrain || !pcie->np_scu)
++		return;
++
++	if (!perst) {
++		dev_warn(dev, "pcie2: PERSTOUT2 reset not available, skip serdes retrain\n");
++		return;
++	}
++
++	speed = mtk_pcie_en7581_read_rootport_speed(pcie);
++	if (speed >= 3) {
++		dev_info(dev, "pcie2: link at Gen%d, no serdes retrain needed\n", speed);
++		return;
++	}
++
++	dev_info(dev, "pcie2: link at Gen%d, retrying with serdes reset for Gen3\n", speed);
++
++	if (reset_control_assert(perst)) {
++		dev_warn(dev, "pcie2: failed to assert PERSTOUT2\n");
++		return;
++	}
++
++	regmap_update_bits(pcie->np_scu, NP_SCU_LANE_CFG0,
++			   NP_SCU_LANE_CFG0_PCIE2_SERDES_RST,
++			   NP_SCU_LANE_CFG0_PCIE2_SERDES_RST);
++	msleep(100);
++	regmap_update_bits(pcie->np_scu, NP_SCU_LANE_CFG0,
++			   NP_SCU_LANE_CFG0_PCIE2_SERDES_RST, 0);
++	msleep(100);
++
++	if (reset_control_deassert(perst)) {
++		dev_warn(dev, "pcie2: failed to deassert PERSTOUT2\n");
++		return;
++	}
++
++	msleep(PCIE_T_PVPERL_MS);
++	if (readl_poll_timeout(pcie->base + PCIE_LINK_STATUS_REG, val,
++			       !!(val & PCIE_PORT_LINKUP), 20,
++			       PCI_PM_D3COLD_WAIT * USEC_PER_MSEC)) {
++		dev_warn(dev, "pcie2: link down after serdes retrain\n");
++		return;
++	}
++
++	speed = mtk_pcie_en7581_read_rootport_speed(pcie);
++	dev_info(dev, "pcie2: link at Gen%d after serdes retrain\n", speed);
++}
++
+ static int mtk_pcie_startup_port(struct mtk_gen3_pcie *pcie)
+ {
+ 	struct resource_entry *entry;
+@@ -518,6 +601,9 @@
+ 		return err;
+ 	}
+ 
++	if (pcie->serdes_retrain && pcie->np_scu)
++		mtk_pcie_en7581_serdes_retrain_pcie2(pcie);
++
+ 	mtk_pcie_enable_msi(pcie);
+ 
+ 	/* Set PCIe translation windows */
+@@ -952,6 +1038,14 @@
+ 			return dev_err_probe(dev, PTR_ERR(pcie->sec_base), "failed to map secondary register base\n");
+ 	}
+ 
++	/* Optional experimental Gen3 x1 retrain for the second Wi-Fi PCIe line */
++	pcie->serdes_retrain = of_property_read_bool(dev->of_node, "airoha,serdes-retrain");
++	if (pcie->serdes_retrain) {
++		pcie->np_scu = syscon_regmap_lookup_by_phandle(dev->of_node, "airoha,scu");
++		if (IS_ERR(pcie->np_scu))
++			return dev_err_probe(dev, PTR_ERR(pcie->np_scu), "failed to map SCU syscon\n");
++	}
++
+ 	return 0;
+ }
+ 
