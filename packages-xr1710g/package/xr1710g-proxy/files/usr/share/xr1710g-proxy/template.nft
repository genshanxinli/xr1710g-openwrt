#!/usr/sbin/nft -f
# xr1710g-proxy nft 模板（ADR-0003 架构 C）
#
# 渲染：libexec/xr1710g-proxy/render.sh 做占位符替换后 `nft -f -` 单批原子载入。
# 占位符共四个：fwmark / dns 端口 / 名单 IPv4 元素 / 名单 IPv6 元素（见文件末尾，不在此列出以免误匹配）。
# 铁律（plan/00 §3）：
#   I3：本文件绝不出现 `table inet fw4`、绝不出现 `flow add` ⇒ 固件任何代码路径不触碰卸载点。
#   独立表 inet xr1710g_proxy ⇒ stop 时 `nft delete table inet xr1710g_proxy` 精确回收。
#
# 判定位置与 offload 不变量：
#   capture 链在 prerouting(mangle) 只做两件事——
#     ① 名单客户端 → 目的 ∈ @china_ip4/@china_ip6 ⇒ accept：放回**原 forward 路径**，
#        继续走 chain forward 的 `flow add @ft` ⇒ PPE/NPU 卸载**完整保留**；
#     ② 其余 ⇒ 打 mark 送 TUN（唯一离开快路径的集合）。
#   名单外客户端不匹配任何规则 ⇒ 行为与本表不存在时逐字节一致。

table inet xr1710g_proxy {
	# ── 名单客户端（由 uci global.proxy_hosts 按地址族分入两个集合）──
	# 空集合会让 `ip saddr @set` 成为语法错误，故渲染时始终至少保留一个不可路由占位元素；
	# 名单真为空时渲染为 `elements = { 192.0.2.1 }` / `{ 2001:db8::1 }`（永不作为真实源地址）。
	# 必须按族分集：inet 表里 `ip6 saddr @<ipv4_addr 集合>` 是 datatype mismatch（已实机 nft -c 抓出）。
	set proxy_hosts4 {
		type ipv4_addr
		flags interval
		elements = { @@PROXY_HOSTS4_ELEMS@@ }
	}

	set proxy_hosts6 {
		type ipv6_addr
		flags interval
		elements = { @@PROXY_HOSTS6_ELEMS@@ }
	}

	# ── CN 放行集合（只读快照 + 运行期更新 + dnsmasq --nftset 注入）──
	# 同上：空集合不可引用，保留 TEST-NET 占位元素；装载脚本用 `flush set` + `add element`
	# 单批原子替换（见 01-方案一 §4.4）。
	set china_ip4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.2 }
	}

	set china_ip6 {
		type ipv6_addr
		flags interval
		elements = { 2001:db8::2 }
	}

	# ── 名单客户端 :53 → sing-box DNS（架构 C 的 fake-ip 作用域边界）──
	# 非名单客户端不匹配 ⇒ 继续走 dnsmasq，永远拿真实 IP（P1-3）。
	chain dns_redirect {
		type nat hook prerouting priority dstnat - 5; policy accept;
		ip  saddr @proxy_hosts4 meta l4proto { tcp, udp } th dport 53 redirect to :@@DNS_PORT@@
		ip6 saddr @proxy_hosts6 meta l4proto { tcp, udp } th dport 53 redirect to :@@DNS_PORT@@
	}

	# ── 分流判定（路由判定之前）──
	chain capture {
		type filter hook prerouting priority mangle; policy accept;

		# ① 名单客户端访问 CN 目的 → 直连，保 offload（硬约束：CN 域名必须回真实 IP，
		#    否则客户端拿 fake-ip，这里匹配不到真实 CN 目的 IP，放行失效 → 卸载全丢）
		ip  saddr @proxy_hosts4 ip  daddr @china_ip4 accept
		ip6 saddr @proxy_hosts6 ip6 daddr @china_ip6 accept

		# ② 其余（含非 CN、fake-ip、未收录 IP）→ 打 mark，由策略路由送 TUN
		#    fake-ip 只是 DNS 应答、不是路由机制；这里进 TUN 的才是"用户态集合"
		ip  saddr @proxy_hosts4 meta mark set @@FW_MARK@@
		ip6 saddr @proxy_hosts6 meta mark set @@FW_MARK@@

		# 名单外客户端：不匹配 ⇒ 落回原 forward 路径 ⇒ flow add @ft ⇒ PPE/NPU
	}
}
